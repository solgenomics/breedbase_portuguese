<%args>
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>

<center>
    <table class="boxbgcolor2" width="100%" summary="">
        <tr>
            <td width="15%">&nbsp;</td>
            <td width="70%" class="left">
                <div class="boxcontent">
                    <div class="subheading" style='font-size:1.1em'>
                    Buscar<br>
                    </div>
                    <div class="boxsubcontent">
                        <div style="margin-left:10px">
                            <a href="/search/organisms">Organismos</a> - procurar por organismos<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/locus">Genes</a> - Pesquisa genética.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/features">Características do genoma</a> Procure por muitos tipos de anotações e sequências.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/stocks">Fenótipos</a> Procure mutantes, acessos e características.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/phenotypes/qtl">QTLs</a> Uma interface web para carregar dados brutos do QTL, mapeamento de QTL e interface de busca de QTLs.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/transcripts/unigene">Unigenes</a> - Busca Unigene.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/family">Famílias Gene</a> - Busca da família Unigene.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/markers">Marcadores</a> - Busca de marcadores.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/genomic/clones">BACs</a> - Busca de BAC (Bacterial Artificial Chromosome).<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/transcripts/est">ESTs e bibliotecas</a> - Encontre bibliotecas EST por palavra-chave, por exemplo, nome da biblioteca, organismo, tecido, estágio de desenvolvimento, ou autores.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/insitu/">Banco de dados Insitu</a> Um banco de dados de imagens in-situ que podem ser atualizadas pelos usuários, com funções de edição de imagens adicionar, excluir e anotar. As imagens atuais foram geradas pelo projeto de genoma floral (FGP). Para mais informações sobre o projeto do genoma floral, visite http://floralgenome.org/ e http://pgn.cornell.edu/.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/images">Imagens</a> Procure imagens contidas no banco de dados da SGN.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/expression">Expressão</a> Procure imagens contidas no banco de dados da SGN.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/search/people">Pessoas</a> Pesquise o banco de dados de pesquisadores que usam a SGN.<br><br></div>
                        <div style="margin-left:10px">
                            <a href="/help/faq.pl">FAQ</a> - Perguntas frequentes de usuários da SGN.<br><br></div>
                    </div>
                </div>
            </td>
            <td width="15%">&nbsp;</td>
        </tr>
    </table>
</center>

