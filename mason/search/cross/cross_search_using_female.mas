<& /page/page_title.mas, title=>'Procure em detalhes usando pais femininos' &>
<br>
<&| /page/info_section.mas, title => 'Buscar', collapsible=>1, collapsed=>0&>
    <div class="row" id="cross_search_form" >
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-horizontal">
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3">Parente feminina:</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="cross_female_parent" placeholder="Entre, mãe">
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_cross_male_parents"><i class="glyphicon glyphicon-search"></i> Pai/população masculino</button>
                                        <button class="btn btn-primary" id="search_all_crosses_using_female"><i class="glyphicon glyphicon-search"></i> Todas as Cruzamentos </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3">Pai/população masculino:</label>
                            <div class="col-sm-9" >
                                <div class="input-group">
                                    <select class="form-control" id="cross_male_parent">
                                        <option value="">Escolha a mãe feminina primeiro</option>
                                    </select>
                                    </select>
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_crosses_female_male"><i class="glyphicon glyphicon-search"></i> Informações Cruzadas </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>
<&| /page/info_section.mas, title => 'Resultados da Pesquisa', collapsible=>1, collapsed=>0&>
    <div class="well well-sm">
        <& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="cross_female_male_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Parental feminino</th>
                            <th>Pai/população masculino</th>
                            <th>ID único do cruzamento</th>
                            <th>Tipo Cruzado</th>
                            <th>Nome da família</th>
                            <th>Experiência de Cruzamento</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-body">
                <&| /page/info_section.mas, title => 'Copiar cruzamentos para uma lista', collapsible=>1, collapsed=>1, subtitle=>'<i>Copie as identidades únicas que aparecem na tabela para uma nova lista.</i>'&>
                    <div style="text-align:right" id="crosses_to_list_menu"></div>
                    <div id="cross_names" style="display: none;"></div>
                </&>
            </div>
        </div>
    </div>
</&>


<script>


jQuery(document).ready(function (){

    jQuery("#cross_female_parent").autocomplete({
        source:'/ajax/stock/cross_female_parent_autocomplete',
    });


    jQuery("#search_cross_male_parents").click(function(){

        jQuery.ajax({
            url:'/ajax/search/cross_male_parents',
            data:{'female_parent':jQuery('#cross_female_parent').val()},
            success: function(response){
                console.log(response);
                var html = '<select id = "cross_male_parent" >';
                for (var i=0; i<response.data.length; i++) {
                    html = html + "<option value='"+response.data[i][0]+ "'>" + response.data[i][0] + "</option>";
                }
                html = html + "</select>";
                console.log(html);

                if(i ==''){
                    alert("Sem parental masculino");
                    return;
                }

                jQuery('#cross_male_parent').html(html);
            },
            error:function(response){
                alert("Ocorreu um erro");
            }
        });
    });


    jQuery('#search_crosses_female_male').click(function(){

        var table = jQuery('#cross_female_male_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy'    : true,
            'ajax':{'url':'/ajax/search/crosses',
                'data':{'female_parent':jQuery('#cross_female_parent').val(),
                    'male_parent':jQuery('#cross_male_parent').val()},
            }
        });

        jQuery('#cross_female_male_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }

            jQuery('#cross_names').html(names);

            addToListMenu('crosses_to_list_menu', 'cross_names',{
                listType:'crosses'
            });
        });
    });


    jQuery('#search_all_crosses_using_female').click(function(){

        var table = jQuery('#cross_female_male_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy': true,
            'ajax':{'url':'/ajax/search/crosses',
                data:{'female_parent':jQuery('#cross_female_parent').val()},
            }
        });

        jQuery('#cross_female_male_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }

            jQuery('#cross_names').html(names);

            addToListMenu('crosses_to_list_menu', 'cross_names',{
                listType:'crosses'
            });
        });

    });

});


</script>
