
<%args>
</%args>

<style>
#images_search_results {
    width: 100% !important;
}
</style>

<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => "Pesquisa de imagens" &>

<&| /page/info_section.mas, title=>"Critérios de busca de imagens",  collapsible => 1, collapsed=>0, subtitle => "Todas as imagens podem não ter nomes, descrições ou etiquetas associadas a elas."&>

    <div id="image_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label">Descrevedores de imagens (nome, descrição ou nome do arquivo): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_description_filename_composite" name="image_description_filename_composite" placeholder="Por exemplo. MyImageName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Submeter: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_submitter" name="image_submitter" placeholder="Por exemplo. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Marca de imagem: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_tag" name="image_tag" placeholder="Por exemplo. ImageTagName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Ações associadas: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_stock_uniquename" name="image_stock_uniquename" placeholder="Por exemplo. FieldPlot100" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Material relacionado: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_related_stock" name="image_related_stock" placeholder="Por exemplo. Acesso, Enredo, Tecidos, Amostra" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Projeto associado: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_project_name" name="image_project_name" placeholder="Por exemplo. DroneProjeto 01/01/2019" />
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="image_search_submit" >Buscar</button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>"Resultados da Pesquisa de Imagens",  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="images_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>Miniatura da Imagem</th>
                    <th>Nome do arquivo</th>
                    <th>Descrição</th>
                    <th>Submisso</th>
                    <th>Associações</th>
                    <th>Acesso Relacionada</th>
                    <th>Etiquetas</th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<script>

var images_table;

jQuery(document).ready(function () {

    _load_image_search_results();

    jQuery("#image_submitter").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery("#image_stock_uniquename").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_related_stock").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_project_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    jQuery('#image_search_submit').click( function() {
        _load_image_search_results();
    });

    jQuery('#image_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#image_search_submit').click();
        }
    });

    jQuery('#images_search_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox({photo: true, onComplete: function () {
            var titleWidth = jQuery('#cboxTitle').outerWidth(true);
            var paddedWidth = titleWidth + 500;
            jQuery.colorbox.resize({width: paddedWidth + 'px'});
        }});
    });

});

function _load_image_search_results() {
    images_table = jQuery('#images_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/images',
            'type': 'POST',
            'data': function(d) {
              d.image_description_filename_composite = jQuery('#image_description_filename_composite').val();
              d.image_person = jQuery('#image_submitter').val();
              d.image_tag = jQuery('#image_tag').val();
              d.image_stock_uniquename = jQuery('#image_stock_uniquename').val();
              d.image_related_stock = jQuery('#image_related_stock').val();
              d.image_project_name = jQuery('#image_project_name').val();
            }
        }
    });
}

</script>
