<%args>

  $results

  $quick_search_term

  $show_times => 0

  $xrefs      => {}
  $xrefs_time => 0

</%args>

<& /page/page_title.mas, title => 'Procura rápida '.encode_entities( '"'.$quick_search_term.'"' ) &>

<div class="page_introduction">
  Nota: a busca rápida não realiza exatamente as mesmas consultas que buscas completas para os vários tipos de dados. Se seu resultado desejado não aparecer, tente de novo com uma das ferramentas de busca avançadas no menu de busca.
</div>

<&| /page/info_section.mas, title => 'Exatamente' &>

<div class="well">

% if( $show_times ) {
  <div>Site xref search time: <% sprintf('%0.1f sec', $xrefs_time) %></div>
% }
% if( @$xrefs ) {
  <& /sitefeatures/mixed/xref_set/link.mas, xrefs => $xrefs &>
    <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />
% }

  <div>
    <dl>
      <dt>Identificadores, dados de melhoramento</dt>
      <dd>
	<div style="float: left; width: 50%">
	  <% $search{accessions} %>
	  <% $search{populations} %>
	  <% $search{vectors} %>
	  <% $search{trials} %>
	</div>
	<div style="float: right; width: 50%">
	  <% $search{traits} %>
	  <% $search{locations} %>
	  <% $search{breeding_programs} %>
	</div>
	<div style="clear: both;">&nbsp;</div>
      </dd>
      <dt>Identificadores - Dados Genômicos</dt>
      <dd >
	<div style="float: left; width: 50%">
          <% $search{marker} %>
          <% $search{clone} %>
          <% $search{est} %>
	</div>
	<div style="float: right; width: 50%;">
	  <% $search{unigene} %>
	  <% $search{microarray} %>
	</div>
      </dd>
    </dl>
    <span style="margin-bottom:20px;">&nbsp</span>
  </div>
</div>

</&>

<&| /page/info_section.mas,
    title => 'Buscas fuzzy',
    subtitle => 'Clique para ver os resultados da pesquisa',
 &>

<div class="well">
  
  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">Identificadores</div>
      <div style="float: right; width: 50%">Bibliotecas do DNA</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{bac} %>
        <% $search{phenotype} %>
      </div>
      <div style="float: right; width: 50%">
	<% $search{locus_allele} %>
        <% $search{library} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">Pessoas (pesquisando pelo nome)</div>
      <div style="float: right; width: 50%">Anotações</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{people} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{manual_annotations} %>
        <% $search{automatic_annotations} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">Imagens</div>
      <div style="float: right; width: 50%">Páginas Web</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{image} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{sgn_pages} %>
        <% $search{external_link} %>
        <% $search{web} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

</div>

</&>

<%init>

  use HTML::Entities;

  my %search = %$results;
  for my $search ( values %search ) {
      my ( $url, $desc ) = @{$search->{result}};
      my $time  = $show_times ? sprintf(' (%0.1f sec)', $search->{time}) : '';
      my $html = $url ? qq|<div><a class="quicksearch_hit" href="$search->{result}[0]">$search->{result}[1]$time</a></div>|
                      : qq|<div class="ghosted">$desc$time</div>|;
      $search = $html;
  }

</%init>

