
<%args>

  $sp_person_autocomplete_uri => '/ajax/people/autocomplete'
  $trait_autocomplete_uri     => '/ajax/stock/trait_autocomplete'
  $onto_autocomplete_uri      => '/ajax/cvterm/autocomplete'
  $trait_db_name              => 'SP'

  $organisms       => undef
  $stock_types     => undef
  $breeding_programs => undef
  $editable_stock_props => undef
</%args>

<%perl>
  my $user_role = '';
  if ($c->user) {
    $user_role = $c->user->get_object()->get_user_type();
  }
</%perl>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.Effects', 'CXGN.List' ] &>

<div class="container-fluid">

<& /page/page_title.mas, title=>'Pesquisar acessos e parcelas' &>


<%perl>

use CXGN::Page::FormattingHelpers qw / conditional_like_input_html simple_selectbox_html/;

my $accession_cvterm_id;

for (my $i=0; $i< scalar(@$stock_types); $i++) {
     if ( $stock_types->[$i][1] eq "accession" ) {
     	$accession_cvterm_id = $stock_types->[$i][0];
	last();
     }
}

my $stock_type_select = simple_selectbox_html(
  choices   => $stock_types,
  id        => "stock_type_select",
  selected => $accession_cvterm_id
);

my $organism_select = simple_selectbox_html(
  choices  =>  $organisms   ,
  id       => "organism_select",
);

my $breeding_programs_select = simple_selectbox_html(
    choices => $breeding_programs,
    id      => "breeding_program" ,
);

</%perl>

<&| /page/info_section.mas, title => 'Pesquisador', collapsible=>1, collapsed=>0 &>

  <div id="stock_search_form" class="well well-sm">

    <&| /page/info_section.mas, title => 'Pesquisa por nome', collapsible=>1, collapsed=>0 &>

    <div class="row">
      <div class="col-sm-11">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Nome ou descrição do material: </label>
          <div class="col-sm-9" >
            <div class="form-group form-group-sm">
              <div class="input-group">
                <span class="input-group-btn" width="20%">
                  <select class="form-control" id="any_name_matchtype" name="any_name_matchtype">
                    <option title="começa com" value="starts_with" selected="selected">começa com</option>
                    <option title="contém" value="contains">contém</option>
                    <option title="termina com" value="ends_with">termina com</option>
                    <option title="exatamente" value="exactly">exatamente</option>
                  </select>
                </span>
                  <span class="input-group-btn">
                  <input class="form-control" name="any_name" id="any_name" value="" size="30" type="text" placeholder="Digite a pesquisa aqui..."/>
                </span>
              </div>
            </div>
            <div class="form-group form-group-sm">
              <label class="col-sm-3 control-label">Tipo de material: </label>
              <div class="col-sm-9" >
                <% $stock_type_select %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </&>

    <&| /page/info_section.mas, title => 'Pesquisa avançada', collapsible=>1, collapsed=>1, id=>'advanced_search_panel' &>

    <&| /page/info_section.mas, title => 'Propriedades', collapsible=>1, collapsed=>1 &>

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label">Organismo:</label>
        <div class="col-sm-8" >
          <% $organism_select %>
        </div>
      </div>
    </div>

    <br />

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label">Organização:</label>
        <div class="col-sm-8" >
          <input type="text" class="form-control" id="organization" placeholder="Digite para ver sugestões"/>
        </div>
      </div>
    </div>

    <br /><hr /><br />

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label">Pesquisar por outra propriedade:</label>
        <div class="col-sm-8" >
          <div class="form-group">
            <div class="input-group">
              <span class="input-group-btn">
                <select class="form-control" id="editable_stockprop_search_term" name="editable_stockprop_search_term">
%  foreach my $stockprop (sort {uc($a) cmp uc($b)} @$editable_stock_props){
                  <option title="<% $stockprop %>" value="<% $stockprop %>" ><% $stockprop %></option>
%  }
                </select>
              </span>
              <span class="input-group-btn">
                <button class="btn btn-primary btn-sm" id="editable_stockprop_search_add">Adicionar</button>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="editable_stockprop_search_div"></div>

% if (( $user_role eq 'curator' ) || ( $user_role eq 'submitter' )) {
    <br /><hr /><br />
    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label">Está obsoleto?</label>
        <div class="col-sm-8" >
          <div class="form-group">
            <select class="form-control" id="obsolete_stock_search_term" name="obsolete_stock_search_term">
              <option value="false" selected>Não obsoleto</option>
              <option value="true">Obsoleto</option>
              <option value="include_obsolete">Incluir obsoletas</option>
            </select>
          </div>
        </div>
      </div>
    </div>
% }

    </&>
    <&| /page/info_section.mas, title => 'Uso', collapsible=>1, collapsed=>1 &>

    <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Nome do projeto: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="project" placeholder="Digite para ver sugestões"/>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Local do projeto: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="location" placeholder="Digite para ver sugestões"/>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Ano do projeto: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="year" placeholder="Digite para ver sugestões"/>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Programa de melhoramento: </label>
          <div class="col-sm-9" >
            <% $breeding_programs_select %>
          </div>
        </div>
      </div>
    </div>

    </&>
    <&| /page/info_section.mas, title => 'Fenótipos', collapsible=>1, collapsed=>1 &>

    <div class="row">
        <div class="col-sm-6">
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Característica: </label>
            <div class="col-sm-9" >
              <input type="text" class="form-control" id="trait" placeholder="Digite para ver sugestões"/>
            </div>
          </div>
        </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Valor mínimo da característica: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="minimum_trait_value" />
          </div>
        </div>
      </div>
      </div>
      <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Valor máximo da característica: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="maximum_trait_value" />
          </div>
        </div>
      </div>
    </div>
    </&>

    <&| /page/info_section.mas, title => 'Pesquisar acessos usando genótipos', collapsible=>1, collapsed=>1 &>
        <div class="row">
            <a href="/search/stocks_using_genotypes"><p>Acessar a pesquisa de acessos usando genótipos.</p></a>
        </div>
    </&>

    </&> <!-- closes advanced search -->

    <center>
    <button class="btn btn-primary" id="submit_stock_search" />Pesquisador</button>
    </center>
    <br/><br/>
  </div>
</&>

<br />

<&| /page/info_section.mas, title => 'Resultados da pesquisa', collapsible=>1, collapsed=>0 &>

<div class="well well-sm">

    <div class="row">
      <div class="col-sm-11">
        <div class="form-group form-group-sm">
          <label class="col-sm-4 control-label">Exibir outra propriedade: </label>
          <div class="col-sm-8" >
            <div class="form-group">
              <div class="input-group">
                <span class="input-group-btn">
                  <select class="form-control" id="editable_stockprop_view_column_term" name="editable_stockprop_view_column_term">
%  foreach my $stockprop (sort { "\L$a" cmp "\L$b" } @$editable_stock_props){
                    <option title="<% $stockprop %>" value="<% $stockprop %>" ><% $stockprop %></option>
%  }
                  </select>
                </span>
                  <span class="input-group-btn">
                    <button class="btn btn-primary btn-sm" id="editable_stockprop_view_column_add">Adicionar</button>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <div id="stock_search_results_div">
                <table id="stock_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>ID do material</th>
                    <th>Nome do material</th>
                    <th>Tipo de material</th>
                    <th>Organismo</th>
                    <th>Sinônimos</th>
                    <th>Organização</th>
                </tr>
                </thead>

                </table>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title => 'Copiar resultados para uma lista', collapsible=>1, collapsed=>0, subtitle=>'<i>Copie os nomes dos materiais exibidos na tabela de resultados para uma lista nova ou existente. Escolha "Todos" no seletor de quantidade de registros para incluir todos os resultados.</i>'&>
            <br>
            <div style="text-align:right" id="results_to_list_menu"></div>
            <div id="search_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>

</div>

</&>

<& /page/detail_page_2_col_section.mas, info_section_title => "<h4 style='display:inline'>Filtragem gráfica por desempenho fenotípico</h4>", info_section_subtitle => 'Filtre graficamente o desempenho médio dos acessos para combinações de características', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "stocks_search_graphical_filtering" &>


</div>

<script>

var stock_table;

function stockSearchTypeLabel(name) {
    const labels = {
        accession: 'Acesso', population: 'População', plot: 'Parcela',
        subplot: 'Subparcela', plant: 'Planta', tissue_sample: 'Amostra de tecido',
        seedlot: 'Lote de sementes', cross: 'Cruzamento', family_name: 'Família',
        vector_construct: 'Construção vetorial', 'backcross population': 'População de retrocruzamento',
        'f2 population': 'População F2', 'mutant population': 'População mutante',
        'training population': 'População de treinamento'
    };
    return Object.prototype.hasOwnProperty.call(labels, name) ? labels[name] : name;
}

function selectedStockSearchType() {
    return jQuery('#stock_type_select option:selected').attr('data-stock-type') || '';
}

function stockSearchPropertyLabel(name) {
  var labels = {
    stock_synonym: 'Sinônimo',
    'solcap number': 'Número SolCAP',
    variety: 'Variedade',
    released_variety_name: 'Nome da variedade lançada',
    donor: 'Doador',
    'donor institute': 'Instituição doadora',
    'donor PUI': 'Identificador permanente do doador',
    'country of origin': 'País de origem',
    state: 'Estado',
    'institute code': 'Código da instituição',
    'institute name': 'Nome da instituição',
    'biological status of accession code': 'Código do estado biológico do acesso',
    notes: 'Observações',
    'accession number': 'Número do acesso',
    PUI: 'Identificador permanente (PUI)',
    'seed source': 'Origem das sementes',
    'type of germplasm storage code': 'Código do tipo de armazenamento de germoplasma',
    'acquisition date': 'Data de aquisição',
    organization: 'Organização',
    location_code: 'Código do local',
    ploidy: 'Ploidia',
    ploidy_level: 'Nível de ploidia',
    genome_structure: 'Estrutura do genoma',
    ncbi_taxonomy_id: 'ID taxonômico do NCBI',
    transgenic: 'Transgênico',
    introgression_parent: 'Genitor de origem da introgressão',
    introgression_backcross_parent: 'Genitor de retrocruzamento da introgressão',
    introgression_map_version: 'Versão do mapa da introgressão',
    introgression_chromosome: 'Cromossomo da introgressão',
    introgression_start_position_bp: 'Posição inicial da introgressão (pb)',
    introgression_end_position_bp: 'Posição final da introgressão (pb)',
    number_of_insertions: 'Número de inserções',
    GenbankRecord: 'Registro no GenBank',
    catalog: 'Catálogo',
    Strain: 'Linhagem',
    CloningOrganism: 'Organismo hospedeiro da clonagem',
    InherentMarker: 'Marcador inerente',
    Backbone: 'Estrutura-base',
    SelectionMarker: 'Marcador de seleção',
    CassetteName: 'Nome do cassete',
    VectorType: 'Tipo de vetor',
    Gene: 'Gene',
    Promotors: 'Promotores',
    Terminators: 'Terminadores',
    PlantAntibioticResistantMarker: 'Marcador de resistência a antibióticos no hospedeiro',
    BacterialResistantMarker: 'Marcador de resistência bacteriana'
  };
  return Object.prototype.hasOwnProperty.call(labels, name) ? labels[name] : name;
}

jQuery(document).ready(function () {
    jQuery('#stock_type_select option').each(function() {
        const name = jQuery(this).text().trim();
        const label = stockSearchTypeLabel(name);
        jQuery(this).attr('data-stock-type', name).text(label).attr('title', label);
    });
    jQuery('#editable_stockprop_search_term option, #editable_stockprop_view_column_term option').each(function() {
        const label = stockSearchPropertyLabel(jQuery(this).val());
        jQuery(this).text(label).attr('title', label);
    });

    window.addEventListener('load', () => {
      // Reset the advanced search form parameters on load.
      // Very similar to later functionality but that one is for advanced search and on load trigger only.
      var input_list = document.getElementById('advanced_search_panel_content').getElementsByTagName('input');
      for (let input_elem of input_list) {
        input_elem.value = '';
      }

      var select_list = document.getElementById('advanced_search_panel_content').getElementsByTagName('select');
      for (let select_elem of select_list) {
        select_elem.selectedIndex = 0;
      }

      var type_select = document.getElementById('stock_type_select');
      type_select.selectedIndex = [...type_select.options].findIndex(elem => elem.getAttribute('data-stock-type') == 'accession') ?? 1;
    });


    const textFields = document.querySelectorAll('input[type="text"]');
    // Loop through the text fields and set their values to an empty string
      textFields.forEach(textField => {
        textField.value = '';
     });

     // Get all the dropdown select elements in the form
     // Reset all but 'stock_type_select' dropdown to zero value
     // Leave 'stock_type_select' with the default "selected" value from the mason file.
     const selectFields = document.querySelectorAll('select');
     selectFields.forEach(selectField => {
        if (selectField.id != 'stock_type_select') {
          selectField.selectedIndex = 0;
        }
     });

     jQuery("#person").autocomplete({
        source: '<% $sp_person_autocomplete_uri %>'
     });
     jQuery("#trait").autocomplete({
        source: '<% $trait_autocomplete_uri %>'
     });
     jQuery("#onto").autocomplete({
        source: '<% $onto_autocomplete_uri %>' + "?db_name=" + '<% $trait_db_name %>'
     });
     jQuery("#project").autocomplete({
        source: '/ajax/stock/project_autocomplete',
     });
     jQuery("#any_name").autocomplete({
        source: '/ajax/stock/stock_autocomplete?stock_type_id='+jQuery('#stock_type_select option:selected').val(),
     });
     jQuery('#stock_type_select').change(function(){
         jQuery("#any_name").autocomplete({
            source: '/ajax/stock/stock_autocomplete?stock_type_id='+jQuery('#stock_type_select option:selected').val(),
         });
     });
     jQuery("#location").autocomplete({
        source: '/ajax/stock/geolocation_autocomplete',
     });
     jQuery("#year").autocomplete({
        source: '/ajax/stock/project_year_autocomplete',
     });
     jQuery("#organization").autocomplete({
        source: '/ajax/stock/stockproperty_autocomplete?property=organization',
     });

    // Update changed organization
    jQuery(document).on("change", "#organization", function() {
      editable_stockprops_search["organization"] = {
        "matchtype": "contains",
        "value": jQuery(this).val()
      }
    });

    var editable_stockprops_search = {};
    var params = {};
    var matchtype = {};
    jQuery('#editable_stockprop_search_add').click( function(){
        // console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
        // console.log("Value is "+jQuery('#editable_stockprop_search_term').val());
        editable_stockprops_search[jQuery('#editable_stockprop_search_term').val()] = {"matchtype": "contains"};
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
        _draw_editable_stockprops_search_fields();
    });

    jQuery(document).on('click', 'button[name="editable_stockprop_search_remove"]', function(){
        delete editable_stockprops_search[jQuery(this).data('property')];
        _draw_editable_stockprops_search_fields();
    });

    jQuery(document).on("keyup", 'input[name="editable_stockprop_search_inputs"]', function(){
        //Store typed value in object, in case of redraw inputs (input deletion or addition) the value will be still there. Also for search submission
        editable_stockprops_search[jQuery(this).data('property')]["value"] = jQuery(this).val();
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
    });

    jQuery(document).on("change", 'select[name="editable_stockprop_matchtype"]', function(){

    // jQuery(document).on("change", 'input[name="editable_stockprop_matchtype"]', function(){
        //Store typed value in object, in case of redraw inputs (input deletion or addition) the value will be still there. Also for search submission
        console.log("prop is "+jQuery(this).data('property'));
        editable_stockprops_search[jQuery(this).data('property')]["matchtype"] = jQuery(this).val();
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
    });

    function _draw_editable_stockprops_search_fields(){
        jQuery('#editable_stockprop_search_div').html('');
        for (var property in editable_stockprops_search) {
            if (editable_stockprops_search.hasOwnProperty(property)) {
                jQuery('#editable_stockprop_search_div').append('<div class="form-group form-group-sm"><label class="col-sm-4 control-label">'+stockSearchPropertyLabel(property)+': </label><div class="col-sm-8"><div class="form-group"><div class="input-group"><span class="input-group-btn" width="20%"><select class="form-control" id="editable_stockprop_matchtype" name="editable_stockprop_matchtype" data-property="'+property+'"><option title="contém" value="contains" selected="selected">contém</option><option title="começa com" value="starts_with">começa com</option><option title="termina com" value="ends_with">termina com</option><option title="exatamente" value="exactly">exatamente</option><option title="uma das opções" value="one of">uma das opções (separe as possibilidades por vírgulas)</option></select></span><span class="input-group-btn"><input type="text" class="form-control" name="editable_stockprop_search_inputs" id="'+property+'_input_id" data-property="'+property+'" placeholder="Digite para ver sugestões"/></span><span class="input-group-btn"><button name="editable_stockprop_search_remove" data-property="'+property+'" class="btn"><span class="glyphicon glyphicon-remove"></span></button></span></div></div></div></div>');

                jQuery('#editable_stockprop_search_div').find("#"+property+"_input_id").autocomplete({
                   source: '/ajax/stock/stockproperty_autocomplete?property='+property,
                });
            }
        }
    }

    //For adding stockprop columns to search result
    var stockprop_extra_columns_view = { 'organization':1 };
    var stockprop_extra_columns_view_array = [ 'organization' ];
    jQuery('#editable_stockprop_view_column_add').click(function(){
        var selected_property = jQuery('#editable_stockprop_view_column_term').val();
        if (!(selected_property in stockprop_extra_columns_view)){
            stockprop_extra_columns_view[selected_property] = 1;
            stockprop_extra_columns_view_array.push(selected_property);

            var table_header_html =
              '<table id="stock_search_results" class="table table-hover table-striped" width="100%">' +
                '<thead><tr>' +
                  '<th>ID do material</th>' +
                  '<th>Nome do material</th>' +
                  '<th>Tipo de material</th>' +
                  '<th>Organismo</th>' +
                  '<th>Sinônimos</th>';
            for (var i = 0; i < stockprop_extra_columns_view_array.length; i++) {
              table_header_html += '<th>' + stockSearchPropertyLabel(stockprop_extra_columns_view_array[i]) + '</th>';
            }
            table_header_html +=
                '</tr></thead>' +
              '</table>';
            jQuery('#stock_search_results_div').html(table_header_html);
        }
        stock_table.destroy();
        _load_stock_search_results(selectedStockSearchType(), editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array);
    });

    parseArgs(editable_stockprops_search);

    jQuery('#stock_search_results').on( 'draw.dt', function () {
        const name_links = stock_table.column(1).data();
        let names = [];
        for (let i = 0; i < name_links.length; i++) { //extract text from anchor tags
            names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
        }

        let is_obsolete = '';
        is_obsolete = jQuery("#obsolete_stock_search_term option:selected").val();

        let  list_type = '';
        if (is_obsolete == 'true') {
            list_type = 'obsoleted_stocks';
        } else if (is_obsolete == 'include_obsolete') {
            list_type = 'accessions_and_obsoleted_accessions';
        } else {
            list_type = selectedStockSearchType()+'s' || 'null';
        }

        jQuery('#search_result_names').html(names);
        addToListMenu('results_to_list_menu', 'search_result_names', {
            listType: list_type
        });
    });

   jQuery('#submit_stock_search').click( function() {
        //stock_table.search("stock_search_results").draw();
        _load_stock_search_results(selectedStockSearchType(), editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array);
   });

   jQuery('#stock_search_form').keypress( function( e ) {
           var code = e.keyCode || e.which;
           if( code == 13 ) {
                jQuery('#submit_stock_search').click();
           }
    } );


    // For graphical filtering, using same search params
    var run = false;
    jQuery('#stock_search_graphical_filter_onswitch').on("click", function(){
        var stock_type = selectedStockSearchType();
        if (stock_type == 'accession'){
            jQuery.ajax ({
                url : '/ajax/search/stocks',
                data : {
                    minimal_info : 1,
                    any_name : jQuery('#any_name').val(),
                    any_name_matchtype : jQuery('#any_name_matchtype').val(),
                    stock_type : selectedStockSearchType(),
                    organism : jQuery('#organism_select').val(),
                    person : jQuery('#person').val(),
                    trait : jQuery('#trait').val(),
                    minimum_trait_value : jQuery('#minimum_trait_value').val(),
                    maximum_trait_value : jQuery('#maximum_trait_value').val(),
                    project : jQuery('#project').val(),
                    location : jQuery('#location').val(),
                    year : jQuery('#year').val(),
                    breeding_program : jQuery('#breeding_program').val(),
                    editable_stockprop_values : JSON.stringify(editable_stockprops_search)
                },
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                    jQuery('#stock_search_graphical_filter_div').html("[CARREGANDO ...]");
                },
                success: function(response){
                    //console.log(response);
                    jQuery("#working_modal").modal("hide");
                    var stock_ids = [];
                    for (var i=0; i<response.data.length; i++){
                        stock_ids.push(response.data[i][0]);
                    }

                    if (run) {
                        jQuery("#stock_search_graphical_filter_results_div").DataTable().destroy();
                        jQuery("#stock_search_graphical_filter_results_div").html("");
                    }
                    run = true;
                    params = {"germplasmDbIds" : stock_ids, "observationLevel" : 'plot'};
                    loadBrAPIData("<% $c->config->{main_production_site_url} %>",params,function(response){
                        useBrAPIData(response,true);
                    });

                },
                error: function(response){
                    jQuery("#working_modal").modal("hide");
                    alert("Erro ao recuperar os acessos na filtragem gráfica.");
                }
            });
        } else {
            jQuery('#stock_search_graphical_filter_div').html("A filtragem gráfica está disponível somente para acessos. A pesquisa atual usa o tipo "+stockSearchTypeLabel(stock_type)+". Altere a pesquisa para acessos para usar a filtragem gráfica.");
        }
    });


});

function parseArgs(editable_stockprops_search) {
  const params = new URLSearchParams(window.location.search);
  if ( params.has('any_name') ) {
    jQuery('#any_name').val(params.get('any_name'));
    jQuery('#stock_type_select').val(0);
  }
  if ( params.has('stock_type') ) {
    var type = params.get('stock_type');
    var value = jQuery("#stock_type_select option").filter(function() { return jQuery(this).attr("data-stock-type") === type; }).val();
    jQuery('#stock_type_select').val(value);

  }
  if ( params.has('prop') & params.has('value') ) {
    editable_stockprops_search[params.get('prop')] = {"matchtype": "exactly"};
    editable_stockprops_search[params.get('prop')]["value"] = params.get('value');
  }
}

function _load_stock_search_results(stock_type, editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array){
    console.log(stock_type);
    console.log("Making AJAX request with editable stockprop "+JSON.stringify(editable_stockprops_search));

    let is_obsolete = '';
    let include_obsolete = '';
    const obsolete_stock_search_term = jQuery("#obsolete_stock_search_term option:selected").val();
    if (obsolete_stock_search_term == 'true') {
        is_obsolete = 'true';
    } else if (obsolete_stock_search_term == 'include_obsolete') {
        include_obsolete = 'true';
    }

    stock_table = jQuery('#stock_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'lengthMenu': [
          [10,20,50,100,1000,10000,1000000000000000],
          [10,20,50,100,1000,10000,'Todos']
        ],
        'iDisplayLength': 10000,
        'fixedFooter' : true,
        'scrollY' : '350px',
        'ajax': { 'url':  '/ajax/search/stocks',
            'data': function(d) {
              d.any_name  = jQuery('#any_name').val();
              d.any_name_matchtype = jQuery('#any_name_matchtype').val();
              d.stock_type   = stock_type;
              d.organism     = jQuery('#organism_select').val();
              d.person       = jQuery('#person').val();
              d.trait        = jQuery('#trait').val();
              d.minimum_trait_value        = jQuery('#minimum_trait_value').val();
              d.maximum_trait_value        = jQuery('#maximum_trait_value').val();
              d.project      = jQuery('#project').val();
              d.location     = jQuery('#location').val();
              d.year         = jQuery('#year').val();
              d.breeding_program = jQuery('#breeding_program').val();
              d.editable_stockprop_values = JSON.stringify(editable_stockprops_search);
              d.extra_stockprop_columns_view = JSON.stringify(stockprop_extra_columns_view);
              d.stockprop_extra_columns_view_array = JSON.stringify(stockprop_extra_columns_view_array);
              d.is_obsolete = is_obsolete;
              d.include_obsolete = include_obsolete;
            }
        }
    });
}

</script>
