
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => "Protocolo de pesquisa de genotipagem" &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="genotyping_protocol_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Protocolo</th>
                        <th>Tipo Marcador</th>
                        <th>Descrição do cabeçalho</th>
                        <th>Número de marcadores</th>
                        <th>Descrição do Protocolo</th>
                        <th>Genoma de Referência</th>
                        <th>Nome da espécie</th>
                        <th>Tipo de amostra</th>
                        <th>Data de criação</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
<!--
    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, title => 'Copiar resultados para uma lista', collapsible=>1, collapsed=>0, subtitle=>'<i>Copie os nomes dos protocolos que aparecem na tabela de resultados de busca para uma nova lista.</i>'&>
                <br>
                <div style="text-align:right" id="genotyping_protocol_to_list_menu"></div>
                <div id="genotyping_protocol_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
-->
</div>


<br /><br />


<&| /page/info_section.mas, id=>"protocol_search_accession_filter", title => 'Filtrar Protocolos por Acesso', collapsible=>1, collapsed=>0 &>

<& /search/genotyping_protocols_accession_filter.mas &>

</&>

<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#genotyping_protocol_search_results').DataTable( {
       'ajax': '/ajax/genotyping_protocol/search',
       "scrollX": true
   });

   jQuery('#genotyping_protocol_search_results').on( 'draw.dt', function () {
     var name_links = trial_table.column( 0, {page:'current'} ).data();
     var names = [];

     for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
       names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
     }

     jQuery('#genotyping_protocol_result_names').html(names);
     addToListMenu('genotyping_protocol_to_list_menu', 'genotyping_protocol_result_names', {
     });

   });

});

</script>
