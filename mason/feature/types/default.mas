<%args>
    $feature
    $featurelocs
    $blast_url => undef
    $xrefs     => []
</%args>

<%once>
    use SGN::View::Feature qw/ type_name /;
</%once>

<& /feature/page_title.mas, feature => $feature &>

<&| /page/info_section.mas,
    title       => type_name($feature,'caps').' details',
    subtitle    => $feature->is_obsolete ? 'ATENÇÃO: esta feição está obsoleta; há dados novos disponíveis.' : '',
    collapsible => 1,
&>
   <& /feature/feature_data.mas,
      feature     => $feature,
      featurelocs => $featurelocs,
    &>
    <& /feature/properties.mas,
       feature => $feature,
    &>
</&>

<&| /page/info_section.mas,
     title         => type_name($feature,'caps').' sequence',
     collapsible   => 1,
     collapsed     => 0,
     hide_if_empty => 1,
 &>
    <& /feature/residues.mas,
            feature   => $feature,
            blast_url => $blast_url,
    &>
</&>

<&| /page/info_section.mas,
   title => 'Feições relacionadas',
   collapsible => 1,
   hide_if_empty => 1,
&>

  <& /feature/related_features.mas,
      feature   => $feature,
      omit_columns => ['organism'],
  &>

</&>

<&| /page/info_section.mas,
     title         => 'Sequência(s) regional(ais)',
     subtitle      => "sequência de referência subjacente a cada localização desta feição",
     collapsible   => 1,
     collapsed     => 0,
     hide_if_empty => 1,
 &>
    <& /feature/region_sequence.mas,
            feature   => $feature,
            blast_url => $blast_url,
    &>
</&>

<&| /page/info_section.mas,
     title => 'Visão relacionada',
     empty_message => 'Nenhum encontrado',
     collapsible => 1,
     is_empty => ! scalar @$xrefs,
 &>
     <& /sitefeatures/mixed/xref_set/link.mas,
        xrefs => $xrefs,
        empty_message => '',
      &>
</&>
