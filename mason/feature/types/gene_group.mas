<%args>
    $feature
    $featurelocs
    $blast_url => undef
    $xrefs     => []
    $protein_fasta => '';
</%args>

<%once>
    use SGN::View::Feature qw/ type_name /;
</%once>

<& /feature/page_title.mas, feature => $feature &>

<&| /page/info_section.mas,
    title       => type_name($feature,'caps').' details',
    subtitle    => $feature->is_obsolete ? 'ATENÇÃO: esta feição está obsoleta; há dados novos disponíveis.' : '',
    collapsible => 1,
&>
   <& /feature/feature_data.mas,
      feature     => $feature,
      featurelocs => $featurelocs,
    &>
    <& /feature/properties.mas,
       feature => $feature,
    &>
</&>

<&| /page/info_section.mas,
    title       => 'Árvore e alinhamento',
    collapsible => 1,
&>

  <& /feature/gene_group_export_to_alignment_viewer.mas, feature => $feature &>

</&>

<&| /page/info_section.mas,
   title => 'Feições relacionadas',
   collapsible => 1,
   hide_if_empty => 1,
&>

  <& /feature/related_features.mas,
      feature   => $feature,
      omit_columns => ['phase'],
      frequency_tables => ['type','organism'],
  &>
</&>

<&| /page/info_section.mas,
     title => 'Visão relacionada',
     empty_message => 'Nenhum encontrado',
     collapsible => 1,
     is_empty => ! scalar @$xrefs,
 &>
     <& /sitefeatures/mixed/xref_set/link.mas,
        xrefs => $xrefs,
        empty_message => '',
      &>
</&>
