<%args>
    $deny_url
    $authorize_url
    $user_name
    $client_id
    $database_name
</%args>

<& /page/page_title.mas, title=>"Autorização do Cliente BRAPI" &>

<!-- <div class="row">
    <div class="col-lg-12">
        <p>To tie Field Book to your account on Breedbase, open Field Book and go to Settings -> External Data Source and scan the below QR code</p>
    </div>
</div>
<div class="row">
    <img class="col-md-2 col-md-offset-5" src="/user/field-book/generate">
</div> -->

<div class="row center">
    <p>Olá <b><% $user_name %></b>!</p>
    <p><b><% $client_id %></b> Gostaria de acessar <b><% $database_name %></b> através da sua conta. Use os botões abaixo para autorizar ou negar este pedido.</p><br>
    <button class="btn btn-success" onclick="window.location.replace('<% $authorize_url %>')">Autorizar Acesso</button>
    <button class="btn btn-danger" onclick="window.location.replace('<% $deny_url %>')">Negar acesso</button>
</div>
