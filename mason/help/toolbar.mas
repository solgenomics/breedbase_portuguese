
<& /page/page_title.mas, title=>"Ajuda da barra de ferramentas" &>

<%perl>
use CXGN::Page::Toolbar::SGN;

print<<END_HEREDOC;
A barra de ferramentas fica na parte superior da tela em quase
todas as páginas do site da SGN e oferece uma maneira fácil de navegar pelo
site. Ela consiste no logotipo da SGN e em uma linha de links que levam
às principais seções do site. Quando o mouse passa sobre um link, um
menu suspenso é exibido (desde que o JavaScript esteja ativado).
Você pode clicar no link principal ou percorrer o menu para escolher um
item. Se tiver problemas com a barra de ferramentas, adicione esta página
aos favoritos e use-a no lugar da barra.
<br /><br />
END_HEREDOC

my $tb=CXGN::Page::Toolbar::SGN->new();
for my $heading($tb->headings())
{
    my $heading_link=$tb->heading_link($heading);
    my $heading_desc=$tb->heading_desc($heading);
    print"<b><a href=\"$heading_link\">$heading</a></b> - $heading_desc<br />\n";
    print"<ul style=\"list-style-type: none;\">\n";
    for my $menu_option($tb->menu_options($heading))
    {
        my $option_link=$tb->option_link($heading,$menu_option);
        my $option_desc=$tb->option_desc($heading,$menu_option);
        print"<li><a href=\"$option_link\">$menu_option</a> - $option_desc<br /></li>\n";
    }
    print"</ul>\n";
}

</%perl>
