<%args>
  $type => 'Data'
  $optional_column => undef
</%args>

<%perl>
my %type_labels = (
  'Data' => 'Dados',
  'Simple phenotype spreadsheets' => 'Planilhas simples de fenótipos',
  'Seedlots' => 'Lotes de sementes',
  'Accessions' => 'Acessos',
  'Crosses' => 'Cruzamentos',
  'qPCR Data' => 'Dados de qPCR',
  'Transgenic Historical Data' => 'Dados históricos de transgênicos',
  'Transformation Identifiers' => 'Identificadores de transformação',
  'Seedlot Inventory' => 'Inventário de lotes de sementes',
  'Derived Accessions' => 'Acessos derivados',
  'Propagation Group Identifiers' => 'Identificadores de grupos de propagação',
  'Trial Coordinates' => 'Coordenadas de ensaios',
  'Propagation ID Status' => 'Status de IDs de propagação',
  'Propagation Identifiers' => 'Identificadores de propagação',
  'Accession exchanges' => 'Substituições de acessos',
  'Simple treatment spreadsheets' => 'Planilhas simples de tratamentos',
  'Vectors' => 'Vetores',
  'Single Trial Designs' => 'Delineamentos de um único ensaio',
  'Multiple Trial Designs' => 'Delineamentos de vários ensaios',
  'Trials' => 'Ensaios',
  'Trial Metadata' => 'Metadados de ensaios',
  'Marker Metadata' => 'Metadados de marcadores',
  'Locations' => 'Locais',
  'Pedigrees' => 'Genealogias',
);
my $type_label = $type_labels{$type} || $type;
</%perl>

<div class="file_upload_type">
  <span class="file_icon glyphicon glyphicon-file"></span>
  <div>
    <p>
      É possível enviar <% $type_label %> em qualquer um dos formatos aceitos: MS Excel (<strong>.xls ou .xlsx</strong>),
      arquivo separado por vírgulas (<strong>.csv</strong>), planilha OpenDocument do LibreOffice/OpenOffice (<strong>.ods</strong>),
      arquivo delimitado por tabulações (<strong>.txt ou .tsv</strong>) ou arquivo separado por ponto e vírgula (<strong>.ssv</strong>).
    </p>
% if ($optional_column) {
    <p>
      As colunas opcionais podem ser omitidas quando não forem usadas nos seus dados.
    </p>
% }
  </div>
</div>

<style>
  .file_upload_type {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 15px;
    padding: 5px;
    border-radius: 5px;
    background: rgba(252, 211, 77, 0.5);
    border: 1px solid #d97706;
  }
  .file_icon {
    color: #B96F1A;
    font-size: 200%;
  }
</style>
