<%args>
$breeding_programs
$locations
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$timestamp
$facilities => ()
$management_factor_types => ()
$design_types => ()
</%args>


<& /util/import_javascript.mas, classes => [ 'CXGN.GuidedHelp','bootstrap_min.js', 'jquery.iframe-post-form', 'CXGN.List', 'CXGN.BreedersToolbox.AddTrial','CXGN.BreedersToolbox.UploadTrial','CXGN.BreedersToolbox.Trial', 'CXGN.Trial','CXGN.BreedersToolbox.GenotypingTrial','CXGN.BreedersToolbox.Accessions', 'CXGN.BreedersToolbox.UploadPedigrees','CXGN.BreedersToolbox.Crosses','CXGN.BreedersToolbox.FieldBook','CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch', 'CXGN.Trial','CXGN.TrialTreeFolders' ] &>

<div class="panel panel-default">
    <div class="panel-body">
        <& /page/page_title.mas, title=>"Novo no banco de dados?" &>

        <center>
        <button class="btn btn-primary btn-block" id="guided_help_begin_button">Deixe-nos ajudar!<br/>Clique neste botão para começar nossa ajuda guiada.</button>
        </center>
    </div>
</div>

<div class="modal fade" id="guided_help_begin_dialog" name="guided_help_begin_dialog" tabindex="-1" role="dialog" aria-labelledby="guidedHelpBeginDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="guidedHelpBeginDialog">No que está interessado? <a href="https://solgenomics.github.io/sgn">Pela Ajuda Geral</a></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-cloud-upload"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Envie um ensaio experimental no banco de dados que você salvou no seu computador no Excel.</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_trial_link" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon glyphicon-flash"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Projete um novo ensaio experimental no banco de dados</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="add_project_link" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-list-alt"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Catalogue seu inventário de sementes disponível no banco de dados</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_seedlot_inventory_button" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-book"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Envie dados fenotípicos para o banco de dados que você salvou em seu computador no Excel.</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_upload_phenotypes_button" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-flag"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Plano de amostragem de tecidos</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="tissue_sample_guided_help" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-random"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Envie cruzamentos e informações para o banco de dados</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_crosses_link" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-tags"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Imprima etiquetas de código de barras para o meu experimento (para suas parcelas ou plantas ou amostras de tecido no campo, ou para suas 96 amostras de bem e tecido)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_barcode_trial_button" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-blackboard"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Analise o desempenho fenotípico nos ensaios</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_trial_comparison_button" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-th"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Prepare uma placa de 96 ou 384 poços para um experimento de genotipagem</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="create_genotyping_trial_link" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-map-marker"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>Envie dados genotípicos do VCF</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_genotyping_data_link" class="btn btn-primary btn-sm">Vá</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_guided_help_begin_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<& /help/workflow_guided/tissue_sample_help.mas &>

<& /help/workflow_guided/seedlot_inventory_modal.mas, timestamp=>$timestamp &>
<& /help/workflow_guided/phenotype_upload_modal.mas &>
<& /help/workflow_guided/trial_barcoding_modal.mas &>
<& /help/workflow_guided/trial_comparison_modal.mas &>

<& /breeders_toolbox/trial/trial_upload_dialogs.mas, breeding_programs=>$breeding_programs, locations=>$locations, design_types => $design_types &>
<& /breeders_toolbox/trial/trial_create_dialogs.mas, locations => $locations, breeding_programs => $breeding_programs, management_factor_types => $management_factor_types, design_types => $design_types &>

<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas, facilities=>$facilities &>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities=>$facilities &>

<& /breeders_toolbox/upload_seedlots_inventory_dialogs.mas &>
<& /breeders_toolbox/upload_seedlots_dialogs.mas &>
<& /breeders_toolbox/add_seedlot_dialogs.mas, timestamp=>$timestamp &>
<& /breeders_toolbox/add_accessions_dialogs.mas, preferred_species=>$preferred_species, editable_stock_props=>$editable_stock_props, editable_stock_props_definitions=>$editable_stock_props_definitions &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
<& /breeders_toolbox/cross/add_cross_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
<& /breeders_toolbox/cross/add_crossing_trial_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
