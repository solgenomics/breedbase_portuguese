<%args>
    $objects
</%args>

<& /page/columnar_table.mas,
    headings => [ "Tipo", "Nome" ],
    data     => [
       map {
         my $o = $_;
         $o = $o->get_bssample_row unless $o->can('type');
         [
          $o->type ? $m->scomp('/chado/cvterm_link.mas', cvterm => $o->type) : '<span class="ghosted">n/a</span>',
          $m->scomp('/biosource/sample_link.mas', sample => $o ),
         ]
       }@$objects
    ],
&>
