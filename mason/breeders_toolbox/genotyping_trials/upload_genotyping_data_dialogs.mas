                        </div>
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Espécie:</label>
                            <div class="col-sm-7">
                                <input class="form-control" id="upload_ssr_species_name_input" name="upload_ssr_species_name_input" type="text" placeholder="por exemplo, Manihot esculenta"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Descrição:</label>
                            <div class="col-sm-7">
                                <input class="form-control" id="upload_ssr_protocol_description_input" name="upload_ssr_protocol_description_input" type="text" />
                            </div>
                        </div>
<!--
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Sample Type: </label>
                            <div class="col-sm-7">
                                <select class="form-control" id="upload_ssr_sample_type_select" name="upload_ssr_sample_type_select">
                                    <option value="">Select sample type</option>
                                    <option value="accession">Accession</option>
                                    <option value="tissue_sample">Tissue Sample</option>
                                </select>
                            </div>
                        </div>
-->
                        <div class="row">
                            <div class="col-sm-5">
                                <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                    <p>
                                        <b>Informações sobre o formato do arquivo</b>
                                        <br>
                                        <a id="upload_ssr_protocol_format">Formato da planilha</a>
                                    </p>
                                </&>
                            </div>
                            <div class="col-sm-7">
                                <br/>
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Selecionar arquivo XLSX (ou XLS): </label>
                                            <div class="col-sm-4">
                                                <input type="file" name="xls_ssr_protocol_file" id="xls_ssr_protocol_file" encoding="multipart/form-data" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" name="upload_ssr_protocol_submit" id="upload_ssr_protocol_submit">Enviar arquivo</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_ssr_spreadsheet_info_dialog" name="upload_ssr_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSSRSpreadsheetInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSSRSpreadsheetInfoDialog">Informações do modelo de dados SSR</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Os dados SSR podem ser enviados em um arquivo Excel (.xls ou .xlsx).</b>
                    <br />
                    <b>Exemplo de planilha de dados SSR:</b>
                    <br>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>sample_name</td>
                                <td>s01</td>
                                <td>s01</td>
                                <td>s01</td>
                                <td>s02</td>
                                <td>s02</td>
                                <td>s02</td>
                            </tr>
                        </tbody>
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td></td>
                                <td>139</td>
                                <td>170</td>
                                <td>194</td>
                                <td>203</td>
                                <td>229</td>
                                <td>290</td>
                            </tr>
                        </tbody>
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>sample_A</td>
                                <td>1</td>
                                <td>0</td>
                                <td>0</td>
                                <td>0</td>
                                <td>1</td>
                                <td>1</td>
                            </tr>
                        </tbody>
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>sample_B</td>
                                <td>0</td>
                                <td>0</td>
                                <td>0</td>
                                <td>1</td>
                                <td>0</td>
                                <td>0</td>
                            </tr>
                        </tbody>
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>sample_C</td>
                                <td>0</td>
                                <td>1</td>
                                <td>1</td>
                                <td>0</td>
                                <td>1</td>
                                <td>0</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        Informações das colunas:
                    </b>
                    <ul>
                        <li>s01 e s02 são nomes de marcadores.</li>
                        <li>139, 170 e 194 são tamanhos de produtos gerados pelo marcador s01; 203, 229 e 290 são tamanhos gerados pelo marcador s02.</li>
                        <li>sample_A, sample_B e sample_C são nomes de acessos.</li>
                        <li>“1” indica a presença do produto de PCR.</li>
                        <li>“0” indica a ausência do produto de PCR.</li>
                        <br>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_genotype_kasp_spreadsheet_info_format_dialog" name="upload_genotype_kasp_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypeKASPDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypeKASPDialog">Informações do modelo de dados KASP</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Este modelo serve para enviar dados de genótipos KASP.</b>
                    <br/>
                    <b>Use arquivos no formato CSV.</b>
                    <br/>
                    <br/>
                    <u><b>Arquivo de informações dos marcadores KASP:</b></u>
                    <br>
                    <p>O cabeçalho deve ser:</p>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>MarkerName</td>
                                <td>Xallele</td>
                                <td>Yallele</td>
                                <td>Chromosome</td>
                                <td>Position</td>
                                <td><b>Opcional:</b> podem ser incluídas informações adicionais dos marcadores; veja abaixo.</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>Observação:</b> no cálculo da dosagem, <code>Xallele</code> é usado como alelo de referência (0) e <code>Yallele</code> como alelo alternativo (1).
                    <br>
                    <b>Colunas opcionais:</b>
                    Você pode incluir informações adicionais usando um ou mais cabeçalhos da lista abaixo. Adicione as colunas selecionadas depois de <code>Position</code>.</li>
                    <ul>
                        <li>Quality</li>
                        <li>Filter</li>
                        <li>Info</li>
                        <li>Format</li>
                        <li>Sequence</li>
                        <li><b><code>FacilityMarkerName</code>:</b> ao enviar dados com os nomes de marcadores usados pelo laboratório, inclua-os no arquivo de informações KASP com esse cabeçalho.</li>
                    </ul>
                    <hr class ="solid">
                    <u><b>Arquivo de resultados KASP:</b></u>
                    <br>
                    <b>Observação:</b> se o laboratório atribuiu nomes próprios aos marcadores e às amostras, você pode usá-los diretamente no envio. Após o armazenamento, os dados serão vinculados automaticamente aos nomes originais dos marcadores e das amostras.
                    <br>
                    <br>
                    <p>Se você estiver usando seus próprios nomes de marcadores e amostras, o cabeçalho deve ser:</p>
                    <table class="table table-hover table-bordered table-condensed" >
                        <tbody>
                            <tr>
                                <td>MarkerName</td>
                                <td>SampleName</td>
                                <td>SNPcall</td>
                                <td>Xvalue</td>
                                <td>Yvalue</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        Colunas obrigatórias:
                    </b>
                    <ul>
                        <li><b><code>MarkerName</code>:</b> deve existir no arquivo de informações dos marcadores. Ao usar um protocolo armazenado, o nome deve existir no protocolo selecionado.</li>
                        <li><b><code>SampleName</code>:</b> deve existir no banco de dados como nome exclusivo.</li>
                        <li><b><code>SNPcall</code>:</b> alelos separados por “:”, por exemplo, A:G.</li>
                        <li><b><code>Xvalue</code>:</b> dado bruto de X.</li>
                        <li><b><code>Yvalue</code>:</b> dado bruto de Y.</li>
                    </ul>
                    <br>
                    <p>Se você estiver usando os nomes de marcadores e amostras do laboratório, o cabeçalho deve ser:</p>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>FacilityMarkerName</td>
                                <td>FacilitySampleName</td>
                                <td>SNPcall</td>
                                <td>Xvalue</td>
                                <td>Yvalue</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        Colunas obrigatórias:
                    </b>
                    <ul>
                        <li><b><code>FacilityMarkerName</code>:</b> deve existir no arquivo de informações dos marcadores.</li>
                        <li><b><code>FacilitySampleName</code>:</b> deve existir no banco de dados. O vínculo com o nome original pode ser criado incluindo o nome usado pelo laboratório durante o envio das placas.</li>
                        <li><b><code>SNPcall</code>:</b> alelos separados por “:”, por exemplo, A:G.</li>
                        <li><b><code>Xvalue</code>:</b> dado bruto de X.</li>
                        <li><b><code>Yvalue</code>:</b> dado bruto de Y.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_kasp_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="upload_marker_metadata_dialog" name="upload_marker_metadata_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadMLADialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_mla_close_modal_header" name="upload_mla_close_modal_header" aria-label="Fechar" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadMLADialog">Enviar metadados de marcadores</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_mla_workflow" &>

                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Informações dos metadados de marcadores" &>
                            <p>Este envio adiciona metadados e valores de alelos aos marcadores de um protocolo de genotipagem existente.</p>
                            <p>Os metadados aceitos incluem:</p>
                            <ul>
                                <li>Descrição do marcador, como o fenótipo resultante de diferentes valores de alelos.</li>
                                <li>Categorias de características dos fenótipos associados ao marcador.</li>
                                <li>Referências a bancos de dados externos com mais informações sobre o marcador.</li>
                                <li>Valores dos alelos individuais de cada marcador. Por exemplo, o marcador <strong>1RS</strong> pode ter os seguintes valores:
                                    <ul>
                                        <li>Non-1RS</li>
                                        <li>1RS:1BL</li>
                                        <li>1RS:1AL</li>
                                    </ul>
                                </li>

                            </ul>
                            <p>
                                Na primeira etapa, selecione o protocolo de genotipagem que contém os marcadores.
                                Esse protocolo <strong>já deve existir no banco de dados</strong>.
                            </p>
                            <p>
                                Na segunda etapa, envie o arquivo com os metadados associados a cada marcador.
                                Os nomes no arquivo <strong>devem corresponder aos nomes dos marcadores</strong> do protocolo selecionado.
                            <hr>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Protocolo de genotipagem" &>
                        <& /page/page_title.mas, title=>"Selecionar protocolo de genotipagem" &>
                            <p>Selecione o protocolo de genotipagem que contém os marcadores.</p>

                            <table id="upload_mla_protocol_search_results" width="100%" class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Selecionar</th>
                                        <th>Nome do protocolo</th>
                                        <th>Descrição do cabeçalho</th>
                                        <th>Número de marcadores</th>
                                        <th>Descrição do protocolo</th>
                                        <th>Genoma de referência</th>
                                        <th>Espécie</th>
                                        <th>Unidade amostral</th>
                                        <th>Data de criação</th>
                                    </tr>
                                </thead>
                            </table>
                            <hr>
                            <center>
                                <button class="btn btn-primary" id="upload_mla_protocol_check_button">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Envio" &>
                        <& /page/page_title.mas, title=>"Enviar metadados de marcadores" &>
                            <b>Cabeçalho:</b><br>
                            A primeira linha (cabeçalho) deve conter os seguintes campos:
                            <br>
                            <table class="table table-bordered table-hover">
                            <tbody>
                            <tr>
                                <td>Marker</td>
                                <td>Alias</td>
                                <td>Description</td>
                                <td>Category</td>
                                <td>...adicione outras colunas Category conforme necessário</td>
                                <td>Allele</td>
                                <td>...adicione outras colunas Allele conforme necessário</td>
                                <td>Reference</td>
                                <td>...adicione outras colunas Reference conforme necessário</td>
                            </tr>
                            </tbody>
                            </table>
                            <b>Valores obrigatórios:</b><br>
                            <b><code>Marker</code>:</b> nome do marcador; deve corresponder ao nome no protocolo selecionado.<br>
                            <b><code>Allele</code>:</b> possível valor de alelo do marcador; adicione quantas colunas forem necessárias ou separe os valores por vírgula em uma coluna.<br>
                            <br /><b>Valores opcionais:</b><br>
                            <b><code>Alias</code>:</b> nome alternativo e mais amigável do marcador.<br>
                            <b><code>Description</code>:</b> descrição do marcador, como o fenótipo associado.<br>
                            <b><code>Category</code>:</b> categoria de característica à qual o marcador pertence; adicione várias colunas ou separe os valores por vírgula.<br>
                            <b><code>Reference</code>:</b> referência a uma entidade de um banco externo, como uma entrada de gene no GrainGenes. Use o formato <code>{nome do banco}:{nome da entidade}</code>, por exemplo, <code>GrainGenes gene:Rht12 (Triticum)</code>. O banco já deve existir como referência externa.<br>

                            <& /help/file_upload_type.mas, type => "Marker Metadata" &>

                            <br /><br />

                            <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_mla_form" name="upload_mla_form">
                                <div style="display: flex; flex-wrap: wrap; gap: 25px; align-items: flex-end">
                                    <div>
                                        <label for="upload_mla_file" style="display: inline-block;">Arquivo de metadados e alelos dos marcadores:</label>
                                        <input type="file" name="upload_mla_file" id="upload_mla_file" encoding="multipart/form-data" />
                                    </div>
                                    <div>
                                        <input id="upload_entry_numbers_ignore_warnings_cb" name="ignore_warnings" type="checkbox" value="checked">
                                        <label for="upload_entry_numbers_ignore_warnings_cb">Ignorar avisos</label><br>
                                    </div>
                                </div>
                            </form>

                            <br /><br />

                            <div style="display:none; padding: 10px;" id="upload_mla_errors" class="alert-danger" role="alert"></div>
                            <div style="display:none; padding: 10px;" id="upload_mla_success" class="alert-success" role="alert"></div>

                            <hr />
                            <center>
                                <button type="button" class="btn btn-primary" name="upload_mla_submit" id="upload_mla_submit">Enviar</button>
                            </center>
                        </&>

                    </&><!-- End of workflow -->
                </div>

                <div class="modal-footer">
                    <button type="reset" id="upload_mla_close_modal" name="upload_mla_close_modal" class="btn btn-default" data-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>

.ui-autocomplete { z-index:2147483647; }

hr.solid { border-top: 3px solid #bbb; }

</style>

<script>
jQuery(document).ready(function(){

    jQuery('#genotype_data_type_select').change(function() {
        var data_type = jQuery('#genotype_data_type_select').val();

        document.getElementById('upload_genotype_data_type').value = data_type;

        if (data_type == 'vcf') {
            jQuery('#upload_genotype_data_format_vcf').show();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_kasp').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
        } else if (data_type == 'intertek') {
            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').show();
            jQuery('#upload_genotype_data_format_kasp').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
        } else if (data_type == 'tassel_hdf5') {
            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_kasp').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').show();
            jQuery('#upload_genotype_data_format_ssr').hide();
        } else if (data_type == 'ssr') {
            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_kasp').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').show();
        } else if (data_type == 'KASP') {
            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_kasp').show();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
        }

    });

    var upload_genotyping_data_trial_table = jQuery('#upload_genotyping_data_project_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/genotyping_data/projects?select_checkbox_name=upload_genotyping_data_project_select',
        },
    });

    var upload_genotyping_data_protocol_table = jQuery('#upload_genotyping_data_protocol_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/genotyping_data/protocols?select_checkbox_name=upload_genotyping_data_protocol_select',
        },
    });

    var upload_mla_protocol_table = jQuery('#upload_mla_protocol_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/genotyping_data/protocols?select_checkbox_name=upload_mla_protocol_select',
        },
    });

    jQuery('#upload_genotyping_data_project_missing_button').click(function(){
        jQuery('#upload_genotyping_data_project_details').show();
        return false;
    });

    jQuery('#upload_genotyping_data_type_check_button').click(function(){
        var data_type = jQuery('#genotype_data_type_select').val();
        if (data_type == '') {
            alert('Selecione um tipo de dado');
        } else {
            Workflow.complete('#upload_genotyping_data_type_check_button');
            Workflow.focus('#upload_genotypes_workflow', 2);
        }
        return false;
    });

    jQuery('#upload_genotyping_data_project_check_button').click(function(){
        selected = [];
        jQuery('input[name="upload_genotyping_data_project_select"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length > 1){
            alert('Selecione somente um projeto de genotipagem!');
        } else {
            if (selected.length == 0 && jQuery('#upload_genotype_vcf_project_name').val() == ''){
                alert('Selecione um projeto de genotipagem ou crie um novo!');
            } else if (selected.length == 1 && jQuery('#upload_genotype_vcf_project_name').val() != ''){
                alert('Se você selecionou um projeto, não tente criar outro ao mesmo tempo!');
            } else if (selected.length == 1 && jQuery('#upload_genotype_vcf_project_name').val() == ''){
                jQuery('#upload_genotype_project_id').val(selected[0]);
                Workflow.complete('#upload_genotyping_data_project_check_button');
                Workflow.focus('#upload_genotypes_workflow', 3);
            } else if (selected.length == 0 && jQuery('#upload_genotype_vcf_project_name').val() != '') {
                if (jQuery('#upload_genotype_year_select').val() == ''){
                    alert('Informe o ano');
                } else if (jQuery('#upload_genotype_vcf_project_description').val() == ''){
                    alert('Informe uma descrição.');
                } else {
                    jQuery('#upload_genotype_project_id').val(undefined);
                    Workflow.complete('#upload_genotyping_data_project_check_button');
                    Workflow.focus('#upload_genotypes_workflow', 3);
                }
            }
        }
        return false;
    });

    jQuery('#upload_genotyping_data_protocol_missing_button').click(function(){
        var data_type = jQuery('#genotype_data_type_select').val();
        if (data_type == 'ssr') {
            selected = [];
            jQuery('input[name="upload_genotyping_data_protocol_select"]:checked').each(function() {
                selected.push(jQuery(this).val());
            });
            if (selected.length == 0){
                jQuery('#upload_ssr_protocol_dialog').modal('show');
                jQuery("#upload_ssr_species_name_input").autocomplete({
                    source: '/organism/autocomplete'
                });
            } else if (selected.length > 0) {
                alert('Se você selecionou um protocolo, não tente criar outro ao mesmo tempo!');
            }
        } else {
            jQuery('#upload_genotype_data_protocol_details').show();
        }
        return false;
    });


    var ssr_protocol_id;

    jQuery('#upload_genotyping_data_protocol_check_button').click(function(){
        selected = [];
        jQuery('input[name="upload_genotyping_data_protocol_select"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length > 1){
            alert('Selecione somente um protocolo de genotipagem!');
        } else {
            if (selected.length == 0 && jQuery('#upload_genotype_vcf_protocol_name').val() == '' && jQuery('#upload_genotype_protocol_id').val() == ''){
                alert('Selecione um protocolo de genotipagem ou crie um novo!');
            } else if (selected.length == 1 && jQuery('#upload_genotype_vcf_protocol_name').val() != ''){
                alert('Se você selecionou um protocolo, não tente criar outro ao mesmo tempo!');
            } else if (selected.length == 1 && jQuery('#upload_genotype_vcf_protocol_name').val() == ''){
                jQuery('#upload_genotype_protocol_id').val(selected[0]);
                Workflow.complete('#upload_genotyping_data_protocol_check_button');
                Workflow.focus('#upload_genotypes_workflow', 4);
            } else if (selected.length == 0 && jQuery('#upload_genotype_protocol_id').val() != ''){
                Workflow.complete('#upload_genotyping_data_protocol_check_button');
                Workflow.focus('#upload_genotypes_workflow', 4);
            } else if (selected.length == 0 && jQuery('#upload_genotype_vcf_protocol_name').val() != '') {
                if (jQuery('#upload_genotype_vcf_reference_genome_name').val() == ''){
                    alert('Informe o nome do genoma de referência.');
                } else if (jQuery('#upload_genotypes_species_name_input').val() == ''){
                    alert('Informe o nome da espécie.');
                } else {
                    jQuery('#upload_genotype_protocol_id').val(undefined);
                    Workflow.complete('#upload_genotyping_data_protocol_check_button');
                    Workflow.focus('#upload_genotypes_workflow', 4);
                }
            }
        }
        return false;
    });

    jQuery('#file_check_button').click(function(){
        var data_type = jQuery('#genotype_data_type_select').val();
        if (data_type == 'vcf') {
            if (jQuery('#upload_genotype_vcf_file_input').val() == ''){
                alert('Selecione um arquivo VCF.');
            } else {
                jQuery('#file_check_button').hide();
                jQuery('#genotyping_data_upload_next').show();
                jQuery('#genotyping_data_upload_next').attr('disabled', false);
            }
        } else if (data_type == 'tassel_hdf5') {
            if (jQuery('#upload_genotype_tassel_hdf5_file_input').val() == ''){
                alert('Selecione um arquivo Tassel HDF5.');
            } else {
                jQuery('#file_check_button').hide();
                jQuery('#genotyping_data_upload_next').show();
                jQuery('#genotyping_data_upload_next').attr('disabled', false);
            }
        } else if (data_type == 'intertek') {
            if (jQuery('#upload_genotype_intertek_file_input').val() == ''){
                alert('Selecione um arquivo Intertek SNP Result Grid.');
            } else if (jQuery('#upload_genotype_intertek_snp_file_input').val() == ''){
                alert('Selecione um arquivo de informações de SNP da Intertek.');
            } else {
                jQuery('#file_check_button').hide();
                jQuery('#genotyping_data_upload_next').show();
                jQuery('#genotyping_data_upload_next').attr('disabled', false);
            }
        } else if (data_type == 'KASP') {
                if (jQuery('#upload_genotype_data_kasp_file_input').val() == ''){
                    alert('Selecione um arquivo de resultados KASP.');
                } else if (jQuery('#upload_genotype_kasp_marker_info_file_input').val() == ''){
                    alert('Selecione um arquivo de informações dos marcadores KASP.');
                } else {
                    jQuery('#file_check_button').hide();
                    jQuery('#genotyping_data_upload_next').show();
                    jQuery('#genotyping_data_upload_next').attr('disabled', false);
                }

        } else if (data_type == 'ssr') {
            if (jQuery('#upload_genotype_ssr_file_input').val() == ''){
                alert('Selecione um arquivo SSR.');
            } else {
                jQuery('#file_check_button').hide();
                jQuery('#genotyping_data_upload_next').show();
                jQuery('#genotyping_data_upload_next').attr('disabled', false);
            }
        }
    });

    jQuery('#upload_genotype_vcf_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_vcf_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_genotype_tassel_hdf5_info_format').click(function(){
        jQuery('#upload_genotype_tassel_hdf5_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_genotype_intertek_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_intertek_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_genotype_kasp_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_kasp_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_ssr_data_spreadsheet_info').click(function(){
        jQuery('#upload_ssr_spreadsheet_info_dialog').modal('show');
    });

    jQuery('#upload_ssr_protocol_format').click(function(){
        jQuery('#upload_ssr_protocol_format_dialog').modal('show');
        jQuery('#upload_ssr_protocol_dialog').modal('hide');
    });

    jQuery("#upload_ssr_protocol_submit").click(function(){

        var ssr_protocol_name = jQuery("#upload_ssr_protocol_name").val();
        var ssr_protocol_species_name = jQuery("#upload_ssr_species_name_input").val();
        var ssr_protocol_description = jQuery("#upload_ssr_protocol_description_input").val();
        var uploadFile = jQuery("#xls_ssr_protocol_file").val();

        jQuery('#upload_ssr_protocol_form').attr("action", "/ajax/genotype/upload_ssr_protocol");
        if (ssr_protocol_name === ''){
            alert("Informe o nome do protocolo");
            return;
        }
        if (ssr_protocol_species_name === ''){
            alert("Informe o nome da espécie");
            return;
        }
        if (ssr_protocol_description === ''){
            alert("Informe uma descrição");
            return;
        }
        if (uploadFile === ''){
            alert("Selecione um arquivo");
            return;
        }
        jQuery('#upload_ssr_protocol_form').submit();
        jQuery('#upload_ssr_protocol_dialog').modal("hide");
    });

    jQuery('#upload_ssr_protocol_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_ssr_protocol_error_display tbody").html('');
                jQuery("#upload_ssr_protocol_error_display tbody").append(response.error_string);
                jQuery("#upload_ssr_protocol_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#ssr_protocol_saved_dialog_message').modal("show");

                ssr_protocol_id = response.protocol_id;
                jQuery('#upload_genotype_protocol_id').val(ssr_protocol_id);

            }

        }
    });

    jQuery("[name='upload_genotype_data_close_modal']").click(function() {
        jQuery('#upload_genotypes_dialog').modal('hide');
        location.reload();
    });

    jQuery('#upload_mla_protocol_check_button').click(function(){
        selected = [];
        jQuery('input[name="upload_mla_protocol_select"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length > 1) {
            alert('Selecione somente um protocolo de genotipagem!');
        }
        else {
            if (selected.length == 0 ) {
                alert('Selecione um protocolo de genotipagem!');
            }
            else {
                Workflow.complete('#upload_mla_protocol_check_button');
                Workflow.focus('#upload_mla_workflow', 2);
            }
        }
        return false;
    });

    jQuery('#upload_mla_submit').click( function() {
        var genoProtocolId = jQuery("input[name='upload_mla_protocol_select']:checked")[0]?.value;
        var uploadFile = jQuery("#upload_mla_file").val();

        if ( !genoProtocolId || genoProtocolId === '' ) {
            alert("Volte e selecione um protocolo de genotipagem");
            return;
        }
        if (uploadFile === '') {
            alert("Selecione um arquivo");
            return;
        }

        jQuery('#upload_mla_errors').hide();
        jQuery('#upload_mla_success').hide();
        jQuery("#working_modal").modal("show");

        jQuery.ajax({
            url: `/ajax/genotyping_protocol/add_marker_metadata/${genoProtocolId}`,
            type: 'POST',
            data: new FormData(jQuery("#upload_mla_form")[0]),
            processData: false,
            contentType: false,
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if ( response.success ) {
                    jQuery('#upload_mla_success').html(`<strong>Metadados dos marcadores armazenados com sucesso no banco de dados!`);
                    jQuery('#upload_mla_success').show();
                }
                else {
                    const errors = (response.error_string || response.warning_string || "Ocorreu um erro desconhecido. Tente novamente mais tarde ou entre em contato conosco.").replaceAll('\n', '<br />');
                    jQuery('#upload_mla_errors').html(`<strong>Os metadados dos marcadores NÃO foram armazenados:</strong><br /><br />${errors}`);
                    jQuery('#upload_mla_errors').show();
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                jQuery('#upload_mla_errors').html(`<strong>Os metadados dos marcadores NÃO foram armazenados devido a um erro do servidor.</strong>`);
                jQuery('#upload_mla_errors').show();
            }
        });
    });



});
</script>
