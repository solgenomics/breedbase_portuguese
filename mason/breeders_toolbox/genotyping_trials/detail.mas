<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-1">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-th"></span>
                </div>
                <div class="col-sm-11">

% my $plate_view_link = '/breeders_toolbox/trial/'.$trial_id.'?format=as_table';
                    <&| /page/info_section.mas, title=>"<h4 style='display:inline'>Disposição da placa</h4>", id=>"trial_plate_layout", collapsible=>1, collapsed=>0, is_subsection=>1,subtitle=> qq{ Baixar disposição <a class='btn btn-sm btn-default' style='margin:3px' id=\"download_layout_xls_link\" href=\"/breeders/trial/$trial_id/download/layout?format=xls&dataLevel=plate\">XLS</a> <a class='btn btn-sm btn-default' style='margin:3px' id=\"download_layout_csv_link\" href=\"/breeders/trial/$trial_id/download/layout?format=csv&dataLevel=plate\">CSV</a><a class='btn btn-sm btn-default' style='margin:3px' href=$plate_view_link>Visualizar placa</a> } &>

                        <div class="well well-sm">
                            <& /breeders_toolbox/genotyping_trials/format/as_table.mas, trial_id => $trial_id, trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, genotyping_plate_format => $genotyping_plate_format, table_only=>1 &>
                            <br/>

                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <& /breeders_toolbox/genotyping_trials/layout.mas, trial_id => $trial_id, genotyping_plate_format => $genotyping_plate_format &>
                                </div>
                            </div>
                        </div>

                    </&>
                </div>
            </div>
        </div>
    </div>
</div>

% if ($assay_type eq 'KASP') {
    <& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Dados de genotipagem</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem derivados desta placa.', icon_class => "glyphicon glyphicon-map-marker", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="plate_genotyping_data_download_all_vcf">Baixar todos os dados de genótipos em VCF</button><button class="btn btn-primary" style="margin:3px" id="plate_genotyping_data_download_all_dosagematrix">Baixar todos os dados de genótipos como matriz de dosagem</button><button class="btn btn-default" style="margin:3px" id="plate_kasp_genotype_data_download_csv">Baixar todos os dados de genótipos (CSV)</button>', info_section_id => "plate_genotyping_data" &>
% } else {
    <& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Dados de genotipagem</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem derivados desta placa.', icon_class => "glyphicon glyphicon-map-marker", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="plate_genotyping_data_download_all_vcf">Baixar todos os dados de genótipos em VCF</button><button class="btn btn-primary" style="margin:3px" id="plate_genotyping_data_download_all_dosagematrix">Baixar todos os dados de genótipos como matriz de dosagem</button>', info_section_id => "plate_genotyping_data" &>

% }
<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-1">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-cloud-upload"></span>
                </div>
                <div class="col-sm-11">

                    <&| /page/info_section.mas, title => "<h4 style='display:inline'>Arquivos adicionais</h4>", subtitle=> "Envie e visualize arquivos adicionais desta placa", id => 'genotyping_trial_additional_files_section', collapsible => 1, collapsed => 1 &>

                        <div class="panel panel-default">
                            <div class="panel-body">
                                <& /breeders_toolbox/genotyping_trials/files_section.mas, trial_id => $trial_id &>
                            </div>
                        </div>
                    </&>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-1">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-link"></span>
                </div>
                <div class="col-sm-11">

                    <&| /page/info_section.mas, title => "<h4 style='display:inline'>Vínculos da placa</h4>", subtitle => 'Visualize os vínculos entre ensaios de campo e a placa de genotipagem', id => 'genotyping_trial_from_field_trial_section', collapsible => 1, collapsed => 1 &>
                        <& /breeders_toolbox/trial/genotyping_trial_from_field_trial_linkage.mas, trial_id => $trial_id, trial_type => 'genotyping_trial' &>
                    </&>
                </div>
            </div>
        </div>
    </div>
</div>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, number_of_samples_with_data => $number_of_samples_with_data, info_section_title => "<h4 style='display:inline'>Exclusão</h4>", info_section_subtitle => 'Exclua os dados de genotipagem derivados desta placa ou a disposição da placa.', icon_class => "glyphicon glyphicon-trash", info_section_id => "delete_genotyping_plate_section" &>

