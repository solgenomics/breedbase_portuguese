
<%args>
$trial_id
$trial_name
$plate_id
$breeding_program_name
$breeding_program_id
$location_data => undef
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$design_layout_view => undef
$user_can_modify => undef
$identifier_prefix => 'SGN'
$genotyping_facility => undef
$genotyping_facility_status => undef
$genotyping_facility_submitted => undef
$genotyping_vendor_order_id => undef
$genotyping_vendor_submission_id => undef
$genotyping_plate_format => '96'
$genotyping_plate_sample_type => undef
$raw_data_link => undef
$trial_owner => undef
$genotyping_project_link => undef
$number_of_samples => undef
$number_of_samples_with_data => undef
$assay_type => undef
</%args>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;"><% $trial_id %></div>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui' , 'jquery.iframe-post-form', 'CXGN.Trial', 'CXGN.BreedersToolbox.GenotypingTrial', 'CXGN.BreedersToolbox.GenotypingSubmission', 'CXGN.BreedersToolbox.HTMLSelect', 'jstree/dist/jstree' ] &>

<& /page/page_title.mas, title=>"Placa de genotipagem $trial_name" &>

<%perl>
    my $order_id;
    my $submission_id;
    if($genotyping_vendor_order_id){
        my $order_info = JSON->new->allow_nonref->decode($genotyping_vendor_order_id);
        $order_id = $order_info->{orderId} || undef;
    } elsif($genotyping_vendor_submission_id){
        my $order_info = JSON->new->allow_nonref->decode($genotyping_vendor_submission_id);
        $submission_id = $order_info->{submissionId} || undef;
    }
 </%perl>

<br/>

<div class="well">
    <div class="row">
        <div class="col-sm-9">

            <div class="panel panel-default">
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                    <tbody>
                    <tr><td><b>Projeto de genotipagem</b></td><td><% $genotyping_project_link %></td></tr>
                    <tr><td><b>Programa de melhoramento</b></td><td><a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a></td></tr>
                    <tr><td><b>Tipo de ensaio</b></td><td>Placa de genotipagem</td></tr>
                    <tr><td><b>Formato da placa</b></td><td><% $genotyping_plate_format %></td></tr>
                    <tr><td><b>Tipo de amostra da placa</b></td><td><% $genotyping_plate_sample_type %></td></tr>
                    <tr><td><b>Número de amostras</b></td><td><% $number_of_samples %></td></tr>
                    <tr><td><b>Número de amostras com dados</b></td><td><% $number_of_samples_with_data %></td></tr>
                    <tr><td><b>Laboratório de genotipagem</b></td><td><% $genotyping_facility %></td></tr>
                    <tr><td><b>Descrição</b></td><td><% $trial_description %></td></tr>
                    <tr><td><b>Criado por</b></td><td><% $trial_owner %></td></tr>
                    <!-- <tr><td><b>Submitted to Genotyping Facility</b></td><td><% $genotyping_facility_submitted %></td></tr>
                    <tr><td><b>Genotyping Facility Status</b></td><td><% $genotyping_facility_status %></td></tr>
                    <tr><td><b>Raw Data Link</b></td><td><a href='<% $raw_data_link %>'><% $raw_data_link %></td></tr> -->
                    </tbody>
                    </table>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <button class="btn btn-primary btn-sm" id="edit_genotyping_trial_details" style="margin:3px">Editar detalhes da placa</button>
                </div>
            </div>

<!--             <div class="panel panel-default">
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                    <tbody>
                    <tr><td><b>Live Status From Genotyping Facility</b></td><td><div id="genotyping_trial_status_info"></div></td></tr>
                    <tr><td><b>Download PDF</b></td><td><div id="download_trial_pdf"></div></td></tr>
                    </tbody>
                    </table>
                </div>
            </div> -->

            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=csv&dataLevel=plate" class="btn btn-default">Baixar arquivo no formato Breedbase</a>
            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=intertekxls&dataLevel=plate" class="btn btn-default">Baixar arquivo no formato Intertek</a>
            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=dartseqcsv&dataLevel=plate" class="btn btn-default">Baixar arquivo no formato DartSeq</a>

        </div>
        <div class="col-sm-3">
            <div style="text-align: center">
                <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", text=> "$identifier_prefix placa $trial_id ($trial_name)", format=>"stock_qrcode"  &>
            </div>
            <br/>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-1">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-export"></span>
                </div>
                <div class="col-sm-11">
                <&| /page/info_section.mas, title => "<h4 style='display:inline'>Status do envio da placa de genotipagem</h4>", subtitle=> "Enviar placas aos laboratórios de genotipagem.", id => 'genotyping_facilities_section', collapsible => 1, collapsed => 1 &>
                    <div class="col-sm-9"></div>
                    <div class="col-sm-3">
                        <button class="btn btn-primary btn-sm" id="submit_plate_link" style="margin:3px">Enviar placas</button>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <table class="table table-bordered table-hover">
                            <tbody>
                                <tr><td><b>Laboratório de genotipagem</b></td><td><div id="genotyping_facility_tab"><% $genotyping_facility %></div></td></tr>
                                <tr><td><b>Enviado ao laboratório de genotipagem</b></td><td><div id="genotyping_facility_submitted_tab"></div></td></tr>
                                <tr><td><b>ID do pedido no laboratório de genotipagem</b></td><td><div id="genotyping_vendor_order_id_tab"><% $order_id %></div></td></tr>
                                <tr><td><b>ID do envio ao laboratório de genotipagem</b></td><td><div id="genotyping_vendor_submission_id_tab"><% $submission_id %></div></td></tr>
                                <tr><td><b>Status atual no laboratório de genotipagem</b></td><td><div id="genotyping_trial_status_info"></div></td></tr>
                                <tr><td><b>Baixar PDF</b></td><td><div id="download_trial_pdf"></div></td></tr>
                                <tr><td><b>Link dos dados brutos</b></td><td><div id="raw_data_tab"></div></td></tr>
                            </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                </&>
            </div>
        </div>
    </div>
</div>

<!--
