<%args>
$facilities => ();
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>


<div class="modal fade" id="genotyping_trial_dialog" name="genotyping_trial_dialog" tabindex="-1" role="dialog" aria-labelledby="addGenoTrialDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addGenoTrialDialog">Adicionar placa de genotipagem</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "genotyping_trial_create_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Este fluxo orientará a inclusão de uma placa de genotipagem no banco de dados" &>
                            <p>As placas de genotipagem representam placas de 96 ou 384 poços.</p>
                            <p>Cada placa possui um ID de placa exclusivo em todo o sistema.</p>
                            <p>Cada poço possui um ID de amostra de tecido exclusivo em todo o sistema.</p>
                            <p>O “conteúdo” de cada poço pode ser uma amostra de tecido, uma planta, uma subparcela, uma parcela ou um acesso. Esse nome de “origem” já deve existir no banco de dados. Ao informar uma entidade de ensaio de campo, fenótipos e genótipos podem ser comparados diretamente.</p>
                            <p>Se você optar por enviar a placa a um laboratório de genotipagem (Cornell IGD, Intertek, BGI etc.), podemos gerar os arquivos exigidos. Observe os requisitos do laboratório, como posições de poços vazios e concentrações.</p>
                            <p>Além do ID da amostra, você pode incluir o identificador do laboratório em cada poço.</p>
                            <br/><br/>
                            <div style="text-align: center">
                                <button id="next_step_intro_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Projeto de genotipagem" &>
                            <& /page/page_title.mas, title=>"Selecione um projeto de genotipagem" &>
                            <p>Os projetos de genotipagem agrupam placas e/ou dados de genotipagem. O projeto de genotipagem deve corresponder ao projeto do fornecedor, caso exista.</p>
                            <div style="text-align: center">
                                <button class="btn btn-info" name="create_genotyping_project_link">Clique aqui para criar um projeto de genotipagem</button><br/><br/>
                                <button id="next_step_creating_genotyping_plates" class="btn btn-primary" onclick="Workflow.complete(this);">Após selecionar o projeto, vá para a próxima etapa</button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Informações básicas da placa" &>
                            <& /page/page_title.mas, title=>"Forneça as informações da placa" &>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotyping_trials_form" name="upload_genotyping_trials_form">
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Nome do projeto de genotipagem: </label>
                                    <div class="col-sm-7">
                                        <span id="plate_genotyping_project_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">ID da placa de genotipagem: <br/><small>— No aplicativo Coordinate, é chamado de “Plate Name”<br/>— É o nome exclusivo da placa em todo o sistema</small></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="genotyping_trial_name" name="genotyping_trial_name" type="text" placeholder="por exemplo, 18DNA00001"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Formato da placa: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_plate_format">
                                            <option value="96">96 poços</option>
                                            <option value="384">384 poços</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Tipo de amostra: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_plate_sample_type">
                                            <option value="DNA">DNA</option>
                                            <option value="RNA">RNA</option>
                                            <option value="Tissue">Tecido</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Descrição da placa de genotipagem (opcional): </label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="genotyping_trial_description" name="genotyping_trial_description"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Incluir identificadores gerados pelo laboratório de genotipagem<br/>(somente nas opções de envio de arquivo):<br/></label>
                                    <div class="col-sm-7">
                                        <input type="checkbox" id="upload_include_facility_identifiers" name="upload_include_facility_identifiers" >
                                    </div>
                                </div>
                                <br/>
                                <div style="text-align: center">
                                    <button id="plate_info_intro_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Informações dos poços" &>
                                <& /page/page_title.mas, title=>"Forneça as informações dos poços da placa" &>
                                <br/>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label text-align: right">Selecione uma opção: </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="genotyping_trial_well_input_option">
                                            <option value="">Selecione o formato que deseja enviar</option>
                                            <option value="xlsx">Enviar um delineamento de placa criado no Excel</option>
                                            <option value="coordinate">Enviar um delineamento padrão do aplicativo Coordinate para Android</option>
                                            <option value="coordinate_template">Enviar um delineamento personalizado do aplicativo Coordinate para Android</option>
                                            <option value="design">Criar uma placa totalmente nova</option>
                                        </select>
                                    </div>
                                </div>
                                <br/><br/>

                                <div id="genotyping_trial_well_upload_section" style="display:none">
                                    <h3>Enviar uma disposição de placa existente</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                                    <p>
                                                        <b>Informações sobre o formato do arquivo</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_spreadsheet_info_format">Formato da planilha</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">Selecione o arquivo XLSX com a disposição da placa: </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload" id="genotyping_trial_layout_upload" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_coordinate_upload_section" style="display:none">
                                    <h3>Enviar um arquivo do aplicativo Coordinate para Android</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                                    <p>
                                                        <b>Informações sobre o formato do arquivo</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_coordinate_spreadsheet_info_format">Formato da planilha</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">Selecione o arquivo CSV do Coordinate: </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload_coordinate" id="genotyping_trial_layout_upload_coordinate" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_coordinate_template_upload_section" style="display:none">
                                    <h3>Enviar um arquivo personalizado do aplicativo para Android</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                                    <p>
                                                        <b>Informações sobre o formato do arquivo</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_coordinate_custom_spreadsheet_info_format">Formato da planilha</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">Selecione o arquivo CSV do Coordinate: </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload_coordinate_template" id="genotyping_trial_layout_upload_coordinate_template" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_design_section" style="display:none">
                                    <h3>Criar uma placa totalmente nova</h3>
                                    <div class="well well-sm">
                                        <ul>
                                            <li>Selecione uma lista com o material de origem de cada poço. A lista deve ter correspondência individual com os poços; por exemplo, para preencher 95 poços, forneça uma lista com 95 elementos.</li>
                                            <li>Observação: da unidade de observação de origem mais desejável à menos desejável, você pode usar amostras de tecido, plantas, subparcelas, parcelas ou acessos.</li>
                                        </ul>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-7 control-label">Lista de unidades de observação de origem: </label>
                                        <div class="col-sm-5">
                                            <span id="accession_select_box_span">[carregando...]</span>
                                        </div>
                                    </div>
                                    <br/>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Poço vazio: <small>(O Cornell IGD exige que um poço específico fique vazio.)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_blank_well" name="genotyping_blank_well" type="text" placeholder="por exemplo, A01"/>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Concentração no poço (ng/µl): <small>(se for igual em todos os poços)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_concentration" name="genotyping_well_concentration" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Volume no poço (µl): <small>(se for igual em todos os poços)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_volume" name="genotyping_well_volume" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Tecido: <small>(se for igual em todos os poços)</small> </label>
                                        <div class="col-sm-5">
                                            <select class="form-control" id="genotyping_well_tissue">
                                                <option value="leaf">Folha</option>
                                                <option value="root">Raiz</option>
                                                <option value="stem">Caule</option>
                                                <option value="seed">Semente</option>
                                                <option value="fruit">Fruto</option>
                                                <option value="tuber">Tubérculo</option>
                                            </select>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> ID taxonômico do NCBI: <small>(ID oficial do NCBI)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_ncbi_taxonomy_id" name="genotyping_well_ncbi_taxonomy_id" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Extração: <small>(se for igual em todos os poços)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_extraction" name="genotyping_well_extraction" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Pessoa: <small>(se a mesma pessoa preparou todos os poços)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_dna_person" name="genotyping_well_dna_person" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Data: <small>(se todos foram colocados na placa na mesma data; AAAA/MM/DD)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_date" name="genotyping_well_date" type="text" placeholder="AAAA/MM/DD"/>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Observações: <small>(observações adicionais sobre estes poços)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_notes" name="genotyping_well_notes" type="text" />
                                        </div>
                                    </div>
                                </div>

                                <br/>
                                <div id="next_upload_button" style="display:none">
                                    <div style="text-align: center">
                                        <button id="well_info_intro_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                    </div>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Vínculo com ensaios" &>
                                <& /page/page_title.mas, title=>"Sua placa de genotipagem está vinculada a ensaios de campo no banco de dados? Essa informação também pode ser adicionada na página de detalhes da placa após o ensaio ser salvo." &>
                                <p>Se você informou a origem da amostra de tecido de cada poço — por exemplo, o nome de uma parcela, subparcela, planta ou amostra de tecido de um ensaio de campo — criaremos automaticamente o vínculo entre o(s) ensaio(s) de campo e esta placa de genotipagem.</p>
                                <br/>
                                <div style="text-align: center">
                                    <button id="trial_linkage_intro_button"  class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" >Continuar para a próxima etapa</button>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Confirmação" &>
                                <& /page/page_title.mas, title=>"Finalize e envie sua placa de genotipagem" &>

                                <p>O envio automático ao laboratório de genotipagem não está disponível no momento. Após clicar em Enviar, use a página de detalhes da placa para fazer o envio ou baixar as informações e encaminhá-las manualmente.</p>
<!--
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Along with saving this information to this database, I want to automatically submit to the Genotyping Facility: <small>Automatic submission currently not working. You can submit it from the Genotyping Plate's detail page or download the information from the Genotyping Plate's detail page and submit it yourself after clicking Submit</small></label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_facility_submit_select" disabled>
                                            <option value="no">No</option>
                                            <option value="yes">Yes</option>
                                        </select>
                                    </div>
                                </div>
-->
                                <input name="genotyping_trial_facility_submit_select" id="genotyping_trial_facility_submit_select" type="hidden" value="no">

                                </form>
                                <hr/>
                                <div style="text-align: center">
                                    <button type="button" class="btn btn-primary" name="add_geno_trial_submit" id="add_geno_trial_submit">Enviar</button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:complete, title=> "Concluído" &>
                                <& /page/page_title.mas, title=>"Concluído! Sua placa de genotipagem foi salva no banco de dados." &>
                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    A placa de genotipagem foi salva com sucesso.
                                </p>
                                <ul>
                                    <li>Acesse a página de detalhes da placa de genotipagem que você acabou de criar.</li>
                                    <li>Você pode imprimir códigos de barras para a placa e para as amostras de tecido.</li>
                                </ul>
                                <br/>
                            </&>
                        </&>
                    </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_spreadsheet_info_format_dialog" name="genotyping_trial_layout_upload_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Este modelo serve para enviar a disposição de uma placa de genotipagem existente.</b>
                    <br/>
                    <b>O arquivo deve estar no formato Excel (.xls ou .xlsx).</b>
                    <br />
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>date</td>
                                <td>sample_id</td>
                                <td>well_A01</td>
                                <td>row</td>
                                <td>column</td>
                                <td>source_observation_unit_name</td>
                                <td>ncbi_taxonomy_id</td>
                                <td>dna_person</td>
                                <td>notes</td>
                                <td>tissue_type</td>
                                <td>extraction</td>
                                <td>concentration</td>
                                <td>volume</td>
                                <td>is_blank</td>
                            </tr>
                        </tbody>
                    </table>
                    Coluna opcional: além dos IDs das amostras, você pode adicionar os identificadores do laboratório na última coluna, com o cabeçalho <code>facility_identifier</code>.
                    <br/><br/>
                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li><code>date</code> (deve estar no formato AAAA-MM-DD)</li>
                    <li><code>sample_id</code> (identificador exclusivo da amostra no poço)</li>
                    <li><code>well_A01</code> (posição da amostra na placa, por exemplo, A10)</li>
                    <li><code>row</code> (linha da amostra na placa, por exemplo, A)</li>
                    <li><code>column</code> (coluna da amostra na placa, por exemplo, 10)</li>
                    <li><code>source_observation_unit_name</code> (deve existir no banco de dados; é o identificador do material de origem. Em ordem de preferência: nome da amostra de tecido, da planta, da subparcela, da parcela ou do acesso. Para poços vazios, informe <code>BLANK</code> e também coloque 1 na coluna <code>is_blank</code>.)</li>
                    <li><code>tissue_type</code> (deve ser <code>leaf</code>, <code>root</code>, <code>stem</code>, <code>seed</code>, <code>fruit</code> ou <code>tuber</code>)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                    <li><code>ncbi_taxonomy_id</code> (identificador taxonômico do NCBI)</li>
                    <li><code>dna_person</code> (nome da pessoa que preparou o poço)</li>
                    <li><code>notes</code> (observações adicionais sobre o poço)</li>
                    <li><code>extraction</code> (texto livre para o método de extração, por exemplo, CTAB)</li>
                    <li><code>concentration</code> (concentração em ng/µl)</li>
                    <li><code>volume</code> (volume em µl)</li>
                    <li><code>is_blank</code> (indica se o poço está vazio; informe 1 se estiver vazio ou deixe em branco)</li>
                    <li><code>facility_identifier</code> (identificador do laboratório; adicione-o na última coluna com esse cabeçalho)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_coordinate_info_format_dialog" name="genotyping_trial_layout_upload_coordinate_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialCoordinateInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialCoordinateInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Este modelo serve para enviar uma disposição de placa padrão exportada pelo aplicativo Coordinate para Android.</b>
                    <br/>
                    <b>O arquivo deve estar no formato CSV (.csv).</b>
                    <br />
                    (O formato Excel não é aceito.)
                    <br /><br />
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>date</td>
                                <td>plate_id</td>
                                <td>plate_name</td>
                                <td>sample_id</td>
                                <td>well_A01</td>
                                <td>well_01A</td>
                                <td>tissue_id</td>
                                <td>dna_person</td>
                                <td>notes</td>
                                <td>tissue_type</td>
                                <td>extraction</td>
                            </tr>
                        </tbody>
                    </table>
                    Coluna opcional: além dos IDs das amostras, você pode adicionar os identificadores do laboratório na última coluna, com o cabeçalho <code>facility_identifier</code>.
                    <br/><br/>
                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li><code>date</code> (deve estar no formato AAAA-MM-DD)</li>
                    <li><code>plate_id</code> (identificador de um grupo de placas; corresponde ao “Nome do projeto de genotipagem” no formulário, por exemplo, NextGenCassava)</li>
                    <li><code>plate_name</code> (nome exclusivo de cada placa; corresponde ao “ID da placa” no formulário, por exemplo, 18DNA00001)</li>
                    <li><code>sample_id</code> (identificador exclusivo da amostra no poço, por exemplo, 18DNA00001_A01)</li>
                    <li><code>well_A01</code> (posição da amostra na placa no formato A01)</li>
                    <li><code>well_01A</code> (posição da amostra na placa no formato 01A)</li>
                    <li><code>tissue_id</code> (identificador do material de origem. Em ordem de preferência: nome da amostra de tecido, da planta, da subparcela, da parcela ou do acesso. Também pode ser <code>BLANK</code> para indicar um poço vazio.)</li>
                    <li><code>dna_person</code> (nome da pessoa que colocou a amostra na placa)</li>
                    <li><code>tissue_type</code> (deve ser <code>leaf</code>, <code>root</code> ou <code>stem</code>)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                    <li><code>notes</code> (observações adicionais sobre o poço)</li>
                    <li><code>extraction</code> (texto livre para o método de extração, por exemplo, CTAB)</li>
                    <li><code>facility_identifier</code> (identificador do laboratório; adicione-o na última coluna com esse cabeçalho)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_coordinate_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_coordinate_custom_info_format_dialog" name="genotyping_trial_layout_upload_coordinate_custom_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialCoordinateCustomInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialCoordinateCustomInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Este modelo serve para enviar uma disposição de placa personalizada exportada pelo aplicativo Coordinate para Android.</b>
                    <br/>
                    <b>O arquivo deve estar no formato CSV (.csv).</b>
                    <br />
                    (O formato Excel não é aceito.)
                    <br /><br />
                    <b>Cabeçalho:</b>
                    <br

                    <p>Ao usar este tipo de envio, o tipo de tecido será definido como <code>leaf</code>, pois essa informação não consta no arquivo e é obrigatória para o DaRT.</p>

                    A primeira linha (cabeçalho) deve conter os seguintes campos:

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>Value</td>
                                <td>Column</td>
                                <td>Row</td>
                                <td>Identification</td>
                                <td>Person</td>
                                <td>Date</td>
                            </tr>
                        </tbody>
                    </table>
                    Coluna opcional: além dos IDs das amostras, você pode adicionar os identificadores do laboratório na última coluna, com o cabeçalho <code>Facility Identifier</code>.
                    <br/><br/>
                    <b>Campos obrigatórios:</b>
                    <ul>
                        <li><code>Value</code> (identificador do material de origem, por exemplo, 2018MyPlant0001. Em ordem de preferência: nome da amostra de tecido, da planta, da subparcela, da parcela ou do acesso. Também pode ser <code>exclude</code> para indicar um poço vazio.)</li>
                        <li><code>Column</code> (coluna da amostra, por exemplo, 10)</li>
                        <li><code>Row</code> (linha da amostra, por exemplo, A)</li>
                        <li><code>Identification</code> (texto livre)</li>
                        <li><code>Person</code> (nome da pessoa que colocou a amostra na placa)</li>
                        <li><code>Date</code> (deve estar no formato AAAA-MM-DD)</li>
                    </ul>
                    <b>Campo opcional:</b>
                    <ul>
                        <li><code>Facility Identifier</code> (identificador do laboratório; adicione-o na última coluna com esse cabeçalho)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_coordinate_custom_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery('#genotyping_trial_layout_upload_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_layout_upload_coordinate_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_coordinate_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_layout_upload_coordinate_custom_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_coordinate_custom_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_well_input_option').change(function(){
        if (jQuery(this).val() == 'xlsx'){
            jQuery("#genotyping_trial_well_upload_section").show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
        if(jQuery(this).val() == 'coordinate'){
            jQuery('#genotyping_trial_well_coordinate_upload_section').show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
        if(jQuery(this).val() == 'coordinate_template'){
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').show();
            jQuery('#next_upload_button').show();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
        }
        if (jQuery(this).val() == 'design' ){
            jQuery("#genotyping_trial_well_design_section").show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
    });

    get_select_box('breeding_programs', 'plate_breeding_program_select_div', {'name' : 'plate_breeding_program_id', 'id' : 'plate_breeding_program_id', 'empty': 1  });

    jQuery('#next_step_creating_genotyping_plates').click(function(){
        get_select_box('projects', 'plate_genotyping_project_select_div', { 'name' : 'plate_genotyping_project_id', 'id' : 'plate_genotyping_project_id', 'get_genotyping_projects': '1', 'empty':1});
    });

});
</script>
