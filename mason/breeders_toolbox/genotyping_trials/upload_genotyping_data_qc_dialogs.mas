<%args>
$facilities
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="upload_genotypes_qc_dialog" name="upload_genotypes_qc_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypesQCDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypesQCDialog">Enviar dados para controle de qualidade de genótipos</h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotypes_qc_form" name="upload_genotypes_qc_form" action="/ajax/genotype_qc/upload">

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "upload_genotypes_qc_workflow" &>
                            <&| /util/workflow.mas:step, title=> "Introdução" &>
                                <& /page/page_title.mas, title=>"Este fluxo orientará o controle de qualidade dos genótipos" &>

                                <ul>
                                    <li>O controle de qualidade não salva os genótipos no banco de dados; ele apenas os compara aos protocolos de genotipagem já armazenados.</li>
                                    <li>Para armazenar os dados no banco, use “Enviar dados de genotipagem”.</li>
                                    <li>Os nomes dos marcadores devem ser exatamente os que você deseja comparar, e não outros IDs.</li>
                                </ul>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> "Protocolo de genotipagem" &>
                                <& /page/page_title.mas, title=>"Selecione o protocolo de genotipagem usado na comparação" &>

                                <ul>
                                    <li>Selecione no banco de dados o protocolo com o qual deseja comparar os genótipos.</li>
                                </ul>
                                <br/><br/>

                                <div id="genotype_qc_selected_protocol">
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> "Informações dos genótipos" &>
                                <& /page/page_title.mas, title=>"Forneça as informações dos genótipos" &>
                                <br/><br/>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                            <p>
                                                <b>Informações sobre o formato do arquivo</b>
                                                <br>
                                                <a id="upload_genotype_qc_spreadsheet_info_format">Formato do arquivo</a>
                                            </p>
                                        </&>
                                    </div>
                                    <div class="col-sm-8">
                                        <br/>
                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="form-group">
                                                    <label class="col-sm-6 control-label">Selecionar arquivo: </label>
                                                    <div class="col-sm-6">
                                                        <input type="file" name="upload_genotype_qc_file_input" id="upload_genotype_qc_file_input" encoding="multipart/form-data" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" id="genotype_qc_upload_submit_button">Enviar</button>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Resultados" &>
                                <& /page/page_title.mas, title=>"Matriz de similaridade entre as amostras do arquivo e os genótipos armazenados para o protocolo selecionado" &>

                                <div id="genotype_qc_result_div"></div>

                            </&>
                        </&>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_genotype_qc_spreadsheet_info_format_dialog" name="upload_genotype_qc_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypeQCInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypeQCInfoDialog">Informações do modelo para controle de qualidade de genótipos</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Este modelo é usado para enviar dados ao controle de qualidade de genótipos.</b>
                    <br/>
                    <b>Use arquivos no formato CSV.</b>
                    <p>
                    <br />
                    <b>Cabeçalho:</b>
                    <br>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>SampleName.LabID</td>
                                <td>Uma coluna separada para cada nome de marcador (por exemplo, S12_7926132)</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_qc_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<style>

.ui-autocomplete { z-index:2147483647; }

</style>

<script>
jQuery(document).ready(function(){

    jQuery('button[name=upload_genotyping_data_qc_link]').click(function(){
        jQuery('#upload_genotypes_qc_dialog').modal('show');
    });

    get_select_box('genotyping_protocol','genotype_qc_selected_protocol', {'empty':'1', 'id':'genotype_qc_protocol_id', 'name':'genotype_qc_protocol_id'});

    jQuery('#upload_genotype_qc_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_qc_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotype_qc_upload_submit_button').click(function () {
        submit_genotype_data_qc_upload()
    });

    function submit_genotype_data_qc_upload() {
        jQuery('#working_modal').modal('show');
        jQuery("#upload_genotypes_qc_form").submit();
    }

    jQuery('#upload_genotypes_qc_form').iframePostForm({
        json: true,
        post: function () {
        },
        complete: function (response) {
            //console.log(response);
            jQuery('#working_modal').modal('hide');
            if (response.success) {

                var html = '<table class="table table-hover"><thead><tr><th>Amostras no arquivo</th>';
                for(var i=0; i<response.protocol_stock_names.length; i++) {
                    html = html + '<th>'+response.protocol_stock_names[i]+'</th>';
                }
                html = html + '</tr></thead><tbody>';
                for(var j=0; j<response.users_stock_names.length; j++) {
                    html = html + '<tr><td>'+response.users_stock_names[j]+'</td>';
                    for(var k=0; k<response.protocol_stock_names.length; k++) {
                        var distance = response.distance_matrix[response.users_stock_names[j]][response.protocol_stock_names[k]];
                        html = html + '<td>'+distance+'</td>';
                    }
                    html = html + '</tr>';
                }
                html = html + '</tbody></table>';
                jQuery('#genotype_qc_result_div').html(html);

                Workflow.complete('#genotype_qc_upload_submit_button');
                Workflow.focus("#upload_genotypes_qc_workflow", 3);
            }
        }
    });

});
</script>
