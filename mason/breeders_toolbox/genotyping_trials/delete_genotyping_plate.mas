<%args>
$trial_id
$number_of_samples_with_data => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.BreedersToolbox.GenotypingTrial' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, id=>'delete_genotyping_data_section', title => 'Excluir dados de genotipagem', subtitle => '<font color="red">A exclusão não pode ser desfeita</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div style="text-align: center">Excluir todos os dados de genotipagem derivados desta placa.</div>
    </div>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-primary" id="delete_plate_genotyping_data" role="button">Excluir dados de genotipagem</button><br/><br/>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_genotyping_plate_layout_section', title => 'Excluir disposição da placa de genotipagem', subtitle => '<font color="red">A exclusão não pode ser desfeita.</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div style="text-align: center">Não exclua a disposição de genotipagem de um experimento que já tenha sido enviado ao laboratório de sequenciamento.</div>
    </div>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
%if ($number_of_samples_with_data > 0) {
                <div class="boxbgcolor5" >Não é possível excluir a disposição da placa porque há dados de genotipagem associados.</div>
%} else {
                <button class="btn btn-primary" id="delete_layout_data_by_trial_id" role="button">Excluir disposição da placa de genotipagem</button><br/><br/>
%}
            </div>
        </div>
    </div>
</&>

<div class="modal fade" id="genotyping_data_delete_message_dialog" name="genotyping_data_delete_message_dialog" tabindex="-1" role="dialog" aria-labelledby="genotypingDataDeleteMessageDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="genotypingDataDeleteMessageDialog"></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div style="text-align: center">Os dados de genotipagem foram excluídos com sucesso.</div>
                    <div id="genotyping_data_delete_complete"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="genotyping_data_delete_dismiss_button_1" name="genotyping_data_delete_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="empty_protocol_message_dialog" name="empty_protocol_message_dialog" tabindex="-1" role="dialog" aria-labelledby="emptyProtocolMessageDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <div style="text-align: center">
                    <h4 class="modal-title" id="createGenotypingProjectdialog">Os dados de genotipagem foram excluídos com sucesso.</h4>
                </div>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div style="text-align: center">
                        <div id="empty_protocol_message"></div>
                        <p>Deseja excluir este protocolo?</p>
                        <button id="delete_empty_protocol_submit" name="delete_empty_protocol_submit" type="button" class="btn btn-primary" data-dismiss="modal">Sim</button>
                        <button id="empty_dismiss_button_1" name="empty_protocol_dismiss_button" type="button" class="btn btn-primary" data-dismiss="modal">Não</button>
                        <br/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    let empty_protocol_id;
    let empty_protocol_name;

    jQuery('#delete_plate_genotyping_data').click(function() {
        const trial_id = get_trial_id();
        const confirmation = confirm("Tem certeza de que deseja excluir todos os dados de genotipagem derivados desta placa? Esta ação não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/plate_genotyping_data_delete',
                dataType: "json",
                type: 'GET',
                data:{
                    'genotyping_plate_id': trial_id,
                },
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                    jQuery('#working_msg').html("Excluindo dados de genotipagem...<br />");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.empty_protocol_id) {
                        empty_protocol_id = response.empty_protocol_id;
                        empty_protocol_name = response.empty_protocol_name;

                        const empty_protocol_message_string = "O protocolo " +empty_protocol_name+ " não possui dados de genotipagem associados.";
                        jQuery('#empty_protocol_message').html(empty_protocol_message_string);
                        jQuery("#empty_protocol_message_dialog").modal("show");
                    }
                    if (response.success == 1) {
                        jQuery("#genotyping_data_delete_message_dialog").modal("show");
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

    jQuery(document).on('click', '[name="genotyping_data_delete_dismiss_button"]', function(){
        jQuery('#genotyping_data_delete_message_dialog').modal('hide');
        location.reload();
    });

    jQuery(document).on('click', '[name="empty_protocol_dismiss_button"]', function(){
        jQuery('#empty_protocol_message_dialog').modal('hide');
        location.reload();
    });

    jQuery('#delete_empty_protocol_submit').click(function() {
        const confirmation = confirm("Tem certeza de que deseja excluir este protocolo de genotipagem? Esta ação não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/empty_protocol_delete',
                dataType: "json",
                type: 'GET',
                data:{
                    'empty_protocol_id': empty_protocol_id,
                },
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                    jQuery('#working_msg').html("Excluindo protocolo de genotipagem...<br />");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert("O protocolo de genotipagem foi excluído com sucesso.");
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });


});

</script>
