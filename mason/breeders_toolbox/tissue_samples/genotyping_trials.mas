
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4>Placas de genotipagem</h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_genotyping_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Nome do ensaio</th>
                        <th>Descrição</th>
                        <th>Programa de melhoramento</th>
                        <th>Pasta</th>
                        <th>Ano</th>
                        <th>Local</th>
                        <th>Laboratório de genotipagem</th>
                        <th>Formato</th>
                        <th>Tipo de amostra</th>
                        <th>Baixar</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var geno_trial_table = jQuery('#tissue_sample_genotyping_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/genotyping_trials',
   });

});

</script>
