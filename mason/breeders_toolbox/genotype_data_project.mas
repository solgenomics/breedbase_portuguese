
<%doc>

=head1 NAME

/breeders_toolbox/genotype_data_project.mas - a mason component to display a genotyping project detail page

=head1 AUTHOR


=cut

</%doc>

<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$user_can_modify => undef
$has_plant_entries => undef
$has_subplot_entries => undef
$has_tissue_sample_entries => undef
$hidap_enabled => undef
$folder_name => undef
$folder_id => undef
$plants_per_plot => undef
$has_expression_atlas => undef
$expression_atlas_url => undef
$site_project_name => undef
$trial_phenotype_files => undef
$sgn_session_id => undef
$user_name => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$identifier_prefix => 'SGN'
$genotyping_facility => undef
$genotype_data_type => undef
$trial_owner => undef
$has_plate => undef
$marker_names => undef
$marker_info_headers => undef
$assay_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial' , 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker' ] &>

<br/>

<& /page/page_title.mas, title=>"Projeto de genotipagem: ".$trial_name &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Detalhes do projeto de genotipagem</h4>", info_section_subtitle => 'Visualize as informações básicas do projeto de genotipagem.',buttons_html => '<button class="btn btn-primary btn-sm" id="edit_genotyping_project_details" style="margin:3px">Editar detalhes do projeto de genotipagem</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_data_project_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, year => $year, trial_description => $trial_description, identifier_prefix => $identifier_prefix, genotyping_facility => $genotyping_facility, genotype_data_type => $genotype_data_type, trial_owner => $trial_owner &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Placas de genotipagem</h4>", info_section_subtitle => 'Visualize as placas de genotipagem deste projeto ou mova placas para ele.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_existing_genotyping_plate_link">Mover placas de genotipagem para este projeto</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "genotyping_project_plates" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Protocolos de genotipagem</h4>", info_section_subtitle => 'Visualize as informações básicas dos protocolos usados neste projeto de genotipagem.', icon_class => "glyphicon glyphicon-cog", info_section_id => "genotyping_data_project_protocols" &>

% if ($genotype_data_type eq 'SSR') {
    <& /page/detail_page_2_col_section.mas, trial_id => $trial_id, marker_names => $marker_names, info_section_title => "<h4 style='display:inline'>Dados genotípicos</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem deste projeto.',buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="download_project_ssr_data_link">Baixar dados SSR</button>', icon_class => "glyphicon glyphicon-save-file", info_section_id => "project_pcr_genotype_data" &>
% } elsif ($assay_type eq 'KASP') {
    <& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Dados de genotipagem</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem.', icon_class => "glyphicon glyphicon-map-marker", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="project_genotype_data_download_all_vcf">Baixar todos os dados genotípicos em VCF</button><button class="btn btn-primary" style="margin:3px" id="project_genotype_data_download_all_dosagematrix">Baixar matriz de dosagem de todos os dados genotípicos</button><button class="btn btn-default" style="margin:3px" id="kasp_project_genotype_data_download_all_csv">Baixar todos os dados genotípicos (CSV)</button>', info_section_id => "genotyping_data_project_data" &>
% } else {
    <& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Dados de genotipagem</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem.', icon_class => "glyphicon glyphicon-map-marker", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="project_genotype_data_download_all_vcf">Baixar todos os dados genotípicos em VCF</button><button class="btn btn-primary" style="margin:3px" id="project_genotype_data_download_all_dosagematrix">Baixar matriz de dosagem de todos os dados genotípicos</button>', info_section_id => "genotyping_data_project_data" &>
% }

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Arquivos armazenados</h4>", info_section_subtitle => 'Baixe os arquivos VCF armazenados associados a este projeto de genotipagem.', icon_class => "glyphicon glyphicon-hdd", info_section_id => "genotyping_data_archived_vcf" &>

% my $data_agreement_link = '<button class="btn btn-sm btn-primary" disabled style="margin:3px">Adicionar/editar acordo de dados</button>';
% if ($user_can_modify) { $data_agreement_link = '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_data_agreement">Adicionar/editar acordo de dados</button>'; }

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Licença do acordo de dados</h4>", info_section_subtitle => 'Visualize e edite o acordo público de dados deste experimento.', icon_class => "glyphicon glyphicon-inbox", info_section_id => "trial_data_agreement_section", buttons_html => $data_agreement_link &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Excluir</h4>", info_section_subtitle => 'Exclua o projeto, as placas e/ou os dados de genotipagem associados a este projeto.', icon_class => "glyphicon glyphicon-trash", info_section_id => "genotyping_project_deletion_section" &>

<& /breeders_toolbox/add_data_agreement_dialogs.mas, trial_id => $trial_id &>
<& /breeders_toolbox/genotyping_data_project/add_existing_genotyping_plate_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/genotyping_data_project/edit_genotyping_project_details_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name, trial_description => $trial_description, year => $year, genotyping_facility => $genotyping_facility, has_plate => $has_plate &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

<script defer="defer">

jQuery(document).ready(function () {

    trial_detail_page_setup_dialogs();

    jQuery('#edit_genotyping_project_details').click(function(){
        jQuery('#edit_genotyping_project_details_dialog').modal("show");
        edit_genotyping_project_details();
    });


});

</script>
