
<%args>
$user_id => undef
</%args>

<& /util/import_css.mas, paths => [
    'leaflet.css',
    'leaflet.extra-markers.min.css',
    'esri-leaflet-geocoder.css'
] &>

<& /page/page_title.mas, title=>"Gerenciar locais" &>

<div class="container-fluid">

<&| /page/info_section.mas, title=>'Tabela de locais',  collapsible=>1, collapsed=>0, subtitle=>'[<a id="upload_locations_link">Enviar novos locais</a>]' &>

<& /breeders_toolbox/location_table.mas, user_id=>$user_id &>

</&>

<&| /page/info_section.mas, title => 'Copiar locais para uma lista', collapsible=>1, collapsed=>0, subtitle=>'<i>Copie os nomes dos locais da tabela para uma lista nova ou existente</i>'&>
<br>
<div style="text-align:right" id="locations_to_list_menu"></div>
<div id="location_names" style="display: none;"></div>
</&>

<&| /page/info_section.mas, title=>'Mapa de locais',  collapsible=>1, collapsed=>0 &>

<& /breeders_toolbox/location_map.mas, user_id=>$user_id &>

</&>

</div>
