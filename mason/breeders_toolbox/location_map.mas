        <div class="form-group">
              <label class="col-sm-2 control-label">Programa: (um ou mais)</label>
      	      <div class="col-sm-10" id="breeding_program" name="breeding_program">
              </div>
	    </div>
        <div class="form-group">
              <label class="col-sm-2 control-label">Tipo: </label>
      	      <div class="col-sm-10">
                  <select class="form-control" id="location_type" name="location_type">
                      <option value=""></option>
                      <option value="Town">Cidade</option>
                      <option value="Farm">Fazenda</option>
                      <option value="Field">Campo</option>
                      <option value="Greenhouse">Estufa</option>
