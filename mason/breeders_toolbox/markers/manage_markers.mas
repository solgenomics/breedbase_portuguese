<%doc>

=head1 NAME

/breeders_toolbox/markers/manage_markers.mas - a mason component to display markerset info, add new markersets and add filtering parameters in markersets

=head1 AUTHOR

Titima Tantikanjana <tt15@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables','CXGN.BreedersToolbox.MarkerSet', "CXGN.List" ] &>

<& /page/page_title.mas, title=>'Gerenciar alelos de marcadores' &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Seus alelos de marcadores</h4>", info_section_subtitle => 'Visualize as informações dos seus alelos de marcadores.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_new_markerset_button">Criar nova lista de alelos de marcadores</button><button class="btn btn-sm btn-primary" style="margin:3px" id="add_marker_dosage_button">Adicionar alelos de marcadores a uma lista existente</button><button class="btn btn-default" style="margin:3px" data-toggle="modal" data-target="#markerset_usage_modal">Ajuda de uso <span class="glyphicon glyphicon-question-sign"></span></button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "marker_set_summary_section" &>

<& /page/detail_page_3_col_section.mas, icon_class => "glyphicon glyphicon-search", title => "Use alelos de marcadores para localizar acessos com um genótipo específico.", go_btn_id => "accession_search_link" &>


<div class="modal fade" id="add_markerset_dialog" name="add_markerset_dialog" tabindex="-1" role="dialog" aria-labelledby="addMarkerSetDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMarkerSetDialog">Criar nova lista de alelos de marcadores</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-1">
                        </div>
                        <div class="col-sm-12 well">
                            <div class="row">
                                <div class="col-sm-11">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">Nome da lista:</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="new_marker_set" placeholder="Informe o nome da lista">
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">Protocolo de genotipagem:</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <select class="form-control" id="selected_protocol">
                                                        </select>
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">Tipo de dados:</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <select class="form-control" id="genotyping_data_type">
                                                        <option value="">Selecione o tipo de dados de genotipagem</option>
                                                        <option value="SNP">SNP</option>
                                                        <option value="Dosage">Dosagem</option>
                                                        <!-- option value="Download">Download</option-->
                                                        </select>
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">Descrição:</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="marker_set_desc" placeholder="Informe a descrição">
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="save_marker_set" id="save_marker_set">Criar lista</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_marker_dosage_dialog" name="add_marker_dosage_dialog" tabindex="-1" role="dialog" aria-labelledby="addMarkerDosageDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMarkerDosageDialog">Adicionar alelos de marcadores à lista</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="row panel panel-default">
                                <div class="col-sm-12 panel-body">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">Nome da lista:</label>
                                            <div class="col-sm-8">
                                                <div class="input-group">
                                                    <select class="form-control" id="selected_marker_set1">
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_download_section" style="display:none">
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">Nome(s) do(s) marcador(es):</label>
                                                <div class="col-sm-8">
                                                    <textarea class="form-control" id="marker_name_download" placeholder="Para adicionar mais de um marcador, informe cada nome em uma nova linha."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_dosage_section" style="display:none">
                                            <hr />
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">Nome do marcador:</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control marker_name" id="marker_name_dosage" placeholder="Informe o nome do marcador">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">Dosagem do alelo:</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <select class="form-control" id="allele_dosage">
                                                            <option value="">Selecione a dosagem do alelo</option>
                                                            <option value="0">0</option>
                                                            <option value="1">1</option>
                                                            <option value="2">2</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_snp_section" style="display:none">
                                            <ul class="nav nav-pills nav-justified" id="markerset_snp_section_tab" style="display: none; margin-bottom: 30px">
                                                <li class="active" id="markerset_snp_section_single">
                                                    <a data-toggle="tab" href="#markerset_snp_section_single_tab">
                                                        Adicionar alelos de um único marcador pelo nome do marcador
                                                    </a>
                                                </li>
                                                <li id="markerset_snp_section_multiple">
                                                    <a data-toggle="tab" href="#markerset_snp_section_multiple_tab">
                                                        Adicionar alelos de vários marcadores pelos nomes dos alelos
                                                    </a>
                                                </li>
                                            </ul>
                                            <hr />
                                            <div class="tab-content">

                                                <!-- Specify individual Allele by Marker -->
                                                <div id="markerset_snp_section_single_tab" class="tab-pane fade in active">
                                                    <div class="form-group">
                                                        <label class="control-label col-sm-4">Nome do marcador:</label>
                                                        <div class="col-sm-8">
                                                            <div class="input-group">
                                                                <input type="text" class="form-control marker_name" id="marker_name_snp" placeholder="Informe o nome do marcador">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-sm-4">Especifique os alelos:</label>
                                                        <div class="col-sm-8" >
                                                            <div class="input-group">
                                                                <select class="form-control" id="allele_1" disabled>
                                                                    <option value="">Informe primeiro o nome do marcador</option>
                                                                </select>
                                                                <select class="form-control" id="allele_2" disabled>
                                                                    <option value="">Informe primeiro o nome do marcador</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Specify multiple Alleles by Allele Names -->
                                                <div id="markerset_snp_section_multiple_tab" class="tab-pane fade in">
                                                    <div class="form-group">
                                                        <label class="control-label col-sm-4">Especifique os alelos:</label>
                                                        <div class="col-sm-8" >
                                                            <div class="input-group">
                                                                <textarea id="allele_names" class="form-control" rows=10 cols=40></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="add-marker-success" role="alert" style="display: none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="close_add_marker">Fechar</button>
                <button type="button" class="btn btn-primary" name="add_marker" id="add_marker">Adicionar alelo de marcador</button>
            </div>
        </div>
    </div>
</div>
