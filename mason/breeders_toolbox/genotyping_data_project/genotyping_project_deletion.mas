<%args>
$trial_id
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>
<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables'] &>


<&| /page/info_section.mas, id=>'delete_genotyping_plate_section', title => 'Excluir placas de genotipagem', subtitle => '<font color="red">A exclusão não pode ser desfeita. Não é possível excluir placas associadas a dados de genotipagem</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="genotyping_plate_deletion_table">
                </table>
            </div>
        </div>
        <button class="btn btn-default" id="delete_all_genotyping_plates" role="button">Excluir todas as placas de genotipagem deste projeto</button><br/><br/>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_protocol_section', title => 'Excluir protocolo de genotipagem e todos os dados', subtitle => '<font color="red">A exclusão não pode ser desfeita</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="genotyping_protocol_deletion_table">
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_genotyping_project_data_section', title => 'Excluir dados do projeto de genotipagem', subtitle => '<font color="red">A exclusão não pode ser desfeita</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_genotyping_project_data" role="button">Excluir dados do projeto de genotipagem</button><br/><br/>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_genotyping_project_section', title => 'Excluir projeto de genotipagem', subtitle => '<font color="red">A exclusão não pode ser desfeita. Exclua primeiro as placas e/ou os dados de genotipagem</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_genotyping_project" role="button">Excluir projeto de genotipagem</button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    var plate_deletion_table = jQuery('#genotyping_plate_deletion_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/genotyping_project/plate_names?genotyping_project_id=<% $trial_id %>',
        'columns': [
            { title: "Nomes das placas", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders_toolbox/trial/"+row.plate_id+"'>"+row.plate_name+"</a>"; } },
            { title: "Excluir", "data": null, "render": function ( data, type, row ) {
                if (row.number_of_samples_with_data > 0){
                    return 'Não é possível excluir'
                } else {
                    return "<a onclick='deletePlate("+row.plate_id+")'>Excluir</a>";
                }
            }},

        ]
    });

    jQuery('#delete_all_genotyping_plates').click(function() {

        var genotyping_project_id = "<% $trial_id %>";
        var confirmation = confirm("Tem certeza de que deseja excluir todas as placas deste projeto de genotipagem? A exclusão não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_all_genotyping_plates_in_project',
                destroy: true,
                beforeSend: function(response) {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão concluída com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

    var protocol_deletion_table = jQuery('#genotyping_protocol_deletion_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/genotyping_project/protocols?genotyping_project_id=<% $trial_id %>',

        'columns': [
            { title: "Protocolo", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders_toolbox/protocol/"+row.protocol_id+"'>"+row.protocol_name+"</a>"; } },
            { title: "Excluir", "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteProtocol("+row.protocol_id+")'>Excluir</a>"; } },
        ]
    });

    jQuery('#delete_genotyping_project_data').click(function() {
        var project_id = "<% $trial_id %>";
        var confirmation = confirm("Tem certeza de que deseja excluir estes dados de genotipagem? A exclusão não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/genotyping_project/delete/' + project_id,
                type: 'POST',
                dataType: 'json',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão concluída com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

    jQuery('#delete_genotyping_project').click(function() {
        var project_id = "<% $trial_id %>";
        var confirmation = confirm("Tem certeza de que deseja excluir este projeto de genotipagem? A exclusão não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+project_id+'/delete/genotyping_project',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão concluída com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

});

function deletePlate(plate_id){

    var confirmation = confirm('Tem certeza de que deseja excluir esta placa de genotipagem? A exclusão não pode ser desfeita.');

    if (confirmation) {
        jQuery.ajax({
            url: '/ajax/breeders/trial/'+plate_id+'/delete/layout',
            beforeSend: function(){
                jQuery('#working_modal').modal("show");
            },
            success: function(response) {
                if (response.error) {
                    alert(response.error);
                }
                else {
                    jQuery('#working_modal').modal("hide");
                    alert('A placa de genotipagem foi excluída.');
                    location.reload();
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal("hide");
                alert("Ocorreu um erro.");
            }
        });
    }
}

function deleteProtocol(protocol_id){

    var confirmation = confirm('Tem certeza de que deseja excluir este protocolo de genotipagem e todos os seus dados? A exclusão não pode ser desfeita.');

    if (confirmation) {
        jQuery.ajax ({
            url : '/ajax/genotyping_protocol/delete/'+protocol_id,
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert('Protocolo de genotipagem excluído!');
                    window.location.replace("/search/genotyping_protocols");
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Erro ao excluir o protocolo de genotipagem!');
            }
        });
    }
}


</script>
