<%args>
$facilities
</%args>


<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="create_genotyping_project_dialog" name="create_genotyping_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createGenotypingProjectdialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <div style="text-align: center">
                    <h4 class="modal-title" id="createGenotypingProjectdialog">Adicionar novo projeto de genotipagem</h4>
                </div>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "add_genotyping_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Projeto de genotipagem" &>
                            <p>O projeto de genotipagem agrupa uma série de placas e dados de genotipagem. Ele deve corresponder ao projeto do fornecedor, caso exista.</p>
                            <hr>
                            <div style="text-align: center">
                                <button id="next_step_add_new_genotyping_project" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <form class="form-horizontal" role="form" name="create_genotyping_project_form" id="create_genotyping_project_form">
                            <&| /util/workflow.mas:step, title=> "Adicionar projeto de genotipagem" &>
                            <& /page/page_title.mas, title=>"Informe os dados básicos do projeto de genotipagem" &>
                                <br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Nome do projeto de genotipagem: </label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="new_genotyping_project_name" name="new_genotyping_project_name" type="text" placeholder="Deve corresponder ao projeto do fornecedor, caso exista"/>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Laboratório de genotipagem: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_project_facility_select" name="genotyping_project_facility_select">
%  foreach my $facility (@$facilities) {
                                            <option value="<% $facility %>"><% $facility %></option>
%  }
                                        </select>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Tipo de dado: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="data_type">
                                            <option value="">Selecione um tipo de dado</option>
                                            <option value="snp">SNP</option>
                                            <option value="ssr">SSR</option>
                                        </select>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Programa de melhoramento: </label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_breeding_program_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Ano: </label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_year_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Local de geração dos dados (opcional): </label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_location_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Descrição: </label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="genotyping_project_description" name="genotyping_project_description" maxlength="250"></textarea>
                                    </div>
                                </div>
                                <br/>
                                <br/>
                                <br/>
                                <div style="text-align: center">
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="add_new_genotyping_project_submit" id="add_new_genotyping_project_submit">Enviar</button>
                                </div>
                            </&>
                        </form>
                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! Seu projeto de genotipagem está no banco de dados" &>
                            <ul>
                                <li>Agora você pode adicionar placas e/ou dados de genotipagem ao projeto criado.</li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_new_genotyping_project_close_modal" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    get_select_box("locations", "genotyping_project_location_select_div", {'id': 'genotyping_project_location_select', 'name': 'genotyping_project_location_select'});
    get_select_box("breeding_programs", "genotyping_project_breeding_program_select_div", {'id': 'genotyping_project_breeding_program_select', 'name': 'genotyping_project_breeding_program_select'});
    get_select_box("years", "genotyping_project_year_select_div", {'auto_generate': 1, 'id': 'genotyping_project_year_select', 'name': 'genotyping_project_year_select'});

    jQuery('#add_new_genotyping_project_submit').click(function() {

        var project_name = jQuery("#new_genotyping_project_name").val();
        if (!project_name) {
            alert("O nome do projeto de genotipagem é obrigatório");
            return;
        }

        var project_facility = jQuery("#genotyping_project_facility_select").val();

        var data_type = jQuery("#data_type").val();
        if (!data_type) {
            alert("O tipo de dado é obrigatório");
            return;
        }

        var project_breeding_program = jQuery("#genotyping_project_breeding_program_select").val();
        if (!project_breeding_program) {
            alert ("O programa de melhoramento é obrigatório");
            return;
        }

        var project_year = jQuery("#genotyping_project_year_select").val();
        if (!project_year) {
            alert ("O ano é obrigatório");
            return;
        }

        var project_description = jQuery("#genotyping_project_description").val();
        if (!project_description) {
            alert ("A descrição é obrigatória");
            return;
        }

        var project_location = jQuery("#genotyping_project_location_select").val();

        jQuery.ajax({
            url: '/ajax/breeders/add_genotyping_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': project_name,
                'project_breeding_program': project_breeding_program,
                'project_facility': project_facility,
                'data_type': data_type,
                'project_year': project_year,
                'project_description': project_description,
                'project_location': project_location
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
//                    refreshGenotypingTrialJsTree(0);
                    Workflow.focus("#add_genotyping_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_genotyping_project_workflow");
                    jQuery("#working_modal").modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert('Ocorreu um erro ao salvar o projeto de genotipagem.');
                jQuery('#create_genotyping_project_dialog').modal("hide");
            },
        });
    });

    jQuery("#add_new_genotyping_project_close_modal").click(function(){
        jQuery('#create_genotyping_project_dialog').modal('hide');
        jQuery(".modal-backdrop").remove();
        location.reload();
    });

});


</script>
