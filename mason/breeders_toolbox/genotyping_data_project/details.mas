<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$year
$trial_description
$identifier_prefix
$genotyping_facility
$genotype_data_type
$trial_owner
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome do projeto de genotipagem</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[Sem nome do projeto]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Programa de melhoramento</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
        <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print "<span class='text-danger'>[Sem programa de melhoramento]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>Local</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name";
% } else {
%  print "<span class='text-danger'>[Sem local]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Ano</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[Sem ano]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Laboratório de genotipagem</b></td>
                <td>
                    <div id="trial_genotyping_facility">
% if ($genotyping_facility) {
%  print "$genotyping_facility";
% } else {
%  print "<span class='text-danger'>[Sem laboratório de genotipagem]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Tipo de dado</b></td>
                <td>
                    <div id="trial_data_type">
% if ($genotype_data_type) {
%  print "$genotype_data_type";
% } else {
%      print "<span class='text-danger'>[Sem tipo de dado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Descrição</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[Sem descrição]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>Criado por</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[Não disponível]</span>";
% }
                    </div>
                </td>
            </tr>
        </table>
        
    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
