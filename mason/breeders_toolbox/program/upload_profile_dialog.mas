<%args>

$program_id
$program_name

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form'] &>

<div class="modal fade" id="upload_profile_dialog" name="upload_profile_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadProfileDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadProfileDialog">Enviar perfil de produto</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_profile_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Perfil de produto" &>
                            <ul>
                                <li>Os perfis de produto podem ser armazenados no banco de dados para apoiar o processo posterior de seleção de cultivares de cada programa de melhoramento.</li>
                                <li>Para facilitar a curadoria dos dados, os nomes e IDs das características-alvo podem ser recuperados diretamente do banco de dados.</li>
                                <li>Use o modelo de perfil de produto gerado pelo banco de dados para preencher os detalhes do perfil.</li>
                                <li>O link para criar o modelo está na seção de perfis de produto; basta informar um nome de arquivo e uma lista de características.</li>
                                <li>As instruções de preenchimento estão na próxima etapa.</li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "Formato do arquivo" &>
                            <& /page/page_title.mas, title=>"Verifique se o arquivo está no formato correto" &>
                            <center>
                                <&| /page/explanation.mas, title=>'Planilha de perfil de produto' &>
                                    <p>
                                        <br>
                                        <a id="product_profile_instructions">Instruções para a planilha de perfil de produto</a>
                                        <br>
                                        <br>
                                    </p>
                                </&>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Quando o arquivo estiver correto, vá para a próxima etapa</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "Enviar perfil de produto" &>
                            <& /page/page_title.mas, title=>"Informe os dados básicos do perfil de produto e envie o arquivo" &>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_profile_form" name="upload_profile_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" name="profile_program_name" id="profile_program_name" disabled value="<% $program_name %>">
                                        <input name="profile_program_id" id="profile_program_id" type="hidden" value="<% $program_id %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Nome do perfil de produto: </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="new_profile_name" name="new_profile_name" type="text"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Escopo: </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="new_profile_scope" name="new_profile_scope" type="text"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Enviar arquivo (.xls ou .xlsx): </label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="profile_uploaded_file" id="profile_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </form>
                            <center>
                                <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" id ="upload_profile_submit" name="upload_profile_submit" >Enviar perfil</button><br/><br/>
                            </center>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! Seu perfil está no banco de dados" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                O arquivo do perfil foi enviado com sucesso.
                            </p>
                            <br/>
                            <center>
                                <button class="btn btn-primary" name="upload_profile_success_complete_button">O perfil foi salvo no banco de dados sem erros. Clique aqui para concluir</button><br/><br/>
                            </center>
                        </&>
                    </&>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_profile_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_profile_error_display" name="upload_profile_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadProfileErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadProfileErrorDialog">Erro ao enviar o arquivo do perfil</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="product_profile_instruction_dialog" name="product_profile_instruction_dialog" tabindex="-1" role="dialog" aria-labelledby="profileInstructionDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="profileInstructionDialog">Instruções para a planilha de perfil de produto</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        Modelo de perfil de produto
                    </b>
                    <ul>
                        <li>O modelo de perfil de produto é um arquivo Excel (.xls).</li>
                        <li>Após preencher os detalhes do perfil de produto, salve também a planilha no formato .xls.</li>
                        <li>Não modifique nem exclua nenhum cabeçalho de coluna do modelo.</li>
                    </ul>
                    <br>
                    <b>
                        Cabeçalho:
                    </b>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>Trait Name (nome da característica)</td>
                                <td>Target Value (valor-alvo)</td>
                                <td>Benchmark Variety (cultivar de referência)</td>
                                <td>Performance (desempenho: equal, smaller, larger)</td>
                                <td>Weight (peso)</td>
                                <td>Trait Type (tipo de característica)</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        Colunas obrigatórias:
                    </b>
                    <ul>
                        <li><b>Trait Name:</b> o modelo já contém os nomes das características com base na sua lista.</li>
                        <li><b>Target Value ou Benchmark Variety:</b> informe <b>um</b> valor-alvo <b>ou</b> uma cultivar de referência para cada característica-alvo. A cultivar de referência deve existir no banco de dados.</li>
                        <li><b>Performance:</b> informe o desempenho de cada característica-alvo (<code>equal</code>, <code>smaller</code> ou <code>larger</code>) em comparação ao valor-alvo ou à cultivar de referência.</li>
                    </ul>
                    <b>
                        Colunas opcionais:
                    </b>
                    <ul>
                        <li><b>Weight:</b> o valor padrão é 1.</li>
                        <li><b>Trait Type:</b> por exemplo, característica básica ou característica de valor agregado.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#product_profile_instructions').click(function(){
        jQuery('#product_profile_instruction_dialog').modal("show");
    });

    jQuery('#upload_profile_submit').click(function () {
        upload_profile();
    });

    function upload_profile() {
        var profile_uploaded_file = jQuery("#profile_uploaded_file").val();
        var program_id = jQuery('#profile_program_id').val();
        var new_profile_name = jQuery('#new_profile_name').val();
        var new_profile_scope = jQuery('#new_profile_scope').val();

        jQuery('#upload_profile_form').attr("action", '/ajax/breeders/program/upload_profile');

        if (program_id === '') {
            alert("Selecione um programa de melhoramento");
            return;
        }
        if (new_profile_name === '') {
            alert("Informe um nome para o perfil");
            return;
        }
        if (new_profile_scope == '') {
            alert("Informe um escopo");
            return;
        }
        jQuery('#upload_profile_form').submit();

    }

    jQuery('#upload_profile_form').iframePostForm({
        json: true,
        post: function () {
        var profile_uploaded_file = jQuery("#profile_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (profile_uploaded_file == '') {
                jQuery('#working_modal').modal("hide");
                alert("Nenhum arquivo selecionado");
            }
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery('#upload_profile_error_display').modal("show");
                jQuery('#upload_profile_error_display tbody').html('');
                jQuery('#upload_profile_error_display tbody').append(response.error_string);
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#upload_profile_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_profile_workflow");

            }
        }
    });

    jQuery(document).on('click', '[name="upload_profile_success_complete_button"]', function(){
        jQuery('#upload_profile_dialog').modal('hide');
        location.reload();
    });


});

</script>
