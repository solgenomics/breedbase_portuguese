<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/trials"><p>Gerenciar ensaios</p></a>
            </td>
            <td>
                <a href="/breeders/genotyping"><p>Gerenciar placas de genotipagem</p></a>
            </td>
            <td>
                <a href="/breeders/crosses"><p>Gerenciar cruzamentos</p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_trials", title => "Ensaios de campo", is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/trials.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_genotyping_plates", title => "Placas de genotipagem", is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_genotyping_plates.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crossing_experiments", title => "Experimentos de cruzamento", is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crossing_experiments.mas, program_id => $program_id &>
    </&>
</div>
