<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/accessions"><p>Gerenciar acessos</p></a>
            </td>
            <td>
                <a href="/breeders/seedlots"><p>Gerenciar lotes de sementes</p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_accessions", title=>"Acessos", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_accessions.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crosses", title=>"Cruzamentos", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crosses.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_seedlots", title=>"Lotes de sementes", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_seedlots.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_propagation_identifiers", title=>"Identificadores de propagação", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_propagation_identifiers.mas, program_id => $program_id &>
    </&>
</div>
