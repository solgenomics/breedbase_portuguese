<%args>

$programs => undef
$program_id => undef
$program_name => undef

</%args>

<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>


<div class="modal fade" id="add_autogenerated_name_metadata_dialog" name="add_autogenerated_name_metadata_dialog" tabindex="-1" role="dialog" aria-labelledby="addAutogeneratedNameMetadataDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="reset" class="close" id="add_autogenerated_name_metadata_dismiss_button_1" name="add_autogenerated_name_metadata_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addAutogeneratedNameMetadataDialog">Adicionar metadados de nomes gerados automaticamente</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div>
                        <center>
                            <&| /page/explanation.mas, title=>'' &>
                                <p>
                                    <b>Nomes gerados automaticamente</b>
                                    <br>
                                <a id="autogenerated_name_usage_info">Informações de uso</a>
                            </p>
                        </&>
                        </center>
                    </div>
                    <form class="form-horizontal" id="add_new_autogenerated_name_metadata_form" name="add_new_autogenerated_name_metadata_form">
% if ($programs) {
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Programa de melhoramento: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="autogenerated_name_metadata_program" name="autogenerated_name_metadata_program">
                                    <option value="">Selecione o programa de melhoramento</option>
<%perl>
foreach my $program (@$programs) {
if (@$program[3]) {
print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
} else {
print "<option value='".@$program[0]."'>".@$program[1]."</option>";
}
}
</%perl>
                                </select>
                            </div>
                        </div>
% } elsif ($program_name) {
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Programa de melhoramento: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="autogenerated_name_metadata_program" name="autogenerated_name_metadata_program">
                                    <option value="<%$program_id%>"><%$program_name%></option>
                                </select>
                            </div>
                        </div>
% }
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Nome do formato: </label>
                            <div class="col-sm-8">
                                <input class="form-control" id="format_name" name="format_name" type="text" placeholder="Por exemplo: breedbase_transformantes"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Descrição: </label>
                            <div class="col-sm-8">
                                <input class="form-control" id="autogenerated_name_metadata_description" name="autogenerated_name_metadata_description" type="text" placeholder="Opcional" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Gerar nomes automaticamente para: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="name_type">
                                    <option value="">Selecione um tipo de nome</option>
                                    <option value="transformant">transformante (acesso)</option>
                                    <option value="plot">nome da parcela</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Quantidade de atributos do nome-base: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="number_of_attributes">
                                    <option value="">Selecione um número</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                    <option value="8">8</option>
                                </select>
                            </div>
                        </div>
                        <div class="well" id="autogenerated_name_preview_box" style="display:none; margin-bottom:15px">
                            <p id="plot_template_naming_rules" style="display:none">O modelo deve conter o nome do ensaio e pelo menos uma destas opções: número da parcela; nome do acesso + número da repetição; número da linha + número da coluna<p>
                            <strong>Pré-visualização do nome:</strong> <span id="autogenerated_name_preview" style="font-family:monospace"></span><span id="autogenerated_name_preview_status"></span>
                            <div id="autogenerated_name_preview_missing" style="margin-top:5px; font-size:0.9em"></div>
                        </div>
                        <div id ="name_attributes_form_div">
                        </div>
                        <div id="last_serial_number_section" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Último número de série: </label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="last_number" name="last_number" type="number" placeholder="Por exemplo: valor 0. O próximo nome será BTI_1"/>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_autogenerated_name_metadata_dismiss_button_2" name="add_autogenerated_name_metadata_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" id="new_autogenerated_name_metadata_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_autogenerated_name_metadata_message" name="add_autogenerated_name_metadata_message" tabindex="-1" role="dialog" aria-labelledby="addAutogeneratedNameMetadataMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addAutogeneratedNameMetadataMessage">Metadados de nomes gerados automaticamente</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        O formato de nome gerado automaticamente foi armazenado com sucesso.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="add_autogenerated_name_format_close_button" id="add_autogenerated_name_format_close_button" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="autogenerated_name_usage_info_dialog" name="autogenerated_name_usage_info_dialog" tabindex="-1" role="dialog" aria-labelledby="autogeneratedNameUsageInfoDialog">
    <div class="modal-dialog modal-xl " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="autogeneratedNameUsageInfoDialog">Como usar o recurso de geração automática de nomes</h4>
            </div>
            <div class="well well-lg">
                <div class="panel panel-default">
                    <div class="modal-body">
                        <div class="container-fluid">
                            <h4>
                                Nomes gerados automaticamente:
                            </h4>
                            <li>Este recurso gera nomes automaticamente no formato desejado, seguido de um número de série. Antes de usá-lo, armazene as informações do formato de nomenclatura e os demais metadados relacionados. Atualmente, somente a ferramenta de transformação oferece esse recurso para gerar nomes de transformantes. Caso tenha interesse em usá-lo em outros tipos de projeto, entre em contato conosco.</li>
                            <li>Os formatos de nomenclatura podem ser compartilhados no mesmo programa de melhoramento. Todos os formatos armazenados aparecem na seção de metadados de nomes gerados automaticamente da página do programa de melhoramento.</li>
                            <br>
                            <h4>
                                Metadados de nomes gerados automaticamente:
                            </h4>
                            <li><b>Programa de melhoramento</b>: cada programa pode armazenar diferentes tipos de formato de nomenclatura. Você pode escolher o formato a ser usado em cada projeto.</li>
                            <li><b>Nome do formato</b>: deve ser exclusivo em todo o sistema. É o identificador usado para reunir todos os metadados relacionados a cada formato de nomenclatura.</li>
                            <li><b>Descrição</b>: descrição do formato de nomenclatura.</li>
                            <li><b>Tipo de nome</b>: usado para recuperar as informações relacionadas que servirão como atributos do formato. Por exemplo, os atributos de um nome de transformante podem incluir programa de melhoramento, construção vetorial, material vegetal usado na transformação, projeto de transformação, ID da transformação e campo de texto.</li>
                            <li><b>Número de atributos</b>: indica quantos atributos você deseja incluir em um nome. Também é possível incluir textos.</li>
                            <li><b>Atributos do nome-base</b>: especifique os atributos que deseja incluir no nome-base e a ordem deles. Para adicionar um campo de texto, selecione “texto” e informe o conteúdo. Os atributos são separados por sublinhado. Por exemplo, ao selecionar programa de melhoramento, construção vetorial e um campo de texto, o nome gerado será <b>“breedingProgram_vectorConstruct_text”</b>, seguido de um <b>número de série</b>.</li>
                            <li><b>Último número de série</b>: se o formato já era usado antes do banco de dados, informe o último número utilizado para continuar a sequência. Para um formato novo, informe “0”; o primeiro nome terá “1” como número de série. Quando novos nomes forem adicionados ao banco de dados, o último número de série será atualizado automaticamente e armazenado nos metadados do formato.</li>
                            <br>
                            <h4>
                                Configuração do formato de nomenclatura de cada projeto:
                            </h4>
                            <li>Depois de armazenar os metadados de cada formato, você poderá configurar um formato de nomenclatura específico para cada projeto.</li>
                            <li>O link para configurar o formato de nomenclatura está na página de cada projeto de transformação.</li>
                        </div>
                        <div class="modal-footer">
                            <button id="close_autogenerated_name_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery("[name='add_autogenerated_name_metadata_link']").click(function(e) {
        e.preventDefault();
        jQuery("#add_autogenerated_name_metadata_dialog").modal("show");
    });

    jQuery('#autogenerated_name_usage_info').click(function(){
        jQuery('#autogenerated_name_usage_info_dialog').modal("show");
    });

    var name_type;

    jQuery("#name_type").change(function() {
        jQuery('#number_of_attributes').val('');
        let attribute_table = document.getElementById("name_attributes_table");
        if (attribute_table) {
            attribute_table.hidden = true;
        }

        name_type = jQuery('#name_type').val();
        if (name_type == 'transformant') {
            jQuery('#last_serial_number_section').modal("show");
            jQuery('#plot_template_naming_rules').css("display", "none");
        } else {
            jQuery('#last_serial_number_section').modal("hide");
            jQuery('#plot_template_naming_rules').css("display", "");
        }
    })

    jQuery("#number_of_attributes").change(function() {
        if (!name_type) {
            jQuery('#number_of_attributes').val('');
            alert("Selecione primeiro um tipo de nome");
            return;
        }

        number_of_attributes = jQuery('#number_of_attributes').val();
        if (number_of_attributes){
            name_attributes_form(name_type);
            document.getElementById("name_attributes_table").hidden = false;
        }
    })

    function translate_autogenerated_attribute_options(select_id) {
        const labels = {
            '': 'Selecione um atributo',
            'breedingProgram': 'programa de melhoramento',
            'transformationProject': 'projeto de transformação',
            'transformationID': 'ID da transformação',
            'vectorConstruct': 'construção vetorial',
            'plantMaterial': 'material vegetal',
            'trialName': 'nome do ensaio',
            'accessionName': 'nome do acesso',
            'plotNumber': 'número da parcela',
            'blockNumber': 'número do bloco',
            'repNumber': 'número da repetição',
            'rangeNumber': 'número da faixa',
            'rowNumber': 'número da linha',
            'colNumber': 'número da coluna',
            'text': 'texto'
        };
        jQuery('#' + select_id + ' option').each(function() {
            if (Object.prototype.hasOwnProperty.call(labels, this.value)) {
                jQuery(this).text(labels[this.value]);
            }
        });
    }

    function name_attributes_form (name_type) {
        let number_of_attributes = parseInt(jQuery('#number_of_attributes').val());

        let html = '<table class="table table-bordered" id="name_attributes_table"><thead><tr><th>Ordem do atributo</th><th>Selecionar atributo</th></tr></thead><tbody>';
        for(let i=0; i<number_of_attributes; i++){
            let attribute_order = i+1;
            html = html + '<tr><td>' + attribute_order + '</td><td><div name="attribute_selects" id="attribute_select_' +i+ '"></div></td><td><span id="selected_attribute_'+ i +'_string" data-related="'+encodeURI(attribute_order)+'" ></span></td></tr>';
        };
        html = html + '</tbody></table>';

        jQuery('#name_attributes_form_div').html(html);

        let attribute_list = jQuery('#name_attributes_table')
            .find("div")
            .map(function() { return this.id; })
            .get();
        for(let i=0; i<attribute_list.length; i++){
            if (name_type == 'transformant') {
                get_select_box('transformant_related_attributes', attribute_list[i], {'name' : 'selected_attribute', 'id' : 'selected_attribute_'+i, 'after_load': function() { translate_autogenerated_attribute_options('selected_attribute_'+i); } });
            } else if (name_type == 'plot') {
                get_select_box('plot_related_attributes', attribute_list[i], {'name' : 'selected_attribute', 'id' : 'selected_attribute_'+i, 'after_load': function() { translate_autogenerated_attribute_options('selected_attribute_'+i); } });
            }
        };
    };

    function update_preview() {
        let parts = [];
        let selected_attributes = [];
        jQuery('select[name="selected_attribute"]').each(function() {
            let value = this.value;
            if (!value) return;
            if (value === 'text') {
                let text_val = jQuery('#' + this.id + '_string').find('input').val() || '';
                parts.push(text_val);
            } else {
                parts.push('{' + value + '}');
                selected_attributes.push(value);
            }
        });
        jQuery('#autogenerated_name_preview').text(parts.join('_'));
        jQuery('#autogenerated_name_preview_box').toggle(parts.length > 0);

        let status_html = '';
        let missing_html = '';

        if (parts.length > 0 && name_type === 'plot') {
            let has_trial_name     = selected_attributes.indexOf('trialName') !== -1;
            let has_accession_name = selected_attributes.indexOf('accessionName') !== -1;
            let has_rep_number     = selected_attributes.indexOf('repNumber') !== -1;
            let has_row_number     = selected_attributes.indexOf('rowNumber') !== -1;
            let has_col_number     = selected_attributes.indexOf('colNumber') !== -1;
            let has_plot_number    = selected_attributes.indexOf('plotNumber') !== -1;

            let combo1_valid = has_accession_name && has_rep_number;
            let combo2_valid = has_row_number && has_col_number;
            let combo3_valid = has_plot_number;
            let is_valid = has_trial_name && (combo1_valid || combo2_valid || combo3_valid);

            if (is_valid) {
                status_html = ' <span class="glyphicon glyphicon-ok" style="color:green" aria-label="válido"></span>';
            } else {
                let missing = [];
                if (!has_trial_name) missing.push('nome do ensaio');

                if (!combo1_valid && !combo2_valid && !combo3_valid) {
                    if (has_accession_name && !has_rep_number) {
                        missing.push('número da repetição');
                    } else if (!has_accession_name && has_rep_number) {
                        missing.push('nome do acesso');
                    } else if (has_row_number && !has_col_number) {
                        missing.push('número da coluna');
                    } else if (!has_row_number && has_col_number) {
                        missing.push('número da linha');
                    } else {
                        missing.push('pelo menos uma destas opções: número da parcela; nome do acesso + número da repetição; número da linha + número da coluna');
                    }
                }

                status_html = ' <span style="color:red">*</span>';
                missing_html = '<span style="color:red">Ausente: ' + missing.join(', ') + '</span>';
            }
        }

        jQuery('#autogenerated_name_preview_status').html(status_html);
        jQuery('#autogenerated_name_preview_missing').html(missing_html);
    }

    jQuery(document).on('change', "select[name='selected_attribute']", function() {
        let div_id = '#' + this.id;
        let attribute = jQuery(div_id).val();
        if (attribute == 'text') {
            attribute_string(div_id, div_id + '_string');
        } else {
            jQuery(div_id + '_string').html('');
        }
        update_preview();
    });

    jQuery(document).on('input', '#name_attributes_form_div input', function() {
        update_preview();
    });

    function attribute_string(div_id, select_id){
        let html = '<td><input class="form-control" placeholder="Informe o texto"/></td>';
        jQuery(select_id).html(html);
    };

    jQuery('#new_autogenerated_name_metadata_submit').click(function(e){
        e.preventDefault();
        let name_attributes = [];

        jQuery('select[name="selected_attribute"]').each(function() {
            value = this.value;
            let text_string;
            if (value == 'text') {
                text_string = jQuery('#' + this.id + '_string').find('input').val() || '';
                name_attributes.push({'text':text_string});
            } else {
                name_attributes.push(value);
            }
        });

        let breeding_program = jQuery('#autogenerated_name_metadata_program').val();
        if (!breeding_program) {
            alert("O programa de melhoramento é obrigatório");
            return;
        }

        let format_name = jQuery('#format_name').val();
        if (!format_name) {
            alert("O nome do formato é obrigatório");
            return;
        }

        let description = jQuery('#autogenerated_name_metadata_description').val();

        let name_type = jQuery('#name_type').val();
        if (!name_type) {
            alert("O tipo de nome é obrigatório");
            return;
        }

        let last_serial_number = jQuery('#last_number').val();
        if (name_type == 'transformant') {
            if (!last_serial_number) {
                alert("O último número de série é obrigatório");
                return;
            }
        }

        jQuery.ajax({
            url: '/ajax/add_autogenerated_name_metadata',
            method: 'POST',
            data: {
                'breeding_program': breeding_program,
                'format_name': format_name,
                'description': description,
                'name_type': name_type,
                'last_serial_number': last_serial_number,
                'name_attributes': JSON.stringify(name_attributes),
            },
            dataType:'json',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    var refresh_callback = jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback');
                    if (refresh_callback) {
                        jQuery("#add_autogenerated_name_metadata_message").modal({backdrop: false});
                    } else {
                        jQuery("#add_autogenerated_name_metadata_message").modal("show");
                    }
                    jQuery('#add_autogenerated_name_metadata_dialog').modal("hide");

                    if (typeof refresh_callback === 'function') {
                        refresh_callback();
                    }
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert('Ocorreu um erro ao armazenar os metadados de nomes gerados automaticamente.');
                jQuery('#add_autogenerated_name_metadata_dialog').modal("hide");
            },
        });

    });

    jQuery("[name='add_autogenerated_name_metadata_dismiss_button']").click(function() {
        jQuery('#add_autogenerated_name_metadata_dialog').modal('hide');
        jQuery('#autogenerated_name_metadata_program').val('');
        jQuery('#format_name').val('');
        jQuery('#autogenerated_name_metadata_description').val('');
        jQuery('#name_type').val('');
        jQuery('#last_number').val('');
        jQuery('#number_of_attributes').val('');
        if (!jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback')) {
            jQuery(".modal-backdrop").remove();
            location.reload();
        }
    });

    jQuery("#add_autogenerated_name_format_close_button").click(function(){
        jQuery('#add_autogenerated_name_metadata_message').modal('hide');
        jQuery('#autogenerated_name_metadata_program').val('');
        jQuery('#format_name').val('');
        jQuery('#autogenerated_name_metadata_description').val('');
        jQuery('#name_type').val('');
        jQuery('#last_number').val('');
        jQuery('#number_of_attributes').val('');
        if (!jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback')) {
            jQuery(".modal-backdrop").remove();
            location.reload();
        }
    });

});

</script>
