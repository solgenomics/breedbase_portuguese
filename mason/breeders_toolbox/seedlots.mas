
<%args>
$timestamp
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$programs
$locations
$crossing_trials
$maintenance_enabled => undef
$user_role => undef
$default_seedlot_material_type => undef
</%args>

<& /page/page_title.mas, title=>"Lotes de sementes disponíveis" &>

<style>
.ui-autocomplete {
    z-index: 5000;
}
</style>

  <& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery.iframe-post-form','CXGN.List','CXGN.BreedersToolbox.Accessions', 'CXGN.BreedersToolbox.UploadPedigrees', 'jquery', 'jquery.dataTables', 'CXGN.BreedersToolbox.Crosses', 'jqueryui' ] &>

<&| /page/info_section.mas, title=>"Sobre os lotes de sementes",  collapsible => 1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <b><p>O que são lotes de sementes?</p></b>
                <ul>
                <li>Os lotes de sementes representam materiais vegetais físicos armazenados em embalagens ou recipientes.</li>
                <li>O material vegetal pode ser uma semente, raiz, clone, planta, cultura de tecidos ou gametófito.</li>
                <li>Entre em contato conosco para definir um tipo de material padrão para os lotes.</li>
                <li>Esses materiais podem vir de cruzamentos ou pertencer a acessos identificados.</li>
                <li>Os lotes podem ter local, caixa, peso (g) e quantidade específicos.</li>
                <li>O material vegetal pode ser transferido para dentro ou para fora de um lote, por exemplo, de um lote para uma parcela.</li>
                <li>Os lotes podem pertencer a programas de melhoramento e organizações.</li>
                </ul>

                <b><p>Como faço o inventário das minhas sementes?</p></b>
                <ul>
                <li>Confirme se os lotes estão no banco de dados. Use "Adicionar novo lote de sementes" para adicionar um único lote ou "Enviar lotes de sementes" para adicionar vários.</li>
                <li>Confirme se os lotes têm códigos de barras. Você pode imprimi-los a partir do banco de dados.</li>
                <li>O aplicativo de inventário não está disponível no momento, mas você pode continuar usando-o caso já esteja instalado em seu tablet.
                <!-- li>3) Use the "Inventory" Android Application to scan seedlot barcodes and record weight. Then click "Upload Inventory" on the Manage Seedlots page to upload this info into the database. If you do not want to use the Inventory Android Application you can create your own CSV file and upload that.</li --><!-- the app is currently not available - re-instate when it is available again -->
                <!-- li><b>For more info about the "Seed Inventory" Android Application go to <a href="https://play.google.com/store/apps/details?id=org.wheatgenetics.inventory/">Inventory</a>.</b></li -->
                Também é possível registrar uma transação manualmente na página de detalhes do lote, clicando em "Adicionar nova transação".</li>
                </ul>
            </div>
        </div>
    </div>
</&>

<%perl>
    my $maintenance_button = $maintenance_enabled ? ' <button onclick="location.href=\'/breeders/seedlot/maintenance\'" class="btn btn-sm btn-primary" style="margin:3px" name="seedlot_record_maintenance">Manutenção de lotes de sementes</button>' : '';
    my $seedlot_subtitle = !!$c->user()
        ? '<div class="btn-group"><button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Criar lote(s) de sementes&nbsp;<span class="caret"></span></button><ul class="dropdown-menu"><li><a href="#" name="add_seedlot_button">Adicionar novo lote</a></li><li><a href="#" name="seedlot_bulk_upload">Enviar lotes de sementes</a></li><li><a href="#" name="create_seedlots_trial_button">Criar lotes a partir de um ensaio</a></li></ul></div>
        <div class="btn-group"><button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Adicionar/enviar transações&nbsp;<span class="caret"></span></button><ul class="dropdown-menu"><li><a href="#" name="transactions_upload_link">Enviar um arquivo</a></li><li><a href="#" id="add_transactions_using_list_link" name="add_transactions_using_list_link">Usar uma lista</a></li><li></ul></div>
        <button class="btn btn-sm btn-primary" style="margin:3px" name="seedlot_upload_inventory">Enviar inventário</button>' . $maintenance_button
        : "Faça login para adicionar ou enviar lotes de sementes";
</%perl>
<&| /page/info_section.mas, title=>"Lotes de sementes",  collapsible => 1, subtitle => $seedlot_subtitle &>

<br/>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">

<&| /page/info_section.mas, title=>"Pesquisar lotes de sementes",  collapsible => 1, collapsed=>0 &>

<div class="well well-sm">
    <form class="form-horizontal" id="search_seedlot_form" name="search_seedlot_form">
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Nome do lote de sementes: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_seedlot_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Programa de melhoramento: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_breeding_program" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Conteúdo (nome único do acesso): </label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_accession" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_accession" value="1">
              <label class="form-check-label" for="exact_accession">correspondência exata</label>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Conteúdo (ID único do cruzamento): </label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_cross" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_cross" value="1">
              <label class="form-check-label" for="exact_cross">correspondência exata</label>
            </div>
        </div>
% if (!$default_seedlot_material_type) {
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Tipo de material: </label>
            <div class="col-sm-9" >
                <div id="search_seedlot_form_material_type_div"></div>
            </div>
        </div>
% }
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Local: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_location" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Nome da caixa: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_box_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Quantidade mínima: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_count" type="number" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Peso mínimo (g): </label>

            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_weight" type="number" />
            </div>
        </div>

        <!-- div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"></label>
            <div class="col-sm-9" >
                <input id="search_seedlot_form_only_good_quality_checkbox" type="checkbox" /> Only show seedlots without quality issues
            </div>
        </div  -->

        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Qualidade: </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_quality" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">Uso em ensaio: </label>
            <div class="col-sm-9">
                <div class="col-sm-5" style="padding-left: 0; padding-right: 5px">
                    <input class="form-control" id="search_seedlot_form_trial_name" type="text" placeholder="Nome do ensaio" />
                </div>
                <div class="col-sm-7" style="padding-left: 5px; padding-right: 0">
                    <select class="form-control" id="search_seedlot_form_trial_usage">
                        <option value="">Selecione o uso do ensaio/lote de sementes...</option>
                        <option value="source">Ensaio --> Lote: encontrar lotes derivados deste ensaio</option>
                        <option value="sink">Lote --> Ensaio: encontrar lotes que forneceram sementes para este ensaio</option>
                        <option value="source|sink">Qualquer uma das opções acima</option>
                    </select>
                </div>
            </div>
        </div>

    </form>
    <div style="text-align: center">
        <button class="btn btn-primary" id="submit_seedlot_search">Pesquisador</button>
    </div>
</div>
</&>

<div style="text-align: center">
    Informe os termos da pesquisa e clique em "Pesquisar" para visualizar os resultados.
</div>

<br />
<br />
<br />
<div style="overflow:scroll">
    <table id="available_seedlots_table" class="table table-hover table-striped table-bordered">
    </table>
</div>

<hr>

<div id="available_seedlots_to_list" style="display:none">
</div>
<div id="available_seedlots_add_to_list">
</div>

        </div>
    </div>
</div>
</&>

<&| /page/info_section.mas, title=>"Marcar lotes como DESCARTADOS usando uma lista",  collapsible => 1, collapsed=>1 &>
% if ($user_role eq "curator" ) {
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-sm btn-default" style="margin:3px" id ="discard_seedlot_usage_info" name = "discard_seedlot_usage_info">Ajuda sobre o uso <span class="glyphicon glyphicon-question-sign"></span></button><button class="btn btn-sm btn-primary" style="margin:3px" id="discard_seedlot_link">Marcar lotes como descartados</button>
            </div>
        </div>
    </div>
% } else {
    Você precisa entrar no sistema e ter privilégios suficientes para marcar lotes como DESCARTADOS usando listas.
% }
</&>

<&| /page/info_section.mas, title=>"Excluir lotes de sementes usando uma lista",  collapsible => 1, collapsed=>1 &>
% if ($user_role eq "curator" ) {
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-sm btn-primary" style="margin:3px" id="delete_seedlots_link">Excluir lotes usando uma lista</button>
            </div>
        </div>
    </div>
% } else {
    Você precisa entrar no sistema e ter privilégios suficientes para excluir lotes de sementes.
% }
</&>

<& /breeders_toolbox/upload_seedlots_inventory_dialogs.mas &>
<& /breeders_toolbox/upload_seedlots_dialogs.mas, default_seedlot_material_type=>$default_seedlot_material_type&>
<& /breeders_toolbox/add_seedlot_dialogs.mas, timestamp=>$timestamp, default_seedlot_material_type=>$default_seedlot_material_type &>
<& /breeders_toolbox/add_accessions_dialogs.mas, preferred_species=>$preferred_species, editable_stock_props=>$editable_stock_props, editable_stock_props_definitions=>$editable_stock_props_definitions &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, programs=>$programs, locations=>$locations, crossing_trials=>$crossing_trials &>
<& /breeders_toolbox/cross/add_cross_dialogs.mas, programs=>$programs, locations=>$locations, crossing_trials=>$crossing_trials &>
<& /breeders_toolbox/cross/add_crossing_trial_dialogs.mas, programs=>$programs, locations=>$locations &>
<& /breeders_toolbox/create_seedlots_from_trial_dialogs.mas, default_seedlot_material_type=>$default_seedlot_material_type&>
<& /breeders_toolbox/delete_seedlots.mas, user_role => $user_role &>
<& /breeders_toolbox/discard_seedlots.mas, user_role => $user_role &>
<& /breeders_toolbox/discard_undo_seedlot_usage.mas &>
<& /breeders_toolbox/upload_transactions_dialogs.mas&>
<& /breeders_toolbox/add_transactions_using_list.mas &>


<script>
jQuery(document).ready(function(){
    jQuery("#search_seedlot_form_seedlot_name").autocomplete({
       source: '/ajax/stock/seedlot_name_autocomplete',
    });
    jQuery("#search_seedlot_form_trial_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    get_select_box('material_types', 'search_seedlot_form_material_type_div', { 'name' : 'search_seedlot_form_material_type', 'id' : 'search_seedlot_form_material_type', 'empty': 1 });


    var seedlots_table;

    //run the query only when the search button is clicked
    jQuery('#submit_seedlot_search').click( function() {
        if (seedlots_table) { seedlots_table.destroy() };
        seedlots_table = jQuery('#available_seedlots_table').DataTable({
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            'lengthMenu': [10,20,50,100,1000],

            columns: [
                { title: "Nome do lote", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/seedlot/"+row.seedlot_stock_id+"'>"+row.seedlot_stock_uniquename+"</a>"; } },
                { title: "Programa de melhoramento", "data": "breeding_program_name" },
                { title: "Conteúdo", "data": "contents_html" },
                { title: "Tipo de material", "data": "material_type" },
                { title: "Local", "data": "location" },
                { title: "Quantidade", "data": "count" },
                { title: "Peso (g)", "data": "weight_gram" },
                { title: "Responsáveis pelo envio", "data": "owners_string" },
                { title: "Organização", "data": "organization" },
                { title: "Caixa", "data": "box" },
                { title: "Qualidade", "data": "seedlot_quality" },
                { title: "Excluir", "data": "null", "render": function ( data, type, row ) { return "<a onclick='removeSeedlot("+row.seedlot_stock_id+")' >X</a>"; } },
                { title: "", "data": "seedlot_stock_uniquename"}
            ],
            'ajax': { 'url': '/ajax/breeders/seedlots',
                'data': function(d) {
                    d.seedlot_name  = jQuery('#search_seedlot_form_seedlot_name').val();
                    d.breeding_program = jQuery('#search_seedlot_form_breeding_program').val();
                    d.minimum_count   = jQuery('#search_seedlot_form_minimum_count').val();
                    d.minimum_weight   = jQuery('#search_seedlot_form_minimum_weight').val();
                    d.location     = jQuery('#search_seedlot_form_location').val();
                    d.box_name = jQuery('#search_seedlot_form_box_name').val();
                    d.contents_accession = jQuery('#search_seedlot_form_contents_accession').val();
                    d.contents_cross = jQuery('#search_seedlot_form_contents_cross').val();
                    d.exact_accession = jQuery('#exact_accession').is(":checked") ? 1 : 0;
                    d.exact_cross = jQuery('#exact_cross').is(":checked") ? 1 : 0;
                    d.quality = jQuery('#search_seedlot_form_quality').val();
                    d.only_good_quality = jQuery('#search_seedlot_form_only_good_quality_checkbox').is(":checked") ? 1 : 0;
                    d.trial_name = jQuery('#search_seedlot_form_trial_name').val();
                    d.trial_usage = jQuery('#search_seedlot_form_trial_usage').val();
                    d.material_type = jQuery('#search_seedlot_form_material_type').val();
                }
            },
        });

        seedlots_table.draw();
        seedlots_table.column(12).visible(false);

    });


    jQuery('#available_seedlots_table').on( 'draw.dt', function () {
        var seedlot_names = seedlots_table.column(12).data();
        var names = "";

        for (var i = 0; i < seedlot_names.length; i++) {
            names += seedlot_names[i]+'\n';
        }

        jQuery('#available_seedlots_to_list').html(names);
        addToListMenu('available_seedlots_add_to_list', 'available_seedlots_to_list', {
            listType: 'seedlots'
        });
    });

    jQuery('#search_seedlot_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#submit_seedlot_search').click();
        }
    });
});

function removeSeedlot(seedlot_stock_id){
    if (confirm("Tem certeza de que deseja excluir este lote de sementes?")){
        jQuery.ajax({
            url: '/ajax/breeders/seedlot/'+seedlot_stock_id+'/delete',
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert("O lote de sementes foi excluído.");
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao excluir o lote de sementes');
            }
        });
    }
}

</script>
