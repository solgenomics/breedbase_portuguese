<%args>
$preferred_species => ""
$editable_stock_props
$editable_stock_props_definitions
</%args>

<%perl>
    my $user_role = '';
    my $email_address = '';
    if ($c->user) {
        $user_role = $c->user->get_object()->get_user_type();
        $email_address = $c->user->get_object()->get_private_email();
    }
</%perl>

<div class="modal fade" id="add_accessions_dialog" tabindex="-1" role="dialog" aria-labelledby="addAccessionsDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addAccessionsDialog">Adicionar acessos</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <ul class="nav nav-pills nav-justified" id="add_new_accessions_tab_select">
                <li class="active" id="add_new_accessions_list_tab"><a data-toggle="tab" href="#with_list_tab">Usar listas</a></li>
                <li id="add_new_accessions_file_tab"><a data-toggle="tab" href="#with_file_tab">Enviar um arquivo</a></li>
            </ul>

            <div class="tab-content">

                <div id="with_list_tab" class="tab-pane fade in active">
                    <hr>
                    <form class="form-horizontal" role="form" name="new_accessions_form" id="new_accessions_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Escolha uma lista de acessos para adicionar: </label>
                            <div class="col-sm-8" id="list_div" name="list_div">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-8">
                                <button name="lists_link" class="btn btn-info btn-sm" style="margin:6px 0px 0px 0px" type="button" >Gerenciar listas</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Usar pesquisa aproximada: </label>
                            <div class="col-sm-8">
% if ( $user_role eq 'curator' ) {
                                <input type="checkbox" id="fuzzy_check" name="fuzzy_check"></input>
% } else {
                                <input type="checkbox" id="fuzzy_check" name="fuzzy_check" checked disabled></input>
% }
                                <br/>
                                <small>Observação: use a pesquisa aproximada para encontrar nomes semelhantes e evitar o envio de acessos duplicados. Ela é muito mais lenta que a pesquisa comum.</small>
                            </div>
                        </div>
                    </form>
                </div>

                <div id="with_file_tab" class="tab-pane fade">
                    <hr>
                    <&| /page/explanation.mas, title=>'Informações do modelo' &>
                        <p>
                            <b>Informações sobre o formato do arquivo</b>
                            <br>
                            <a id="accessions_upload_spreadsheet_format_info">Formato da planilha</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_new_accessions_form" name="upload_new_accessions_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Arquivo para envio: </label>
                            <div class="col-sm-8" >
                                <input type="file" name="new_accessions_upload_file" id="new_accessions_upload_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Aviso por e-mail: </label>
                            <div class="col-sm-8">
                                <input id="email_option_to_recieve_accession_upload_status" name="email_option_to_recieve_upload_status" type="checkbox" data-toggle="toggle" style="margin-right: 10px;">
                                <label id="email_label_upload" class="control-label" style="display: none; margin-right: 10px;">E-mail:</label>
                                <input id="email_address_upload" name="email_address_upload" type="email" value="<% $email_address %>" style="display: none;">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Usar pesquisa aproximada: </label>
                            <div class="col-sm-8">
%# if ( $user_role eq 'curator' ) {
                                <input type="checkbox" id="fuzzy_check_upload_accessions" name="fuzzy_check_upload_accessions"></input>
%# } else {
%#                                <input type="checkbox" id="fuzzy_check_upload_accessions" name="fuzzy_check_upload_accessions" checked disabled></input>
%# }
                                <br/>
                                <small>Observação: use a pesquisa aproximada para encontrar nomes semelhantes e evitar o envio de acessos duplicados. Ela é muito mais lenta que a pesquisa comum. Somente um curador pode desativá-la.</small>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Acrescentar sinônimos:</label>
                            <div class="col-sm-8">
                                <input type="checkbox" id="append_synonyms" name="append_synonyms" checked />
                                <br />
                                <small>Quando selecionado, acrescenta os sinônimos dos acessos existentes aos que já estão armazenados. Quando não selecionado, remove os sinônimos existentes e armazena somente os informados no arquivo enviado.</small>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Criar lista de acessos:</label>
                            <div class="col-sm-8">
                                <input type="checkbox" id="create_accession_list" name="create_accession_list" />
                                <br />
                                <small>Quando selecionado, cria automaticamente uma lista com os acessos do arquivo enviado.</small>
                                <input id="create_accession_list_name" name="create_accession_list_name" class='form-control input-sm' placeholder='Nome da nova lista' />
                            </div>
                        </div>
                    </form>

                    <& /help/file_upload_type.mas, type => "Accessions", optional_column => 1 &>

                </div>

            </div>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-primary" name="new_accessions_submit" id="new_accessions_submit">Continuar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="accessions_upload_spreadsheet_format_modal" name="accessions_upload_spreadsheet_format_modal" tabindex="-1" role="dialog" aria-labelledby="uploadAccessionsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadAccessionsInfoDialog">Informações do modelo para envio de acessos</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter as colunas <b>accession_name</b> E <b>species_name</b>. Para incluir outras informações, selecione as colunas opcionais indicadas abaixo.
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>accession_name</td>
                                <td>species_name</td>
                                <td>population_name</td>
                                <td>Sinónimos</td>
				<td>Descrição</td>
%  foreach my $editable_stockprop (sort keys %$editable_stock_props) {
%                               print "<td>$editable_stockprop</td>";
% }
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos separados por vírgula:</b>
                    <ul>
                    <li>Os campos a seguir aceitam valores separados por vírgulas para indicar vários valores para o acesso: organization_name, synonym
%  foreach my $editable_stockprop (sort keys %$editable_stock_props) {
%                   print ", $editable_stockprop";
%  }
                    </li>
                    </ul>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li>accession_name (deve ser exclusivo)</li>
                    <li>species_name (deve existir no banco de dados)</li>
                    </ul>
                    <b>Campos opcionais:</b>
                    <ul>
		    <li>description — descrição livre do acesso.</li>
                    <li>population_name — uma população é um agrupamento de acessos. Se ela já existir, o acesso será adicionado; caso contrário, uma nova população será criada. É possível informar várias populações separadas por barra vertical (|), por exemplo: pop1|pop2|pop3.</li>
                    <li>synonym — um acesso pode ser conhecido por vários nomes, inclusive nomes populares locais. Um sinônimo pode substituir accession_name em todo o banco de dados e, por isso, também deve ser exclusivo. Ex.: accession_synonym1,accession_synonym001.</li>
%  foreach my $editable_stockprop (sort keys %$editable_stock_props) {
%    if (exists($editable_stock_props_definitions->{$editable_stockprop})) {
%                   print "<li>$editable_stockprop (".$editable_stock_props_definitions->{$editable_stockprop}.")</li>";
%    } else {
%                   print "<li>$editable_stockprop (no definition available)</li>";
%    }
%  }
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Accessions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="review_absent_dialog" name="review_absent_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewAbsentDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content ui-front">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewAbsentDialog">Acessos que serão adicionados</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div id="add_accessions_using_list_inputs" style="display:none">
                <label for="species_name_input">Nome da espécie dos acessos adicionados</label>
                <input class="form-control" type="text" id="species_name_input" value="<% $preferred_species %>"></input>
                <br><br>
                <label for="population_name_input">Nome da população dos acessos adicionados (opcional)</label>
                <input class="form-control" type="text" id="population_name_input"></input>
                <br><br>
                <label for="organization_name_input">Nome da organização dos acessos adicionados (opcional)</label>
                <input class="form-control" type="text" id="organization_name_input"></input>
                <br><br>
                <b>Os acessos a seguir são novos e serão adicionados ao banco de dados:</b>
                <div id="count_of_absent_accessions"></div>
                <br>
                <div id="view_absent"></div>
            </div>
            <div id="view_infoToAdd"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
	<button type="button" class="btn btn-primary" name="review_absent_accessions_submit" id="review_absent_accessions_submit">Adicionar acessos</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="review_fuzzy_matches_dialog" name="review_fuzzy_matches_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewFuzzyDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewFuzzyDialog">Correspondências aproximadas</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <b>Foram encontrados acessos com nomes semelhantes.</b>
          <br/><br/>
          <div id="view_fuzzy_matches"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="review_fuzzy_matches_download" id="review_fuzzy_matches_download">Baixar correspondências aproximadas</button>
        <button type="button" class="btn btn-primary" name="review_fuzzy_matches_continue" id="review_fuzzy_matches_continue" data-dismiss="modal">Fazer alterações e continuar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="review_found_matches_dialog" name="review_found_matches_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewFoundDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewFoundDialog">Acessos encontrados</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <b>Os acessos a seguir já existem no banco de dados:</b>
          <div id="count_of_found_accessions"></div>
          <br/>
          <div id="view_found_matches"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" name="review_found_matches_hide" id="review_found_matches_hide" data-dismiss="modal">Continuar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="add_accessions_saved_message_modal" name="add_accessions_saved_message_modal" tabindex="-1" role="dialog" aria-labelledby="addAccessionsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addAccessionsSavedDialog">Acessos salvos</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="add_accessions_saved_message"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_add_accessions_saved_message_modal" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<form id="add_accession_fuzzy_match_download" method="post" action="/ajax/accession_list/fuzzy_download" target="TheWindow">
    <input type="hidden" name="fuzzy_response" value="" />
</form>

<style>
.ui-autocomplete {
  max-height: 100px;
  overflow-y: auto;
  /* prevent horizontal scrollbar */
  overflow-x: hidden;
}

/* IE 6 doesn't support max-height
* we use height instead, but this forces the menu to always be this tall
*/
* html .ui-autocomplete {
  height: 100px;
}
</style>
