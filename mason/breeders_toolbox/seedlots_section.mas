<%args>
$stock_id
$stock_uniquename => undef
$stock_type => undef
</%args>

<& /util/import_javascript.mas, classes => [] &>

% if ($stock_type eq 'accession'){
    <& /breeders_toolbox/add_seedlot_dialogs.mas, accession_uniquename=>$stock_uniquename &>
% } elsif ($stock_type eq 'cross'){
    <& /breeders_toolbox/add_seedlot_dialogs.mas, cross_uniquename=>$stock_uniquename &>
% }

<&| /page/info_section.mas, id=>'related_seedlots_to_accessions', title => 'Lotes de sementes relacionados', collapsible=>1, collapsed=>1, subtitle=>"<button class='btn btn-sm btn-primary' style='margin:3px' name='add_seedlot_button' >Criar novo lote de sementes</button>" &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body" style="overflow:scroll">
                <table id="seedlots_of_accession_table" class="table table-hover table-striped">
                </table>
            </div>
        </div>
        <br>
        <&| /page/info_section.mas, title => 'Copiar lotes de sementes para uma lista', collapsible=>1, collapsed=>1, subtitle=>'<i>Copie os nomes dos lotes exibidos na tabela para uma lista nova ou existente</i>'&>
            <br/>
            <div style="text-align:right" id="accession_seedlots_to_list_menu">[CARREGANDO...]</div>
            <div id="accession_seedlot_names" style="display: none;"></div>
        </&>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    jQuery('#related_seedlots_to_accessions_onswitch').one("click", function(){

        var seedlots_table = jQuery('#seedlots_of_accession_table').DataTable({
            'destroy' : true,
            'autoWidth': false,
            'ajax': '/ajax/stock/stock_related_seedlots/'+ "<% $stock_id %>",
            'columns': [
                { title: "Nome do lote de sementes", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/seedlot/"+row.seedlot_stock_id+"'>"+row.seedlot_stock_uniquename+"</a>"; } },
                { title: "Programa de melhoramento", "data": "breeding_program_name" },
                { title: "Conteúdo", "data": "contents_html" },
                { title: "Local do lote de sementes", "data": "location" },
                { title: "Quantidade", "data": "count" },
                { title: "Peso (g)", "data": "weight_gram" },
                { title: "Nome da caixa", "data": "box" },
                { title: "Qualidade", "data": "seedlot_quality" },
                { title: "Tipo de material", "data": "material_type"},
                { title: "", "data": "seedlot_stock_uniquename"}
            ],
        });

        seedlots_table.draw();
        seedlots_table.column(9).visible(false);

        jQuery('#seedlots_of_accession_table').on( 'draw.dt', function () {
            var seedlot_names = seedlots_table.column(9).data();
            var names = "";

            for (var i = 0; i < seedlot_names.length; i++) {
                names += seedlot_names[i]+'\n';
            }

            jQuery('#accession_seedlot_names').html(names);
            addToListMenu('accession_seedlots_to_list_menu', 'accession_seedlot_names', {
                listType: 'seedlots'
            });
        });
    });

});

</script>
