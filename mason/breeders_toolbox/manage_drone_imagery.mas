                    <br/><br/>

                    <center>
                    <button class="btn btn-primary" id="drone_imagery_compare_images_drone_runs_select_step">Ir para a próxima etapa</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Bandas do evento de imageamento" &>
                    <& /page/page_title.mas, title=>"Selecione as bandas dos eventos de imageamento que deseja comparar" &>

                    <table class="table table-bordered table-hover" id="drone_image_compare_images_drone_run_bands_table">
                        <thead>
                            <tr>
                                <th>Selecionar</th>
                                <th>Nome do evento de imageamento</th>
                                <th>Tipo do evento de imageamento</th>
                                <th>Descrição</th>
