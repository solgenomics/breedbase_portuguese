                                <th>GDD do evento de imageamento</th>
                                <th>Tipo de câmera</th>
                                <th>Nome do ensaio de campo</th>
                                <th>Descrição do ensaio de campo</th>
                            </tr>
                        </thead>
                    </table>

                    <br/><br/>

                    <center>
                    <button class="btn btn-primary" id="drone_imagery_compare_images_drone_run_bands_select_step">Ir para a próxima etapa</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Seleção da imagem" &>
                    <& /page/page_title.mas, title=>"Selecione as imagens que deseja comparar" &>

                    <table class="table table-bordered table-hover" id="drone_imagery_compare_images_images_type_table">
                        <thead>
                            <tr>
                                <th>Selecionar</th>
                                <th>Ensaio de campo</th>
                                <th>Nome do evento de imageamento</th>
