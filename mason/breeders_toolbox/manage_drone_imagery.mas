
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreederSearch', 'd3.d3v4Min.js', "opencv.opencv" ] &>

<style>
.ui-autocomplete { z-index:2147483647; }

.straightLine, .hrLine{
  position: absolute;
  background-color: red;
  transition: transform .05s ease-in-out;
}
</style>

<div id="manage_drone_imagery_top_div">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas" &>

    <div class="well well-sm">
        <center><h4>Use os navegadores Brave ou Chrome para acessar estas ferramentas de imagem. Outros navegadores poderão ser compatíveis futuramente.</h4></center>
    </div>

<%perl>
#my $buttons_html = "<button class='btn btn-primary' style='margin:3px' id='upload_drone_imagery_link'>Upload Imagery</button><button class='btn btn-default' style='margin:3px' id='download_phenotypes_drone_imagery_link'>Download Image-Phenotypes</button><button class='btn btn-success' style='margin:3px' id='keras_cnn_drone_imagery_link'>CNN Models</button><button class='btn btn-success' style='margin:3px' id='drone_imagery_calculate_statistics_link'>Statistics</button><button class='btn btn-success' style='margin:3px' id='drone_imagery_analytics_link'>Analytics</button><button class='btn btn-default' style='margin:3px' id='drone_imagery_compare_field_images_link'>Compare Aerial Field Images</button><button class='btn btn-default' style='margin:3px' id='drone_imagery_view_imaging_vehicles_link'>Imaging Vehicles</button><button class='btn btn-default' style='margin:3px' id='export_drone_imagery_events'>Export Imaging Events</button>";

my $buttons_html = "<button class='btn btn-primary' style='margin:3px' id='upload_drone_imagery_link'>Enviar imagens</button><button class='btn btn-success' style='margin:3px' id='keras_cnn_drone_imagery_link'>Modelos CNN</button><button class='btn btn-success' style='margin:3px' id='drone_imagery_calculate_statistics_link'>Calcular estatísticas</button><button class='btn btn-success' style='margin:3px' id='drone_imagery_analytics_link'>Análises</button><button class='btn btn-default' style='margin:3px' id='drone_imagery_view_imaging_vehicles_link'>Veículos de imageamento</button><button class='btn btn-default' style='margin:3px' id='download_phenotypes_drone_imagery_link'>Baixar arquivo de fenótipos de imagens</button><button class='btn btn-default' style='margin:3px' id='export_drone_imagery_events'>Exportar eventos de imageamento</button>";
</%perl>

    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Imagens aéreas</h4>", info_section_subtitle => 'Se estas ferramentas forem úteis, cite o <a href="https://acsess.onlinelibrary.wiley.com/doi/full/10.1002/ppj2.20004" target=_blank>ImageBreed</a>.', buttons_html => $buttons_html, icon_class => undef, col1_width_class => "col-sm-0", col2_width_class => "col-sm-12", info_section_id => "manage_drone_imagery_main" &>

</div>

<& /breeders_toolbox/drone_imagery/drone_imagery_analytics.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_analysis.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_export_imaging_events.mas &>
<& /analyses/store_new_analysis_values_and_model.mas &>

<div id="manage_drone_imagery_standard_process_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: executar processamento padrão em ortofotomosaicos" &>

    <&| /util/workflow.mas, id=> "manage_drone_imagery_standard_process_workflow" &>
        <&| /util/workflow.mas:step, title=> "Introdução" &>
            <& /page/page_title.mas, title=>"Este fluxo orientará a aplicação de um processamento padrão às bandas de imagens aéreas" &>
            <p>Aqui, uma das bandas enviadas será processada até o salvamento das imagens das parcelas. O processo inclui etapas manuais, como rotação, recorte e criação do modelo de polígonos. Depois de concluir uma banda, as mesmas etapas poderão ser aplicadas às demais bandas do evento e aos índices de vegetação calculados.</p>
            <br/><br/>
            <center>
            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "Banda do evento de imageamento" &>
            <& /page/page_title.mas, title=>"Selecione uma banda do evento de imageamento" &>

            <div class="well well-sm">
                <p>Selecione uma banda do evento de imageamento para processar. Recomenda-se uma banda de alto contraste, como NIR.</p>
            </div>

            <div class="well well-sm">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <table class="table table-bordered table-hover" id="manage_drone_imagery_standard_process_drone_run_bands_table">
                            <thead>
                                <tr>
                                    <th>Selecionar</th>
                                    <th>Nome da banda do evento de imageamento</th>
                                    <th>Descrição da banda</th>
                                    <th>Tipo da banda</th>
                                    <th>Nome do evento de imageamento</th>
                                    <th>Descrição do evento de imageamento</th>
                                    <th>Data do evento de imageamento</th>
                                    <th>Nome do ensaio de campo</th>
                                    <th>Descrição do ensaio de campo</th>
                                </tr>
                            </thead>
                        </table>

                        <br/>

                        <center>
                        <button class="btn btn-primary" id="manage_drone_imagery_standard_process_drone_run_band_step">Ir para a próxima etapa</button>
                        </center>
                    </div>
                </div>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "Usar GCPs" &>
            <& /page/page_title.mas, title=>"Use pontos de controle em solo (GCPs) para automatizar todo o processamento padrão" &>

            <div class="well well-sm">
                <p>Se um evento anterior deste ensaio já concluiu o processamento padrão, ele pode ser usado para automatizar o restante do processamento do novo evento.</p>
                <p>Se pontos de controle em solo (GCPs) foram definidos no evento anterior, eles podem automatizar o processamento padrão do novo evento.</p>
            </div>

            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Algum evento de imageamento anterior deste ensaio já concluiu o processamento padrão? </label>
                    <div class="col-sm-6">
                        <select class="form-control" id="manage_drone_imagery_standard_process_ground_control_points_option">
                            <option value="No">Não</option>
                            <option value="Yes">Sim, e possui GCPs definidos.</option>
                            <option value="Yes_camera_rig">Sim, e foi usada a mesma estrutura de câmera fixa.</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="manage_drone_imagery_standard_process_ground_control_points_select_div" style="display:none">
                <div class="well well-sm">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Selecione o evento de imageamento aéreo que será usado como modelo: </label>
                                <div class="col-sm-6">
                                    <div id="manage_drone_imagery_standard_process_ground_control_points_select"></div>
                                </div>
                            </div>
                            <br/><br/>
                            <hr>

                            <div class="well well-sm">
                                <ul>
                                    <li>Clique nos pontos de controle em solo (GCPs) na imagem abaixo e salve-os.</li>
                                    <li>Clique e salve pelo menos três pontos. Os nomes dos GCPs DEVEM ser consistentes entre os eventos!</li>
                                    <li>Para melhores resultados, use pontos de controle nos quatro cantos mais distantes do campo.</li>
                                    <li>Você pode reduzir o zoom do navegador (Ctrl + -).</li>
                                </ul>
                            </div>

                            <div class="well well-sm">
                                <div id="project_drone_imagery_standard_process_ground_control_points_saved_div"></div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_step">Desenhar polígonos calculados das parcelas</button>
                                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_step_confirm">Confirmar e salvar</button>
                                </center>
                            </div>

                            <div id="project_drone_imagery_standard_process_ground_control_points_info_div"></div>

                            <div id="project_drone_imagery_standard_process_ground_control_points_loading_div"><img src="/img/wheel.gif" /></div>

                            <canvas id="project_drone_imagery_standard_process_ground_control_points_canvas_div"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div id="manage_drone_imagery_standard_process_previous_camera_rig_select_div" style="display:none">
                <div class="well well-sm">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Selecione o evento de imageamento aéreo que será usado como modelo. Serão aplicados a mesma rotação, o mesmo recorte e o mesmo modelo de polígonos: </label>
                                <div class="col-sm-6">
                                    <div id="manage_drone_imagery_standard_process_previous_camera_rig_select"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <center>
                    <button class="btn btn-primary" id="manage_drone_imagery_standard_process_previous_camera_rig_step_confirm">Confirmar e salvar</button>
                    </center>
                </div>
            </div>
            <div id="manage_drone_imagery_standard_process_ground_control_points_skip_div" style="display:none">
                <center>
                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_skip_step">Pular e ir para a próxima etapa</button>
                </center>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "Rotacionar" &>
            <& /page/page_title.mas, title=>"Rotacione a banda selecionada do evento de imageamento" &>

            <div class="well well-sm">
                <ul>
                    <li>Aqui você pode rotacionar a imagem do evento.</li>
                    <li>Você pode reduzir o zoom do navegador (Ctrl + -).</li>
                    <li>A imagem deve ter um alinhamento paralelo preciso entre as linhas.</li>
                </ul>
            </div>

            <div class="well well-sm">

                <form class="form-horizontal">
                    <div class="form-group form-group-sm">
                        <label class="col-sm-6 control-label">Rotação em graus no sentido anti-horário (use as setas esquerda e direita para ajuste fino): </label>
                        <div class="col-sm-6">
                            <input type="range" min="-180" max="180" step="0.01" id="drone_imagery_standard_process_rotate_degrees_input" name="drone_imagery_standard_process_rotate_degrees_input" value="0.00"><div id="drone_imagery_standard_process_rotate_degrees_input_text"></div>
                        </div>
                    </div>
                </form>

                <!--button class="btn btn-primary" id="drone_imagery_standard_process_rotate_stitched_view">Rotacionar imagem (não salva)</button-->
                <button class="btn btn-default" id="drone_imagery_standard_process_rotate_stitched_crosshairs">Desenhar linhas-guia</button>
                <!--button class="btn btn-default" id="drone_imagery_standard_process_rotate_stitched_restart">Reiniciar</button-->
                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_rotate_step">Salvar imagem rotacionada e avançar</button>
            </div>

            <div id="manage_drone_imagery_standard_process_rotate_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <div id="drone_imagery_standard_process_rotate_original_stitched_div"></div>

        </&>
        <&| /util/workflow.mas:step, title=> "Recorte" &>
            <& /page/page_title.mas, title=>"Recorte a banda do evento para uma área de interesse específica" &>

            <div class="well well-sm">
                <ul>
                    <li>Aqui você pode fazer um recorte aproximado do ortofoto unido para manter apenas o ensaio de campo.</li>
                    <li>Você pode reduzir o zoom do navegador (Ctrl + -).</li>
                    <li>Clique em quatro pontos da imagem para criar um polígono de quatro lados.</li>
                    <li>Somente o último polígono desenhado será usado no recorte.</li>
                </ul>
                <br/>
                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_cropping_step">Salvar e ir para a próxima etapa</button>
            </div>

            <div id="manage_drone_imagery_standard_process_crop_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <canvas id="drone_imagery_standard_process_crop_original_stitched_div"></canvas>

            <hr>
            <div class="well well-sm">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Recortes de imagem usados anteriormente neste ensaio: </label>
                                <div class="col-sm-6">
                                    <div id="plot_polygons_standard_process_previously_saved_image_cropping_templates">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <button class="btn btn-primary" id="drone_imagery_standard_process_cropping_use_previous_cropping">Usar recorte de imagem</button>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "Limiarização" &>
            <& /page/page_title.mas, title=>"Aplique um limiar à banda do evento para remover o fundo" &>

            <div class="well">
                <&| /page/info_section.mas, title => 'Remover o fundo usando limiar percentual', collapsible=>1, collapsed => 0, subtitle=> 'Remova o fundo informando os valores percentuais do limiar.' &>
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-6 control-label">Descartar o percentual mais baixo dos valores de pixels: </label>
                                        <div class="col-sm-6">
                                            <input class="form-control" id="drone_imagery_standard_process_remove_background_lower_threshold_percentage" name="drone_imagery_standard_process_remove_background_lower_threshold_percentage" type="number" max="99" min="0" placeholder="ex.: 10% dos menores valores (mín. 0, máx. 100)" value=25 disabled/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-6 control-label">Descartar o percentual mais alto dos valores de pixels: </label>
                                        <div class="col-sm-6">
                                            <input class="form-control" id="drone_imagery_standard_process_remove_background_upper_threshold_percentage" name="drone_imagery_standard_process_remove_background_upper_threshold_percentage" type="number" max="99" min="0" placeholder="ex.: 10% dos maiores valores (mín. 0, máx. 100)" value=25 disabled/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </&>
            </div>

            <center>
                <button id="drone_imagery_standard_process_remove_background_defined_percentage_submit" class="btn btn-primary">Aplicar limiar</button>
            </center>

            <hr>

            <div id="manage_drone_imagery_standard_process_remove_background_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <div class="well well-sm">
                <&| /page/info_section.mas, title => 'Histograma dos valores de pixels', collapsible=>1, collapsed => 0, subtitle=> 'Histograma dos valores de pixels' &>
                    <center>
                        <canvas id="drone_imagery_standard_process_remove_background_histogram_div"></canvas>
                    </center>
                </&>
            </div>

            <div class="well well-sm">
                <&| /page/info_section.mas, title => 'Imagem original sem ruído', collapsible=>1, collapsed => 0, subtitle=> 'Imagem original sem ruído' &>
                    <center>
                        <canvas id="drone_imagery_standard_process_remove_background_original"></canvas>
                    </center>
                </&>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "Polígonos das parcelas" &>
            <& /page/page_title.mas, title=>"Defina os polígonos das parcelas em relação ao arranjo de campo" &>

            <& /page/detail_page_2_col_section.mas, info_section_collapsible=>1, info_section_collapsed=>0, info_section_title => "<h4 style='display:inline'>Ferramenta para gerar modelo de polígonos</h4>", info_section_subtitle => 'Sobreponha uma grade uniforme à imagem.', icon_class => "glyphicon glyphicon-th-large", info_section_id => "manage_drone_imagery_standard_process_generate_plot_polygons_section" &>

            <div class="well well-sm">
                <div id="drone_imagery_standard_process_plot_polygons_top_section"></div>

                <button id="drone_imagery_standard_process_plot_polygons_clear" class="btn btn-danger">Limpar todos os polígonos</button>
                <button id="drone_imagery_standard_process_plot_polygons_clear_one" class="btn btn-danger">Limpar um polígono</button>
                <button id="drone_imagery_standard_process_plot_polygons_get_distance" class="btn btn-default">Medir distância entre pontos</button>
                <button id="drone_imagery_standard_process_plot_polygons_switch_image_url" class="btn btn-default">Alternar entre a imagem original e a imagem sem fundo</button>
            </div>

            <div id="manage_drone_imagery_standard_process_plot_polygons_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <canvas id="drone_imagery_standard_process_plot_polygons_original_stitched_div"></canvas>

            <hr>
            <div class="well well-sm">
                <h2>Ou atribua manualmente os números das parcelas aos polígonos gerados</h2>

                <&| /page/info_section.mas, title => 'Atribuir manualmente números de parcelas aos números dos polígonos', collapsible=>1, collapsed => 1, subtitle=> 'Tabela para atribuição manual dos números das parcelas.' &>
                    <div id="drone_imagery_standard_process_generated_polygons_table"></div>
                </&>
            </div>

            <div id="drone_imagery_standard_process_generated_polygons_div"></div>

            <hr>
            <div class="well well-sm">
                <div id="drone_imagery_standard_process_trial_layout_div"></div>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "Aplicar" &>
            <& /page/page_title.mas, title=>"Aplique as mesmas etapas às outras bandas do evento de imageamento atual" &>

            <div class="well well-sm">
                <ul>
                    <li>Aqui você pode aplicar às outras bandas deste evento as mesmas ações realizadas nas etapas 1 a 6.</li>
                    <li>O limiar será calculado dinamicamente, removendo os 20% maiores e os 20% menores valores de pixels.</li>
                </ul>
            </div>

            <div class="well well-sm">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <table class="table table-bordered table-hover" id="manage_drone_imagery_standard_process_drone_run_bands_apply_table">
                            <thead>
                                <tr>
                                    <th>Selecionar</th>
                                    <th>Nome da banda do evento de imageamento</th>
                                    <th>Descrição da banda</th>
                                    <th>Tipo da banda</th>
                                    <th>Nome do evento de imageamento</th>
                                    <th>Descrição do evento de imageamento</th>
                                    <th>Data do evento de imageamento</th>
                                    <th>Nome do ensaio de campo</th>
                                    <th>Descrição do ensaio de campo</th>
                                </tr>
                            </thead>
                        </table>

                        <br/>

                        <center>
                        <button class="btn btn-primary" id="manage_drone_imagery_standard_process_drone_run_band_apply_step">Ir para a próxima etapa</button>
                        </center>
                    </div>
                </div>
            </div>
        </&>
        <&| /util/workflow.mas:step, title=> "Índices" &>
            <& /page/page_title.mas, title=>"Crie e aplique as mesmas etapas aos índices de vegetação" &>

            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Índices de vegetação a aplicar: </label>
                    <div class="col-sm-6">
                        <input name="drone_imagery_standard_process_apply_indices_select" value="TGI" type="checkbox" checked> Índice triangular de verdor (TGI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="VARI" type="checkbox" checked> Índice visível resistente à atmosfera (VARI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="NDVI" type="checkbox" checked> Índice de vegetação por diferença normalizada (NDVI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="NDRE" type="checkbox" checked> Índice de vegetação por diferença normalizada da borda vermelha (NDRE) <br/>
                    </div>
                </div>
            </form>

            <br/>

            <center>
            <button type="button" class="btn btn-primary" id="manage_drone_imagery_standard_process_indices_step">Ir para a próxima etapa</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "Fenótipos" &>
            <& /page/page_title.mas, title=>"Calcule os fenótipos de todas as imagens dos polígonos das parcelas" &>

            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Estatísticas zonais a calcular e salvar no banco de dados: </label>
                    <div class="col-sm-6">
                        <input name="drone_imagery_standard_process_phenotypes_select" value="zonal" type="checkbox" checked disabled> Estatísticas zonais: contagem de pixels não zero, soma total, média, média harmônica, mediana, variância, desvio-padrão, desvio-padrão populacional, mínimo, máximo, valor e contagem minoritários, valor e contagem majoritários e variedade de pixels <br/>
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Aplicar o mesmo processamento padrão a todos os eventos enviados que usam a mesma estrutura de câmera: </label>
                    <div class="col-sm-6">
                        <select class="form-control" id="drone_imagery_standard_process_camera_rig_apply_select">
                            <option value="No">Não</option>
                            <option value="Yes">Sim</option>
                        </select>
                    </div>
                </div>
            </form>
            <br/>

            <div id="drone_imagery_standard_process_week_term_div"></div>

            <center>
            <button type="button" class="btn btn-info" id="manage_drone_imagery_standard_process_phenotypes_step">Concluir</button>
            </center>
        </&>
    </&>

</div>

<& /breeders_toolbox/drone_imagery/standard_process_raw_images.mas &>

<div id="project_drone_imagery_ground_control_points_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: salvar pontos de controle em solo" &>

    <div id="project_drone_imagery_ground_control_points_title_div"></div>

    <div class="well well-sm">
        <ul>
            <li>Clique nos pontos de controle em solo (GCPs) na imagem abaixo e salve-os.</li>
            <li>Clique e salve pelo menos três pontos. Os nomes dos GCPs DEVEM ser consistentes entre os eventos!</li>
            <li>Você pode alternar entre as imagens disponíveis após a conclusão do processamento padrão (ex.: azul, verde, vermelho, NIR e BGR).</li>
            <li>Você pode reduzir o zoom do navegador (Ctrl + -).</li>
        </ul>
    </div>

    <div id="project_drone_imagery_ground_control_points_next_buttons" style="display:none">
        <button class="btn btn-default" id="project_drone_imagery_ground_control_points_previous_image">Ver tipo de imagem anterior</button>
        <button class="btn btn-default" id="project_drone_imagery_ground_control_points_next_image">Ver próximo tipo de imagem</button>
        <br/><br/>
    </div>

    <div class="well well-sm">
        <div id="project_drone_imagery_ground_control_points_saved_div"></div>
    </div>

    <div id="project_drone_imagery_ground_control_points_image_type_div"></div>
    <div id="project_drone_imagery_ground_control_points_info_div"></div>

    <div id="project_drone_imagery_ground_control_points_loading_div"><img src="/img/wheel.gif" /></div>

    <canvas id="project_drone_imagery_ground_control_points_canvas_div"></canvas>

</div>

<div class="modal fade" id="project_drone_imagery_ground_control_points_form_dialog" name="project_drone_imagery_ground_control_points_form_dialog" tabindex="-1" role="dialog" aria-labelledby="saveGroundControlPointsDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="saveGroundControlPointsDialog">Salvar pontos de controle em solo</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Nome do ponto de controle em solo (pode sobrescrever outro com o mesmo nome; os nomes DEVEM ser consistentes entre os eventos): </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_name" name="project_drone_imagery_ground_control_points_form_input_name" type="text" placeholder="ex.: canto noroeste ou ponto 1" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Latitude (opcional): </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_latitude" name="project_drone_imagery_ground_control_points_form_input_latitude" type="text" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Longitude (opcional): </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_longitude" name="project_drone_imagery_ground_control_points_form_input_longitude" type="text" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Posição X: </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_x_pos" name="project_drone_imagery_ground_control_points_form_input_x_pos" type="text" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Posição Y: </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_y_pos" name="project_drone_imagery_ground_control_points_form_input_y_pos" type="text" />
                    </div>
                </div>
            </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="project_drone_imagery_ground_control_points_form_save">Salvar GCP</button>
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<div id="manage_drone_imagery_standard_process_raw_images_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: executar processamento padrão nas imagens brutas" &>

    <&| /util/workflow.mas, id=> "manage_drone_imagery_standard_process_raw_images_workflow" &>
        <&| /util/workflow.mas:step, title=> "Introdução" &>
            <& /page/page_title.mas, title=>"Este fluxo orientará a aplicação de um processamento padrão às bandas de imagens aéreas" &>

            <div class="well well-sm">
                <p>Este processo permitirá atribuir manualmente polígonos de parcelas às imagens brutas.</p>
            </div>

            <br/><br/>
            <center>
            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "Polígonos das parcelas" &>
            <& /page/page_title.mas, title=>"Atribua manualmente polígonos de parcelas às imagens brutas" &>

            <div class="well well-sm">
                <ul>
                    <li>(1) Selecione uma imagem na grade abaixo e ajuste a rotação.</li>
                    <li>(2) Clique nos quatro cantos que delimitam um grupo de parcelas de interesse ou cole um modelo usado anteriormente.</li>
                    <li>(3) Digite na tabela os números das parcelas correspondentes aos polígonos desenhados.</li>
                    <li>(4) Clique em atribuir polígonos para salvar. Repita as etapas 1 a 4 até que todas as parcelas tenham uma imagem atribuída.</li>
                </ul>
            </div>

            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-2 control-label">Clique na pilha de imagens brutas: </label>
                    <div class="col-sm-10">
                        <div id="drone_imagery_standard_process_raw_images_image_id_select_div"></div>
                    </div>
                </div>
            </div>
            <hr>

            <canvas id="drone_imagery_standard_process_raw_images_show"></canvas>
            <canvas id="drone_imagery_standard_process_raw_images_show_another_image"></canvas>
            <canvas id="drone_imagery_standard_process_raw_images_show_another_image_second"></canvas>

            <hr>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_in_place" onclick="return false;">Colar polígono usado anteriormente</button>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_view_image" onclick="return false;">Ver também outra imagem</button>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_view_image_second" onclick="return false;">Ver também outra imagem</button>

            <hr>
            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Rotação em graus no sentido anti-horário: </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="drone_imagery_standard_process_raw_images_rotate_degrees_input" name="drone_imagery_standard_process_raw_images_rotate_degrees_input" type="text" placeholder="Número de graus para rotacionar" value="0.00"/>
                    </div>
                </div>
            </form>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_rotate_image" onclick="return false;">Rotacionar imagem</button>
            <hr>

            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Modelos Mask R-CNN treinados: </label>
                    <div class="col-sm-6">
                        <div id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_models_div"></div>
                    </div>
                </div>
            </form>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_predict_button" onclick="return false;">Predizer máscara</button>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_modal_button" onclick="return false;">Retreinar Mask R-CNN</button>
            <hr>

            <hr>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_save_polygon" onclick="return false;">Salvar polígono da parcela</button>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_paste_polygon" onclick="return false;">Colar polígono da parcela</button>
            <button class="btn btn-danger btn-sm" id="drone_imagery_standard_process_raw_images_clear_polygon" onclick="return false;">Reiniciar</button>
            <hr>

            <hr>
            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Polígonos usados anteriormente: </label>
                    <div class="col-sm-6">
                        <div id="drone_imagery_standard_process_raw_images_previous_polygons_div"></div>
                    </div>
                </div>
            </form>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon" onclick="return false;">Colar polígono usado anteriormente em um novo ponto</button>
            <hr>

            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-3 control-label">Número de linhas: </label>
                    <div class="col-sm-9">
                        <input type="number" class="form-control" id="drone_imagery_standard_process_raw_images_number_rows" name="drone_imagery_standard_process_raw_images_number_rows" placeholder="0"/>
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-3 control-label">Número de colunas: </label>
                    <div class="col-sm-9">
                        <input type="number" class="form-control" id="drone_imagery_standard_process_raw_images_number_columns" name="drone_imagery_standard_process_raw_images_number_columns" placeholder="0"/>
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-3 control-label">Nome do modelo: </label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="drone_imagery_standard_process_raw_images_partial_template_name" name="drone_imagery_standard_process_raw_images_partial_template_name" placeholder="ex.: 3ª faixa 2x4"/>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_draw_polygons" onclick="return false;">Desenhar polígono da parcela (não salva)</button>
            <hr>

            <div id="drone_imagery_standard_process_raw_images_polygon_assign_table" name="drone_imagery_standard_process_raw_images_polygon_assign_table"></div>

            <br/><br/>
            <center>
            <button class="btn btn-primary" id="drone_imagery_standard_process_raw_images_assign_plot" onclick="return false;">Atribuir imagens às parcelas (salva)</button>
            </center>

            <hr>
            <div id="drone_imagery_standard_process_raw_images_assigned_plot_images" name="drone_imagery_standard_process_raw_images_assigned_plot_images"></div>
        </&>
    </&>

</div>

<div id="manage_drone_imagery_rotate_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: rotacionar imagem unida" &>

    <div class="well well-sm">
        <ul>
            <li>Aqui você pode rotacionar a imagem unida para alinhar exatamente as linhas e colunas nos sentidos vertical e horizontal.</li>
            <li>A rotação pode usar frações de grau.</li>
            <li>Valores negativos indicam o sentido horário; valores positivos, o anti-horário.</li>
            <li>As linhas-guia servem apenas para auxiliar no alinhamento e não serão salvas.</li>
        </ul>
    </div>
    <div class="well well-sm">

        <form class="form-horizontal">
            <div class="form-group form-group-sm">
                <label class="col-sm-6 control-label">Rotação em graus no sentido anti-horário: </label>
                <div class="col-sm-6">
                    <input class="form-control" id="drone_imagery_rotate_degrees_input" name="drone_imagery_rotate_degrees_input" type="text" placeholder="Número de graus para rotacionar" value="0.00"/>
                </div>
            </div>
        </form>

        <button class="btn btn-primary" id="drone_imagery_rotate_stitched_view">Rotacionar imagem (não salva)</button>
        <button class="btn btn-default" id="drone_imagery_rotate_stitched_crosshairs">Desenhar linhas-guia</button>
        <button class="btn btn-default" id="drone_imagery_rotate_stitched_restart">Reiniciar</button>
        <button class="btn btn-primary" id="drone_imagery_rotate_stitched_submit">Salvar imagem rotacionada</button>
    </div>

    <div id="manage_drone_imagery_rotate_load_div">
        <img src="/img/wheel.gif" />
    </div>

    <canvas id="drone_imagery_rotate_original_stitched_div">
    </canvas>
</div>

<div id="manage_drone_imagery_crop_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: recortar imagem unida para o ensaio de campo" &>

    <div class="well well-sm">
        <ul>
            <li>Aqui você pode fazer um recorte aproximado do ortofoto unido para manter apenas o ensaio de campo.</li>
            <li>Você pode reduzir o zoom do navegador (Ctrl + -).</li>
            <li>Clique em quatro pontos da imagem para criar um polígono de quatro lados.</li>
            <li>Somente o último polígono desenhado será usado no recorte.</li>
        </ul>
        <br/>
        <button class="btn btn-primary" id="drone_imagery_crop_stitched_submit">Recortar a imagem para o polígono selecionado</button>
    </div>

    <div class="well well-sm">
        <form class="form-horizontal">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group form-group-sm">
                        <label class="col-sm-6 control-label">Recortes de imagem usados anteriormente neste ensaio: </label>
                        <div class="col-sm-6">
                            <div id="plot_polygons_previously_saved_image_cropping_templates">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <button class="btn btn-primary" id="drone_imagery_cropping_use_previous_cropping">Usar recorte de imagem</button>
    </div>

    <div id="manage_drone_imagery_crop_load_div">
        <img src="/img/wheel.gif" />
    </div>

    <canvas id="drone_imagery_crop_original_stitched_div"></canvas>
</div>

<div id="manage_drone_imagery_vegetative_index_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: converter em índice de vegetação" &>

    <div class="well well-sm">
        <ul>
            <li>Aqui você pode converter a imagem em um índice de vegetação.</li>
            <li>Se houver uma banda NIR, você poderá calcular o índice de vegetação por diferença normalizada (NDVI).</li>
            <li>Se houver uma imagem RGB, você poderá calcular o índice visível resistente à atmosfera (VARI) ou o índice triangular de verdor (TGI).</li>
            <li>Com imagens vermelhas, azuis, verdes ou de qualquer banda espectral, é possível calcular razões para usar como índice de vegetação.</li>
        </ul>
    </div>

    <hr>
    <div id="manage_drone_imagery_vegetative_index_tgi_bgr_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_TGI_bgr">Calcular o índice triangular de verdor TGI. TGI = {Banda verde 2} - 0.39*{Banda vermelha 3} - 0.61*{Banda azul 1}</button>
        <hr>
    </div>
    <div id="manage_drone_imagery_vegetative_index_vari_bgr_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_VARI_bgr">Calcular o índice visível resistente à atmosfera VARI. VARI = ({Banda verde 2} - {Banda vermelha 3}) / ({Banda verde 2} + {Banda vermelha 3} - {Banda azul 1})</button>
        <hr>
    </div>
    <div id="manage_drone_imagery_vegetative_index_tgi_rgb_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_TGI_rgb">Calcular o índice triangular de verdor TGI. TGI = {Banda verde 2} - 0.39*{Banda vermelha 1} - 0.61*{Banda azul 3}</button>
        <hr>
    </div>
    <div id="manage_drone_imagery_vegetative_index_vari_rgb_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_VARI_rgb">Calcular o índice visível resistente à atmosfera VARI. VARI = ({Banda verde 2} - {Banda vermelha 1}) / ({Banda verde 2} + {Banda vermelha 1} - {Banda azul 3})</button>
        <hr>
    </div>
    <div id="manage_drone_imagery_vegetative_index_ndvi_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_NDVI">Calcular o índice de vegetação por diferença normalizada NDVI. NDVI = ({Banda NIR 1} - {Banda vermelha 2}) / ({Banda NIR 1} + {Banda vermelha 2})</button>
        <hr>
    </div>
    <div id="manage_drone_imagery_vegetative_index_ndre_div" style="display:none">
        <button class="btn btn-primary" id="drone_imagery_vegetative_index_NDRE">Calcular o índice de diferença normalizada da borda vermelha NDRE. NDRE = ({Banda NIR 1} - {Banda de borda vermelha 2}) / ({Banda NIR 1} + {Banda de borda vermelha 2})</button>
        <hr>
    </div>

    <button class="btn btn-success" id="drone_imagery_rgb_vegetative_index_submit">Concluir e salvar índice de vegetação</button>
    <hr>

    <canvas id="drone_imagery_vegetative_index_original_stitched_div"></canvas>
</div>

<div id="manage_drone_imagery_remove_background_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: remover o fundo" &>

    <div class="well">
        <&| /page/info_section.mas, title => 'Remover o fundo usando limiar gráfico', collapsible=>1, collapsed => 1, subtitle=> 'Remova o fundo usando um valor de limiar simples' &>

            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="well well-sm">
                        <h5>O fundo pode ser removido aplicando um limiar aos valores dos pixels</h5>
                        <ul>
                            <li><b>1.</b> Clique nos dois picos mais altos à direita do histograma. O pico mais à direita representa os pixels de interesse; o pico imediatamente à esquerda representa o fundo do solo.</li>
                            <li><b>2.</b> Clique no botão “Encontrar mínimo”.</li>
                            <li><b>3.</b> Se a imagem estiver adequada com o limiar aplicado, clique em Salvar. Caso contrário, reinicie.</li>
                        </ul>
                    </div>

                    <div class="well well-sm">
                        <div name="drone_imagery_remove_background_threshold_current"></div>
                        <div name="drone_imagery_remove_background_threshold"></div>
                    </div>

                    <canvas id="drone_imagery_remove_background_histogram_div"></canvas>
                    <hr>
                    <button class="btn btn-primary" id="drone_imagery_remove_background_find_minimum">Encontrar mínimo (não salva)</button>
                    <button class="btn btn-default" id="drone_imagery_remove_background_start_over">Reiniciar</button>
                    <button class="btn btn-primary" id="drone_imagery_remove_background_submit">Salvar</button>
                    <hr>
                </div>
            </div>
        </&>
    </div>
    <div class="well">
        <&| /page/info_section.mas, title => 'Remover o fundo usando limiar definido pelo usuário', collapsible=>1, collapsed => 1, subtitle=> 'Remova o fundo usando um valor de limiar simples' &>
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Descartar pixels com valor inferior a: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_remove_background_lower_threshold" name="drone_imagery_remove_background_lower_threshold" type="number" max="255" min="0" placeholder="ex.: 10 (mín. 0)" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Descartar pixels com valor superior a: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_remove_background_upper_threshold" name="drone_imagery_remove_background_upper_threshold" type="number" max="255" min="0" placeholder="ex.: 200 (máx. 255)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button id="drone_imagery_remove_background_defined_submit" class="btn btn-primary">Aplicar limiar</button>
                </div>
            </div>
        </&>
    </div>
    <div class="well">
        <&| /page/info_section.mas, title => 'Remover o fundo usando limiar percentual', collapsible=>1, collapsed => 1, subtitle=> 'Remova o fundo informando os valores percentuais do limiar' &>
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Descartar o percentual mais baixo dos valores de pixels: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_remove_background_lower_threshold_percentage" name="drone_imagery_remove_background_lower_threshold_percentage" type="number" max="99" min="0" placeholder="ex.: 10% dos menores valores (mín. 0, máx. 100)" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Descartar o percentual mais alto dos valores de pixels: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_remove_background_upper_threshold_percentage" name="drone_imagery_remove_background_upper_threshold_percentage" type="number" max="99" min="0" placeholder="ex.: 10% dos maiores valores (mín. 0, máx. 100)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button id="drone_imagery_remove_background_defined_percentage_submit" class="btn btn-primary">Aplicar limiar</button>
                </div>
            </div>
        </&>
    </div>

    <hr>

    <div id="manage_drone_imagery_remove_background_load_div">
        <img src="/img/wheel.gif" />
    </div>

    <canvas id="drone_imagery_remove_background_original"></canvas>
</div>

<div id="manage_drone_imagery_plot_polygons_div" style="display:none">

    <& /page/page_title.mas, title=>"Gerenciar imagens aéreas: definir polígonos das parcelas" &>

    <div id="manage_drone_imagery_plot_polygons_div_title"></div>

    <& /page/detail_page_2_col_section.mas, info_section_collapsible=>1, info_section_collapsed=>0, info_section_title => "<h4 style='display:inline'>Ferramenta para gerar modelo de polígonos</h4>", info_section_subtitle => 'Sobreponha uma grade uniforme à imagem.', icon_class => "glyphicon glyphicon-th-large", info_section_id => "manage_drone_imagery_generate_plot_polygons_section" &>

    <div class="well well-sm">
        <div id="drone_imagery_plot_polygons_top_section"></div>

        <button id="drone_imagery_plot_polygons_clear" class="btn btn-danger">Limpar todos os polígonos</button>
        <button id="drone_imagery_plot_polygons_clear_one" class="btn btn-danger">Remover um polígono</button>
