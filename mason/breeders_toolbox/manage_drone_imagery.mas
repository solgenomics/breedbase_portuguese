            }
        });

        jQuery('#drone_imagery_minimal_vi_standard_process_dialog').modal('show');
    });

    jQuery('#drone_imagery_minimal_vi_standard_process_select').click(function() {
        if (manage_drone_imagery_standard_process_minimal_vi_phenotype_time == '') {
            alert('O momento do fenótipo não foi definido para o processo mínimo de índices de vegetação. Isso não deveria acontecer; entre em contato conosco.');
            return false;
        }

        alert("O processo padrão mínimo de índices de vegetação ocorrerá em segundo plano. Atualize esta página para consultar o indicador.");

        jQuery.ajax({
            type: 'POST',
            url: '/api/drone_imagery/standard_process_minimal_vi_apply?drone_run_project_id='+manage_drone_imagery_standard_process_minimal_vi_drone_run_project_id,
            dataType: "json",
            success: function(response){
                console.log(response);
                if (response.error) {
                    alert(response.error);
                } else {
                    alert('Processo padrão mínimo de índices de vegetação concluído! A geração de fenótipos ainda poderá estar em andamento.');
                    location.reload();
                }
            },
            error: function(response){
                alert('Erro ao executar o processo padrão mínimo de índices de vegetação!');
            }
        });

        jQuery.ajax({
            type: 'GET',
            url: '/api/drone_imagery/generate_phenotypes?drone_run_project_id='+manage_drone_imagery_standard_process_minimal_vi_drone_run_project_id+'&time_cvterm_id='+manage_drone_imagery_standard_process_minimal_vi_phenotype_time+'&standard_process_type=minimal_vi',
            dataType: "json",
            success: function(response){
                console.log(response);
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert('Fenótipos das imagens aéreas armazenados para o processo padrão mínimo de índices de vegetação!');
                }
            },
            error: function(response){
                alert('Erro ao gerar os fenótipos das imagens aéreas para o processo padrão mínimo de índices de vegetação!');
            }
        });

        location.reload();
    });

