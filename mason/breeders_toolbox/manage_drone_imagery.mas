                        <thead>
                            <tr>
                                <!--th>Select <br/><input type="checkbox" id="drone_image_train_keras_plot_polygon_image_type_table_select_all" checked>Selecionar todos</th-->
                                <th>Selecionar</th>
                                <th>Ensaio de campo</th>
                                <th>Nome do evento de imageamento</th>
                                <th>Nome da banda do evento de imageamento</th>
                                <th>Tipo da banda do evento de imageamento</th>
                                <th>Tipo de polígono da parcela</th>
                                <th>Número de imagens</th>
                            </tr>
                        </thead>
                    </table>

                    <br/><br/>
                    <center>
                    <button class="btn btn-primary" id="drone_imagery_train_keras_model_plot_polygon_type_select_step">Ir para a próxima etapa</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Confirmar" &>
                    <& /page/page_title.mas, title=>"Treine o modelo!" &>

                    <br/><br/>
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Tipo de modelo: </label>
                            <div class="col-sm-8" >
                                <select class="form-control" id="drone_image_train_keras_model_type" name="drone_image_train_keras_model_type" >
                                    <option value="KerasCNNSequentialSoftmaxCategorical">Regressão linear Keras CNN Sequential 16-32-64-128-512</option>
                                    <option value="KerasCNNMLPExample">Exemplo de Keras CNN e MLP</option>
                                    <option value="SimpleKerasTunerCNNSequentialSoftmaxCategorical">Regressão linear Simple Keras Tuner CNN Sequential 16-32-64-128-512</option>
                                    <option value="KerasTunerCNNSequentialSoftmaxCategorical">Regressão linear Keras Tuner CNN Sequential 16-32-64-128-512</option>
                                    <option value="KerasCNNInceptionResNetV2">Regressão linear Keras CNN InceptionResNetV2</option>
                                    <option value="KerasCNNLSTMDenseNet121ImageNetWeights">Regressão linear Keras LSTM DenseNet121 com pesos ImageNet</option>
                                    <option value="KerasCNNInceptionResNetV2ImageNetWeights">Regressão linear Keras CNN InceptionResNetV2 pré-treinada com pesos ImageNet</option>
                                    <option value="KerasCNNDenseNet121ImageNetWeights">Regressão linear Keras DenseNet121 com pesos ImageNet</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Nome do modelo: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="drone_image_train_keras_model_name" name="drone_image_train_keras_model_name" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Descrição do modelo: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="drone_image_train_keras_model_desc" name="drone_image_train_keras_model_desc" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Protocolo de genotipagem para a GRM: </label>
                            <div class="col-sm-8" >
                                <div id="drone_image_train_keras_model_genotyping_protocol_div"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Usar os parentais dos acessos para híbrido in silico: </label>
                            <div class="col-sm-8" >
                                <select class="form-control" id="drone_image_train_keras_model_use_parents_grm" name="drone_image_train_keras_model_use_parents_grm" >
                                    <option value="yes">Sim, GRM dos parentais dos acessos, se genotipados</option>
                                    <option value="no">Não, GRM dos acessos, se genotipados</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <br/><br/>
                    <center>
                    <button class="btn btn-primary" id="drone_imagery_train_keras_model_confirm_step">Treinar e salvar modelo CNN do Keras</button>
                    </center>

                    <div id="drone_imagery_train_keras_model_results_div">
                    </div>
                </&>
            </&>

        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

