      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <&| /page/info_section.mas, title => 'Copiar/colar modelo', collapsible=>1, collapsed => 0, subtitle=> 'Copie e cole este modelo sobre a imagem.' &>
                <button class="btn btn-primary" id="drone_imagery_plot_polygon_template_options_paste_click">Clique para colar</button>
            </&>
