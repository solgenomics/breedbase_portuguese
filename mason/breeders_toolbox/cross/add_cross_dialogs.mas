                                        <input class="form-control" id="doubled_haploid_parent" type="text" name="doubled haploid" placeholder="Informe o nome do genitor" />
                                    </div><br/><br/>
                                </div>
                                <div class="form-group" id="get_dihaploid_induction_parent" style="display: none">
                                    <label class="col-sm-2 control-label">Genitor da indução di-haploide: </label>
