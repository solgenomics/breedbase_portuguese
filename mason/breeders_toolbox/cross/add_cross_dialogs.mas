                                        <div id="maternal_accession_list"></div>
                                    </div><br/><br/>
                                </div>
                                <div class="form-group" id="paternal_accessions" style="display: none">
                                    <label class="col-sm-2 control-label">Genitores masculinos do multicruzamento: </label>
                                    <div class="col-sm-10">
                                        <div id="paternal_accession_list"></div>
                                    </div><br/><br/>
                                </div>
                                <div class="form-group" id="exact_parents" style="display: none">
                                    <& /page/page_title.mas, title=>"Opcional: registre os genitores exatos do cruzamento" &>

                                    <div class="form-group">
