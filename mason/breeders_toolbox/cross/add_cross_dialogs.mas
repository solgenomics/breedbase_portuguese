                                                <div class ="input-group-btn">
                                                    <button class = "btn btn-info" id="search_parents_plots_plants" name="search_plots_plants"></i>Pesquisar parcelas/plantas</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Parcela/planta feminina: </label>
                                        <div class="col-sm-10">
                                            <select class="form-control" id="female_plot_plant" name="female_plot_plant">
                                                <option value="">Informe primeiro o nome do ensaio</option>
                                            </select>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Parcela/planta masculina: </label>
                                        <div class="col-sm-10">
                                            <select class="form-control" id="male_plot_plant" name="male_plot_plant">
                                                <option value="">Informe primeiro o nome do ensaio</option>
                                            </select>
                                        </div>
                                    </div><br/><br/>
                                </div>
                                <div class="form-group" id="exact_female" style="display: none">
                                    <& /page/page_title.mas, title=>"Opcional: registre o genitor feminino exato do cruzamento" &>

                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Ensaio de campo: </label>
                                        <div class="col-sm-10">
                                            <div class="input-group">
                                                <input type ="text" class ="form-control" id="female_field_trial" name ="female_field_trial" placeholder="Informe o nome do ensaio">
                                                <div class ="input-group-btn">
                                                    <button class = "btn btn-info" id="search_female_plots_plants" name="search_plots_plants"></i>Pesquisar parcelas/plantas</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Parcela/planta feminina: </label>
                                        <div class="col-sm-10">
                                            <select class="form-control" id="open_female_plot_plant" name="open_female_plot_plant">
                                                <option value="">Informe primeiro o nome do ensaio</option>
                                            </select>
                                        </div>
                                    </div><br/><br/>
                                </div>
                                <br>
                                <center>
                                    <button id="next_step_basic_information" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Informações adicionais" &>
                                <& /page/page_title.mas, title=>"Adicione aqui nomes de progênies gerados automaticamente para este cruzamento" &>
                                <h3>Opcional:</h3>
                                <table>
