<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$planting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
</%args>


<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome do experimento de cruzamento</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[Sem nome do experimento de cruzamento]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Programa de melhoramento</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
%  print "$breeding_program_name";
% }
% else {
%  print "<span class='text-danger'>[Sem programa de melhoramento]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>Local</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name ($country_name)";
% } else {
%  print "<span class='text-danger'>[Sem local]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Ano</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[Sem ano]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Data de plantio</b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $planting_date %>" ><% $planting_date %></a>
% } else {
%  print "<span class='text-danger'>[Sem data de plantio]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Data de colheita</b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $harvest_date %>" ><% $harvest_date %></a>
% } else {
%  print "<span class='text-danger'>[Sem data de colheita]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Descrição</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[Sem descrição]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Massa</b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link">Massa Nova</button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link">Alterar pasta</button>
                </td>
            </tr>

            <tr>
                <td><b>Criado por</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[N/A]</span>";
% }
                    </div>
                </td>
            </tr>
        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_new_crosses_link">Enviar novos cruzamentos</button><a href="/breeders/trial/<% $trial_id %>/download/crosses?format=crossing_experiment_xls&dataLevel=cross" class="btn btn-sm btn-default">Baixar cruzamentos deste experimento</a>
