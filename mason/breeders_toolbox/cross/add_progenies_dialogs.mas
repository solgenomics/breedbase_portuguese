                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_progenies_new_submit" id="upload_progenies_new_submit">Enviar arquivo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_progenies_new_spreadsheet_info_dialog" name="upload_progenies_new_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadProgeniesInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadProgeniesNewInfoDialog">Informações do modelo</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        As progênies de cruzamentos existentes podem ser enviadas em um arquivo do Excel (.xls ou .xlsx)
                    </b>
                    <br><br>
                    <b>
                        Cabeçalho:
                    </b>
                    <br>
                        A primeira linha (cabeçalho) deve conter o seguinte:
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>cross_unique_id</td>
                                <td>progeny_name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        Colunas obrigatórias:
                    </b>
                    <br>
                        <b>-cross_unique_id</b> (deve existir no banco de dados)
                    <br>
                        <b>-progeny_name</b> (os nomes dos acessos NÃO podem existir no banco de dados; informe apenas uma progênie por linha e adicione novas linhas para incluir mais progênies)
                    <br>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

