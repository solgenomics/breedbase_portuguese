<%args>

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<a href="/search/download_cross_entries" class="btn btn-sm btn-default">Baixar todos os registros de cruzamentos</a>
</br>
</br>
<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="all_cross_entries_table">
    </table>
</div>


<script>

jQuery(document).ready(function(){

    jQuery('#all_cross_entries_section_onswitch').click(function(){
        jQuery('#all_cross_entries_table').DataTable({
            'destroy': true,
            'ajax':'/ajax/search/all_cross_entries',
            columns: [
                { title: "ID exclusivo do cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: "Tipo de cruzamento", "data": "cross_type" },
                { title: "Parental feminino", "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.female_id+"/view'>"+row.female_name+"</a>"; } },
                { title: "Ploidia feminina", "data": "female_ploidy" },
                { title: "Estrutura do genoma feminino", "data": "female_genome_structure" },
                { title: "Parental masculino", "data": null, "render": function ( data, type, row ) {
                    if (row.male_parent_id === null){
                        return 'NA';
                    } else {
                        return "<a href='/stock/"+row.male_id+"/view'>"+row.male_name+"</a>";
                    }
                }},
                { title: "Ploidia masculina", "data": "male_ploidy" },
                { title: "Estrutura do genoma masculino", "data": "male_genome_structure" },
                { title: "Data de polinização", "data": "pollination_date" },
                { title: "Número de sementes", "data": "number_of_seeds" },
                { title: "Número de progênies", "data": "progeny_count" },
                { title: "Experimento de cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/trial/"+row.project_id+"'>"+row.project_name+"</a>"; } },
                { title: "Descrição", "data": "project_description" },
                { title: "Local", "data": "project_location" },
            ],
        });
    });

});

</script>
