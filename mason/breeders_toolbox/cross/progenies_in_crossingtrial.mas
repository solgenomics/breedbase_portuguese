<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"Enviar progênies ou nomes de famílias", is_subsection => 1, collapsible=>1, collapsed=>1, &>
                <&| /page/info_section.mas, title=>"Enviar nomes de progênies que NÃO estão no banco de dados", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_progenies_new_accessions_link">Enviar</button>'&>
                </&>
                <&| /page/info_section.mas, title=>"Enviar nomes de progênies que já EXISTEM no banco de dados", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_progenies_existing_accessions_link">Enviar</button>'&>
                </&>
                <&| /page/info_section.mas, title=>"Enviar nomes de famílias", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_family_names_link">Enviar</button>'&>
                </&>
            </&><!-- closes upload progenies and family names section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"Informações de progênies e famílias", is_subsection => 1, collapsible=>1, collapsed=>0 &>
                <table class="table table-hover table-bordered" id="progenies_in_crossingtrial_table">
                    <thead>
                        <tr>
                            <th>ID exclusivo do cruzamento</th>
                            <th>Combinação do cruzamento</th>
                            <th>Número de progênies</th>
                            <th>Nome da família</th>
                        </tr>
                    </thead>
                </table>
            </&><!-- closes progeny and family name info section -->
        </div>
    </div>
</div>

<& /breeders_toolbox/cross/add_progenies_dialogs.mas &>


<script>

jQuery(document).ready(function(){

    jQuery('#progenies_in_crossingtrial_section_onswitch').click(function(){
        jQuery('#progenies_in_crossingtrial_table').DataTable({
            'destroy': true,
            'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/cross_progenies_trial',
        });
    });

});

</script>
