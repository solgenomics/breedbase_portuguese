<%args>

$breeding_program_name
$breeding_program_id
$locations_by_program_json

</%args>

<div class="modal fade" id="upload_cross_seedlot_dialog" name="upload_cross_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog">Enviar lotes de sementes</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"O que são lotes de sementes?" &>
                            <ul>
                                <li>Um lote de sementes é um conjunto de sementes colhidas de um cruzamento, acesso, parcela ou planta.</li>
                                <li>Os lotes podem ter local, caixa, peso (g) e quantidade específicos.</li>
                                <li>Os lotes podem pertencer a programas de melhoramento e organizações.</li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "Formato do arquivo" &>
                        <& /page/page_title.mas, title=>"Verifique se o arquivo está no formato correto" &>
                            <br/><br/>
                            <center>
                                <div id="upload_crosses_seedlots_template_section" style="display:none">
                                    <button class="btn btn-info" id ="guided_help_crosses_seedlots_upload_format_button" name ="guided_help_crosses_seedlots_upload_format_button">Informações sobre o formato do arquivo de lotes de sementes colhidos</button><br/><br/>
                                </div>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);">Quando o arquivo estiver correto, vá para a próxima etapa</button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "Enviar lotes de sementes" &>
                        <& /page/page_title.mas, title=>"Informe os dados básicos dos lotes de sementes e envie o arquivo" &>
                        <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_cross_seedlot_form" name="upload_cross_seedlot_form">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_breeding_program_name" id="upload_seedlot_breeding_program_name" disabled value="<% $breeding_program_name %>">
                                    <input name="upload_seedlot_breeding_program_id" id="upload_seedlot_breeding_program_id" type="hidden" value="<% $breeding_program_id %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Local de armazenamento dos lotes: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" name="upload_seedlot_location" id="upload_seedlot_location"></select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Nome da organização: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="Opcional">
                                </div>
                            </div>
                            <div id="upload_seedlots_harvested_section" style="display:none">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Enviar arquivo (.xls ou .xlsx): </label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </div>
                            <div id="upload_seedlot_breeding_program_id" style="visibility:hidden">
                                <% $breeding_program_id %>
                            </div>
                        </form>
                        <center>
                            <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" id ="upload_cross_seedlot_button" name="upload_cross_seedlot_button" >Enviar lotes de sementes</button><br/><br/>
                        </center>
                    </&>
                    <&| /util/workflow.mas:complete, title=> "Concluído" &>
                        <& /page/page_title.mas, title=>"Concluído! Seus lotes de sementes estão no banco de dados" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                O arquivo de lotes de sementes foi enviado com sucesso
                            </p>
                            <ul>
                                <li>Você pode acessar as páginas de detalhes dos lotes que acabou de criar.</li>
                                <li>Você pode imprimir códigos de barras para os lotes de sementes.</li>
                            </ul>
                            <br/>
                            <center>
                                <button class="btn btn-primary" name="upload_seedlot_success_complete_button">Os lotes de sementes foram salvos sem erros. Clique aqui</button><br/><br/>
                            </center>
                        </&>
                    </&>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="crosses_seedlots_upload_spreadsheet_info_dialog" name="crosses_seedlots_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog">Informações do modelo para lotes de sementes provenientes de cruzamentos</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Os lotes de sementes podem ser enviados em um arquivo do Excel (.xls ou .xlsx)</b>
                    <br />
                    <b>Cabeçalho:</b>
                    <br>
                        A primeira linha (cabeçalho) deve conter o seguinte:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>Quantidade</td>
                                <td>peso(g)</td>
                                <td>Descrição</td>
                                <td>box_name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>Campos obrigatórios:</b>
                    <ul>
                        <li>seedlot_name (deve ser exclusivo)</li>
                        <li>cross_unique_id (deve existir no banco de dados; pode representar um cruzamento entre acessos, por exemplo A × B, ou entre parcelas específicas do campo)</li>
                        <li>operator_name (nome da pessoa responsável pelo processo de inventário; pode ser qualquer nome)</li>
                        <li>amount (número de sementes no lote; pode ser informado junto com weight(g). É obrigatório informar amount, weight(g) ou ambos.)
                            <br/><b>E/OU</b><br/>
                            weight(g) (peso do lote em gramas; pode ser informado junto com amount. É obrigatório informar amount, weight(g) ou ambos.)
                        </li>
                        <li>box_name (nome da caixa onde as sementes estão armazenadas; pode ser qualquer nome)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                        <li>description (informações adicionais sobre cada lote de sementes)</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_cross_seedlot_error_display" name="upload_cross_seedlot_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCrossSeedlotErrorDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadCrossSeedlotErrorDialog">Erro ao enviar o arquivo de lotes de sementes</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	  <table>
    	  <tbody></tbody>
  	  </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>


<script>
jQuery(document).ready(function(){

    var locations_array = <% $locations_by_program_json %>;

    jQuery('#upload_seedlots_from_crosses').click( function() {
        jQuery('#upload_cross_seedlot_dialog').modal('show');

        var html = '<select id = "upload_seedlot_location" >';
        for (var i=0; i<locations_array.length; i++) {
            html += `<option value="${locations_array[i]}">${locations_array[i]}</option>`;
        }
        html = html + "</select>";

        jQuery('#upload_seedlot_location').html(html);

    });

    jQuery('#upload_crosses_seedlots_template_section').show();

    jQuery('#upload_seedlots_harvested_section').show();

    jQuery('#guided_help_crosses_seedlots_upload_format_button').click( function () {
        jQuery('#crosses_seedlots_upload_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#upload_cross_seedlot_button').click(function () {
        upload_crosses_seedlots();
    });

    function upload_crosses_seedlots() {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_cross_seedlot_form').attr("action", "/ajax/breeders/seedlot-upload");
        if (breeding_program === '') {
            alert("Escolha um programa de melhoramento");
            return;
        }
        if (location === '') {
            alert("Informe um local");
            return;
        }
        if (uploadSeedlotsHarvestedFile == '') {
            alert("Selecione um arquivo");
            return;
        }
        jQuery("#upload_cross_seedlot_form").submit();
    }

    jQuery('#upload_cross_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert("Nenhum arquivo selecionado");
            }
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery('#upload_cross_seedlot_error_display').modal("show");
                jQuery('#upload_cross_seedlot_error_display tbody').html('');
                jQuery('#upload_cross_seedlot_error_display tbody').append(response.error_string);
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");

            }
        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert('Os lotes de sementes foram salvos no banco de dados');
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });

});


</script>
