
<%args>
$family_id
$family_name => ''
$user_id => undef
$identifier_prefix => ''
$family_type
$family_type_string
</%args>

<%init>
my %family_type_labels = (
    same_parents       => 'mesmos genitores',
    reciprocal_parents => 'genitores recíprocos',
);
my $family_type_label = $family_type_labels{$family_type} || $family_type_string;
</%init>

<& /util/import_javascript.mas, classes => ["jquery", "jqueryui", "thickbox", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List"] &>

<& /page/page_title.mas, title => "Detalhes da família '$family_name'" &>

<&| /page/info_section.mas, title => "Informações da família" &>
<div class="panel panel-default">
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-6">`
                <& /page/form.mas,
                    object_type=>'family_name',
                    object_id=> $family_id,
                    form_name=> 'stock_form',
                    server_side_script => '/phenome/stock/stock_ajax_form.pl',
                    form_div_name=>'stock_details',
                    js_object_name=> 'stockForm',
                    page_url => "/family/$family_id" ,
                    alternate_new_button => '',
                    alternate_ghosted_new_button => '',
                    alternate_delete_button => '',
                    alternate_ghosted_delete_button => ''
                &>
            </div>
            <div class="col-sm-6">
                <br /><br />
                <& /util/barcode.mas, identifier => "$identifier_prefix"."$family_id", text=> "$identifier_prefix stock $family_id ($family_name)", format=>"stock_qrcode"  &>
                <br /><br />
            </div>
        </div>
    </div>
</div>
</&>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, title => "Genitores: ($family_type_label)", collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <table id = "family_parent_information" class="table table-hover table-striped">
                    <thead>
                        <tr>
% if ($family_type eq 'same_parents') {
                            <th>Genitor feminino</th>
                            <th>Tipo de material feminino</th>
                            <th>Ploidia feminina</th>
                            <th>Genitor Masculino</th>
                            <th>Tipo de material masculino</th>
                            <th>Ploidia masculina</th>
% } elsif ($family_type eq 'reciprocal_parents') {
                            <th>Genitor 1</th>
                            <th>Tipo de material do genitor 1</th>
                            <th>Ploidia do genitor 1</th>
                            <th>Genitor 2</th>
                            <th>Tipo de material do genitor 2</th>
                            <th>Ploidia do genitor 2</th>
%}
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => 'Cruzamentos desta família', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="crosses_in_family_table">
                    </table>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <&| /page/info_section.mas, title => 'Adicionar cruzamentos a uma lista', collapsible=>1, collapsed=>1, subtitle=>'<i>Adicione os cruzamentos desta família a uma lista nova ou existente</i>'&>
                            <br>
                            <div id="members_to_new_list" style="display:none"></div>
                            <div id="members_add_to_list"></div>
                        </&>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => 'Progênies', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="all_progenies">
                    </table>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <&| /page/info_section.mas, title => 'Adicionar progênies a uma lista', collapsible=>1, collapsed=>1, subtitle=>'<i>Adicione as progênies desta família a uma lista nova ou existente</i>'&>
                            <br>
                            <div id="progenies_to_new_list" style="display:none"></div>
                            <div id="progenies_add_to_list"></div>
                        </&>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>

<script>

jQuery(document).ready(function(){

    var family_id = "<% $family_id %>";

    var family_parent_table = jQuery('#family_parent_information').DataTable({
        'ajax': '/ajax/family/parents/'+family_id,
        'paging' : false,
        'searching' : false,
        'destroy' : true,
    });

    var crosses_in_family = jQuery('#crosses_in_family_table').DataTable({
        'ajax': '/ajax/family/members/'+family_id,
        'destroy': true,
        columns: [
            { title: "ID exclusivo do cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
            { title: "Tipo de cruzamento", "data": "cross_type", "render": function (data, type) {
                if (type !== 'display') return data;
                return { biparental: 'biparental', self: 'autofecundação', open: 'polinização aberta', polycross: 'policruzamento' }[data] || data;
            } },
            { title: "Número de progênies", "data": "progeny_number" },
            { title: "Experimento de cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/trial/"+row.crossing_experiment_id+"'>"+row.crossing_experiment_name+"</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#members_add_to_list').html("<div class='well well-sm'><h3>Faça login para usar as listas!</h3></div>");
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].cross_name+"\n";
                }
                jQuery("#members_to_new_list").html(html);
                addToListMenu("members_add_to_list", "members_to_new_list", {
                    selectText: true,
                    listType: 'crosses',
                });
            }
        }
    });

    var progenies = jQuery('#all_progenies').DataTable({
        'ajax': '/ajax/family/all_progenies/'+family_id,
        'destroy': true,
        columns: [
            { title: "Nome da progênie", "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.progeny_id+"/view'>"+row.progeny_name+"</a>"; } },
            { title: "ID exclusivo do cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#progenies_add_to_list').html("<div class='well well-sm'><h3>Faça login para usar as listas!</h3></div>");
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].progeny_name+"\n";
                }
                jQuery("#progenies_to_new_list").html(html);
                addToListMenu("progenies_add_to_list", "progenies_to_new_list", {
                    selectText: true,
                    listType: 'accessions',
                });
            }
        }
    });

});

</script>
