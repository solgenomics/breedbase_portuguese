<%args>
$trial_id
$trial_name
</%args>


<div class="modal fade" id="upload_intercross_file_dialog" name="upload_intercross_file_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadIntercrossFileDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadIntercrossFileDialog">Enviar arquivo do Intercross</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'Informações para envio ao Intercross' &>
                        <p>
                            <a id="upload_intercross_file_spreadsheet_format_info">Informações para envio ao Intercross</a>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_intercross_form" name="upload_intercross_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Experimento de cruzamento: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="intercross_experiment_name" id="intercross_experiment_name" disabled value="<% $trial_name %>">
                                <input name="intercross_experiment_id" id="intercross_experiment_id" type="hidden" value="<% $trial_id %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Selecione o formato do ID exclusivo do cruzamento: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="cross_id_format_option" name="cross_id_format_option">
                                    <option value="">Selecione o formato do ID exclusivo do cruzamento no arquivo do Intercross</option>
                                    <option value="customized_id">Usar o ID exclusivo personalizado já armazenado no banco de dados</option>
                                    <option value="auto_generated_id">Usar um ID exclusivo gerado automaticamente</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo (.csv): </label>
                            <div class="col-sm-8">
                                <input type="file" name="intercross_file" id="intercross_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_intercross_file_submit" id="upload_intercross_file_submit">Enviar arquivo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_intercross_error_display" name="upload_intercross_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadIntercrossErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadIntercrossErrorDialog">Erro ao enviar o arquivo do Intercross</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_saved_dialog_message" name="intercross_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="intercrossSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Os dados de cruzamento do arquivo do Intercross foram salvos com sucesso.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_intercross_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_spreadsheet_info_dialog" name="intercross_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossFileInfoDialog">Informações sobre o ID exclusivo do cruzamento e o modelo</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>ID exclusivo do cruzamento:</b> o banco de dados pode gerar automaticamente os IDs exclusivos, ou você pode cadastrar IDs personalizados antes de enviar o arquivo do Intercross. O ID gerado automaticamente combina o nome do experimento de cruzamento com um número sequencial.
                    <br><br>
                    <b>O arquivo do Intercross deve estar no formato CSV (.csv).</b> Todos os cruzamentos do arquivo devem pertencer ao mesmo experimento de cruzamento.
                    <br><br>
                    <b>Cabeçalho:</b>
                    <br>
                    Não altere o cabeçalho do arquivo do Intercross. A primeira linha deve conter os seguintes campos:
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>crossDld</td>
                                <td>MulherObsUnitDbld</td>
                                <td>MaleObsUnitDbld</td>
                                <td>Timetamp</td>
                                <td>Pessoa</td>
                                <td>experimento</td>
                                <td>tipo</td>
                                <td>Frutos</td>
                                <td>Flores</td>
                                <td>Sementes</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>Informações dos campos:</b>
                    <ul>
                        <li>crossDbId (ID da transação no banco de dados; identificador exclusivo de cada atividade)</li>
                        <li>femaleObsUnitDbId (deve existir como uniquename no banco de dados e pode ser um acesso, uma parcela ou uma planta)</li>
                        <li>maleObsUnitDbId (deve existir como uniquename no banco de dados e pode ser um acesso, uma parcela ou uma planta)</li>
                        <li>person (nome do operador; não é necessário que ele possua uma conta de usuário)</li>
                        <li>experiment (experimento de cruzamento, que deve existir no banco de dados)</li>
                        <li>type (tipo de cruzamento; o Intercross aceita biparental, self, open e polycross)</li>
                        <li>fruits (número de frutos)</li>
                        <li>flowers (número de flores)</li>
                        <li>seeds (número de sementes)</li>
                    </ul>
                    <br>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#upload_intercross_file_link').click(function(){
        jQuery('#upload_intercross_file_dialog').modal("show");
    });

    jQuery('#upload_intercross_file_spreadsheet_format_info').click(function(){
        jQuery("#intercross_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_intercross_file_submit").click(function(){
        var uploadFile = jQuery("#intercross_file").val();
        var crossIDformat = jQuery("#cross_id_format_option").val();

        jQuery('#upload_intercross_form').attr("action", "/ajax/cross/upload_intercross_file");

        if (crossIDformat === ''){
            alert("Selecione o formato do ID do cruzamento");
            return;
        }

        if (uploadFile === ''){
            alert("Selecione um arquivo");
            return;
        }
        jQuery("#upload_intercross_form").submit();
        jQuery("#upload_intercross_file_dialog").modal("hide");
    });

    jQuery('#upload_intercross_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_intercross_error_display tbody").html('');
                jQuery("#upload_intercross_error_display tbody").append(response.error_string);
                jQuery("#upload_intercross_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#intercross_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_intercross_saved_dialog").click(function(){
        location.reload();
    });

});

</script>
