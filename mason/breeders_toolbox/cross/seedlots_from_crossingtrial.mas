<%args>
$trial_id
$breeding_program_name
$breeding_program_id
$timestamp => localtime()
$locations_by_program_json
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<table class="table table-hover table-bordered" id="seedlots_from_crossingtrial_table">
</table>

<div class="modal fade" id="add_cross_seedlot_dialog" name="add_cross_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="add_seedlot_dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="add_seedlot_dialog">Adicionar novo lote de sementes</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="add_cross_seedlot_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button id="add_cross_seedlot_button" type="button" class="btn btn-primary" >Adicionar</button>
            </div>
        </div>
    </div>
</div>


<script>

var breeding_program_name = "<% $breeding_program_name %>";
var breeding_program_id = "<% $breeding_program_id %>";
var time = "<% $timestamp %>";
var locations = <% $locations_by_program_json %>;

jQuery(document).ready(function(){

    jQuery('#seedlots_from_crossingtrial_section_onswitch').click(function(){
        var seedlots_crossingtrial_table = jQuery('#seedlots_from_crossingtrial_table').DataTable({

            'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/seedlots_from_crossingtrial',

            columns: [
                { title: "ID exclusivo do cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: "Nome do lote de sementes", "data": null, "render": function ( data, type, row ) {
                    if (row.seedlot_id === null){
                        return 'Sem lote de sementes'
                    } else {
                        return "<a href='/breeders/seedlot/"+row.seedlot_id+"'>"+row.seedlot_name+"</a>"
                    }
                }},
                { title: "Adicionar novo lote de sementes", "data": "null", "render": function ( data, type, row ) {
                    return `<a onclick='addSeedlot("${row.cross_name}")'>Adicionar</a>`;
                }},
            ]
        });
    });

    jQuery('#add_cross_seedlot_button').click( function() {

        var seedlot_name = jQuery('#new_seedlot_name').val();
        if (!seedlot_name) {
            alert ("O nome do lote de sementes é obrigatório");
            return;
        }

        var seedlot_program = jQuery('#new_seedlot_program').val();
        if (!seedlot_program) {
            alert ("Erro ao obter o nome do programa de melhoramento");
            return;
        }

        var seedlot_program_id = jQuery('#new_seedlot_breeding_program_id').val();
        if (!seedlot_program_id) {
            alert ("Erro ao obter o ID do programa de melhoramento");
            return;
        }

        var seedlot_location = jQuery('#new_seedlot_location').val();
        if (!seedlot_location) {
            alert ("O local é obrigatório");
            return;
        }

        var box_name = jQuery('#new_seedlot_box_name').val();
        if (!box_name) {
            alert ("O nome da caixa é obrigatório");
            return;
        }

        var seedlot_content = jQuery('#new_seedlot_content').val();
        if (!seedlot_content) {
            alert ("O ID exclusivo do cruzamento é obrigatório");
            return;
        }

        var seedlot_amount = jQuery('#new_seedlot_amount').val();
        var seedlot_weight = jQuery('#new_seedlot_weight').val();
        if (!seedlot_amount && !seedlot_weight) {
            alert ("A quantidade ou o peso do lote de sementes é obrigatório");
            return;
        }

        var seedlot_organization = jQuery('#new_seedlot_organization').val();

        var seedlot_timestamp = jQuery('#new_seedlot_timestamp').val();
        if (!seedlot_timestamp) {
            alert ("A data e hora são obrigatórias");
            return;
        }

        var seedlot_description = jQuery('#new_seedlot_description').val();

        const cross_seedlot_material_type = jQuery('#cross_seedlot_material_type').val();
        if (!cross_seedlot_material_type) {
            alert ("O tipo de material é obrigatório");
            return;
        }

        jQuery.ajax({
            url: '/ajax/breeders/seedlot-create',
            data : {
                'seedlot_name' : seedlot_name,
                'seedlot_location': seedlot_location,
                'seedlot_box_name':box_name,
                'seedlot_cross_uniquename': seedlot_content,
                'seedlot_organization': seedlot_organization,
                'seedlot_amount':seedlot_amount,
                'seedlot_weight':seedlot_weight,
                'seedlot_timestamp':seedlot_timestamp,
                'seedlot_description':seedlot_description,
                'seedlot_breeding_program_id':seedlot_program_id,
                'seedlot_material_type':cross_seedlot_material_type,
                'no_refresh': 1,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert("O lote de sementes foi adicionado.");
                    jQuery('#add_cross_seedlot_dialog').modal('hide');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao adicionar o lote de sementes');
            }
        });
    });

});

function addSeedlot(cross_name){
    get_select_box('material_types', 'cross_seedlot_material_type_div', { 'name' : 'cross_seedlot_material_type', 'id' : 'cross_seedlot_material_type' });

    var html = '';
    html = html + '<form class="form-horizontal"><div class="form-group"><label class="col-sm-4 control-label">ID exclusivo do cruzamento: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_content" name="new_seedlot_content" value="'+cross_name+'" disabled></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Nome do lote de sementes: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_name" name="new_seedlot_name" placeholder="Obrigatório"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Tipo de material: </label><div class="col-sm-8" ><div id="cross_seedlot_material_type_div" name="cross_seedlot_material_type_div"></div></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Programa de melhoramento: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_program" name="new_seedlot_program" value="'+breeding_program_name+'" disabled></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Local: </label><div class="col-sm-8" ><select class="form-control" id="new_seedlot_location" name="new_seedlot_location"><option disabled value="" selected hidden>Selecione um local</option>';
    if (locations) {
        for (var i=0; i<locations.length; i++) {
            html += `<option value="${locations[i]}">${locations[i]}</option>`;
        }
    }
    html = html + '</select></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Nome da caixa: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_box_name" name="new_seedlot_box_name" placeholder="Obrigatório"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Quantidade: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_amount" name="new_seedlot_amount" placeholder="Quantidade (número de sementes) OU peso (g), obrigatório"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Peso (g): </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_weight" name="new_seedlot_weight" placeholder="Quantidade (número de sementes) OU peso (g), obrigatório"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Organização: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_organization" name="new_seedlot_organization" placeholder="Opcional"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Data e hora: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_timestamp" name="new_seedlot_timestamp" value="'+time+'"></div></div>';
    html = html + '<div class="form-group"><label class="col-sm-4 control-label">Descrição: </label><div class="col-sm-8" ><input class="form-control" id="new_seedlot_description" name="new_seedlot_description" placeholder="Opcional"></div></div></form>';
    html = html + '<div class="form-group"><input id="new_seedlot_breeding_program_id" type="hidden" value="'+breeding_program_id+'"/>';

    jQuery('#add_cross_seedlot_div').html(html);
    jQuery('#add_cross_seedlot_dialog').modal('show');

}


</script>
