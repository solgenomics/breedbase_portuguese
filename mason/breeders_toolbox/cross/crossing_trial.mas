<%doc>

=head1 NAME

/breeders_toolbox/cross/crossing_trial.mas - a mason component to display a crossing experiment detail page

=head1

=cut

</%doc>


<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$folder_name => undef
$folder_id => undef
$locations_by_program_json
$trial_owner => undef
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker', 'CXGN.BreedersToolbox.Crosses'] &>

<br/>


<& /page/page_title.mas, title=>"Detalhes de ".$trial_name &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Detalhes do experimento de cruzamento</h4>", info_section_subtitle => 'Visualize e edite as informações básicas do experimento.', buttons_html => '<button class="btn btn-primary btn-sm" id="edit_crossingtrial_details" style="margin:3px">Editar detalhes do experimento</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "crossingtrial_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, folder_name => $folder_name, folder_id => $folder_id, trial_owner => $trial_owner &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Metas de sementes e progênies</h4>", info_section_subtitle => 'Visualize as metas e o progresso dos cruzamentos deste experimento.', buttons_html => '<button class="btn btn-sm btn-default" style="margin:3px" id ="target_numbers_usage_info">Ajuda de uso <span class="glyphicon glyphicon-question-sign"></span></button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_target_numbers_link">Enviar metas</button><button class="btn btn-sm btn-primary" style="margin:3px" id="record_target_numbers_using_lists">Usar listas para registrar metas</button>', icon_class => "glyphicon glyphicon-record", info_section_id => "target_numbers_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Gerenciar Intercross</h4>", info_section_subtitle => 'Baixe arquivos de parentais e da lista de desejos ou envie o arquivo exportado.', buttons_html => '<button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_parents">Baixar arquivo de parentais</button><button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_wishlist">Baixar lista de desejos</button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_intercross_file_link">Enviar arquivo do Intercross</button>', icon_class => "glyphicon glyphicon-sort", info_section_id => "intercross_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Cruzamentos deste experimento</h4>", info_section_subtitle => 'Visualize IDs exclusivos, combinações, tipos e parentais dos cruzamentos.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="crossing_experiment_barcode">Gerar etiquetas com código de barras</button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "crosses_in_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Informações adicionais dos parentais</h4>", info_section_subtitle => 'Visualize informações adicionais dos parentais femininos e masculinos.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_additional_info">Enviar informações adicionais dos parentais</button>', icon_class => "glyphicon glyphicon-pencil", info_section_id => "additional_info_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Dados dos cruzamentos de campo</h4>", info_section_subtitle => 'Visualize os detalhes dos cruzamentos, como data de polinização e número de flores e sementes.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_cross_info">Enviar dados de campo de cruzamentos existentes</button>', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "cross_properties_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json, info_section_title => "<h4 style='display:inline'>Informações dos lotes de sementes</h4>", info_section_subtitle => 'Visualize os lotes derivados deste experimento de cruzamento.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_seedlots_from_crosses">Enviar lotes colhidos dos cruzamentos</button>', icon_class => "glyphicon glyphicon-retweet", info_section_id => "seedlots_from_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Progênies e nomes de famílias</h4>", info_section_subtitle => 'Visualize o número de progênies e os nomes das famílias.', icon_class => "glyphicon glyphicon-random", info_section_id => "progenies_in_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Vínculos do ensaio</h4>", info_section_subtitle => 'Visualize os ensaios de campo que fazem parte deste experimento.', icon_class => "glyphicon glyphicon-link", info_section_id => "crossing_experiment_and_trial_linkage_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>Excluir experimento ou cruzamentos</h4>", info_section_subtitle => 'Exclua o experimento ou cruzamentos específicos.', icon_class => "glyphicon glyphicon-trash", info_section_id => "crossing_experiment_deletion_section" &>

<& /breeders_toolbox/folder/folder_set.mas, project_type => 'crossing_experiment', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, project_type => 'crossing_experiment',, breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name &>
<& /breeders_toolbox/cross/edit_crossingtrial_details_dialog.mas, trial_name => $trial_name, breeding_program_id => $breeding_program_id, location_id => $location_id, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description &>
<& /breeders_toolbox/cross/upload_update_crosses.mas &>
<& /breeders_toolbox/cross/upload_crossingtrial_seedlots_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json&>
<& /breeders_toolbox/trial/generate_trial_barcode.mas, identifier => ''."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", trial_stock_type => '' &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, trial_id => $trial_id, trial_name => $trial_name, breeding_program_id => $breeding_program_id &>
<& /breeders_toolbox/cross/intercross_file_upload.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/intercross_parents_download.mas, trial_id => $trial_id &>
<& /breeders_toolbox/cross/intercross_wishlist_download.mas, trial_id => $trial_id &>
<& /breeders_toolbox/cross/target_numbers_upload.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/target_numbers_using_lists.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/target_numbers_usage_info_dialog.mas &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>
