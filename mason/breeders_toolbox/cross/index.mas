
<%args>
$cross_id
$cross_name => ''
$breeding_program => undef
$progeny_count => undef
$trial_id => undef
$trial_name => undef
$user_id => undef
$identifier_prefix => ''
</%args>

<& /util/import_javascript.mas, classes => ["jquery", "jqueryui", "thickbox", "CXGN.Phenome.Tools", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List", "CXGN.BreederSearch", "CXGN.BreedersToolbox.CrossDetailPage" ] &>

% use utf8;
% $cross_name ||= "Cruzamento sem título";
% my $basename = $cross_name."P";
% my $cross_properties = $c->config->{cross_properties};
% my @cross_props = split ',',$cross_properties;
% my $odk_crossing_data_service_name = $c->config->{odk_crossing_data_service_name};
% my $cross_additional_info_header_string = $c->config->{cross_additional_info_header};
% my @cross_additional_info_header = split ',',$cross_additional_info_header_string;
% my $cross_additional_info_string = $c->config->{cross_additional_info};
% my @cross_additional_info = split ',',$cross_additional_info_string;

<& /page/page_title.mas, title => "Detalhes do cruzamento '$cross_name'" &>

<&| /page/info_section.mas, title => "Informações do cruzamento" &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <& /page/form.mas,
                        object_type=>'cross',
                        object_id=> $cross_id,
                        form_name=> 'stock_form',
                        server_side_script => '/phenome/stock/stock_ajax_form.pl',
                        form_div_name=>'stock_details',
                        js_object_name=> 'stockForm',
                        page_url => "/cross/$cross_id" ,
                        alternate_new_button => '',
                        alternate_ghosted_new_button => '',
                        alternate_delete_button => '',
                        alternate_ghosted_delete_button => ''
                    &>
                </div>
                <div class="col-sm-6">
                    <br /><br />
                    <& /util/barcode.mas, identifier => "$identifier_prefix"."$cross_id", text=> "$identifier_prefix stock $cross_id ($cross_name)", format=>"stock_qrcode"  &>
                    <br /><br />
                </div>
            </div>
        </div>
    </div>

</&>

<div id="cross_name" style="visibility:hidden">
<% $cross_name %>
</div>

<div id="cross_id" style="visibility:hidden">
<% $cross_id %>
</div>


<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, title => 'Pertence a', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "membership_table" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Experimento de cruzamento</th>
                                <th>Descrição</th>
                                <th>Nome da família</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => 'Genitores', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "parent_information" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Combinação do cruzamento</th>
                                <th>Tipo de cruzamento</th>
                                <th>Acesso feminino</th>
                                <th>Ploidia feminina</th>
                                <th>Acesso masculino</th>
                                <th>Ploidia masculina</th>
                                <th>Parcela feminina</th>
                                <th>Parcela masculina</th>
                                <th>Planta feminina</th>
                                <th>Planta masculina</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_additional_info_link = "[Editar]";
% if ($user_id) { $edit_additional_info_link = '<a id="edit_additional_info_link">[Editar]</a>'; }

<div id="edit_additional_info_dialog">
    <select id="additional_info_select">
% foreach my $info(@cross_additional_info){
        <option value="<%$info%>"><%$info%></option>
%}
    </select>
    <input id="additional_info_value" />
    <button id="edit_additional_info_submit" >Salvar</button>
</div>


<&| /page/info_section.mas, title => 'Informações adicionais dos genitores', collapsible => 1, collapsed => 0, subtitle => $edit_additional_info_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_additional_info" class="table table-hover table-striped">
                        <thead>
                            <tr>
% foreach my $additional_info(@cross_additional_info_header){
                                <th><%$additional_info%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_link = "[Editar]";
% if ($user_id) { $edit_link = '<a id="edit_properties_link">[Editar]</a>'; }

<&| /page/info_section.mas, title => 'Dados de cruzamento em campo', collapsible => 1, collapsed => 0, subtitle => $edit_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                <table id = "cross_properties" class="table table-hover table-striped">
                    <thead>
                        <tr>
% foreach my $cross_prop(@cross_props){
                        <th><%$cross_prop%></th>
%}
                        </tr>
                    </thead>
                </table>
                </div>
            </div>
        </div>
    </div>
 </&>

<div id="edit_properties_dialog">

    <select id="properties_select">
% foreach my $cross_prop(@cross_props){
        <option value="<%$cross_prop%>"><%$cross_prop%></option>
%}
    </select>

    <input id="property_value" />

    <button id="property_submit" >Salvar</button>

    <p><b>AVISO!</b>&nbsp;A alteração dos parâmetros pode causar resultados imprevisíveis nas análises posteriores se eles forem incompatíveis com os demais dados.</p>

</div>

<&| /page/info_section.mas, title => 'Transações do cruzamento', collapsible => 1, collapsed => 0, subtitle => 'Visualize as atividades de cruzamento deste registro'&>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_transactions" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>ID da transação</th>
                                <th>Operador</th>
                                <th>Data e hora</th>
                                <th>Número de flores</th>
                                <th>Número de frutos</th>
                                <th>Número de sementes</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% if ($odk_crossing_data_service_name eq 'ONA') {
    <&| /page/info_section.mas, id=>'tissue_culture_summary_section', title => 'IDs de cultura de tecidos deste cruzamento', collapsible=>1, collapsed=>1, subtitle => 'Visualize os IDs de cultura de tecidos em cada etapa (por exemplo, embrião, subcultura, enraizamento e aclimatação)'&>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div style="overflow:scroll">
                        <table id="tissue_culture_summary_table" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>IDs de embrião</th>
                                    <th>IDs de subcultura</th>
                                    <th>IDs de enraizamento</th>
                                    <th>IDs da aclimatação 1</th>
                                    <th>IDs da aclimatação 2</th>
                                    <th>IDs de telado</th>
                                    <th>IDs de endurecimento</th>
                                    <th>IDs de campo aberto</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<& /breeders_toolbox/seedlots_section.mas, stock_id=>$cross_id, stock_type=>'cross', stock_uniquename=>$cross_name &>

% my $add_progeny_link = "[adicionar progênie]";
% if ($user_id) { $add_progeny_link= '<a id="add_more_progeny_link">[adicionar progênie]</a>'; }

<&|  /page/info_section.mas, title => "Progênie", collapsible => 1, collapsed => 0, subtitle => $add_progeny_link   &>

    <div id="progeny_information_div">
        [Carregando...]
    </div>

    <div id="add_more_progeny_dialog">
        <table>
            <tr><td>Nome-base</td><td><input type="input" id="basename" name="basename" value="<% $basename %>" /></td></tr>
            <tr><td>Número inicial</td><td><input type="input" id="start_number" name="start_number" size="5" value="<% $progeny_count + 1 %>" /></td></tr>
            <tr><td>Quantidade</td><td><input type="input" id="progeny_count" name="progeny_count" size="5" /></td></tr>
        </table>
    </div>


</&>

<&|  /page/info_section.mas, title => "Excluir cruzamento", collapsible => 1, collapsed => 0, subtitle => '<font color="red">A exclusão não poderá ser desfeita</font>'  &>

<button id="delete_cross_button" class="btn btn-default">Excluir</button>

</&>

<script>

jQuery(document).ready( function() {
    jQuery('#delete_cross_button').click( function() {
        var response = confirm('Deseja realmente excluir este cruzamento? Esta ação não poderá ser desfeita.');
        if (response) {
            jQuery.ajax( {
                url: '/ajax/cross/delete',
                data: { 'cross_id' : <% $cross_id %>},
                method: 'POST',
                error: function(r) { alert('Ocorreu um erro.'); },
                success: function(r) {
                    if (r.error) {
                        alert(r.error);
                    } else {
                        alert('Exclusão concluída com sucesso.');
                    }
                }
            });
        }
    });
});

</script>
