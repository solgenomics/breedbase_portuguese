<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, id=>'delete_cross_section', title => 'Excluir cruzamentos', subtitle => '<font color="red">A exclusão não poderá ser desfeita</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="cross_deletion_table">
                </table>
            </div>
        </div>
        <button class="btn btn-default" id="delete_all_crosses" role="button">Excluir todos os cruzamentos deste experimento</button><br/><br/>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_crossing_experiment_section', title => 'Excluir experimento de cruzamento', subtitle => '<font color="red">A exclusão não poderá ser desfeita. Primeiro, exclua os cruzamentos deste experimento</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_crossing_experiment" role="button">Excluir experimento de cruzamento</button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    jQuery('#delete_cross_section_onswitch').click(function(){

        var cross_deletion_table = jQuery('#cross_deletion_table').DataTable({

            'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/crosses_in_crossingtrial',

            columns: [
                { title: "ID exclusivo do cruzamento", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: "Excluir", "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteCross("+row.cross_id+")'>Excluir</a>"; } },
            ]
        });
    });

    jQuery('#delete_all_crosses').click(function() {

        var trial_id = "<% $trial_id %>";
        var confirmation = confirm("Deseja realmente excluir todos os cruzamentos deste experimento? A exclusão não poderá ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_all_crosses_in_crossingtrial',
                destroy: true,
                beforeSend: function(response) {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão concluída com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

    jQuery('#delete_crossing_experiment').click(function() {

        var trial_id = "<% $trial_id %>";
        var confirmation = confirm("Deseja realmente excluir este experimento de cruzamento? A exclusão não poderá ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+trial_id+'/delete/crossing_experiment',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão concluída com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

});

function deleteCross(cross_id){

    var confirmation = confirm('Deseja realmente excluir este cruzamento? A exclusão não poderá ser desfeita.');

    if (confirmation) {
        jQuery.ajax({
            url: '/ajax/cross/delete',
            data: {'cross_id' : cross_id},
            method: 'POST',
            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert('Exclusão concluída com sucesso');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro durante a exclusão');
            }
        });
    }
}


</script>
