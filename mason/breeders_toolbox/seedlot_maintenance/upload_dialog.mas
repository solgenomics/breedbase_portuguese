<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui' ] &>

<div class="modal fade" id="upload_maintenance_event_upload_modal" name="upload_maintenance_event_upload_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Enviar eventos de manutenção de lotes de sementes</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p><strong>Selecione um arquivo Excel (.xls) com os eventos de manutenção de lotes de sementes</strong></p>
                    <p><strong>Requisitos:</strong></p>
                    <ul>
                        <li>
                            Os eventos de manutenção são associados a lotes de sementes; portanto, o nome do lote no arquivo deve corresponder a um lote existente no banco de dados.
                            Se o lote ainda não estiver cadastrado, acesse a página <a href='/breeders/seedlots/'>Gerenciar lotes de sementes</a> para criá-lo primeiro.
                        </li>
                        <li>
                            O nome do evento de manutenção deve corresponder a um tipo de evento válido. Os tipos válidos incluem:
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Nome do tipo de evento</th>
                                        <th>Valores do tipo de evento</th>
                                    </tr>
                                </thead>
                                <tbody id="maintenece_event_terms"></tbody>
                            </table>
                        </li>
                    </ul>
                    <&| /page/explanation.mas, title=>'Informações do modelo' &>
                        <p>
                        <b>Informações sobre o formato do arquivo</b>
                        <br>
                        <a id="maintenance_event_upload_spreadsheet_format_info">Formato da planilha</a>
                        </p>
                    </&>
                    <br />
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_maintenance_events_form" name="upload_maintenance_events_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="file" name="maintenance_events_upload_file" id="maintenance_events_upload_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                    <br /><br />
                    <div id="maintenance_events_upload_messages">
                        <ul id="maintenance_events_upload_messages_list" class='list-group'></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="maintenance_events_submit" id="maintenance_events_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<!-- Template Info Modal -->
<div class="modal fade" id="maintenance_event_upload_spreadsheet_format_modal" name="maintenance_event_upload_spreadsheet_format_modal" tabindex="-1" role="dialog" aria-labelledby="uploadMaintenanceInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadMaintenanceInfoDialog">Informações do modelo de eventos de manutenção</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <strong>Os eventos de manutenção de lotes de sementes podem ser enviados em um arquivo Excel (.xls ou .xlsx).</strong>
                    <br />
                    <strong>Cabeçalho:</strong>
                    <br />
                    A primeira linha (cabeçalho) deve conter os seguintes campos:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                            <tbody>
                                <tr>
                                    <td>seedlot</td>
                                    <td>type</td>
                                    <td>value</td>
                                    <td>notes</td>
                                    <td>operator</td>
                                    <td>timestamp</td>
                                </tr>
                        </tbody>
                    </table>

                    <b>Campos:</b>
                    <ul>
                        <li>seedlot (nome do lote de sementes; deve corresponder a um lote existente)</li>
                        <li>type (nome do tipo de evento de manutenção; deve corresponder a um termo existente)</li>
                        <li>value (valor do evento)</li>
                        <li>notes (opcional; comentários adicionais sobre o evento)</li>
                        <li>operator (nome de usuário da pessoa que registra o evento)</li>
                        <li>timestamp (data e hora do registro do evento, no formato 'AAAA-MM-DD HH:MM:SS')</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<style>
    div.center {
        text-align: center
    }
</style>

<script type="text/javascript">

    jQuery(document).ready(function() {

        // Setup functions
        getValidEventTypes();

        // Click Listeners
        jQuery('#maintenance_event_upload_spreadsheet_format_info').click(function() {
            jQuery('#maintenance_event_upload_spreadsheet_format_modal').modal('show');
        });
        jQuery('#maintenance_events_submit').click(uploadMaintenanceEvents);

    });


    /**
     * Get the maintenance event ontology and populate the table of valid names and values
     */
    function getValidEventTypes() {
        let html = "";
        jQuery.ajax({
            type: 'GET',
            dataType: 'json',
            url: '/ajax/breeders/seedlot/maintenance/ontology',
            success: function(data) {
                if ( data && data.ontology ) {
                    for ( let i = 0; i < data.ontology.length; i++ ) {
                        for ( let j = 0; j < data.ontology[i].children.length; j++ ) {
                            let name = data.ontology[i].children[j].name;
                            let values = [];
                            if ( data.ontology[i].children[j].children ) {
                                for ( let k = 0; k < data.ontology[i].children[j].children.length; k++ ) {
                                    values.push(data.ontology[i].children[j].children[k].name);
                                }
                            }
                            if ( values.length === 0 ) values.push('<em>Qualquer valor</em>');
                            html += "<tr><td>" + name + "</td><td>" + values.join(', ') + "</td></tr>";
                        }
                    }
                }
            },
            complete: function() {
                jQuery("#maintenece_event_terms").html(html);
            }
        });
    }

    /**
     * Upload the Excel file and process the results
     */
    function uploadMaintenanceEvents() {
        let file = jQuery('#maintenance_events_upload_file').val();
        if ( !file || file === '' ) {
            alert("Selecione o arquivo a enviar.");
            return false;
        }

        // Setup working modal
        jQuery('#working_msg').html("Enviando arquivo de eventos de manutenção de lotes de sementes");
        jQuery('#working_modal_progress').css('width', 0).attr('aria-valuenow', 0);
        jQuery('#working_modal_progress_div').css('display', 'block');
        jQuery('#working_modal').modal("show");
        jQuery('#maintenance_events_upload_messages_list').empty();

        // Build the FormData to pass as POST arguments
        let formData = new FormData();
        formData.append('file', jQuery('#maintenance_events_upload_file').prop('files')[0]);

        // Make the POST request
        jQuery.ajax({
            url: '/ajax/breeders/seedlot/maitenance/upload',
            type: 'POST',
            data: formData,
            cache: false,
            contentType: false,
            processData: false,
            xhr: function () {
                var myXhr = jQuery.ajaxSettings.xhr();
                if (myXhr.upload) {
                    myXhr.upload.addEventListener('progress', function (e) {
                        if (e.lengthComputable) {
                            let prog = (e.loaded / e.total)*100;
                            jQuery('#working_modal_progress').css('width', prog + "%").attr('aria-valuenow', prog);
                            if ( prog >= 100 ) {
                               jQuery('#working_msg').html("Enviando arquivo de eventos de manutenção de lotes de sementes");
                            }
                        }
                    }, false);
                }
                return myXhr;
            },
            success: function(response) {
                handleUploadResponse(response);
            },
            error: function(e) {
                console.log(e);
                alert("ERRO: não foi possível enviar o arquivo!");
            },
            complete: function() {
                jQuery('#working_msg').html("");
                jQuery('#working_modal_progress').css('width', 0).attr('aria-valuenow', 0);
                jQuery('#working_modal_progress_div').css('display', 'none');
                jQuery('#working_modal').modal("hide");
            }
        });
    }


    /**
     * Handle the Upload Response
     * - display success message, if no errors
     * - display error messages, if errors encountered
     */
    function handleUploadResponse(response) {
        if ( response && response.success && response.success === 1 ) {
            add_message("success", "Eventos de manutenção de lotes de sementes armazenados com sucesso!");
            if ( getEvents ) getEvents();
        }
        else if ( response && response.error ) {
            let html = "<strong>Não foi possível armazenar os eventos de manutenção devido aos seguintes erros:</strong><br />" + response.error;
            add_message("error", html);
        }
        else {
            add_message("error", "Os eventos de manutenção não foram armazenados devido a um erro desconhecido!");
        }
    }


    /**
    * Add Message to Upload step
    * @param {string} type Message Type (success, error)
    * @param {string} message Message Text
    */
    function add_message(type, message) {
        let html = "";
        let class_name = "danger";
        let icon_name = "remove";
        
        if ( type === "success" ) {
            class_name = "success";
            icon_name = "ok";
        }
        else if ( type === "warning" ) {
            class_name = "warning";
            icon_name = "asterisk";
        }
        else if ( type === "info" ) {
            class_name = "info";
            icon_name = "info-sign";
        }

        html += "<li class='list-group-item list-group-item-" + class_name + "'>";
        html += "<span class='badge'><span class='glyphicon glyphicon-" + icon_name + "'></span></span>";
        html += message;
        html += "</li>";

        jQuery('#maintenance_events_upload_messages_list').append(html);
    }

</script>
