<%args>
</%args>

<& /util/import_javascript.mas, classes => ['CXGN.BreedersToolbox.Accessions'] &>


<div class="modal fade" id="manage_populations_add_population_dialog" name="manage_populations_add_population_dialog" tabindex="-1" role="dialog" aria-labelledby="addPopulationDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" name="create_population_dismiss_button" id="create_population_dismiss_button_1" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addPopulationDialog">Criar uma população</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" name="create_population_form" id="create_population_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Nome da população: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" id="create_population_name" name="create_population_name" type="text" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Tipo de membro: </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="member_type">
                                    <option value="">Selecione um tipo de membro</option>
                                    <option value="accessions">acessos</option>
                                    <option value="plots">parcelas</option>
                                    <option value="plants">plantas</option>
                                </select>
                            </div>
                        </div>
                        <div id="population_accession_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Escolha uma lista de acessos para adicionar: </label>
                                <div class="col-sm-8" id="create_population_accession_list_div" name="create_population_accession_list_div">
                                </div>
                            </div>
                        </div>
                        <div id="population_plot_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Escolha uma lista de parcelas para adicionar: </label>
                                <div class="col-sm-8" id="create_population_plot_list_div" name="create_population_plot_list_div">
                                </div>
                            </div>
                        </div>
                        <div id="population_plant_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Escolha uma lista de plantas para adicionar: </label>
                                <div class="col-sm-8" id="create_population_plant_list_div" name="create_population_plant_list_div">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="create_population_dismiss_button" id="create_population_dismiss_button_2" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="create_population_submit" id="create_population_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manage_populations_add_members_dialog" name="manage_populations_add_members_dialog" tabindex="-1" role="dialog" aria-labelledby="addMembersToPopulationsDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMembersToPopulationsDialog">Adicionar membros à população <div id="add_member_population_name"></div></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" name="add_member_to_population_form" id="add_member_to_population_form">
                        <div class="form-group">
                            <label class="col-sm-6 control-label">Escolha uma lista de membros para adicionar: </label>
                            <div class="col-sm-6" id="add_member_to_population_list_div" name="list_div">
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="add_members_to_population_submit" id="add_members_to_population_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manage_populations_delete_dialog" name="manage_populations_delete_dialog" tabindex="-1" role="dialog" aria-labelledby="deletePopulationsDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="deletePopulationsDialog">Excluir população <div id="delete_population_name"></div></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form">
                        <div class="form-group">
                            <label class="col-sm-6 control-label">Tem certeza?</label>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="delete_population_submit" id="delete_population_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="create_population_saved_dialog_message" name="create_population_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="createPopulationSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createPopulationSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_create_population_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery("#member_type").change(function() {

        if(jQuery(this).val() == ''){
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').hide();
        } else if(jQuery(this).val() == 'accessions'){
            document.getElementById("create_population_accession_list_div").innerHTML = list.listSelect("create_population_accession_list_div", [ 'accessions' ], 'selecione uma lista', undefined, undefined);
            jQuery('#population_accession_list').show();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').hide();
        } else if (jQuery(this).val() == 'plots'){
            document.getElementById("create_population_plot_list_div").innerHTML = list.listSelect("create_population_plot_list_div", [ 'plots' ], 'selecione uma lista', undefined, undefined);
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').show();
            jQuery('#population_plant_list').hide();
        } else if (jQuery(this).val() == 'plants'){
            document.getElementById("create_population_plant_list_div").innerHTML = list.listSelect("create_population_plant_list_div", [ 'plants' ], 'selecione uma lista', undefined, undefined);
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').show();
        }

    });

    jQuery("[name='create_population_dismiss_button']").click(function() {
        jQuery('#manage_populations_add_population_dialog').modal('hide');
        jQuery('#create_population_name').val('');
        jQuery('#member_type').val('');
        jQuery('#population_accession_list').hide();
        jQuery('#population_plot_list').hide();
        jQuery('#population_plant_list').hide();
    });


});

</script>
