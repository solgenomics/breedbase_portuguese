<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="field_trial_tissue_sample_dialog" name="field_trial_tissue_sample_dialog" tabindex="-1" role="dialog" aria-labelledby="addFieldTrialTissueSampleDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addFieldTrialTissueSampleDialog">Criar amostras de tecido para um ensaio de campo</h4>
            </div>
            <div class="modal-body">

                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "field_tissue_samples_create_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Este fluxo orientará a criação de amostras de tecido para o ensaio de campo" &>
                            <p>As amostras de tecido são vinculadas a uma única planta, que, por sua vez, está vinculada a uma única parcela.</p>
                            <p>Várias amostras de tecido podem ser criadas para cada planta.</p>
                            <p>Cada amostra de tecido precisa ter um nome globalmente exclusivo.</p>
                            <p>Depois, as amostras de tecido podem ser transferidas para placas de genotipagem de 96 ou 384 poços.</p>

                            <br/><br/>
                            <center>
                            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Selecionar um ensaio de campo" &>
                            <& /page/page_title.mas, title=>"Selecione um ensaio de campo" &>

                            <div class="well well-sm">
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <table id="manage_tissue_samples_field_search_results" class="table table-hover table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Selecionar</th>
                                                    <th>Nome do ensaio</th>
                                                    <th>Descrição</th>
                                                    <th>Programa de melhoramento</th>
                                                    <th>Massa</th>
                                                    <th>Ano</th>
                                                    <th>Local</th>
                                                    <th>Tipo de ensaio</th>
                                                    <th>Delineamento</th>
                                                    <th>Data de plantio</th>
                                                    <th>Data de colheita</th>
                                                    <th>Baixar</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" id="create_tissue_samples_select_trial">Ir para a próxima etapa</button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> "Registros de plantas" &>
                            <& /page/page_title.mas, title=>"Registros de plantas do ensaio de campo" &>

                            <div id="create_tissue_samples_plant_entries_exist_section" style="display:none">
                                <h4>Já existem registros de plantas para este ensaio. Avance para a próxima etapa.</h4>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </center>
                            </div>
                            <div id="create_tissue_samples_plant_entries_dont_exist_section" style="display:none">
                                <h4>Crie registros de plantas para este ensaio.</h4>
                                <form class="form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Número de plantas por parcela: </label>
                                        <div class="col-sm-9" >
                                            <input name="create_tissue_samples_plants_per_plot_num" id="create_tissue_samples_plants_per_plot_num" class="form-control" type="number" autofocus/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Herdar tratamentos das parcelas: </label>
                                        <div class="col-sm-9" >
                                            <input name="create_tissue_samples_plants_per_plot_inherit_treatments" id="create_tissue_samples_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
                                        </div>
                                    </div>
                                </form><br/>
                                <center>
                                    <button type="button" class="btn btn-primary" id="create_tissue_samples_plants_per_plot_submit">Enviar</button>
                                </center>
                            </div>

                        </&>
                        <&| /util/workflow.mas:step, title=> "Criar registros de amostras de tecido" &>
                            <& /page/page_title.mas, title=>"Criar registros de amostras de tecido para este ensaio" &>

                            <form class="form-horizontal" >
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><span title="Você pode usar o mesmo nome de tecido mais de uma vez abaixo, como raiz e raiz. O nome continuará exclusivo porque um índice, como 1 ou 2, será acrescentado ao final." </span><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;Número de amostras de tecido por planta: </span></label>
                                    <div class="col-sm-9" >
                                        <input name="create_tissue_samples_per_plant_num" id="create_tissue_samples_per_plant_num" class="form-control" type="text" autofocus/>
                                    </div>
                                </div>

                                <div id="create_tissue_samples_names_div">
                                </div>


                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Herdar tratamentos das parcelas: </label>
                                    <div class="col-sm-9" >
                                        <input name="create_tissue_samples_per_plant_inherit_treatments" id="create_tissue_samples_per_plant_inherit_treatments" type="checkbox"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Usar números nos tecidos: </label>
                                    <div class="col-sm-9" >
                                        <input name="create_tissue_samples_per_plant_use_tissue_numbers" id="create_tissue_samples_per_plant_use_tissue_numbers" type="checkbox"/>
                                    </div>
                                </div>
                            </form><br/>
                            <center>
                            <button type="button" class="btn btn-primary" name="create_tissue_samples_plants_per_plant_submit" id="create_tissue_samples_plants_per_plant_submit">Enviar</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! As amostras de tecido do ensaio de campo foram salvas." &>

                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                Amostras de tecido salvas com sucesso
                            </p>

                            <ul>
                                <li>Agora que o ensaio possui plantas, você pode acessar a página de detalhes do ensaio.</li>
                                <li>Você pode imprimir códigos de barras para as novas amostras de tecido.</li>
                                <li>Você pode usar essas amostras de tecido como material de origem para placas de genotipagem de 96 ou 384 poços.</li>
                            </ul>
                            <br/>
                        </&>
                    </&>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    var create_tissue_sample_trial_table = jQuery('#manage_tissue_samples_field_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/search/trials',
            'data': function(d) {
                d.select_checkbox_name = 'create_tissue_sample_select_trial';
            }
        },
        "scrollX": true
    });

    var selected;
    jQuery('#create_tissue_samples_select_trial').click(function(){
        selected = [];
        jQuery('input[name="create_tissue_sample_select_trial"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length !== 1){
            alert('Selecione somente um ensaio!');
        } else {
            new jQuery.ajax({
                type: 'POST',
                url: '/ajax/breeders/trial/'+selected[0]+'/has_plants',
                dataType: "json",
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                },
                success: function (response) {
                    jQuery("#working_modal").modal("hide");
                    if (response.has_plants){
                        jQuery('#create_tissue_samples_plant_entries_exist_section').show();
                        jQuery('#create_tissue_samples_plant_entries_dont_exist_section').hide();
                        Workflow.complete('#create_tissue_samples_select_trial');
                        Workflow.skip('#create_tissue_samples_plant_entries_exist_section');
                        Workflow.focus("#field_tissue_samples_create_workflow", 3);
                    } else {
                        jQuery('#create_tissue_samples_plant_entries_dont_exist_section').show();
                        jQuery('#create_tissue_samples_plant_entries_exist_section').hide();
                        Workflow.complete('#create_tissue_samples_select_trial');
                        Workflow.focus("#field_tissue_samples_create_workflow", 2);
                    }
                },
                error: function () {
                    jQuery("#working_modal").modal("hide");
                    alert('Ocorreu um erro ao verificar as plantas do ensaio.');
                }
            });
        }
    });

    jQuery('#create_tissue_samples_plants_per_plot_submit').click(function(){
        var is_checked;
        if(jQuery('#create_tissue_samples_plants_per_plot_inherit_treatments').is(":checked")){
            is_checked = 1;
        }

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+selected[0]+'/create_plant_entries/',
            type: 'POST',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            data: {
                'plants_per_plot' : jQuery('#create_tissue_samples_plants_per_plot_num').val(),
                'inherits_plot_treatments' : is_checked
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert("Registros de plantas criados com sucesso.");
                    Workflow.complete('#create_tissue_samples_plants_per_plot_submit');
                    Workflow.focus("#field_tissue_samples_create_workflow", 3);
                }
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert("Ocorreu um erro ao salvar os registros de plantas.");
            },
        });
    });

    jQuery('#create_tissue_samples_per_plant_num').keyup(function(){
        var num_tissues = jQuery(this).val();
        var html = '';
        for (var i=1; i<=num_tissues; i++){
            html = html + '<div class="form-group"><label class="col-sm-3 control-label"><span title="Os nomes das amostras combinarão o nome da planta, o nome de tecido informado aqui e o número do tecido."><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;Nome do tecido '+i+': </span></label><div class="col-sm-9" ><input name="create_tissue_samples_tissue_name" id="create_tissue_samples_tissue_name_'+i+'" class="form-control" type="text" placeholder="exemplos: folha, raiz, caule, semente ou fruto" /></div></div>';
        }
        jQuery('#create_tissue_samples_names_div').html(html);
    });

    jQuery('#create_tissue_samples_plants_per_plant_submit').click(function(){
        var is_checked;
        if(jQuery('#create_tissue_samples_per_plant_inherit_treatments').is(":checked")){
            is_checked = 1;
        }

        var use_tissue_numbers;
        if(jQuery('#create_tissue_samples_per_plant_use_tissue_numbers').is(":checked")){
            use_tissue_numbers = 1;
        }

        var tissue_names = [];
        jQuery('input[name="create_tissue_samples_tissue_name"]').each(function() {
            tissue_names.push(this.value);

        });

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+selected[0]+'/create_tissue_samples/',
            type: 'POST',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            data: {
                'tissue_samples_per_plant' : jQuery('#create_tissue_samples_per_plant_num').val(),
                'inherits_plot_treatments' : is_checked,
                'use_tissue_numbers' : use_tissue_numbers,
                'tissue_samples_names' : JSON.stringify(tissue_names)
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert("Registros de amostras de tecido criados com sucesso.");
                    Workflow.complete('#create_tissue_samples_plants_per_plant_submit');
                    Workflow.focus("#field_tissue_samples_create_workflow", -1); //go to success
                }
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert("Ocorreu um erro ao criar os registros de amostras de tecido.");
            },
        });
    });

});
</script>
