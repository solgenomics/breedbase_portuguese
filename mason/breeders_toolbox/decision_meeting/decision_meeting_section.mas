<%doc>Decision Meeting</%doc>

<div class="well">

  <&| /page/info_section.mas,
       title=>'Acompanhamento de reuniões',
       is_subsection=>1, collapsible=>1, collapsed=>0,
       subtitle=>'Visualize o registro de reuniões'
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="table-responsive">
          <table id="meeting_table" class="table table-striped table-bordered" width="100%">
            <thead>
              <tr>
                <th>Selecionar</th>
                <th>Reunião</th>
                <th>Programas</th>
                <th>Data</th>
                <th>Local</th>
                <th>Participantes</th>
                <th>Baixar</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </&>
</div>
