<%doc>Accession Tracker</%doc>

<& /util/import_javascript.mas, classes => ['jquery', 'CXGN.BreedersToolbox.HTMLSelect'], entries => ['decision_meeting'] &>

<div class="well">
  <&| /page/info_section.mas,
     title=>'Acessos — acompanhamento de decisões',
     is_subsection=>1, collapsible=>1, collapsed=>0,
     subtitle=>'Acompanhe as decisões de cada acesso. Use os filtros por coluna abaixo do cabeçalho.'
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <!-- Breeding Program checkbox dropdown placeholder -->
          <div id="bp_filter_placeholder" class="btn-group" style="margin-left:12px;">
            <!-- JS will inject checkbox dropdown here -->
          </div>
        </div>
        <div class="table-responsive">
          <table id="decision_table" class="table table-striped table-bordered" width="100%">
            <thead>
              <tr>
                <th>Acesso</th>
                <th>Programa de melhoramento</th>
                <th>Etapa</th>
                <th>Ano</th>
                <th>Decisão</th>
                <th>Nova etapa</th>
                <th>Genitor feminino</th>
                <th>Genitor masculino</th>
                <th>Observações</th>
              </tr>
            </thead>
          </table>
        </div>

      </div>
    </div>
  </&>

  <&| /page/info_section.mas,
       title=>'Resumo dos dados e gráficos',
       is_subsection=>1, collapsible=>1, collapsed=>0,
       subtitle=>""
    &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <label for="dataset_select" class="control-label" style="margin-right:8px;">Selecione um conjunto de dados:</label>
          <span id="dataset_select" style="display:inline-block; min-width:240px;"></span>
        </div>
        <div class="panel-body">
          <div class="table-responsive">
            <table id="summary_table" class="table table-striped table-bordered" width="100%">
              <thead>
                <tr>
                  <th>Acesso</th>
                  <th>Característica</th>
                  <th>Mín.</th>
                  <th>Máx.</th>
                  <th>Média</th>
                  <th>Desvio-padrão</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </&>

</div>
