<%args>
</%args>

<& /util/import_javascript.mas, classes => ['jquery.dataTables-buttons-min', 'jquery.iframe-post-form', 'jszip-min','buttons.bootstrap-min', 'buttons.html5-min', 'buttons.print-min'] &>

<div class="modal fade" id="upload_locations_dialog" name="upload_locations_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadLocationsDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadLocationsDialog">Enviar locais</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
                <b>Cabeçalho:</b><br>
                A primeira linha (cabeçalho) deve conter:
                <br>
                <table class="table table-bordered table-hover">
                  <tbody>
                  <tr>
                    <td>Nome</td>
                    <td>Abreviação</td>
                    <td>Código do país</td>
                    <td>Nome do país</td>
                    <td>Programa</td>
                    <td>Tipo</td>
                    <td>Latitude</td>
                    <td>Longitude</td>
                    <td>Elevação</td>
                    <td>ID da estação NOAA</td>
                  </tr>
                  </tbody>
                </table>
                <b>Valores obrigatórios:</b><br>
                <b>Nome:</b> não pode ser igual ao nome de um local existente<br>
                <b>Abreviação:</b> usada no mapa e nos envios; não pode ser igual a uma abreviação existente<br>
                <b>Código do país:</b> deve ser um <a href="https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3">código de país ISO Alfa-3</a><br>
                <b>Nome do país:</b> deve ser o nome curto em inglês, em letras maiúsculas, conforme o <a href="https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3">padrão ISO</a><br>
                <b>Programa:</b> deve ser um programa de melhoramento existente no banco de dados; vários programas devem ser separados por '&'<br>
                <b>Tipo:</b> deve ser um destes valores: Town, Farm, Field, Greenhouse, Screenhouse, Lab, Storage ou Other<br>
                <b>Latitude:</b> em graus, deve ser um número entre -90 e 90.<br>
                <b>Longitude:</b> em graus, deve ser um número entre -180 e 180.<br>
                <b>Elevação:</b> em metros, deve ser um número entre -418 (Mar Morto) e 8.848 (Monte Everest).<br>
                <br><b>Valores opcionais:</b><br>
                <b>ID da estação NOAA:</b> o ID da estação NOAA mais próxima e relevante para o local. <a href="https://www.ncdc.noaa.gov/cdo-web/search" target="_blank">Pesquisar aqui</a><br>

          <& /help/file_upload_type.mas, type => "Locations" , optional_column => 1 &>
          <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_locations_form" name="upload_locations_form">
    <label for="locations_upload_file" style="display: inline-block;">Arquivo de locais:</label>
    <input type="file" name="locations_upload_file" id="locations_upload_file" encoding="multipart/form-data" />
  </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
	<button type="button" class="btn btn-primary" name="upload_locations_dialog_submit" id="upload_locations_dialog_submit">Enviar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="locations_result_dialog" tabindex="-1" role="dialog" aria-labelledby="locationsResultDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="locationsResultDialog">Resultados</h4>
            </div>
            <div id="locations_result_body" class="container-fluid">
            </div>
            <div class="modal-footer">
                <button id="locations_result_close_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_locations_link').click( function() {
        jQuery('#upload_locations_dialog').modal("show");
    });

    jQuery('#upload_locations_dialog_submit').click( function() {
        var uploadFile = jQuery("#locations_upload_file").val();
        jQuery('#upload_locations_form').attr("action", "/ajax/locations/upload");
        if (uploadFile === '') {
            alert("Selecione um arquivo.");
            return;
        }
        jQuery("#upload_locations_form").submit();
    });

    jQuery('#upload_locations_form').iframePostForm({
        json: false,
        post: function () {
            jQuery('#working_modal').modal("show");
        },
        complete: function (r) {
            r = r.replace('<pre>', '');
            r = r.replace('</pre>', '');
            var response = JSON.parse(r);

            jQuery('#working_modal').modal("hide");
            //console.log(response);
            if (response.error) {
                var errors = [];
                for (i = 0; i < response.error.length; i++) {
                    errors.push( '<p>'+response.error[i]+'</p>');
                }
                var html = '<br><center><b>Falha no envio.</b><br><b>Corrija os seguintes erros em </b>'+response.filename+'<b> e tente novamente:</b></center><br>';
                html += errors.join('') + '<br>';
                document.getElementById('locations_result_body').innerHTML = html;
                jQuery('#locations_result_dialog').modal("show");
            }
            else {
                jQuery('#upload_locations_dialog').modal("hide");
                var saved_locations = [];
                for (var key in response) {
                    saved_locations.push( '<p>'+key+': '+response[key]+'</p>');
                }
                var html = '<br><center>'+saved_locations.join('')+'</center>';
                document.getElementById('locations_result_body').innerHTML = html;
                jQuery('#locations_result_dialog').modal("show");
                jQuery('#locations_result_close_button').click( function() {
                    location.reload();
                });
            }
        },
        error: function(response) {
            jQuery('#working_modal').modal("hide");
            alert("Ocorreu um erro durante o envio.");
        }
    });

});

</script>
