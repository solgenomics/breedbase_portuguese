
<%args>
$facilities => ()
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<& /page/page_title.mas, title=>"Gerenciar amostras de tecido" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Amostras de tecido de ensaios de campo</h4>", info_section_subtitle => 'Visualize e crie amostras de tecido para ensaios de campo. As amostras de tecido são obtidas de uma planta em uma parcela.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="tissue_sample_guided_help">Ajuda guiada para amostras de tecido de ensaios de campo</button><button class="btn btn-sm btn-primary" style="margin:3px" name="manage_tissue_samples_create_field_trial_samples">Criar amostras de tecido para um ensaio de campo</button>', icon_class => "glyphicon glyphicon-leaf", info_section_id => "manage_tissue_samples_field_trials" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Amostras de tecido em placas de genotipagem</h4>", info_section_subtitle => 'Visualize e crie amostras de tecido para placas de genotipagem. As placas representam amostras de tecido em um arranjo de 96 ou 384 poços.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="create_genotyping_trial_link">Criar ou enviar uma placa de genotipagem</button> <button class="btn btn-sm btn-primary" style="margin:3px" name="export_genotyping_trial_link">Exportar para o prestador de serviços de genotipagem</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "manage_tissue_samples_genotyping_trials" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Ensaios de amostragem</h4>", info_section_subtitle => 'Visualize e crie amostras de tecido para ensaios de amostragem genéricos.', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="create_sampling_trial_button">Criar novo ensaio de amostragem</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "manage_tissue_samples_sampling_trials" &>

<& /help/workflow_guided/tissue_sample_help.mas &>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities=>$facilities &>
<& /breeders_toolbox/create_tissue_samples_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<script>

jQuery(document).ready(function(){
    jQuery('button[name="export_genotyping_trial_link"]').click(function(){
        alert('A exportação automática para prestadores de serviços de genotipagem ainda não está disponível. Você pode baixar o arranjo e enviá-lo manualmente ao prestador.');
    });
});

</script>
