<%args>
$sampling_facilities => ();
$sample_tissue_types => ();
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>


<div class="modal fade" id="sampling_trial_dialog" name="sampling_trial_dialog" tabindex="-1" role="dialog" aria-labelledby="addSamplingTrialDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addSamplingTrialDialog">Adicionar ensaio de amostragem</h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_sampling_trials_form" name="upload_sampling_trials_form" >

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "sampling_trial_create_workflow" &>
                            <&| /util/workflow.mas:step, title=> "Introdução" &>
                                <& /page/page_title.mas, title=>"Este fluxo orientará você na adição de um ensaio de amostragem ao banco de dados" &>
                                <p>Os ensaios de amostragem podem representar placas de 96 ou 384 poços ou, de forma mais geral, qualquer esquema de amostragem.</p>
                                <p>Cada amostra tem um ID de amostra de tecido globalmente único.</p>
                                <p>O "conteúdo" de cada amostra pode ser uma amostra de tecido, o nome de uma planta, o nome de uma parcela ou o nome de um acesso. Esse nome de "origem" já deve existir no banco de dados. Ao informar uma entidade de ensaio de campo (como uma parcela, planta ou amostra de tecido), fenótipos e genótipos poderão ser comparados diretamente.</p>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "Informações básicas" &>
                                <& /page/page_title.mas, title=>"Forneça informações sobre o ensaio de amostragem" &>

                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Unidade de amostragem: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="sampling_trial_facility_select">
% foreach my $facility(@$sampling_facilities){
    <option value="<%$facility%>"><%$facility%></option>
% }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Nome do ensaio de amostragem: </label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="sampling_trial_name" name="sampling_trial_name" type="text" placeholder=" Por exemplo, 18DNA00001"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Tipo de amostra: </label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="sampling_trial_plate_sample_type">
                                            <option value="Tissue">Tecido</option>
                                            <option value="DNA">DNA</option>
                                            <option value="RNA">RNA</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Programa de melhoramento do ensaio: </label>
                                    <div class="col-sm-7">
                                        <span id="sampling_trial_breeding_program_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Local do ensaio de amostragem: </label>
                                    <div class="col-sm-7">
                                        <span id="sampling_trial_location_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Ano do ensaio de amostragem: </label>
                                    <div class="col-sm-7">
                                        <span id="sampling_trial_year_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Descrição do ensaio de amostragem: </label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="sampling_trial_description" name="sampling_trial_description" maxlength="250"></textarea>
                                    </div>
                                </div>

                                <br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Informações das amostras" &>
                                <& /page/page_title.mas, title=>"Forneça informações sobre as amostras" &>
                                <br/><br/>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Selecione uma opção: </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="sampling_trial_well_input_option">
                                            <option value="xls">Quero enviar um delineamento de amostragem criado no Excel</option>
                                            <option value="design">Preciso criar um ensaio de amostragem totalmente novo</option>
                                        </select>
                                    </div>
                                </div>

                                <div id="sampling_trial_well_upload_section">
                                    <h3>Enviar uma disposição de amostras existente</h3>

                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'Informações do modelo' &>
                                                    <p>
                                                        <b>Informações sobre o formato do arquivo</b>
                                                        <br>
                                                        <a id="sampling_trial_layout_upload_spreadsheet_info_format">Formato da planilha</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">Selecione o arquivo XLSX (ou XLS) da disposição das amostras: </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="sampling_trial_layout_upload" id="sampling_trial_layout_upload" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="sampling_trial_well_design_section" style="display:none">
                                    <h3>Criar um ensaio de amostragem totalmente novo</h3>

                                    <div class="well well-sm">
                                        <ul>
                                            <li>Selecione uma lista com o material de origem de cada amostra de tecido. Em seguida, indique quantas repetições são necessárias.</li>
                                            <li>Observação: da unidade de observação de origem mais desejável para a menos desejável, você pode escolher amostras de tecido, plantas, parcelas ou acessos.</li>
                                        </ul>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-7 control-label">Lista de unidades de observação de origem: </label>
                                        <div class="col-sm-5">
                                            <span id="sampling_trial_accession_select_box_span">[Carregando...]</span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-7 control-label">Repetições: </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_replicates" name="sampling_trial_replicates" type="number" placeholder="1"/>
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Concentração da amostra (ng/µl): <small>(se foi usada a mesma concentração para todas as amostras)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_concentration" name="sampling_trial_concentration" type="text" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Volume de amostragem (µl): <small>(se foi usado o mesmo volume para todas as amostras)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_volume" name="sampling_well_volume" type="text" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Tecido: <small>(se foi usado o mesmo tecido para todas as amostras)</small> </label>
                                        <div class="col-sm-5">
                                            <select class="form-control" id="sampling_trial_tissue">
% foreach my $tissue_type(@$sample_tissue_types){
    <option value="<%$tissue_type%>"><%$tissue_type%></option>
% }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> ID de taxonomia do NCBI: <small>(ID oficial do NCBI)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_ncbi_taxonomy_id" name="sampling_trial_ncbi_taxonomy_id" type="text" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Extração: <small>(se foi usada a mesma extração para todas as amostras)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_extraction" name="sampling_trial_extraction" type="text" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Responsável: <small>(se a mesma pessoa preparou todas as amostras)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_person" name="sampling_trial_person" type="text" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Dados: <small>(se todas as amostras foram coletadas na mesma data; AAAA/MM/DD)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_date" name="sampling_trial_date" type="text" placeholder="AAAA/MM/DD"/>
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>Opcional</i> Observações: <small>(observações adicionais sobre estas amostras)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="sampling_trial_notes" name="sampling_trial_notes" type="text" />
                                        </div>
                                    </div>
                                </div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Vinculação" &>
                                <& /page/page_title.mas, title=>"O ensaio de amostragem está vinculado a ensaios de campo no banco de dados? Esta informação também pode ser adicionada na página de detalhes após o ensaio ser salvo." &>

                                <p>Se você informou a origem da amostra (por exemplo, o nome de uma parcela, planta ou amostra de tecido de um ensaio de campo), a vinculação entre o(s) ensaio(s) de campo e este ensaio de amostragem será criada automaticamente.</p>

                                <br/>
                                <center>
                                <button class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" >Continuar para a próxima etapa</button>
                                <center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Confirmar" &>
                                <& /page/page_title.mas, title=>"Finalize e envie o ensaio de amostragem" &>

                                <hr>
                                <center>
                                <button type="button" class="btn btn-primary" name="add_sampling_trial_submit" id="add_sampling_trial_submit">Enviar</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:complete, title=> "Concluído" &>
                                <& /page/page_title.mas, title=>"Concluído! Seu ensaio de amostragem foi salvo no banco de dados." &>

                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    O ensaio de amostragem foi salvo com sucesso.
                                </p>

                            </&>
                        </&>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sampling_trial_layout_upload_spreadsheet_info_format_dialog" name="sampling_trial_layout_upload_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSamplingTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSamplingTrialInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Use esta opção para enviar a disposição de um ensaio de amostragem já existente.</b>
                    <br/>
                    <b>O arquivo deve estar no formato Excel (.xls ou .xlsx).</b>
                    <br />
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>Data</td>
                                <td>sample_name</td>
                                <td>source_observation_unit_name</td>
                                <td>sample_number</td>
                                <td>Replicar</td>
                                <td>tissue_type</td>
                                <td>ncbi_taxonomy_id</td>
                                <td>Pessoa</td>
                                <td>Notas</td>
                                <td>extração</td>
                                <td>concentração</td>
                                <td>volume</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li>date (deve estar no formato AAAA-MM-DD)</li>
                    <li>sample_name (identificador globalmente único da amostra)</li>
                    <li>source_observation_unit_name (deve existir no banco de dados; é o identificador do material de origem. Da opção mais recomendada para a menos recomendada, podem ser usados: nome da amostra de tecido, nome da planta, nome da parcela ou nome do acesso. Para poços vazios, informe BLANK neste campo e também 1 na coluna is_blank.)</li>
                    <li>sample_number (número da amostra; deve ser único neste ensaio de amostragem)</li>
                    <li>replicate (número da repetição da amostra)</li>
% my $tissue_string = join(', ', @$sample_tissue_types);
                    <li>tissue_type (deve ser um destes valores: <% $tissue_string %>)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                    <li>ncbi_taxonomy_id (identificador de taxonomia do NCBI)</li>
                    <li>person (nome da pessoa que preparou a amostra)</li>
                    <li>notes (observações adicionais sobre a amostra)</li>
                    <li>extraction (texto livre para o método de extração, por exemplo, CTAB)</li>
                    <li>concentration (concentração em ng/µl)</li>
                    <li>volume (volume em µl)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_sampling_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery('button[name="create_sampling_trial_button"]').click(function(){
        jQuery('#sampling_trial_dialog').modal('show');
    });

    jQuery('#sampling_trial_dialog').on('show.bs.modal', function (e) {
        get_select_box("locations", "sampling_trial_location_select_div", {'id':'sampling_trial_location_select', 'name':'sampling_trial_location_select'});
        get_select_box("breeding_programs", "sampling_trial_breeding_program_select_div", {'id':'sampling_trial_breeding_program_select', 'name':'sampling_trial_breeding_program_select'});
        get_select_box("years", "sampling_trial_year_select_div", {'auto_generate': 1, 'id':'sampling_trial_year_select', 'name':'sampling_trial_year_select'});

        var l = new CXGN.List();
        var html = l.listSelect('sampling_trial_accession_select_box', [ 'accessions', 'plots', 'plants', 'tissue_samples' ], undefined, undefined, undefined);
        jQuery('#sampling_trial_accession_select_box_span').html(html);
    });

    jQuery('#sampling_trial_layout_upload_spreadsheet_info_format').click(function(){
        jQuery('#sampling_trial_layout_upload_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#sampling_trial_well_input_option').change(function(){
        if (jQuery(this).val() == 'xls'){
            jQuery("#sampling_trial_well_upload_section").show();
            jQuery("#sampling_trial_well_design_section").hide();
        }
        if (jQuery(this).val() == 'design' ){
            jQuery("#sampling_trial_well_design_section").show();
            jQuery("#sampling_trial_well_upload_section").hide();
            jQuery('#sampling_trial_layout_upload').val('');
        }
    });

    var sampling_data = new Object();
    jQuery('#add_sampling_trial_submit').click(function () {
        sampling_data = new Object();
        sampling_data.breeding_program = jQuery('#sampling_trial_breeding_program_select').val();
        sampling_data.year = jQuery('#sampling_trial_year_select').val();
        sampling_data.sampling_facility = jQuery('#sampling_trial_facility_select').val();
        sampling_data.location = jQuery('#sampling_trial_location_select').val();
        sampling_data.description = jQuery('#sampling_trial_description').val();
        sampling_data.replicates = jQuery('#sampling_trial_replicates').val();
        sampling_data.name = jQuery('#sampling_trial_name').val();
        sampling_data.sample_type = jQuery('#sampling_trial_plate_sample_type').val();
        sampling_data.sample_concentration = jQuery('#sampling_trial_concentration').val();
        sampling_data.ncbi_taxonomy_id = jQuery('#sampling_trial_ncbi_taxonomy_id').val();
        sampling_data.sample_extraction = jQuery('#sampling_trial_extraction').val();
        sampling_data.sample_date = jQuery('#sampling_trial_date').val();
        sampling_data.sample_person = jQuery('#sampling_trial_person').val();
        sampling_data.sample_volume = jQuery('#sampling_trial_volume').val();
        sampling_data.sample_tissue = jQuery('#sampling_trial_tissue').val();
        sampling_data.sample_notes = jQuery('#sampling_trial_notes').val();

        if (sampling_data.breeding_program == '') {
            alert("É necessário selecionar um programa de melhoramento. Tente novamente.");
            return;
        }
        if (sampling_data.year == '') {
            alert("É necessário informar o ano. Tente novamente.");
            return;
        }
        if (sampling_data.location == '') {
            alert("É necessário selecionar um local. Tente novamente.");
            return;
        }
        if (sampling_data.name == '') {
            alert("É necessário informar um nome de ensaio de amostragem que seja único no banco de dados. Tente novamente.");
            return;
        }
        if (sampling_data.description == '') {
            alert("É necessário informar a descrição do ensaio de amostragem. Tente novamente.");
            return;
        }
        if (sampling_data.sample_type == '') {
            alert("É necessário selecionar o tipo do ensaio de amostragem. Tente novamente.");
            return;
        }
        if (sampling_data.replicates == '') {
            sampling_data.replicates = 1;
        }

        var uploadFileXLS = jQuery("#sampling_trial_layout_upload").val();
        if (uploadFileXLS === ''){
            sampling_data.list_id = jQuery('#sampling_trial_accession_select_box_list_select').val();
            var l = new CXGN.List();
            if (! l.validate(sampling_data.list_id, 'accessions', true) && ! l.validate(sampling_data.list_id, 'plots', true) && ! l.validate(sampling_data.list_id, 'plants', true) && ! l.validate(sampling_data.list_id, 'tissue_samples', true)) {
                alert('A lista contém elementos que não são acessos, parcelas, plantas nem amostras de tecido.');
                return;
            }
            var elements = l.getList(sampling_data.list_id);
            if (typeof elements == 'undefined' ) {
                alert("A lista fornecida não contém elementos.");
                return;
            }
            sampling_data.elements = elements;

            jQuery.ajax({
                url: '/ajax/breeders/generatesamplingtrial',
                method: 'POST',
                beforeSend: function(){
                    jQuery("working_modal").modal('show');
                },
                data: {
                    'sampling_data': JSON.stringify(sampling_data)
                },
                success : function(response) {
                    console.log(response);
                    jQuery("working_modal").modal('hide');
                    if (response.error) {
                        alert(response.error);
                    }
                    else {
                        sampling_data.design = response.design;
                        store_sampling_trial(sampling_data);
                    }
                },
                error: function(response) {
                    alert('Ocorreu um erro ao tentar criar a disposição do ensaio de amostragem.');
                    jQuery("working_modal").modal('hide');
                }
            });
        }
        else {
            jQuery('#upload_sampling_trials_form').attr("action", "/ajax/breeders/parsesamplingtrial");
            jQuery("#upload_sampling_trials_form").submit();
        }
    });

    jQuery('#upload_sampling_trials_form').iframePostForm({
        json: true,
        post: function () {
        },
        complete: function (response) {
            console.log(response);
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                sampling_data.design = response.design;
                store_sampling_trial(sampling_data);
            }
        }
    });

    function store_sampling_trial(sampling_data) {
        jQuery.ajax({
            url: '/ajax/breeders/storesamplingtrial',
            method: 'POST',
            beforeSend: function(){
                jQuery("#working_modal").modal('show');
            },
            data: {
                'sampling_data': JSON.stringify(sampling_data)
            },
            success : function(response) {
                jQuery("#working_modal").modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert(response.message);
                    Workflow.complete('#add_sampling_trial_submit');
                    Workflow.focus("#sampling_trial_create_workflow", -1); //Go to success page
                    Workflow.check_complete("#sampling_trial_create_workflow");
                }
            },
            error: function(response) {
                alert('Ocorreu um erro ao tentar criar a disposição.');
                jQuery("#working_modal").modal('hide');
            }
        });
    }

});
</script>
