<%args>
$timestamp => localtime()
$default_seedlot_material_type => undef
</%args>

<div class="modal falde" id="create_seedlots_trial_dialog" name="create_seedlots_trial_dialog" tabindex="-1" aria-labelledby="create_seedlots_trial_dialog_title">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="create_seedlots_trial_dialog_title">Criar lotes de sementes a partir de um ensaio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <!-- CREATE SEEDLOTS WORKFLOW -->
                    <&| /util/workflow.mas, id=> "create_seedlots_trial_workflow" &>


                        <!-- STEP 1: Intro -->
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Introdução" &>
                            <p>
                                Este fluxo orienta a criação de lotes de sementes a partir dos acessos de um ensaio
                                de campo. Você pode criar um novo lote para cada parcela ou acesso único do ensaio.
                                Também é possível definir o conteúdo inicial do lote (quantidade ou peso) usando
                                o valor de uma característica registrada no ensaio.
                            </p>
                            <br/><br/>
                            <div style="text-align: center">
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <!-- STEP 2: Select Trial -->
                        <&| /util/workflow.mas:step, title=> "Selecionar ensaio" &>
                            <& /page/page_title.mas, title=>"Selecione um ensaio de campo" &>
                            <p>
                                Informe o nome do ensaio de campo a partir do qual os lotes serão criados:
                            </p>
                            <br /><br />
                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Ensaio: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="create_seedlots_trial_name" placeholder="Nome do ensaio..." value="">
                                </div>
                            </div>
                            <br /><br /><br /><br />
                            <div class="alert alert-danger" id="trial_error_message_container" style="display: none">
                                <p id="trial_error_message"></p>
                            </div>
                            <br/><br/>
                            <div style="text-align: center">
                                <button id="create_seedlots_trial_complete_select_trial" class="btn btn-primary">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <!-- STEP 3: Select Seedlots -->
                        <&| /util/workflow.mas:step, title=> "Selecionar lotes de sementes" &>
                            <& /page/page_title.mas, title=>"Selecionar lotes de sementes" &>

                            <p>
                                É possível gerar lotes de sementes para cada <strong>acesso</strong> ou <strong>parcela</strong>
                                <span class='create_seedlots_trial_subplots_available'> ou <strong>subparcela</strong></span>
                                <span class='create_seedlots_trial_plants_available'> ou <strong>planta</strong></span>
                                deste ensaio.
                            </p>
                            <ul>
                                <li>Se você selecionar <strong>acessos</strong>: <span id="create_seedlots_trial_accession_count"></span> lotes de sementes serão criados</li>
                                <li>Se você selecionar <strong>parcelas</strong>: <span id="create_seedlots_trial_plot_count"></span> lotes de sementes serão criados</li>
                                <li class='create_seedlots_trial_subplots_available_list'>Se você selecionar <strong>subparcelas</strong>: <span id="create_seedlots_trial_subplot_count"></span> lotes de sementes serão criados</li>
                                <li class='create_seedlots_trial_plants_available_list'>Se você selecionar <strong>plantas</strong>: <span id="create_seedlots_trial_plant_count"></span> lotes de sementes serão criados</li>
                            </ul>

                            <br /><br />

                            <div class="form-group">
                                <div class="col-sm-3"></div>
                                <div class="col-sm-6" >
                                    <select id="create_seedlots_trial_stock_type" class="form-control">
                                        <option value="accessions">Acessos</option>
                                        <option value="plots">Parcelas</option>
                                        <option class="create_seedlots_trial_subplots_available" value="subplots">Subparcelas</option>
                                        <option class="create_seedlots_trial_plants_available" value="plants">Plantas</option>
                                    </select>
                                </div>
                                <div class="col-sm-3"></div>
                            </div>

                            <br/><br/><br /><br />
                            <div style="text-align: center">
                                <button id="create_seedlots_trial_complete_select_stock_type" class="btn btn-primary">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <!-- STEP 4: Name Seedlots -->
                        <&| /util/workflow.mas:step, title=> "Nomear lotes de sementes" &>
                            <& /page/page_title.mas, title=>"Nomear lotes de sementes" &>

                            <p>
                                Informe um modelo para nomear os novos lotes. As variáveis abaixo, entre chaves, podem ser usadas no modelo e serão substituídas pelos valores correspondentes.
                            </p>
                            <ul>
                                <li><code>trial_name</code></li>
                                <li><code>accession_name</code></li>
                                <li class="plot_level_variable"><code>plot_name</code></li>
                                <li class="plot_level_variable"><code>plot_number</code></li>
                                <li class="plot_level_variable"><code>rep</code></li>
                                <li class="plot_level_variable"><code>block</code></li>
                                <li class="subplot_level_variable"><code>subplot_name</code></li>
                                <li class="subplot_level_variable"><code>subplot_index</code></li>
                                <li class="plant_level_variable"><code>plant_name</code></li>
                                <li class="plant_level_variable"><code>plant_index</code></li>
                                <li><code>index</code> - um número sequencial iniciado em 1</li>
                            </ul>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Modelo de nome: </label>
                                <div class="col-sm-7" >
                                    <input class="form-control" id="create_seedlots_trial_name_template" value="">
                                </div>
                                <div class="col-sm-2">
                                    <button id="create_seedlots_trial_name_update" type="button" class="btn btn-primary btn-block" disabled>Atualizar</button>
                                </div>
                            </div>

                            <br /><br /><br />

                            <div style="text-align: center">
                                <button id="create_seedlots_trial_complete_name_seedlots" class="btn btn-primary">Ir para a próxima etapa</button>
                            </div>

                            <br /><br />

                            <h4>Nomes dos lotes de sementes</h4>
                            <table id="create_seedlots_trial_name_table" class="table table-striped table-hover"></table>
                        </&>

                        <!-- STEP 5: Seedlot Contents -->
                        <&| /util/workflow.mas:step, title=> "Definir conteúdo" &>
                            <& /page/page_title.mas, title=>"Definir conteúdo dos lotes de sementes" &>

                            <p>
                                Cada lote precisa de um conteúdo inicial (quantidade ou peso). Você pode definir
                                o mesmo valor para todos os lotes, usar uma característica registrada no ensaio
                                ou calcular um novo valor a partir das características registradas. Ao criar um
                                lote por acesso e usar uma característica ou um valor calculado, será usada a
                                soma dos valores das parcelas daquele acesso. O conteúdo de cada lote pode
                                ser alterado na tabela abaixo antes da criação.
                            </p>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Tipo de conteúdo: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="create_seedlots_trial_contents_type">
                                        <option value="amount">Quantidade / Contagem</option>
                                        <option value="weight">Peso</option>
                                    </select>
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Valor do conteúdo: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="create_seedlots_trial_contents_value">
                                        <option value="constant">Valor constante</option>
                                        <option value="trait">Valor de característica</option>
                                        <option value="computed">Valor calculado a partir das características</option>
                                    </select>
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group" id="create_seedlots_trial_contents_constant_form">
                                <label class="col-sm-3 control-label" style="text-align: right">Constante: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="create_seedlots_trial_contents_constant" value="1">
                                </div>
                            </div>

                            <div class="form-group" id="create_seedlots_trial_contents_trait_form" style="display: none">
                                <label class="col-sm-3 control-label" style="text-align: right">Característica: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="create_seedlots_trial_contents_trait"></select>
                                </div>
                            </div>

                            <div class="form-group" id="create_seedlots_trial_contents_computed_form" style="display: none">
                                <label class="col-sm-3 control-label" style="text-align: right">Variáveis das características: </label>
                                <div class="col-sm-9">
                                    <p>
                                        Use as variáveis abaixo para representar os valores das características no cálculo
                                        do conteúdo inicial dos lotes. Ao criar um lote <strong>por parcela</strong>, será usado
                                        o valor da característica daquela parcela. Ao criar um lote <strong>por acesso</strong>,
                                        será usada a soma dos valores das parcelas daquele acesso.
                                    </p>
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Variável</th>
                                                <th>Característica</th>
                                            </tr>
                                        </thead>
                                        <tbody id="create_seedlots_trial_contents_computed_table"></tbody>
                                    </table>
                                </div>

                                <label class="col-sm-3 control-label" style="text-align: right">Fórmula do conteúdo: </label>
                                <div class="col-sm-9">
                                    <input class="form-control" id="create_seedlots_trial_contents_computed_formula" value="" placeholder="{trait_1}/10">
                                    <p>
                                        <strong>OBSERVAÇÃO:</strong> a fórmula é calculada em JavaScript. Você pode usar operadores
                                        básicos (+-*/) e funções de Math, como Math.abs(x).
                                    </p>
                                </div>

                                <div class="col-sm-12" style="text-align: center; margin: 25px 0">
                                    <button id="create_seedlots_trial_complete_computed_compute" class="btn btn-primary" disabled>Calcular</button>
                                </div>
                            </div>

                            <br /><br />

                            <div style="text-align: center">
                                <button id="create_seedlots_trial_complete_set_contents" class="btn btn-primary">Ir para a próxima etapa</button>
                            </div>

                            <br /><br />

                            <h4>Conteúdo dos lotes de sementes</h4>
                            <table id="create_seedlots_trial_contents_table" class="table table-striped table-hover"></table>
                        </&>

                        <!-- STEP 6: Seedlot Metadata -->
                        <&| /util/workflow.mas:step, title=> "Definir metadados" &>
                            <& /page/page_title.mas, title=>"Definir metadados dos lotes de sementes" &>

                            <p>
                                Os metadados abaixo são necessários para cada lote. Preencha o formulário acima
                                para aplicá-los a todos os lotes. Depois, altere os dados de cada lote
                                individualmente na tabela abaixo, se necessário.
                            </p>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Programa de melhoramento: </label>
                                <div class="col-sm-9" >
                                    <div id="create_seedlots_trial_breeding_program_div"></div>
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Local: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_location" value="" placeholder="Obrigatório">
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Nome da caixa: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_box_name" value="" placeholder="Obrigatório">
                                </div>
                            </div>

                            <br /><br />
%if ($default_seedlot_material_type) {
                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Tipo de material: </label>
                                <div class="col-sm-9">
                                    <input class="form-control" name="create_seedlots_trial_default_material_type" id="create_seedlots_trial_default_material_type" disabled value="<% $default_seedlot_material_type %>">
                                </div>
                            </div>
% } else {
                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Tipo de material: </label>
                                <div class="col-sm-9" >
                                    <div id="create_seedlots_trial_material_type_div"></div>
                                </div>
                            </div>
% }
                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Problemas de qualidade: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_quality_issues" value="" placeholder="Opcional: descreva os problemas de qualidade ou informe 'bom' para sementes de boa qualidade">
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Organização: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_organization" value="" placeholder="Opcional">
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Data e hora: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_timestamp" value="<% $timestamp %>" placeholder="<% $timestamp %>">
                                </div>
                            </div>

                            <br /><br />

                            <div class="form-group">
                                <label class="col-sm-3 control-label" style="text-align: right">Descrição: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control create_seedlots_trial_metadata_input" id="create_seedlots_trial_description" value="" placeholder="Opcional">
                                </div>
                            </div>

                            <br /><br /><br />

                            <div style="text-align: center">
                                <button id="create_seedlots_trial_update_metadata" class="btn btn-primary">Atualizar</button>
                                <br />
                                <button id="create_seedlots_trial_complete_set_metadata" class="btn btn-primary" disabled>Ir para a próxima etapa</button>
                            </div>

                            <br /><br />

                            <h4>Metadados dos lotes de sementes</h4>
                            <table id="create_seedlots_trial_metadata_table" class="table table-striped table-hover"></table>
                        </&>

                        <!-- STEP 7: Confirm -->
                        <&| /util/workflow.mas:step, title=> "Confirmar" &>
                            <& /page/page_title.mas, title=>"Confirmar lotes de sementes" &>

                            <p>
                                Confira os dados dos novos lotes na tabela abaixo. Se houver alguma informação
                                incorreta, volte à etapa anterior e corrija-a. Quando todos os dados estiverem
                                corretos, avance para a próxima etapa para criar os lotes.
                            </p>

                            <br /><br />

                            <div style="text-align: center">
                                <button id="create_seedlots_trial_complete_confirm_seedlots" class="btn btn-primary">
                                    <span class="glyphicon glyphicon-ok"></span>&nbsp;Criar lotes de sementes
                                </button>
                            </div>

                            <br /><br />

                            <h4>Lotes de sementes a criar</h4>
                            <table id="create_seedlots_trial_confirm_table" class="table table-striped table-hover"></table>
                        </&>

                        <!-- STEP 8: Create -->
                        <&| /util/workflow.mas:step, title=> "Criar" &>
                            <& /page/page_title.mas, title=>"Criar lotes de sementes" &>

                            <br /><br />

                            <div id="create_seedlots_trial_uploading">
                                <p id="create_seedlots_trial_status"><strong>Criando lotes de sementes...</strong></p>
                                <div class="progress">
                                    <div id="create_seedlots_trial_progress" class="progress-bar" role="progressbar" aria-valuenow="70"
                                    aria-valuemin="0" aria-valuemax="100" style="width:70%">
                                        <span class="sr-only">70% concluído</span>
                                    </div>
                                </div>
                            </div>

                            <div id="create_seedlots_trial_results"></div>

                            <br /><br />

                            <h4>Progresso dos lotes de sementes</h4>
                            <table id="create_seedlots_trial_results_table" class="table table-striped table-hover"></table>
                        </&>

                    </&>

                </div>
            </div>
        </div>
    </div>
</div>


<style>

</style>


<script type="text/javascript">
    let TRIAL_ID;
    let BREEDING_PROGRAM_ID;
    let ACCESSIONS;
    let PLOTS;
    let SUBPLOTS;
    let PLANTS;
    let TRAITS;
    let TRAIT_DATA;
    let SEEDLOTS;
    const UPLOAD_BATCH_SIZE = 5;

    jQuery(document).ready(function() {

        // Click / Change Listeners
        jQuery('[name="create_seedlots_trial_button"]').click( function() {
            jQuery('#create_seedlots_trial_dialog').modal('show');
        });
        jQuery("#create_seedlots_trial_complete_select_trial").click(completeSelectTrial);
        jQuery("#create_seedlots_trial_complete_select_stock_type").click(completeSelectStockType);
        jQuery("#create_seedlots_trial_name_template").keyup(function() {
            jQuery("#create_seedlots_trial_name_update").attr("disabled", false);
            jQuery("#create_seedlots_trial_complete_name_seedlots").attr("disabled", true);
        });
        jQuery("#create_seedlots_trial_name_update").click(updateSeedlotNames);
        jQuery(document).on('keyup', '.create_seedlots_trial_name_seedlot', function() {
            let el = jQuery(this);
            let index = el.data("index");
            let name = el.val();
            SEEDLOTS[index].name = name;
        });
        jQuery("#create_seedlots_trial_complete_name_seedlots").click(completeNameSeedlots);
        jQuery("#create_seedlots_trial_contents_value").change(function() {
            let val = jQuery("#create_seedlots_trial_contents_value").val();
            jQuery("#create_seedlots_trial_contents_constant_form").css("display", val === "constant" ? "block" : "none");
            jQuery("#create_seedlots_trial_contents_trait_form").css("display", val === "trait" ? "block" : "none");
            jQuery("#create_seedlots_trial_contents_computed_form").css("display", val === "computed" ? "block" : "none");
            jQuery("#create_seedlots_trial_complete_set_contents").attr("disabled", val === "computed");
        });
        jQuery("#create_seedlots_trial_contents_value").change(updateSeedlotContents);
        jQuery("#create_seedlots_trial_contents_constant").keyup(updateSeedlotContents);
        jQuery("#create_seedlots_trial_contents_trait").change(function() {
            let id = jQuery("#create_seedlots_trial_contents_trait").val();
            let name = jQuery("#create_seedlots_trial_contents_trait option:selected").text();
            if ( id && name ) {
                updateSeedlotContents();
            }
        });
        jQuery("#create_seedlots_trial_contents_computed_formula").keyup(function() {
            jQuery("#create_seedlots_trial_complete_computed_compute").attr("disabled", false);
            jQuery("#create_seedlots_trial_complete_set_contents").attr("disabled", true);
        });
        jQuery("#create_seedlots_trial_complete_computed_compute").click(updateSeedlotContents);
        jQuery(document).on('keyup', '.create_seedlots_trial_contents_seedlot', function() {
            let el = jQuery(this);
            let index = el.data("index");
            let contents = el.val();
            SEEDLOTS[index].contents = contents;
        });
        jQuery("#create_seedlots_trial_complete_set_contents").click(completeSeedlotContents);
        jQuery("#create_seedlots_trial_update_metadata").click(function() { updateSeedlotMetadata() });
        jQuery(document).on('change', "#create_seedlots_trial_breeding_program_id", function() {
            jQuery("#create_seedlots_trial_update_metadata").attr("disabled", false);
            jQuery("#create_seedlots_trial_complete_set_metadata").attr("disabled", true);
        });
        jQuery(".create_seedlots_trial_metadata_input").keyup(function() {
            jQuery("#create_seedlots_trial_update_metadata").attr("disabled", false);
            jQuery("#create_seedlots_trial_complete_set_metadata").attr("disabled", true);
        });
        jQuery(document).on('change', '.create_seedlots_trial_metadata_input_seedlot_breeding_program', function() {
            let el = jQuery(this);
            let sel = el.find("option:selected");
            let index = el.data("index");
            let id = el.val();
            let name = sel.text();
            SEEDLOTS[index].metadata.breeding_program = { id: id, name: name };
        });
        jQuery(document).on('keyup', '.create_seedlots_trial_metadata_input_seedlot', function() {
            let el = jQuery(this);
            let index = el.data("index");
            let prop = el.data("prop");
            let value = el.val();
            SEEDLOTS[index].metadata[prop] = value;
        });
        jQuery("#create_seedlots_trial_complete_set_metadata").click(completeSeedlotMetadata);
        jQuery("#create_seedlots_trial_complete_confirm_seedlots").click(completeSeedlotConfirmation);

        // Autocomplete
        jQuery("#create_seedlots_trial_name").autocomplete({
            source: '/ajax/trials/trial_autocomplete'
        });
        jQuery("#create_seedlots_trial_location").autocomplete({
            source: '/ajax/stock/geolocation_autocomplete',
        });

        // Breeding Program Select Box
        get_select_box('breeding_programs', 'create_seedlots_trial_breeding_program_div', { 'name' : 'create_seedlots_trial_breeding_program_id', 'id' : 'create_seedlots_trial_breeding_program_id' });
        //Material Type Select Box
        get_select_box('material_types', 'create_seedlots_trial_material_type_div', { 'name' : 'create_seedlots_trial_material_type', 'id' : 'create_seedlots_trial_material_type' });

    });



    //
    // WORKFLOW FUNCTIONS
    //

    /**
     * Complete the Select Trial step
     * - Get details of selected trial
     */
    async function completeSelectTrial() {

        // Make sure trial name was entered
        let trial_name = jQuery("#create_seedlots_trial_name").val();
        if ( !trial_name || trial_name === '' ) {
            alert("Informe o nome de um ensaio para continuar");
            return;
        }

        // Display working modal and disable button
        jQuery('#working_modal').modal("show");
        jQuery("#create_seedlots_trial_complete_select_trial").attr("disabled", true);
        jQuery("#trial_error_message_container").hide();

        try {
            TRIAL_ID = await getTrialID(trial_name);
            if ( TRIAL_ID ) {
                const { breeding_program_id, accessions, plots, subplots, plants, traits } = await getTrialDetails(TRIAL_ID);
                BREEDING_PROGRAM_ID = breeding_program_id;
                ACCESSIONS = accessions;
                PLOTS = plots;
                SUBPLOTS = subplots;
                PLANTS = plants;
                TRAITS = traits || [];
                TRAIT_DATA = await getTraitData(TRAITS);
            }

            // Hide the working modal, renable the button, and continue (if complete)
            jQuery('#working_modal').modal("hide");
            jQuery("#create_seedlots_trial_complete_select_trial").attr("disabled", false);
            jQuery("#create_seedlots_trial_accession_count").html(ACCESSIONS ? ACCESSIONS.length : '');
            jQuery("#create_seedlots_trial_plot_count").html(PLOTS ? PLOTS.length : '');
            jQuery("#create_seedlots_trial_subplot_count").html(SUBPLOTS ? SUBPLOTS.length : '');
            jQuery("#create_seedlots_trial_plant_count").html(PLANTS ? PLANTS.length : '');
            jQuery(".create_seedlots_trial_subplots_available").css("display", SUBPLOTS && SUBPLOTS.length > 0 ? 'inline' : 'none');
            jQuery(".create_seedlots_trial_plants_available").css("display", PLANTS && PLANTS.length > 0 ? 'inline' : 'none');
            jQuery(".create_seedlots_trial_subplots_available_list").css("display", SUBPLOTS && SUBPLOTS.length > 0 ? 'list-item' : 'none');
            jQuery(".create_seedlots_trial_plants_available_list").css("display", PLANTS && PLANTS.length > 0 ? 'list-item' : 'none');
            Workflow.complete('#create_seedlots_trial_complete_select_trial');
            Workflow.focus("#create_seedlots_trial_workflow", 2);
        }
        catch (err) {
            jQuery('#working_modal').modal("hide");
            jQuery("#create_seedlots_trial_complete_select_trial").attr("disabled", false);
            jQuery("#trial_error_message").html(err || 'Ocorreu um erro desconhecido!');
            jQuery("#trial_error_message_container").show();
        };
    }

    /**
     * Complete the stock type selection step
     * - Setup the initial Seedlots
     */
    function completeSelectStockType() {
        let stock_type = jQuery("#create_seedlots_trial_stock_type").val();

        // Hide the plot-level variables, if stock type is not plots
        jQuery(".plot_level_variable").css("display", ["plots", "subplots", "plants"].includes(stock_type) ? "list-item" : "none");
        jQuery(".subplot_level_variable").css("display", stock_type === 'subplots' ? "list-item" : "none");
        jQuery(".plant_level_variable").css("display", stock_type === 'plants' ? "list-item" : "none");
        jQuery("#create_seedlots_trial_name_template").val(
            stock_type === "plots" ? "{trial_name}-{accession_name}-{rep}" :
            stock_type === "subplots" ? "{trial_name}-{accession_name}-subplot{subplot_index}" :
            stock_type === "plants" ? "{trial_name}-{accession_name}-plant{plant_index}" :
            "{trial_name}-{accession_name}"
        );

        // Build the Seedlots
        SEEDLOTS = [];
        if ( stock_type === 'accessions' ) {
            for ( let i = 0; i < ACCESSIONS.length; i++ ) {
                SEEDLOTS.push({
                    accession: ACCESSIONS[i],
                    name: ""
                });
            }
        }
        else if ( stock_type === 'plots' ) {
            for ( let i = 0; i < PLOTS.length; i++ ) {
                SEEDLOTS.push({
                    plot: PLOTS[i].plot,
                    accession: PLOTS[i].accession,
                    name: ""
                });
            }
        }
        else if ( stock_type === 'subplots' ) {
            for ( let i = 0; i < SUBPLOTS.length; i++ ) {
                SEEDLOTS.push({
                    plot: SUBPLOTS[i].plot,
                    subplot: SUBPLOTS[i].subplot,
                    accession: SUBPLOTS[i].accession,
                    name: ""
                });
            }
        }
        else if ( stock_type === 'plants' ) {
            for ( let i = 0; i < PLANTS.length; i++ ) {
                SEEDLOTS.push({
                    plot: PLANTS[i].plot,
                    plant: PLANTS[i].plant,
                    accession: PLANTS[i].accession,
                    name: ""
                });
            }
        }
        else {
            alert("ERRO: tipo de material do lote desconhecido!");
        }

        Workflow.complete('#create_seedlots_trial_complete_select_stock_type');
        Workflow.focus("#create_seedlots_trial_workflow", 3);
        updateSeedlotNames();
    }

    /**
     * Complete the seedlot name step
     * - Make sure names are unique
     * - Setup trait information
     */
    function completeNameSeedlots() {

        // Make sure Seedlot names are unique
        let unique = true;
        let names = [];
        for ( let i = 0; i < SEEDLOTS.length; i++ ) {
            if ( names.includes(SEEDLOTS[i].name) ) {
                alert("Os nomes dos lotes devem ser únicos — '" + SEEDLOTS[i].name + "' está sendo usado mais de uma vez");
                return;
            }
            names.push(SEEDLOTS[i].name);
        }

        // Set trait values
        let html = "<option value=''>Selecione uma característica...</option>";
        for ( let i = 0; i < TRAITS.length; i++ ) {
            html += "<option value='" + TRAITS[i].id + "'>" + TRAITS[i].name + "</option>";
        }
        jQuery("#create_seedlots_trial_contents_trait").html(html);

        Workflow.complete('#create_seedlots_trial_complete_name_seedlots');
        Workflow.focus("#create_seedlots_trial_workflow", 4);
        updateSeedlotContents();

    }

    /**
     * Complete the seedlot contents step
     */
    function completeSeedlotContents() {
        jQuery("#create_seedlots_trial_breeding_program_id").val(BREEDING_PROGRAM_ID);
        Workflow.complete('#create_seedlots_trial_complete_set_contents');
        Workflow.focus("#create_seedlots_trial_workflow", 5);
        updateSeedlotMetadata(true);
    }

    /**
     * Complete the seedlot metadata step
     */
    function completeSeedlotMetadata() {
        Workflow.complete('#create_seedlots_trial_complete_set_metadata');
        Workflow.focus("#create_seedlots_trial_workflow", 6);
        updateSeedlotDetails();
    }

    /**
     * Complete the seedlot confirmation step
     * - Start uploading Seedlots to DB
     */
    async function completeSeedlotConfirmation() {
        Workflow.complete('#create_seedlots_trial_complete_confirm_seedlots');
        Workflow.focus("#create_seedlots_trial_workflow", 7);
        const { upload_count, errors } = await uploadSeedlots();
        displayUploadResults(errors, upload_count);
    }



    //
    // HELPER FUNCTIONS
    //


    /**
     * Set the name of each seedlot - using the template and replacing the values
     * then update the table displaying the results
     */
    function updateSeedlotNames() {
        let trial_name = jQuery("#create_seedlots_trial_name").val();
        let stock_type = jQuery("#create_seedlots_trial_stock_type").val();
        let name_template = jQuery("#create_seedlots_trial_name_template").val();
        if ( name_template === '{plot_name}' ) {
            return alert("O nome do lote não pode ser igual ao nome da parcela. Adicione um prefixo ou sufixo para torná-lo único");
        }

        let html = "<thead></tr>";
        if ( stock_type === 'accessions' ) html += "<th>Nome do ensaio</th>";
        html += "<th>Nome do acesso</th>";
        if ( ["plots", "subplots", "plants"].includes(stock_type) ) html += "<th>Número da parcela</th>";
        if ( ["plots", "subplots", "plants"].includes(stock_type)  ) html += "<th>Repetição</th>";
        if ( ["plots", "subplots", "plants"].includes(stock_type)  ) html += "<th>Bloco</th>";
        if ( stock_type === 'subplots' ) html += "<th>Nome da subparcela</th>";
        if ( stock_type === 'subplots' ) html += "<th>Índice da subparcela</th>";
        if ( stock_type === 'plants' ) html += "<th>Nome da planta</th>";
        if ( stock_type === 'plants' ) html += "<th>Índice da planta</th>";
        html += "<th>Nome do lote de sementes</th>";
        html += "</tr></thead>";

        for ( let i = 0; i < SEEDLOTS.length; i++ ) {
            index = i+1;
            let name = name_template
                .replace("{trial_name}", trial_name)
                .replace("{accession_name}", SEEDLOTS[i].accession.name)
                .replace("{index}", index);
            if ( SEEDLOTS[i].plot ) {
                name = name
                    .replace("{plot_name}", SEEDLOTS[i].plot.name)
                    .replace("{plot_number}", SEEDLOTS[i].plot.number)
                    .replace("{rep}", SEEDLOTS[i].plot.rep)
                    .replace("{block}", SEEDLOTS[i].plot.block);
            }
            if ( SEEDLOTS[i].subplot ) {
                name = name
                    .replace("{subplot_name}", SEEDLOTS[i].subplot.name)
                    .replace("{subplot_index}", SEEDLOTS[i].subplot.index);
            }
            if ( SEEDLOTS[i].plant ) {
                name = name
                    .replace("{plant_name}", SEEDLOTS[i].plant.name)
                    .replace("{plant_index}", SEEDLOTS[i].plant.index);
            }
            SEEDLOTS[i].name = name;

            html += "<tr>";
            if ( stock_type === 'accessions' ) html += "<td>" + trial_name + "</td>";
            html += "<td>" + SEEDLOTS[i].accession.name + "</td>";
            if ( ["plots", "subplots", "plants"].includes(stock_type) ) html += "<td>" + SEEDLOTS[i].plot.number + "</td>";
            if ( ["plots", "subplots", "plants"].includes(stock_type) ) html += "<td>" + SEEDLOTS[i].plot.rep + "</td>";
            if ( ["plots", "subplots", "plants"].includes(stock_type) ) html += "<td>" + SEEDLOTS[i].plot.block + "</td>";
            if ( stock_type === 'subplots' ) html += "<td>" + SEEDLOTS[i].subplot.name + "</td>";
            if ( stock_type === 'subplots' ) html += "<td>" + SEEDLOTS[i].subplot.index + "</td>";
            if ( stock_type === 'plants' ) html += "<td>" + SEEDLOTS[i].plant.name + "</td>";
            if ( stock_type === 'plants' ) html += "<td>" + SEEDLOTS[i].plant.index + "</td>";
            html += "<td><input class='form-control create_seedlots_trial_name_seedlot' data-index='" + i + "' value='" + name + "'></td>";
            html += "</tr>";
        }

        jQuery("#create_seedlots_trial_name_table").html(html);
        jQuery("#create_seedlots_trial_complete_name_seedlots").attr("disabled", false);
        jQuery("#create_seedlots_trial_name_update").attr("disabled", true);
    }

    /**
     * Calculate the seedlot contents and update the table displaying the results
     */
    function updateSeedlotContents() {
        let stock_type = jQuery("#create_seedlots_trial_stock_type").val();
        let contents_type = jQuery("#create_seedlots_trial_contents_type").val();
        let value = jQuery("#create_seedlots_trial_contents_value").val();
        let constant = jQuery("#create_seedlots_trial_contents_constant").val();
        let trait_id = jQuery("#create_seedlots_trial_contents_trait").val();
        let formula = jQuery("#create_seedlots_trial_contents_computed_formula").val();

        let html = "<thead></tr>";
        html += "<th>Nome do lote de sementes</th>";
        html += "<th>Conteúdo</th>";
        html += "</tr></thead>";

        for ( let i = 0; i < SEEDLOTS.length; i++ ) {
            let contents = 0;

            // Set contents value
            if ( value === 'constant' ) {
                contents = constant;
            }
            else if ( value === 'trait' && TRAIT_DATA ) {
                contents = _getTraitData(i, trait_id);
            }
            else if ( value === 'computed' && TRAIT_DATA && formula && formula !== "" ) {
                let seedlot_formula = formula;
                for ( let j = 0; j < TRAITS.length; j++ ) {
                    let variable = TRAITS[j].variable;
                    let variable_trait_id = TRAITS[j].id;
                    if ( formula.includes('{' + variable + '}') ) {
                        let variable_value = _getTraitData(i, variable_trait_id);
                        seedlot_formula = seedlot_formula.replaceAll('{' + variable + '}', variable_value);
                    }
                }
                try {
                    let eval_value = eval(seedlot_formula);
                    if ( eval_value ) contents = eval_value;
                }
                catch (e) {}
            }

            html += "<tr>";
            html += "<td>" + SEEDLOTS[i].name + "</td>";
            html += "<td><input class='form-control create_seedlots_trial_contents_seedlot' data-index='" + i + "' value='" + contents + "'></td>";
            html +=" </tr>";

            SEEDLOTS[i].contents = contents;
        }

        jQuery("#create_seedlots_trial_contents_table").html(html);
        jQuery("#create_seedlots_trial_complete_computed_compute").attr("disabled", true);
        jQuery("#create_seedlots_trial_complete_set_contents").attr("disabled", false);


        /**
         * Get the value of the specified trait for the specified seedlot
         * If 'stock_type' == 'accessions', then the sum of the plots is returned
         */
        function _getTraitData(seedlot_index, trait_id) {
            let contents = 0;
            for ( let j = 0; j < TRAIT_DATA.length; j++ ) {
                if ( TRAIT_DATA[j].trait_id + '' === trait_id + '' ) {

                    // Sum plots of the same accession
                    if ( stock_type === 'accessions' ) {
                        if ( SEEDLOTS[seedlot_index].accession.id === TRAIT_DATA[j].accession_id ) {
                            try {
                                contents = contents + parseFloat(TRAIT_DATA[j].trait_value);
                            }
                            catch (e) {}
                        }
                    }

                    // Use the plot value
                    else {
                        if ( SEEDLOTS[seedlot_index].plot.id === TRAIT_DATA[j].plot_id ) {
                            contents = TRAIT_DATA[j].trait_value;
                        }
                    }

                }
            }
            return contents;
        }
    }

    /**
     * Set the seedlot metadata and update the table displaying the individual metadata
     */
    function updateSeedlotMetadata(quiet) {
        let p_id = jQuery("#create_seedlots_trial_breeding_program_id").val();
        let p_name = jQuery("#create_seedlots_trial_breeding_program_id option:selected").text();
        let l = jQuery("#create_seedlots_trial_location").val();
        let b = jQuery("#create_seedlots_trial_box_name").val();
        let q = jQuery("#create_seedlots_trial_quality_issues").val();
        let o = jQuery("#create_seedlots_trial_organization").val();
        let t = jQuery("#create_seedlots_trial_timestamp").val();
        let d = jQuery("#create_seedlots_trial_description").val();
        let mt = "";
        const default_seedlot_material_type = "<%$default_seedlot_material_type%>";
        if (default_seedlot_material_type) {
            mt = default_seedlot_material_type;
        } else {
            mt = jQuery("#create_seedlots_trial_material_type").val();
        }

        // Check for required fields
        if ( !p_id || p_id === '' ) {
            if (!quiet) alert("O programa de melhoramento é obrigatório");
            return;
        }
        if ( !l || l === '' ) {
            if (!quiet) alert("O local é obrigatório");
            return;
        }
        if ( !b || b === '' ) {
            if (!quiet) alert("O nome da caixa é obrigatório");
            return;
        }
        if ( !mt || mt === '' ) {
            if (!quiet) alert("O tipo de material é obrigatório");
            return;
        }

        // Build Table
        let html = "<thead><tr>";
        html += "<th>Nome do lote de sementes</th>";
        html += "<th>Metadados</th>";
        html += "</tr></thead>";

        for ( let i = 0; i < SEEDLOTS.length; i++ ) {
            let p_select = jQuery("#create_seedlots_trial_breeding_program_id").html();

            html += "<tr>";
            html += "<td>" + SEEDLOTS[i].name + "</td>";
            html += "<td>";
            html += "<strong>Programa de melhoramento:</strong><select class='form-control  create_seedlots_trial_metadata_input_seedlot_breeding_program' data-index='" + i + "'>" + p_select + "</select><br />";
            html += "<strong>Local:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='location' data-index='" + i + "' value='" + l + "'><br />";
            html += "<strong>Nome da caixa:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='box_name' data-index='" + i + "' value='" + b + "'><br />";
            html += "<strong>Problemas de qualidade:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='quality_issues' data-index='" + i + "' value='" + q + "'><br />";
            html += "<strong>Organização:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='organization' data-index='" + i + "' value='" + o + "'><br />";
            html += "<strong>Data e hora:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='timestamp' data-index='" + i + "' value='" + t + "'><br />";
            html += "<strong>Descrição:</strong><input class='form-control create_seedlots_trial_metadata_input_seedlot' data-prop='description' data-index='" + i + "' value='" + d + "'><br />";
            html += "</td>";
            html += "</tr>";

            SEEDLOTS[i].metadata = {
                breeding_program: {
                    id: p_id,
                    name: p_name,
                },
                location: l,
                box_name: b,
                material_type: mt,
                quality_issues: q,
                organization: o,
                timestamp: t,
                description: d
            }
        }

        jQuery("#create_seedlots_trial_metadata_table").html(html);
        jQuery(".create_seedlots_trial_metadata_input_seedlot_breeding_program").val(p_id);
        jQuery("#create_seedlots_trial_update_metadata").attr("disabled", true);
        jQuery("#create_seedlots_trial_complete_set_metadata").attr("disabled", false);
    }


    /**
     * Build the table of Seedlot details for the user to confirm
     */
    function updateSeedlotDetails() {
        let stock_type = jQuery("#create_seedlots_trial_stock_type").val();
        let contents_type = jQuery("#create_seedlots_trial_contents_type").val();

        let html = "<thead><tr>";
        html += "<th>Nome do lote de sementes</th>";
        html += "<th>Programa de melhoramento</th>";
        html += "<th>Acesso de origem</th>";
        if ( stock_type === 'plots' ) html += "<th>Parcela de origem</th>";
        if ( stock_type === 'subplots' ) html += "<th>Subparcela de origem</th>";
        if ( stock_type === 'plants' ) html += "<th>Planta de origem</th>";
        if ( contents_type === 'amount' ) html += "<th>Conteúdo (quantidade)</th>";
        if ( contents_type === 'weight' ) html += "<th>Conteúdo (peso)</th>";
        html += "<th>Local</th>";
        html += "<th>Nome da caixa</th>";
        html += "<th>Tipo de material</th>";
        html += "<th>Problemas de qualidade</th>";
        html += "<th>Organização</th>";
        html += "<th>Data e hora</th>";
        html += "<th>Descrição</th>";
        html += "</tr></thead>";

        for ( let i = 0; i < SEEDLOTS.length; i++ ) {
            html += "<tr>";
            html += "<td>" + SEEDLOTS[i].name + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.breeding_program.name + "</td>";
            html += "<td>" + SEEDLOTS[i].accession.name + "</td>";
            if ( stock_type === 'plots' ) html += "<td>" + SEEDLOTS[i].plot.name + "</td>";
            if ( stock_type === 'subplots' ) html += "<td>" + SEEDLOTS[i].subplot.name + "</td>";
            if ( stock_type === 'plants' ) html += "<td>" + SEEDLOTS[i].plant.name + "</td>";
            html += "<td>" + SEEDLOTS[i].contents + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.location + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.box_name + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.material_type + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.quality_issues + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.organization + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.timestamp + "</td>";
            html += "<td>" + SEEDLOTS[i].metadata.description + "</td>";
            html += "</tr>";
        }

        jQuery("#create_seedlots_trial_confirm_table").html(html);
    }


    /**
     * Upload each of the Seedlots to the Database in batches of up to
     * UPLOAD_BATCH_SIZE seedlots per batch
     * @return {Promise<{ upload_count, errors }>} Return a count of successfully uploaded seedlots and error messages
     */
    function uploadSeedlots() {
        let stock_type = jQuery("#create_seedlots_trial_stock_type").val();
        let contents_type = jQuery("#create_seedlots_trial_contents_type").val();
        let seedlot_count = 0;                      // Count of processed seedlots
        let seedlot_total = SEEDLOTS.length;        // Total number of seedlots
        let upload_count = 0;                       // Count of successfully created/uploaded seedlots
        let errors = [];                            // Array of errors encountered during upload

        return new Promise(async (resolve) => {
            jQuery("#create_seedlots_trial_status").html("<strong>Criando lotes de sementes...</strong>");
            jQuery("#create_seedlots_trial_progress").css('width', '0%').attr('aria-valuenow', 0);
            jQuery("#create_seedlots_trial_results").empty();

            // Create Results table
            let html = "<thead><tr>";
            html += "<th>Lote de sementes</th>";
            html += "<th>Progresso</th>";
            html += "</tr></thead>";
            html += "<tbody id='create_seedlots_trial_results_table_body'></tbody>";
            for ( let i = 0; i < SEEDLOTS.length; i++ ) {
                let status_id = "create_seedlots_trial_results_row_" + i;
                html += "<tr><td>" + SEEDLOTS[i].name + "</td><td id='" + status_id + "'>Pendente...</td>";
                SEEDLOTS[i].status_id = status_id;
            }
            jQuery("#create_seedlots_trial_results_table").html(html);

            // Chunk the Seedlots into batches
            let batches = [];
            while ( SEEDLOTS.length > 0 ) {
                batches.push(SEEDLOTS.splice(0, UPLOAD_BATCH_SIZE));
            }

            // Upload each batch
            for ( let i = 0; i < batches.length; i++ ) {
                await _uploadBatch(batches[i]);
            }

            // Refresh the matviews when complete
            jQuery.ajax({ url: '/ajax/breeder/refresh?matviews=stockprop' });

            // Display Upload Results
            resolve({ upload_count, errors });
        });

        /**
         * Upload a batch of Seedlots (max set with UPLOAD_BATCH_SIZE)
         */
        async function _uploadBatch(batch) {
            const requests = [];
            batch.forEach((seedlot) => {
                requests.push(_processSeedlot(seedlot));
            });
            await Promise.all(requests);
        }

        /**
         * Process the specified seedlot
         */
        async function _processSeedlot(seedlot) {
            _setStatusInfo(seedlot, "Criando...");

            // Set seedlot request data
            let data = {
                'seedlot_name': seedlot.name,
                'seedlot_location': seedlot.metadata.location,
                'seedlot_box_name': seedlot.metadata.box_name,
                'seedlot_material_type': seedlot.metadata.material_type,
                'seedlot_accession_uniquename': seedlot.accession.name,
                'seedlot_organization': seedlot.metadata.organization,
                'seedlot_timestamp': seedlot.metadata.timestamp,
                'seedlot_description': seedlot.metadata.description,
                'seedlot_breeding_program_id': seedlot.metadata.breeding_program.id,
                'seedlot_quality': seedlot.metadata.quality_issues,
                'no_refresh': 1
            };
            if ( stock_type === 'plots' ) data['seedlot_source'] = seedlot.plot.name;
            if ( stock_type === 'subplots' ) data['seedlot_source'] = seedlot.subplot.name;
            if ( stock_type === 'plants' ) data['seedlot_source'] = seedlot.plant.name;
            if ( contents_type === 'amount' ) data['seedlot_amount'] = seedlot.contents;
            if ( contents_type === 'weight' ) data['seedlot_weight'] = seedlot.contents;

            // Upload the Seedlot
            await _uploadSeedlot(seedlot, data);

            // Update Progress Bar
            seedlot_count++;
            let p = (seedlot_count/seedlot_total)*100;
            jQuery("#create_seedlots_trial_progress").css('width', p+'%').attr('aria-valuenow', p);
        }

        /**
         * Upload the specified seedlot
         */
        function _uploadSeedlot(seedlot, data) {
            return new Promise((resolve) => {
                jQuery.ajax({
                    url: '/ajax/breeders/seedlot-create',
                    data: data,
                    success: (response) => {
                        if (response.success === 1) {
                            _setStatusComplete(seedlot);
                        }
                        else if (response.error) {
                            _setStatusError(seedlot, response.error);
                        }
                        resolve();
                    },
                    error: () => {
                        _setStatusError(seedlot, "Erro na solicitação AJAX");
                        resolve();
                    }
                });
            });
        }

        /**
         * Display an info message for the specified seedlot
         */
        function _setStatusInfo(seedlot, info) {
            jQuery("#" + seedlot.status_id).html(info);
        }

        /**
         * Display a complete message for the specified seedlot
         */
        function _setStatusComplete(seedlot) {
            upload_count++;
            _setStatusInfo(seedlot, "<strong><span class='glyphicon glyphicon-ok-sign text-success'></span></strong>&nbsp;Lote de sementes criado!");
        }

        /**
         * Display an error message for the specified seedlot
         */
        function _setStatusError(seedlot, error) {
            errors.push({
                index: seedlot.status_id,
                seedlot: seedlot,
                error: error
            });
            _setStatusInfo(seedlot, "<strong><span class='glyphicon glyphicon-exclamation-sign text-danger'></span>&nbsp;ERRO:</strong> " + error);
        }
    }

    /**
     * Display the status results message
     * @param {Object[]} errors List of upload errors
     * @param {int} upload_count Count of successfully uploaded seedlots
     */
    function displayUploadResults(errors, upload_count) {
        jQuery("#create_seedlots_trial_status").html("<strong>Envio concluído</strong>");
        jQuery("#create_seedlots_trial_progress").css('width', '100%').attr('aria-valuenow', 100);

        let html = "<br /><br />";
        if ( !errors || errors.length === 0 ) {
            html += "<div class='alert-success' role='alert'>";
            html += "<strong><span class='glyphicon glyphicon-ok-sign'></span></strong>&nbsp;";
            html += upload_count + " lotes de sementes criados com sucesso!";
            html += "</div>";
        }
        if ( errors && errors.length > 0 ) {
            html += "<div class='alert-danger' role='alert'>"
            html += "<strong><span class='glyphicon glyphicon-exclamation-sign'></span>&nbsp; " + errors.length + " erros encontrados!<br />";
            html += "Veja abaixo os lotes que apresentaram falhas e os detalhes<br />";
            if ( upload_count > 0 ) html += "<br /><strong><span class='glyphicon glyphicon-ok-sign'></span>&nbsp; " + upload_count + " lotes de sementes criados com sucesso";
            html += "</div>";
        }

        jQuery("#create_seedlots_trial_results").html(html);
    }


    //
    // DB QUERY FUNCTIONS
    //

    /**
     * Query the database for the trial id (by name)
     * @param {string} trial_name Trial Name
     * @return {Promise<trial_id>} the trial id for the named trial
     */
    function getTrialID(trial_name, callback) {
        return new Promise((resolve, reject) => {
            let trial_id;
            jQuery.ajax({
                type: "GET",
                url: '/ajax/breeders/trial_lookup',
                data: { name: trial_name },
                success: (response) => {
                    if (response.error) {
                        reject(response.error);
                    }
                    else if ( response.trial_id ) {
                        resolve(response.trial_id);
                    }
                    else {
                        reject('Não foi possível consultar o ensaio');
                    }
                },
                error: () => reject('Não foi possível consultar o ensaio')
            });
        });
    }

    /**
     * Get required metadata for the Trial:
     * - Breeding Program ID
     * - Accessions
     * - Plots
     * - Subplots
     * - Plants
     * - Traits
     * @param {int} trial_id Trial ID
     * @return {Promise<{ breeding_program_id, accessions, plots, subplots, plants, traits }>} Returns all trial details
     */
    async function getTrialDetails(trial_id, callback) {
        return new Promise(async (resolve, reject) => {
            try {
                const [ breeding_program_id, accessions, { plots, subplots, plants }, traits ] = await Promise.all([
                    _getBreedingProgram(),
                    _getAccessions(),
                    _getPlots(),
                    _getTraits()
                ]);
                resolve({ breeding_program_id, accessions, plots, subplots, plants, traits });
            }
            catch (err) {
                reject(err);
            }
        });

        // Returns breeding_program_id
        function _getBreedingProgram() {
            return new Promise((resolve, reject) => {
                jQuery.ajax({
                    type: "GET",
                    url: '/breeders/programs_by_trial/' + trial_id,
                    success: (response) =>  {
                        if (response.error) {
                            reject(response.error);
                        }
                        else if ( response.projects ) {
                            resolve(response.projects[0][0]);
                        }
                        else {
                            reject('Não foi possível consultar o programa de melhoramento do ensaio');
                        }
                    },
                    error: () => reject('Não foi possível consultar o programa de melhoramento do ensaio')
                });
            });
        }

        // Returns accessions[]
        function _getAccessions() {
            return new Promise((resolve, reject) => {
                jQuery.ajax({
                    type: "GET",
                    url: '/ajax/breeders/trial/' + trial_id + '/accessions',
                    success: (response) => {
                        if (response.error) {
                            reject(response.error);
                        }
                        else if ( response.accessions ) {
                            let accessions = [];
                            for ( let i = 0; i < response.accessions[0].length; i++ ) {
                                if ( response.accessions[0][i].stock_type !== 'accession' ) {
                                    error = `Esta ferramenta aceita somente ensaios com parcelas que contêm acessos. Este ensaio tem uma ou mais parcelas com material do tipo ${response.accessions[0][i].stock_type}.`;
                                }
                                accessions.push({
                                    id: response.accessions[0][i].stock_id,
                                    name: response.accessions[0][i].accession_name
                                });
                            }
                            resolve(accessions);
                        }
                        else {
                            reject('Não foi possível consultar os acessos do ensaio');
                        }
                    },
                    error: () => reject('Não foi possível consultar os acessos do ensaio')
                });
            });
        }

        // Returns { plots[], subplots[], plants[] }
        function _getPlots() {
            return new Promise((resolve, reject) => {
                jQuery.ajax({
                    type: "GET",
                    url: '/ajax/breeders/trial/' + trial_id + '/layout',
                    success: (response) => {
                        if (response.error) {
                            reject(response.error);
                        }
                        else if ( response.design ) {
                            let plots = [];
                            let subplots = [];
                            let plants = [];
                            for (const [plot, info] of Object.entries(response.design)) {
                                plots.push({
                                    plot: {
                                        id: info.plot_id,
                                        number: info.plot_number,
                                        name: info.plot_name,
                                        rep: info.rep_number,
                                        block: info.block_number
                                    },
                                    accession: {
                                        name: info.accession_name,
                                        id: info.accession_id
                                    }
                                });
                                if ( info.subplot_names && info.subplot_ids && info.subplot_index_numbers ) {
                                    for ( let i = 0; i < info.subplot_names.length; i++ ) {
                                        subplots.push({
                                            subplot: {
                                                name: info.subplot_names[i],
                                                id: info.subplot_ids[i],
                                                index: info.subplot_index_numbers[i]
                                            },
                                            plot: {
                                                id: info.plot_id,
                                                number: info.plot_number,
                                                name: info.plot_name,
                                                rep: info.rep_number,
                                                block: info.block_number
                                            },
                                            accession: {
                                                name: info.accession_name,
                                                id: info.accession_id
                                            }
                                        });
                                    }
                                }
                                if ( info.plant_names && info.plant_ids && info.plant_index_numbers ) {
                                    for ( let i = 0; i < info.plant_names.length; i++ ) {
                                        plants.push({
                                            plant: {
                                                name: info.plant_names[i],
                                                id: info.plant_ids[i],
                                                index: info.plant_index_numbers[i]
                                            },
                                            plot: {
                                                id: info.plot_id,
                                                number: info.plot_number,
                                                name: info.plot_name,
                                                rep: info.rep_number,
                                                block: info.block_number
                                            },
                                            accession: {
                                                name: info.accession_name,
                                                id: info.accession_id
                                            }
                                        });
                                    }
                                }
                                resolve({ plots, subplots, plants });
                            }
                        }
                        else {
                            reject('Não foi possível consultar as parcelas do ensaio');
                        }
                    },
                    error: () => reject('Não foi possível consultar as parcelas do ensaio')
                });
            });
        }

        // Returns traits[]
        function _getTraits() {
            return new Promise((resolve, reject) => {
                jQuery.ajax({
                    type: "GET",
                    url: '/ajax/breeders/trial/' + trial_id + '/traits_assayed?stock_type=plot',
                    success: (response) => {
                        if (response.error) {
                            reject(response.error);
                        }
                        else if ( response.traits_assayed ) {
                            let traits = [];
                            let html = "";
                            for ( let i = 0; i < response.traits_assayed[0].length; i++ ) {
                                let id = response.traits_assayed[0][i][0];
                                let name = response.traits_assayed[0][i][1];
                                let variable = "trait_" + parseInt(i+1);
                                traits.push({
                                    id: id,
                                    name: name,
                                    variable: variable
                                });
                                html += "<tr><td><code>{" + variable + "}</code></td>";
                                html += "<td>" + name + "</td></tr>";
                            }
                            jQuery("#create_seedlots_trial_contents_computed_table").html(html);
                            resolve(traits);
                        }
                        else {
                            reject('Não foi possível consultar as características do ensaio');
                        }
                    },
                    error: () => reject('Não foi possível consultar as características do ensaio')
                });
            });
        }
    }

    /**
     * Set the plot-level trait data for all of the traits
     * @return {Promise<TRAIT_DATA[]>} data for each available trait
     */
    async function getTraitData(traits = []) {
        return new Promise(async (resolve, reject) => {
            try {
                const requests = [];
                traits.forEach((t) => requests.push(_getTraitData(t.id, t.name)));
                const data = await Promise.all(requests);
                resolve(data ? data.flat() : []);
            }
            catch (err) {
                reject(err);
            }
        });

        function _getTraitData(trait_id, trait_name) {
            return new Promise((resolve, reject) => {
                jQuery.ajax({
                    type: "GET",
                    url: '/ajax/breeders/trial/' + TRIAL_ID + '/trait_phenotypes/?trait=' + trait_id + '&display=plot',
                    success: (response) => {
                        if (response.error) {
                            reject(response.error);
                        }
                        else if ( response.status && response.status === 'success' && response.data ) {
                            const data = _parseTraitData(response.data, trait_id, trait_name);
                            resolve(data);
                        }
                        else {
                            reject('Não foi possível obter os dados da característica');
                        }
                    },
                    error: () => reject('Não foi possível obter os dados da característica')
                });
            });
        }

        function _parseTraitData(data, trait_id, trait_name) {
            let accession_id_col, plot_id_col, trait_col;
            let headers = data[0];
            for ( let i = 0; i < headers.length; i++ ) {
                if ( headers[i] === 'germplasmDbId' ) accession_id_col = i;
                if ( headers[i] === 'observationUnitDbId' ) plot_id_col = i;
                if ( headers[i] === trait_name ) trait_col = i;
            }
            let rtn = [];
            for ( let i = 1; i < data.length; i++ ) {
                rtn.push({
                    accession_id: data[i][accession_id_col],
                    plot_id: data[i][plot_id_col],
                    trait_id: trait_id,
                    trait_value: data[i][trait_col]
                })
            }
            return rtn;
        }
    }
</script>

<style>
    .create_seedlots_trial_subplots_available, .create_seedlots_trial_plants_available {
        display: none;
    }
    .alert-success, .alert-danger {
        padding: 15px !important;
        margin-bottom: 20px !important;
        border: 1px solid transparent !important;
        border-radius: 4px !important;
    }
</style>
