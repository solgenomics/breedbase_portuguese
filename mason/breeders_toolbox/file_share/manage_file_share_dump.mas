
<%args>
</%args>

<& /util/import_javascript.mas, classes => ['jquery.iframe-post-form'] &>

<& /page/page_title.mas, title=>"Área de compartilhamento de arquivos" &>

<& /page/detail_page_2_col_section.mas, info_section_title => "<h4 style='display:inline'>Arquivos compartilhados</h4>", info_section_subtitle => 'Visualize e baixe arquivos de dados compartilhados. Estes são arquivos não estruturados; envie os dados estruturados para o banco de dados.', buttons_html => "<button class='btn btn-sm btn-primary' style='margin:3px' id='file_dump_share_upload_button'>Enviar arquivo não estruturado para compartilhar</button>", icon_class => "glyphicon glyphicon-upload", info_section_id => "manage_file_share_dump", info_section_collapsed => 0 &>

<div class="modal fade" id="manage_file_dump_upload_file_dialog" name="manage_file_dump_upload_file_dialog" tabindex="-1" role="dialog" aria-labelledby="manageFileDumpUploadFileDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="manageFileDumpUploadFileDialog">Enviar arquivo para compartilhar</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>Selecione um arquivo do seu computador para enviá-lo à área de compartilhamento.</p>
                    <p>Este recurso destina-se a dados não estruturados. Para usar as ferramentas de organização e análise do Breedbase, continue enviando os dados estruturados ao banco de dados correspondente.</p>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="manage_file_dump_upload_file_dialog_form" name="manage_file_dump_upload_file_dialog_form">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo: </label>
                            <div class="col-sm-8" >
                                <input type="file" name="manage_file_dump_upload_file_dialog_file" id="manage_file_dump_upload_file_dialog_file" encoding="multipart/form-data" />
                            </div>
                        </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="manage_file_dump_upload_file_dialog_submit" id="manage_file_dump_upload_file_dialog_submit" title="Enviar">Enviar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function() {

    jQuery('#file_dump_share_upload_button').click(function(){
        jQuery('#manage_file_dump_upload_file_dialog').modal('show');
    });

    jQuery('#manage_file_dump_upload_file_dialog_submit').click(function () {
        manage_file_share_dump_file_submit();
    });
    function manage_file_share_dump_file_submit() {
        var uploadFile = jQuery("#manage_file_dump_upload_file_dialog_file").val();
        jQuery('#manage_file_dump_upload_file_dialog_form').attr("action", "/ajax/filesharedump/upload");
        if (uploadFile === '') {
            alert("Selecione um arquivo.");
            return;
        }
        jQuery("#manage_file_dump_upload_file_dialog_form").submit();
    }

    jQuery('#manage_file_dump_upload_file_dialog_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedAdditionalFile = jQuery("#manage_file_dump_upload_file_dialog_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedAdditionalFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("Nenhum arquivo selecionado.");
                return;
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                alert("Arquivo enviado com sucesso.");
                location.reload();
            }
        }
    });

});

</script>
