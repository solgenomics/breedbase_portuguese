<%args>
$seedlot_id
$uniquename
</%args>

<div class="modal fade" id="discard_seedlot_dialog" name="discard_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="discardSeedlotDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="discardSeedlotDialog">Marcar este lote de sementes como DESCARTADO</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="discard_seedlot_form" name="discard_seedlot_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Nome do lote de sementes: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="discard_seedlot_name" id="discard_seedlot_name" disabled value="<% $uniquename %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Motivo do descarte: </label>
                            <div class="col-sm-8" >
                                <textarea class="form-control" id="reason_for_discarding_details_page" name="reason_for_discarding_details_page" placeholder="Obrigatório"></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="discard_single_seedlot_submit" id="discard_single_seedlot_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="saved_dialog_message" name="saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="savedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="savedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Este lote de sementes foi marcado como DESCARTADO.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="undo_dialog_message" name="undo_dialog_message" tabindex="-1" role="dialog" aria-labelledby="undoDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="undoDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Este lote de sementes foi restaurado.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_undo_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    var seedlot_name = "<% $uniquename %>";

    jQuery("#discard_seedlot_details_page_link").click( function() {
        jQuery('#discard_seedlot_dialog').modal('show');
    });

    jQuery('#discard_single_seedlot_submit').click(function(){

        var discard_reason = jQuery('#reason_for_discarding_details_page').val();

        if (seedlot_name === '') {
            alert("Erro ao obter as informações do lote de sementes.");
            return;
        }

        if (discard_reason === '') {
            alert("Informe o motivo do descarte deste lote de sementes.");
            return;
        }

        jQuery.ajax({
            url: '/ajax/breeders/seedlot/discard',
            dataType: "json",
            data : {
                'seedlot_name' : seedlot_name,
                'discard_reason': discard_reason,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#discard_seedlot_dialog').modal('hide');
                    jQuery('#saved_dialog_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao descartar o lote de sementes.');
            }
        });
    });

    jQuery("#dismiss_saved_dialog").click( function() {
        jQuery('#saved_dialog_message').modal('hide');
        location.reload();
    });

    jQuery('#undo_discarding_seedlot_link').click(function() {
        var seedlot_id = "<% $seedlot_id %>";
        var confirmation = confirm("Tem certeza de que deseja DESFAZER a marcação deste lote de sementes como DESCARTADO?");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/seedlot/undo_discard',
                dataType: "json",
                data : {
                    'seedlot_id' : seedlot_id,
                },
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        jQuery('#undo_dialog_message').modal("show");
                    }
                    if (response.error_string) {
                        alert(response.error_string);
                    }
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro ao processar a solicitação.');
                }
            });
        }
    });

    jQuery("#dismiss_undo_dialog").click( function() {
        jQuery('#undo_dialog_message').modal('hide');
        location.reload();
    });


});

</script>
