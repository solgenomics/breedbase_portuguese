<%args>
$timestamp => localtime()
$accession_uniquename => ''
$cross_uniquename => ''
$default_seedlot_material_type => undef

</%args>

<div class="modal fade" id="add_seedlot_dialog" name="add_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="seedlot_dialog">Criar novo lote de sementes</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" id="create_new_seedlot_form" name="create_new_seedlot_form">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Nome: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_name" placeholder="Obrigatório">
                    </div>
                </div>
%if ($default_seedlot_material_type) {
                <div class="form-group">
                    <label class="col-sm-3 control-label" >Tipo de material: </label>
                    <div class="col-sm-9">
                        <input class="form-control" name="add_seedlot_default_material_type" id="add_seedlot_default_material_type" disabled value="<% $default_seedlot_material_type %>">
                    </div>
                </div>
% } else {
                <div class="form-group">
                    <label class="col-sm-3 control-label">Tipo de material: </label>
                    <div class="col-sm-9" >
                        <div id="seedlot_material_type_div"></div>
                    </div>
                </div>
% }
                <div class="form-group">
                    <label class="col-sm-3 control-label">Descrição do lote de sementes: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_description" placeholder="Opcional">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                    <div class="col-sm-9" >
                        <div id="seedlot_breeding_program_div"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Local: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_location" placeholder="Obrigatório">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Nome da caixa: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_box_name" placeholder="Obrigatório">
                    </div>
                </div>

		<div class="form-group">
                    <label class="col-sm-3 control-label">Problemas de qualidade:</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_quality" placeholder="Liste os problemas de qualidade ou informe 'ok' para sementes de boa qualidade" >
                    </div>
                </div>

                <div class="well well-sm">
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="col-sm-12 control-label">Conteúdo: </label>
                            </div>
                        </div>
                        <div class="col-sm-9">
% if ($accession_uniquename || $cross_uniquename){
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Nome do acesso: </label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_accession_uniquename" placeholder="Um tipo de conteúdo é obrigatório" disabled value="<% $accession_uniquename %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: center">
                                <h4>OU</h4>
                            </div>
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">ID único do cruzamento: </label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_cross_uniquename" placeholder="Um tipo de conteúdo é obrigatório" disabled value="<% $cross_uniquename %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
% } else {
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Nome do acesso: </label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_accession_uniquename" placeholder="Um tipo de conteúdo é obrigatório">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: center">
                                <h4>OU</h4>
                            </div>
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">ID único do cruzamento: </label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_cross_uniquename" placeholder="Um tipo de conteúdo é obrigatório">
                                        </div>
                                    </div>
                                </div>
                            </div>
% }
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Origem: </label>
                    <div class="col-sm-9">
                        <input class="form-control" id="seedlot_source" placeholder="Opcional">
                        <span style="font-size: 80; color: #666">Nome do lote de sementes, parcela, subparcela ou planta a ser usado como origem da primeira transação</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Quantidade (número de unidades de material): </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_amount" placeholder="A quantidade OU o peso (g) é obrigatório">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Peso (g): </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_weight" placeholder="A quantidade OU o peso (g) é obrigatório">
                    </div>
                </div>
                <!--
                <div class="form-group">
                    <label class="col-sm-3 control-label">Population: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_population_name" placeholder="Optional">
                    </div>
                </div>
                -->
                <div class="form-group">
                    <label class="col-sm-3 control-label">Organização: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_organization" placeholder="Opcional">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Data e hora: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_timestamp" value="<% $timestamp %>" placeholder="<% $timestamp %>">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Descrição da transação: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_transaction_description" placeholder="Opcional">
                    </div>
                </div>
            </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
        <button id="create_new_seedlot_button" type="button" class="btn btn-primary" >Criar</button>
      </div>
    </div>
  </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery("#seedlot_location").autocomplete({
       source: '/ajax/stock/geolocation_autocomplete',
    });
    jQuery("#seedlot_accession_uniquename").autocomplete({
       source: '/ajax/stock/accession_autocomplete',
    });
    jQuery("#seedlot_cross_uniquename").autocomplete({
       source: '/ajax/stock/cross_autocomplete',
    });
    jQuery("#seedlot_source").autocomplete({
        source: '/ajax/stock/seedlot_source_autocomplete'
    });

    jQuery('[name="add_seedlot_button"]').click( function() {
        jQuery('#add_seedlot_dialog').modal('show');
        get_select_box('breeding_programs', 'seedlot_breeding_program_div', { 'name' : 'seedlot_breeding_program_id', 'id' : 'seedlot_breeding_program_id' });
        get_select_box('material_types', 'seedlot_material_type_div', { 'name' : 'seedlot_material_type', 'id' : 'seedlot_material_type' });

    });

    jQuery('#create_new_seedlot_button').click( function() {
        var name = jQuery('#seedlot_name').val();
        let material_type = "";
        const default_seedlot_material_type = "<%$default_seedlot_material_type%>";
        if (default_seedlot_material_type) {
            material_type = default_seedlot_material_type;
        } else {
            material_type = jQuery('#seedlot_material_type').val();
        }
        var seedlot_description = jQuery('#seedlot_description').val();
        var location = jQuery('#seedlot_location').val();
        var box_name = jQuery('#seedlot_box_name').val();
        var accession_uniquename = jQuery('#seedlot_accession_uniquename').val();
        var cross_uniquename = jQuery('#seedlot_cross_uniquename').val();
        var population_name = jQuery('#seedlot_population_name').val();
        var organization = jQuery('#seedlot_organization').val();
        var source = jQuery("#seedlot_source").val();
        var amount = jQuery('#seedlot_amount').val().trim();
        var weight = jQuery('#seedlot_weight').val().trim();
        var timestamp = jQuery('#seedlot_timestamp').val();
        var transaction_description = jQuery('#seedlot_transaction_description').val();
        var breeding_program_id = jQuery('#seedlot_breeding_program_id').val();
        var seedlot_quality = jQuery('#seedlot_quality').val();

        if (name == '') { alert("Informe um nome."); return; }
        else if (material_type == '') { alert("Informe um tipo de material."); return; }
        else if (location == '') { alert("Informe um local."); return; }
        else if (box_name == '') { alert("Informe o nome da caixa."); return; }
        else if (amount.trim().length == 0 && weight.trim().length == 0) { alert("Informe a quantidade de sementes ou o peso em gramas!"); return; }
        else if (isNaN(amount)) { alert("A quantidade de sementes deve ser um valor numérico."); return; }
        else if (isNaN(weight)) { alert("O peso deve ser um valor numérico."); return; }
        else if (breeding_program_id == '') { alert("Selecione um programa de melhoramento."); return; }
        else if (accession_uniquename == '' && cross_uniquename == '') {
            alert("Informe o nome de um acesso ou o ID único de um cruzamento como conteúdo do lote de sementes."); return;
        }
        else if (accession_uniquename != '' && cross_uniquename != '') {
            alert("Informe o nome de um acesso OU o ID único de um cruzamento como conteúdo do lote de sementes, mas não ambos."); return;
        }
        else {

            jQuery.ajax({
                url: '/ajax/breeders/seedlot-create',
                data : {
                    'seedlot_name' : name,
                    'seedlot_material_type' : material_type,
                    'seedlot_description': seedlot_description,
                    'seedlot_location': location,
                    'seedlot_box_name':box_name,
                    'seedlot_accession_uniquename': accession_uniquename,
                    'seedlot_cross_uniquename': cross_uniquename,
                    'seedlot_organization': organization,
                    'seedlot_population_name': population_name,
                    'seedlot_source': source,
                    'seedlot_amount':amount,
                    'seedlot_weight':weight,
                    'seedlot_timestamp':timestamp,
                    'seedlot_transaction_description':transaction_description,
                    'seedlot_breeding_program_id':breeding_program_id,
                    'seedlot_quality' : seedlot_quality,
                },
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert("O lote de sementes foi criado.");
                        jQuery('#add_seedlot_dialog').modal('hide');
                        //seedlots_table.ajax.reload();
                        //document.location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro ao criar o lote de sementes.');
                }
            });
        }

    });

});
</script>
