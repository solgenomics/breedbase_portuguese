<%args>

$default_seedlot_material_type => undef

</%args>

<div class="modal fade" id="upload_seedlot_dialog" name="upload_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" name="close_seedlots_upload" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog">Enviar lotes de sementes</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"O que são lotes de sementes?" &>
                            <ul>
                            <li>Os lotes de sementes representam materiais vegetais físicos em embalagens ou recipientes.</li>
                            <li>O material de um lote pode ser semente, raiz, clone, planta, cultura de tecidos ou gametófito.</li>
                            <li>Entre em contato conosco para definir um tipo de material padrão para os lotes.</li>
                            <li>Esses materiais podem vir de cruzamentos ou pertencer a acessos identificados.</li>
                            <li>Os lotes podem ter local, caixa, peso em gramas e quantidade específicos.</li>
                            <li>Os lotes podem pertencer a programas de melhoramento e organizações.</li>
                            <li>Os lotes podem ser usados em ensaios (por exemplo, plantados em uma parcela) e colhidos de uma parcela ou planta (por exemplo, após um cruzamento e a coleta das sementes).</li>
                            </ul>

                            <br/><br/>
                            <div style="text-align: center">
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Quais lotes de sementes você tem?" &>
                            <& /page/page_title.mas, title=>"Os lotes de sementes se dividem em duas categorias" &>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Selecione uma opção: </label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="upload_seedlots_type_select" name="upload_seedlots_type_select">
                                        <option value=""></option>
                                        <option data-desc="Use esta opção para lotes de acessos identificados, como sementes adquiridas de um fornecedor. O material não deve ter sido colhido de um cruzamento cadastrado no banco de dados." value="from_accession">Tenho lotes de acessos identificados</option>
                                        <option data-desc="Use esta opção para lotes colhidos de cruzamentos cadastrados no banco de dados." value="from_cross">Tenho lotes colhidos de cruzamentos</option>
                                    </select>
                                </div>
                            </div>
                            <br/><br/>
                            <div id="upload_seedlots_types_description">
                            </div>
                            <br/>
                            <div style="text-align: center">
                                <button disabled id="seedlot_upload_type_select_button" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Formato do arquivo" &>
                            <& /page/page_title.mas, title=>"Confirme se o arquivo está no formato correto" &>
                            <br/><br/>
                            <div style="text-align: center">
                                <div id="upload_seedlots_accessions_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_upload_format_button">Informações sobre o formato para enviar lotes de acessos identificados</button><br/><br/>
                                </div>
                                <div id="upload_seedlots_crosses_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_crosses_upload_format_button">Informações sobre o formato para enviar lotes colhidos</button><br/><br/>
                                </div>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">Quando o arquivo estiver no formato correto, avance para a próxima etapa</button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> "Enviar lotes de sementes" &>
                            <& /page/page_title.mas, title=>"Informe os dados básicos dos lotes de sementes e envie o arquivo" &>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_seedlot_form" name="upload_seedlot_form">
%if ($default_seedlot_material_type) {
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" >Tipo de material: </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" name="upload_seedlots_default_material_type" id="upload_seedlots_default_material_type" disabled value="<% $default_seedlot_material_type %>">
                                    </div>
                                </div>
% } else {
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Tipo de material: </label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_material_type_div"></div>
                                    </div>
                                </div>
% }
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_breeding_program_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Local de armazenamento dos lotes: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_location" id="upload_seedlot_location" placeholder="Obrigatório">
                                    </div>
                                </div>
                                <!--
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Nome da população: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_population_name" id="upload_seedlot_population_name" placeholder="Opcional">
                                    </div>
                                </div>
                                -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Nome da organização: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="Opcional">
                                    </div>
                                </div>

                                <div id="upload_seedlots_accessions_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Enviar arquivo: </label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_uploaded_file" id="seedlot_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                                <div id="upload_seedlots_harvested_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Enviar arquivo: </label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                            </form>
                            <div style="text-align: center">
                                <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" name="upload_seedlot_button" >Enviar lotes de sementes</button><br/><br/>
                            </div>

                        </&>
                        <&| /util/workflow.mas:step, title=> "Corrigir erros no arquivo" &>
                            <& /page/page_title.mas, title=>"Corrija todos os erros do arquivo" &>

                            <div id="upload_seedlots_missing_accessions_or_crosses_div" style="display:none">
                                <div id="upload_seedlots_missing_accessions_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>Os acessos devem existir no banco de dados antes da inclusão de seus lotes de sementes. Um acesso pode estar em vários lotes e, por isso, é cadastrado separadamente. É preciso cuidado ao adicionar novos acessos para evitar a duplicação incorreta de dados.</li>
                                            <li>Para adicionar acessos ao banco de dados, use uma lista de acessos ou um arquivo Excel.</li>
                                        </ul>
                                    </div>

                                    <div id="upload_seedlots_add_missing_accessions_html">
                                    </div>

                                    <button class="btn btn-info" name="add_accessions_link">Adicionar os acessos ao banco de dados</button><br/><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);">Clique aqui quando todos os acessos estiverem no banco de dados</button><br/><br/>
                                </div>
                                <div id="upload_seedlots_missing_crosses_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>Os cruzamentos devem existir no banco de dados antes da inclusão de seus lotes de sementes. Um cruzamento pode produzir vários lotes e, por isso, é cadastrado separadamente. É preciso cuidado ao adicionar novos cruzamentos para evitar que os dados sejam vinculados incorretamente a duplicatas.</li>
                                        </ul>
                                    </div>
                                    <ul>
                                    <li>Para adicionar cruzamentos ao banco de dados, envie um arquivo Excel ou adicione um cruzamento de cada vez.<br/><br/>
                                        <ul>
                                        <li><button class="btn btn-info" name="upload_crosses_link">Enviar arquivo Excel</button><br/><br/></li>
                                        <li><button class="btn btn-info" name="create_cross_link">Adicionar um cruzamento</button></li>
                                        </ul>
                                    </li>
                                    </ul><br/>
                                    <div style="text-align: center">
                                        <button class="btn btn-primary" onclick="Workflow.complete(this);">Clique aqui quando todos os cruzamentos estiverem no banco de dados</button><br/><br/>
                                    </div>
                                </div>
                            </div>
                            <div id="upload_seedlots_error_display" style="display:none">

                                <h3>Mensagens de erro no envio de lotes de sementes</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: center">
                                <div id="upload_seedlots_no_error_messages_accessions_html">
                                </div>
                                <div name="upload_seedlots_completed_message">
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:step, title=> "Tentar enviar os lotes novamente" &>
                            <& /page/page_title.mas, title=>"Envie os lotes de sementes novamente. Se ainda houver erros, consulte a caixa vermelha abaixo. Continue corrigindo o arquivo e clique em Enviar até que ele seja aceito." &>
                            <div style="text-align: center" id="seedlot_upload_show_repeat_upload_button">
                                <button type="button" class="btn btn-lg btn-primary" name="upload_seedlot_button" >Enviar lotes de sementes</button><br/><br/>
                            </div>
                            <div style="text-align: center" name="upload_seedlots_completed_message">
                            </div>

                            <div id="upload_seedlots_error_display_second_try" style="display:none">

                                <h3>O arquivo apresenta os seguintes problemas:</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! Os lotes de sementes estão no banco de dados" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                O arquivo de lotes de sementes foi enviado com sucesso
                            </p>

                            <ul>
                                <li>Você pode acessar as páginas de detalhes dos lotes que acabou de criar.</li>
                                <li>Você pode imprimir códigos de barras para os lotes.</li>
                            </ul>
                            <br/>
                            <div style="text-align: center">
                                <button class="btn btn-primary" name="upload_seedlot_success_complete_button">Os lotes foram salvos no banco de dados sem erros! Clique aqui para concluir</button><br/><br/>
                            </div>
                        </&>
                    </&>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" name="close_seedlots_upload" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_info_dialog" name="seedlot_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotInfoDialog">Informações do modelo de envio para acessos identificados</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>accession_name</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>description</td>
                                <td>box_name</td>
                                <td>quality</td>
                                <td>source</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li><code>seedlot_name</code> (deve ser único)</li>
                    <li><code>accession_name</code> (deve existir no banco de dados; é o identificador único do genótipo)</li>
                    <li><code>operator_name</code> (nome da pessoa responsável pelo inventário; pode ser qualquer nome)</li>
                    <li>
                    <code>amount</code> (quantidade de materiais no lote; informe este valor, o peso ou ambos)
                    <br/><b>E/OU</b><br/>
                    <code>weight_gram</code> (peso do lote em gramas; informe este valor, a quantidade ou ambos)
                    </li>
                    <li><code>box_name</code> (nome da caixa onde está o material vegetal; pode ser qualquer nome)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                      <li><code>description</code> (motivo da inclusão do lote)</li>
                      <li><code>quality</code> (condição do lote, por exemplo, "bom", "com mofo" ou "danificado por insetos")</li>
                      <li><code>source</code> (origem alternativa, como o identificador da parcela, subparcela ou planta de onde as sementes foram coletadas)</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlots", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_harvested_info_dialog" name="seedlot_upload_spreadsheet_harvested_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog">Informações do modelo de envio para lotes colhidos</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>description</td>
                                <td>box_name</td>
                                <td>quality</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li><code>seedlot_name</code> (deve ser único)</li>
                    <li><code>cross_unique_id</code> (deve existir no banco de dados; identifica um cruzamento entre acessos, como AxB, ou entre parcelas específicas no campo, quando essa informação estiver disponível)</li>
                    <li><code>operator_name</code> (nome da pessoa responsável pelo inventário; pode ser qualquer nome)</li>
                    <li>
                    <code>amount</code> (quantidade de materiais no lote; informe este valor, o peso ou ambos)
                    <br/><b>E/OU</b><br/>
                    <code>weight_gram</code> (peso do lote em gramas; informe este valor, a quantidade ou ambos)
                    </li>
                    <li><code>box_name</code> (nome da caixa onde está o material vegetal; pode ser qualquer nome)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                      <li><code>description</code> (motivo da inclusão do lote)</li>
                      <li><code>quality</code> (breve descrição da qualidade, por exemplo, "bom", "com mofo" ou "danificado por insetos")</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlots", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>



<script>
jQuery(document).ready(function(){

    jQuery("#upload_seedlot_location").autocomplete({
       source: '/ajax/stock/geolocation_autocomplete',
    });

    jQuery('#upload_seedlots_type_select').change(function(){
        if (jQuery(this).val() != ''){
            jQuery('#seedlot_upload_type_select_button').attr('disabled', false);
            jQuery('#upload_seedlots_types_description').html('<br/><div class="well"><p>'+jQuery(this).find("option:selected").data("desc")+'</p></div>');
        } else {
            jQuery('#seedlot_upload_type_select_button').attr('disabled', true);
            jQuery('#upload_seedlots_types_description').html('');
        }

        if(jQuery(this).val() == 'from_accession'){
            jQuery('#upload_seedlots_accessions_template_section').show();
            jQuery('#upload_seedlots_crosses_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').show();
            jQuery('#upload_seedlots_harvested_section').hide();
        }
        if(jQuery(this).val() == 'from_cross'){
            jQuery('#upload_seedlots_crosses_template_section').show();
            jQuery('#upload_seedlots_accessions_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').hide();
            jQuery('#upload_seedlots_harvested_section').show();
        }
    });

    jQuery('[name="seedlot_bulk_upload"]').click( function() {
        jQuery('#upload_seedlot_dialog').modal('show');
        get_select_box('breeding_programs', 'upload_seedlot_breeding_program_div', { 'name' : 'upload_seedlot_breeding_program_id', 'id' : 'upload_seedlot_breeding_program_id' });
        get_select_box('material_types', 'upload_seedlot_material_type_div', { 'name' : 'upload_seedlot_material_type', 'id' : 'upload_seedlot_material_type' });
    });

    jQuery("[name='guided_help_seedlot_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery("[name='guided_help_seedlot_crosses_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_harvested_info_dialog" ).modal("show");
    });

    jQuery('[name="upload_seedlot_button"]').click(function () {
        upload_seedlot_button();
    });
    function upload_seedlot_button() {
        let material_type = "";
        const default_seedlot_material_type = "<%$default_seedlot_material_type%>";
        if (default_seedlot_material_type) {
            material_type = default_seedlot_material_type;
        } else {
            material_type = jQuery('#upload_seedlot_material_type').val();
        }
        if (material_type === '') {
            alert("Selecione um tipo de material");
            return;
        }

        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_seedlot_form').attr("action", "/ajax/breeders/seedlot-upload");
        if (breeding_program === '') {
            alert("Selecione um programa de melhoramento");
            return;
        }
        if (location === '') {
            alert("Informe um local");
            return;
        }
        if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
            alert("Selecione um arquivo");
            return;
        }
        jQuery("#upload_seedlot_form").submit();
    }

    jQuery('#upload_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert("Nenhum arquivo selecionado");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            else if (response.error_string) {

                if (response.missing_accessions || response.missing_crosses) {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').show();
                    if (response.missing_accessions){
                        jQuery('#upload_seedlots_missing_accessions_div').show();
                        var missing_accessions_html = "<div class='well well-sm'><h3>Adicionar os acessos ausentes a uma lista</h3><div id='upload_seedlots_missing_accessions' style='display:none'></div><div id='upload_seedlots_add_missing_accessions'></div></div><br/>";
                        jQuery("#upload_seedlots_add_missing_accessions_html").html(missing_accessions_html);

                        var missing_accessions_vals = '';
                        for(var i=0; i<response.missing_accessions.length; i++) {
                            missing_accessions_vals = missing_accessions_vals + response.missing_accessions[i] + '\n';
                        }
                        jQuery("#upload_seedlots_missing_accessions").html(missing_accessions_vals);
                        addToListMenu('upload_seedlots_add_missing_accessions', 'upload_seedlots_missing_accessions', {
                            selectText: true,
                            listType: 'accessions'
                        });
                    } else if (response.missing_crosses){
                        jQuery('#upload_seedlots_missing_crosses_div').show();
                    }
                } else {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').hide();
                    var no_missing_accessions_html = '<button class="btn btn-primary" onclick="Workflow.skip(this);">Não há erros relacionados a acessos ou cruzamentos ausentes. Clique aqui</button><br/><br/>';
                    jQuery('#upload_seedlots_no_error_messages_accessions_html').html(no_missing_accessions_html);
                    Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                }

                jQuery("#upload_seedlots_error_display").show();
                jQuery("#upload_seedlots_error_display tbody").html(response.error_string);
                jQuery("#upload_seedlots_error_display_second_try").show();
                jQuery("#upload_seedlots_error_display_second_try tbody").html(response.error_string);
            }
            if (response.missing_accessions || response.missing_crosses){
                Workflow.focus("#upload_seedlot_main_workflow", 4);
            } else if(response.error_string){
                Workflow.focus("#upload_seedlot_main_workflow", 5);
                jQuery("#upload_seedlots_error_display_second_try").show();
            }
            if (response.success) {
                jQuery("#upload_seedlots_error_display").hide();
                jQuery("#upload_seedlots_error_display_second_try").hide();
                jQuery('#seedlot_upload_show_repeat_upload_button').hide();
                jQuery('[name="upload_seedlots_completed_message"]').html('<button class="btn btn-primary" name="upload_seedlot_success_complete_button">Os lotes foram salvos no banco de dados sem erros! Clique aqui para concluir</button><br/><br/>');
                Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                Workflow.skip('#upload_seedlots_error_display_second_try', false);
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");
            }

        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert('Os lotes de sementes foram salvos no banco de dados');
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });

    jQuery('[name="close_seedlots_upload"]').click(function () {
        jQuery('#upload_seedlots_type_select').val("");
        jQuery('#upload_seedlot_location').val("");
        jQuery('#upload_seedlot_organization_name').val("");
        jQuery('#seedlot_uploaded_file').val("");
        jQuery('#seedlot_harvested_uploaded_file').val("");
        location.reload();
    });


});
</script>
