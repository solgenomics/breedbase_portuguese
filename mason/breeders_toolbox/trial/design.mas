
<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [  ] &>


<div id="trial_design_html" >
<div class="well">
[CARREGANDO...]
<br/>
</div>
</div>

<script>

jQuery(document).ready(function () {

	jQuery.ajax ( {
		url : '/ajax/breeders/trial/'+<% $trial_id %>+'/design',
		success: function(response){
			if (!response.design_type) {
				jQuery('#trial_design_html').empty();
				var html = "<div class='well well-sm'>Não há dados de delineamento para este ensaio.</div>";
					jQuery('#trial_design_html').html(html);
	    	} else {
				var trial_design_html = "<table class='table table-hover table-condensed table-bordered table-striped' id='trial_controls_table'><thead><tr><th>Atributo</th><th>Valor</th></tr></thead><tbody><tr><td>Delineamento</td><td><b>"+response.design_type+"</b></td></tr><tr><td>Número de blocos</td><td>"+response.num_blocks+"</td></tr><tr><td>Número de repetições</td><td>"+response.num_reps+"</td></tr><tr><td>Comprimento da parcela</td><td>"+response.plot_length+"</td></tr><tr><td>Largura da parcela</td><td>"+response.plot_width+"</td></tr><tr><td>Subparcelas por parcela</td><td>"+response.subplots_per_plot+"</td></tr><tr><td>Plantas por parcela</td><td>"+response.plants_per_plot+"</td></tr></tbody></table>";
				jQuery('#trial_design_html').empty();
				jQuery('#trial_design_html').html(trial_design_html);
			}
		},
		error: function(response){
			alert("Erro ao obter o delineamento.");
		}
	});
});

</script>
