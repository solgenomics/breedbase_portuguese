
<%args>
$trial_id
$user_can_modify
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

% if ($user_can_modify) {
    <button class="btn btn-sm btn-primary" style="margin:3px" id="trial_detail_page_add_treatment">Adicionar tratamentos</button>
% }

<div id="trial_treatments_html">
    <br>
    <table id="trial_treatments_table">
    </table>
    <br>
    <select id="trial_treatment_to_stock_select">
    </select>
    <select id="trial_treatment_level_applied_select">
        <option value="plot">Parcela</option>
        <option value="subplot">Subparcela</option>
        <option value="plant">Planta</option>
        <option value="tissue_sample">Amostra de tecido</option>
    </select>
    <button class="btn btn-sm btn-primary" id="treatments_get_raw_data_btn">Obter dados dos tratamentos</button>
    <br>
    <table id="trial_treatments_raw_data">
    </table>
</div>

<script>

jQuery(document).ready(function () {

    function get_trial_overview_data() {
        jQuery.ajax ({
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/treatments',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    let seen_treatments = {};
                    if (""+<% $user_can_modify %>+"") {
                        jQuery('#trial_treatments_table').DataTable({
                            data: JSON.parse(response.data),
                            columns: [
                                {
                                    data : 'trait_name', 
                                    title : 'Tratamento',
                                    orderable : false,
                                    render : function(data, type, row, meta) {
                                        
                                        if (!(row.trait_id in seen_treatments)) {
                                            jQuery('#trial_treatment_to_stock_select').append('<option value="'+row.trait_id+'">'+data+'</option>');
                                            seen_treatments[row.trait_id] = 1;
                                        }
                                        
                                        let html = '<a href="/cvterm/'+row.trait_id+'/view/">'+data+'</a>';
                                        return html;
                                    }
                                },
                                {data : 'count', title : 'Total de materiais'},
                                {
                                    data : 'trait_id',
                                    title : 'Remover tratamento',
                                    orderable : false,
                                    render : function(data, type, row, meta) {
                                        let html = `<button class="btn btn-small btn-danger treatment-delete-btn" id="delete_treatment_${data}"><span class="glyphicon glyphicon-trash"></span></button>`;
                                        return html;
                                    }
                                }
                            ]
                        });
                    } else {
                        jQuery('#trial_treatments_table').DataTable({
                            data: JSON.parse(response.data),
                            columns: [
                                {
                                    data : 'trait_name', 
                                    title : 'Tratamento',
                                    orderable : false,
                                    render : function(data, type, row, meta) {
                                        
                                        if (!(row.trait_id in seen_treatments)) {
                                            jQuery('#trial_treatment_to_stock_select').append('<option value="'+row.trait_id+'">'+data+'</option>');
                                            seen_treatments[row.trait_id] = 1;
                                        }
                                        
                                        let html = '<a href="/cvterm/'+row.trait_id+'/view/">'+data+'</a>';
                                        return html;
                                    }
                                },
                                {data : 'count', title : 'Total de materiais'},
                            ]
                        });
                    }
                    
                }
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert("Erro ao obter os tratamentos.");
            }
        });
    }

    jQuery('#trial_treatments_onswitch').one("click", function() {
        get_trial_overview_data();
    });

    jQuery('#treatments_get_raw_data_btn').click(function() {
        jQuery('#working_modal').modal("show");
        let trial_id = "" + <% $trial_id %> + "";
        let treatment_id = jQuery('#trial_treatment_to_stock_select').val();
        let stock_type = jQuery('#trial_treatment_level_applied_select').val();
        jQuery.ajax({
    	   	url: "/brapi/v2/search/observations/",
		    data: { studyDbIds: [ trial_id ], observationVariableDbIds: [ treatment_id ], observationLevel: [ stock_type ]},
		    method: "POST"
        }).then((result) => fetch_raw_observation_data_table(result.result.searchResultsDbId))
        .then((result) => {
            jQuery('#working_modal').modal("hide");
            jQuery('#trial_treatments_raw_data').DataTable().clear().destroy();
            jQuery('#trial_treatments_raw_data').DataTable({
                data : result.result.data,
                columns : [
                    {
                        data : 'observationUnitName',
                        title : 'Material',
                        orderable : true,
                        render : function(data, type, row, meta) {
                            let html = '<a href="/stock/'+row.observationUnitDbId+'/view/">'+data+'</a>';
                            return html;
                        }
                    },
                    {data : 'value', title : 'Valor do tratamento'}
                ],
                columnDefs : [
                    {targets : 0, width : "50%"}
                ]
            });
        }).catch((error) => {
            jQuery('#working_modal').modal("hide"); 
            console.log(error);
        });
    });


    jQuery('#trial_detail_page_add_treatment').click(function(){
        jQuery('#upload_treatment_spreadsheet_dialog').modal('show');
    });

    jQuery(document).on('change', 'input[name="add_trial_treatment_select_all"]', function(){
        if(jQuery(this).is(":checked")){
            jQuery('input[name="add_trial_treatment_input"]').each(function(){
                jQuery(this).prop("checked", true);
            });
        } else {
            jQuery('input[name="add_trial_treatment_input"]').each(function(){
                jQuery(this).prop("checked", false);
            });
        }
    });

    function fetch_raw_observation_data_table(searchResultsDbId) {
       	return jQuery.ajax( {
       		url: "/brapi/v2/search/observations/"+searchResultsDbId,
	    	data: { pageSize: 10000 },
	    	method: "GET"
	    });     
    }

    jQuery('#trial_treatments_raw_data').DataTable({
        'destroy': true,
        'columns': [
            { title: 'Material' },
            { title: 'Valor do tratamento' },
        ]
    });

    jQuery(document).on('click', '.treatment-delete-btn',function() {

        let this_id = jQuery(this).attr('id');
        let splits = this_id.split('_');
        let treatment_id = splits[2];

        if (confirm("Excluir os dados deste tratamento de todos os materiais?")) {
            jQuery.ajax({
                url : '/ajax/breeders/trial/'+<% $trial_id %>+'/remove_treatment',
                data : {
                    'treatment_id' : treatment_id
                },
                beforeSend: function() {
                    jQuery('#working_modal').modal("show");
                },
                success : function(response) {
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert(response.error);
                    } else {
                        alert("Dados do tratamento removidos.");
                        window.location.reload();
                    }
                },
                error : function(response) {
                    jQuery('#working_modal').modal("hide");
                    console.log(response);
                    alert("Ocorreu um erro ao excluir os dados do tratamento.");
                }
            });
        }
        
    });
});

</script>
