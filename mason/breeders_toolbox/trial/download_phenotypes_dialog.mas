
<%args>
$trial_ids
$dialog_type => undef
$dialog_name => undef
</%args>

<%once>
    my $default_repeat_measurements = $c->get_conf('pheno_download_default_repeat_measurements');
    my $default_include_timestamps = $c->get_conf('pheno_download_default_include_timestamps');
    my $default_include_intercrop_accessions = $c->get_conf('pheno_download_default_include_intercrop_accessions');
    my $default_include_entry_numbers = $c->get_conf('pheno_download_default_include_entry_numbers');
    my $default_include_trait_synonyms = $c->get_conf('pheno_download_default_include_trait_synonyms');
    my $default_supress_outliers = $c->get_conf('exclude_phenotype_outliers');
    my $default_include_pedigree_parents = $c->get_conf('pheno_download_default_include_pedigree_parents');
</%once>

% my $dialog_type_label = $dialog_type;
% if (defined $dialog_type && $dialog_type eq 'Trial') {
%     $dialog_type_label = 'ensaio';
% } elsif (defined $dialog_type && $dialog_type eq 'Analysis') {
%     $dialog_type_label = 'análise';
% }

<div class="modal fade" id="download_trial_phenotypes_dialog" name="download_trial_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="downloadTrialPhenotypesDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="downloadTrialPhenotypesDialog">Baixar fenótipos da <% $dialog_type_label %> <% $dialog_name %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

	       <form class="form-horizontal" role="form" method="post" >
               <div class="form-group">
                   <label class="col-sm-3 control-label">Velocidade: </label>
                   <div class="col-sm-9" >
                       <select class="form-control" id="download_trial_phenotypes_speed">
                           <option selected value="Native">Padrão</option>
                           <option value="MaterializedViewTable">Rápida (melhora a velocidade, mas pode omitir alterações recentes)</option>
                       </select>
                   </div>
               </div>
	        <div class="form-group">
                <label class="col-sm-3 control-label">Formato: </label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_trial_phenotypes_format">
                        <option value="csv">CSV</option>
						<option value="xlsx">Excel (xlsx)</option>
                    </select>
                </div>
	        </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Nível dos dados: </label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_trial_phenotypes_level_option">
                        <option value="all">Todos</option>
%  if ($dialog_type ne 'Analysis') {
                        <option value="plot">Parcelas</option>
                        <option value="plant">Plantas</option>
                        <option value="subplot">Subparcelas</option>
%  }
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Características:<br/><small>(não selecione nenhuma para incluir todas)</small></label>
                <div class="col-sm-9" >
                    <div id="download_trial_phenotypes_traits">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Componentes das características:<br/><small>(não selecione nenhum para incluir todos)</small></label>
                <div class="col-sm-9" >
                    <div id="download_trial_phenotypes_trait_components">
                    </div>
                </div>
            </div>

<&| /page/info_section.mas, title=>"Opções adicionais de pesquisa",  collapsible => 1, collapsed=>1 &>

            <div class="form-group">
                <label class="col-sm-7 control-label">Para medições repetidas, retornar: </label>
                <div class="col-sm-5">
                    <select class="form-control" id="download_trial_phenotypes_repetitive_measurements_option">
                        <option value="first">Primeiro valor</option>
                        <option value="last">Último valor</option>
                        <option value="average">Valor médio</option>
                        <option value="sum">Soma dos valores</option>
                        <option value="all_values_single_line">Todos os valores em uma única linha</option>
                        <option value="all_values_multiple_line">Todos os valores em várias linhas</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Incluir data e hora: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_timestamp_option">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Incluir acessos de cultivo consorciado: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_intercrop_option">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Incluir números de entrada: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_entry_numbers_option">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Incluir sinônimos das características: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_trait_synonyms_option">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Incluir parentais: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_pedigrees_option">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">O nome da característica contém: </label>
                <div class="col-sm-5" >
                    <input id="download_trial_phenotype_trait_contains" name="download_trial_phenotype_trait_contains" type="text" class="form-control" placeholder="storage root,oxoglutarate" style="width: 100%"/>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-7 control-label">Valor fenotípico mínimo: </label>
                        <div class="col-sm-5" >
                            <input id="download_trial_phenotype_phenotype_min" name="download_trial_phenotype_phenotype_min" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-7 control-label">Valor fenotípico máximo: </label>
                        <div class="col-sm-5" >
                            <input id="download_trial_phenotype_phenotype_max" name="download_trial_phenotype_phenotype_max" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-7 control-label">Suprimir valores fenotípicos atípicos definidos pelo usuário: </label>
                <div class="col-sm-5" >
                    <select class="form-control" id="download_trial_phenotypes_exclude_outliers">
                        <option value="0">Não</option>
                        <option value="1">Sim</option>
                    </select>
                </div>
            </div>
</&>
        </form><br/>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="download_trial_phenotypes_cancel_button" id="download_trial_phenotypes_cancel_button" data-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-primary" name="download_trial_phenotypes_submit_button" id="download_trial_phenotypes_submit_button" title="Enviar">Enviar</button>
      </div>
    </div>
  </div>
</div>

<script>

jQuery(document).ready(function() {

  setDefaultOptions();

  jQuery('#trial_download_phenotypes_button').click( function () {
    jQuery('#download_trial_phenotypes_dialog').modal("show");
    data_level_change_traits();
  });

  jQuery(document).on('change', "#download_trial_phenotypes_level_option", function() {
    data_level_change_traits();
  });

  jQuery('#download_trial_phenotypes_submit_button').click( function () {
    var trial_ids = "<% $trial_ids %>";
    var trial_id_array = trial_ids.split(",");
    var speed = jQuery("#download_trial_phenotypes_speed").val();
    var format = jQuery("#download_trial_phenotypes_format").val();
    var repetitive_measurements = jQuery("#download_trial_phenotypes_repetitive_measurements_option").val();
    var timestamp = jQuery("#download_trial_phenotypes_timestamp_option").val();
    var intercrop = jQuery("#download_trial_phenotypes_intercrop_option").val()
    var entry_numbers = jQuery("#download_trial_phenotypes_entry_numbers_option").val();
    var trait_contains = jQuery("#download_trial_phenotype_trait_contains").val();
    var trait_contains_array = trait_contains.split(",");
    var traits = jQuery("#download_trial_phenotypes_traits_select").val();
    var trait_components = jQuery("#download_trial_phenotypes_trait_components_select").val();
    var data_level = jQuery("#download_trial_phenotypes_level_option").val();
    var phenotype_min_value = jQuery("#download_trial_phenotype_phenotype_min").val();
    var phenotype_max_value = jQuery("#download_trial_phenotype_phenotype_max").val();
    var exclude_phenotype_outlier = jQuery("#download_trial_phenotypes_exclude_outliers").val();
    var include_trait_synonyms = jQuery("#download_trial_phenotypes_trait_synonyms_option").val();
    var include_pedigree_parents = jQuery("#download_trial_phenotypes_pedigrees_option").val();

    window.open("/breeders/trials/phenotype/download?trial_list="+JSON.stringify(trial_id_array)+"&speed="+speed+"&format="+format+"&timestamp="+timestamp+"&intercrop="+intercrop+"&entry_numbers="+entry_numbers+"&trait_contains="+JSON.stringify(trait_contains_array)+"&trait_component_list="+JSON.stringify(trait_components)+"&trait_list="+JSON.stringify(traits)+"&dataLevel="+data_level+"&phenotype_min_value="+phenotype_min_value+"&phenotype_max_value="+phenotype_max_value+"&exclude_phenotype_outlier="+exclude_phenotype_outlier+"&repetitive_measurements="+repetitive_measurements+"&trait_synonyms="+include_trait_synonyms+"&include_pedigree_parents="+include_pedigree_parents);

  });

});

function data_level_change_traits() {
    get_select_box('traits', 'download_trial_phenotypes_traits', { 'name' : 'download_trial_phenotypes_traits_select', 'id' : 'download_trial_phenotypes_traits_select', 'trial_ids':'<% $trial_ids %>', 'data_level':jQuery('#download_trial_phenotypes_level_option').val(), 'multiple': true });
    get_select_box('phenotyped_trait_components', 'download_trial_phenotypes_trait_components', { 'name' : 'download_trial_phenotypes_trait_components_select', 'id' : 'download_trial_phenotypes_trait_components_select', 'trial_ids':'<% $trial_ids %>', 'data_level':jQuery('#download_trial_phenotypes_level_option').val() });
}

function setDefaultOptions() {
    var default_repeat_measurements = "<% $default_repeat_measurements %>";
    var default_include_timestamps = <% $default_include_timestamps %>;
    var default_include_intercrop_accessions = <% $default_include_intercrop_accessions %>;
    var default_include_entry_numbers = <% $default_include_entry_numbers %>;
    var default_include_trait_synonyms = <% $default_include_trait_synonyms %>;
    var default_supress_outliers = <% $default_supress_outliers %>;
    var default_include_pedigree_parents = <% $default_include_pedigree_parents %>;

    jQuery("#download_trial_phenotypes_repetitive_measurements_option").val(default_repeat_measurements);
    jQuery("#download_trial_phenotypes_timestamp_option").val(default_include_timestamps);
    jQuery("#download_trial_phenotypes_intercrop_option").val(default_include_intercrop_accessions);
    jQuery("#download_trial_phenotypes_entry_numbers_option").val(default_include_entry_numbers);
    jQuery("#download_trial_phenotypes_trait_synonyms_option").val(default_include_trait_synonyms);
    jQuery("#download_trial_phenotypes_exclude_outliers").val(default_supress_outliers);
    jQuery("#download_trial_phenotypes_pedigrees_option").val(default_include_pedigree_parents);

}
</script>
