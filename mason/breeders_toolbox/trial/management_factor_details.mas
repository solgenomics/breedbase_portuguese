<%args>
$trial_id
$trial_name
$trial_description
$year => undef
$management_factor_date => undef
$management_factor_type => undef
</%args>

<table class="table table-hover table-bordered" >
    <tr>
    <td><b>Nome do tratamento</b></td>
    <td>
        <div id="management_factor_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "[Sem nome]";
% }
        </div>
    </td>
    </tr>
    <tr>
    <td><b>Descrição do tratamento</b></td>
    <td>
        <div id="management_factor_description">
% if ($trial_description) {
%   print "$trial_description";
% } else {
%   print "[Sem descrição]";
% }
        </div>
    </td>
    </tr>
    <tr>
    <td><b>Tipo de tratamento</b></td>
    <td>
        <div id="management_factor_type">
% if ($management_factor_type) {
%   print "$management_factor_type";
% } else {
%   print "[Sem tipo]";
% }
        </div>
    </td>
    </tr>
    <tr>
    <td><b>Ano do tratamento</b></td>
    <td>
        <div id="management_factor_year">
% if ($year) {
%   print "$year";
% } else {
%   print "[Sem ano]";
% }
        </div>
    </td>
    </tr>
    </tr>
    <tr>
    <td><b>Data do tratamento</b></td>
    <td>
        <div id="management_factor_date">
% if ($management_factor_date) {
%   print "$management_factor_date";
% } else {
%   print "[Sem data]";
% }
        </div>
    </td>
    </tr>
</table>
