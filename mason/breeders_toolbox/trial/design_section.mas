<%args>
$trial_id
$trial_name
$has_subplot_entries
$has_plant_entries
$has_tissue_sample_entries
$trial_stock_type => undef
$management_factor_types => undef
$user_can_modify => undef
$curator => undef
</%args>

<style>

</style>

<div class="well well-sm">

    <& /breeders_toolbox/trial/design.mas, trial_id => $trial_id &>
% my $stock_label = '';
% if ($trial_stock_type eq 'family_name') {
%     $stock_label = 'Nomes de famílias';
% } elsif ($trial_stock_type eq 'cross') {
%     $stock_label = 'IDs exclusivos de cruzamentos';
% } else {
%     $stock_label = 'Acessos' ;

% }

  <&| /page/info_section.mas, id => "management_regime", title=> 'Manejo', subtitle => '<div class="col-sm-4"><div id="management_factors">Como este ensaio foi manejado</div></div>',is_subsection => 1, collapsible=>1, collapsed=>1 &>

      <& /breeders_toolbox/trial/design_section_management_regime.mas, trial_id => $trial_id,management_factor_types => $management_factor_types, user_can_modify => $user_can_modify &>

  </&>

  <& /breeders_toolbox/trial/trial_stocks_count.mas, trial_id => $trial_id &>
  <&| /page/info_section.mas, id => "trial_stocks", title=> $stock_label, subtitle => '<div class="col-sm-4"><div id="stocks_counts"></div></div>',is_subsection => 1, collapsible=>1, collapsed=>1 &>

      <& /breeders_toolbox/trial/trial_stocks.mas, trial_id => $trial_id &>

  </&>


    <&| /page/info_section.mas, id => "trial_seedlots", title=>"Lotes de sementes", subtitle => '<div class="col-sm-4"><div id="seedlots_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_seedlots.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_seedlots_count.mas, trial_id => $trial_id &>
    </&>


    <&| /page/info_section.mas, id => "trial_controls", title=>"Testemunhas", subtitle => '<div class="col-sm-4"><div id="controls_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_controls.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_controls_count.mas, trial_id => $trial_id &>
    </&>


    <&| /page/info_section.mas, id => "trial_plots", title=>"Parcelas", subtitle => '<div class="col-sm-4"><div id="plots_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_plots.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_plots_count.mas, trial_id => $trial_id &>
    </&>

    <&| /page/info_section.mas, id => "trial_subplots", title=>"Subparcelas",  is_subsection => 1, collapsible=>1, collapsed=>1 &>

        <div id="subplot_entries_section">

% if (!$has_subplot_entries && !$has_plant_entries) {
            <button class="btn btn-default" id="create_subplot_entries_button">Adicionar subparcelas</button>
            <button class="btn btn-default" id="upload_subplot_entries_button">Enviar subparcelas usando subplot_name</button>
            <button class="btn btn-default" id="upload_subplot_entries_with_index_number_button">Enviar subparcelas usando o número de índice da subparcela</button>
            <button class="btn btn-default" id="trial_upload_subplots_with_num_subplots_button">Enviar subparcelas usando o número de subparcelas por parcela</button>
% } elsif ($has_plant_entries && !$has_subplot_entries) {
            <p>Não é possível adicionar subparcelas a ensaios que já contêm plantas.</p>
% } else {
            <& /breeders_toolbox/trial/trial_subplots.mas, trial_id => $trial_id, curator => $curator &>     
% if ($curator) {
            <br>
            <button class="btn btn-default" id="create_subplot_entries_button">Adicionar subparcelas</button>
            <button class="btn btn-default" id="upload_subplot_entries_button">Enviar subparcelas usando subplot_name</button>
            <button class="btn btn-default" id="upload_subplot_entries_with_index_number_button">Enviar subparcelas usando o número de índice da subparcela</button>
            <button class="btn btn-default" id="trial_upload_subplots_with_num_subplots_button">Enviar subparcelas usando o número de subparcelas por parcela</button>
% }
% }

        </div>

    </&>

    <&| /page/info_section.mas, id => "trial_plants", title=>"Plantas", is_subsection => 1, collapsible=> 1, collapsed=>1 &>

        <div id="plant_entries_section">

% if (!$has_plant_entries && !$has_subplot_entries) {
           <p><strong>Adicionar plantas às parcelas:</strong></p>
           <button class="btn btn-default" id="create_plant_entries_button">Adicionar plantas</button>
           <button class="btn btn-default" id="upload_plant_entries_button">Enviar plantas usando plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_button">Enviar plantas usando o número de índice da planta</button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_button">Enviar plantas usando o número de plantas por parcela</button>

% } elsif ($has_subplot_entries && !$has_plant_entries) {

           <br />
           <p><strong>Adicionar plantas às subparcelas:</strong></p>
           <button class="btn btn-default" id="create_plant_entries_subplots_button">Adicionar plantas</button>
           <button class="btn btn-default" id="upload_plant_entries_subplots_button">Enviar plantas usando plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_subplots_button">Enviar plantas usando o número de índice da planta</button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_subplots_button">Enviar plantas usando o número de plantas por subparcela</button>
% } else { # if this executes, there's definitely no plants
            <& /breeders_toolbox/trial/trial_plants.mas, trial_id => $trial_id, curator => $curator &>
%       if ($curator && $has_subplot_entries) {
            <p><strong>Adicionar plantas às subparcelas:</strong></p>
           <button class="btn btn-default" id="create_plant_entries_subplots_button">Adicionar plantas</button>
           <button class="btn btn-default" id="upload_plant_entries_subplots_button">Enviar plantas usando plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_subplots_button">Enviar plantas usando o número de índice da planta</button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_subplots_button">Enviar plantas usando o número de plantas por subparcela</button>
%       }
%       if ($curator && !$has_subplot_entries) {
            <p><strong>Adicionar plantas às parcelas:</strong></p>
           <button class="btn btn-default" id="create_plant_entries_button">Adicionar plantas</button>
           <button class="btn btn-default" id="upload_plant_entries_button">Enviar plantas usando plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_button">Enviar plantas usando o número de índice da planta</button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_button">Enviar plantas usando o número de plantas por parcela</button>
%       }
% }

        </div><!--closes plant_entries_section -->

    </&>

    <&| /page/info_section.mas, id => "trial_tissue_samples", title=>"Amostras de tecido", is_subsection => 1, collapsible=> 1, collapsed=>1 &>

        <div id="tissue_sample_entries_section">

% if (!$has_tissue_sample_entries) {
           <button class="btn btn-default" id="create_tissue_sample_entries_button">Adicionar amostras de tecido</button>
           <& /breeders_toolbox/trial/add_tissue_sample_per_plant.mas, trial_id => $trial_id, trial_name => $trial_name, trial_has_plants => $has_plant_entries &>
% } else {
		   <button class="btn btn-default" id="create_tissue_sample_entries_button">Adicionar amostras de tecido</button>
           <& /breeders_toolbox/trial/add_tissue_sample_per_plant.mas, trial_id => $trial_id, trial_name => $trial_name, trial_has_plants => $has_plant_entries &>
           <& /breeders_toolbox/trial/trial_tissue_samples.mas, trial_id => $trial_id &>
% }

        </div><!--closes tissue_sample_entries_section -->

    </&>

    <&| /page/info_section.mas, id => "summary_of_stock_entries", title=>"Resumo dos materiais",  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <div id="summary_entries_section">
            <& /breeders_toolbox/trial/summary_stock_entries.mas, trial_id => $trial_id, trial_stock_type => $trial_stock_type &>
        </div>
    </&>

    <&| /page/info_section.mas, id => "trial_treatments", title=>"Tratamentos",  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_treatments.mas, trial_id => $trial_id, user_can_modify => $user_can_modify &>
    </&>

    <&| /page/info_section.mas, id=>"trial_entry_numbers", title=>"Números de entrada", is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_entry_numbers.mas, trial_id => $trial_id, trial_name => $trial_name &>
    </&>



</div><!-- closes well -->
