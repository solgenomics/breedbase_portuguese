<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>



<&| /page/info_section.mas, title => "Dados do solo do ensaio", collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "soil_data_table" class="table table-hover table-striped">
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<script defer="defer">

jQuery(document).ready(function () {

    var soil_data_table = jQuery('#soil_data_table').DataTable({
        'searching': false,
        'order': false,
        'autoWidth': false,
        'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/all_soil_data',
        columns: [
            { title: "ID dos dados do solo", "data": "prop_id" },
            { title: "Descrição", "data": "description" },
            { title: "Data", "data": "date" },
            { title: "GPS", "data": "gps" },
            { title: "Tipo de amostragem", "data": "type_of_sampling" },
            { title: "Dados do solo", "data": "soil_data" },
            { title: "Baixar", "data": "download_link" },
            { title: "Excluir", "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteSoilData("+row.prop_id+")'>Excluir</a>"; } },
        ]
    });

});

function deleteSoilData(prop_id){
    var confirmation = confirm('Deseja realmente excluir este registro de dados do solo? A exclusão não pode ser desfeita.');

    if (confirmation) {
        jQuery.ajax({
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_soil_data',
            method: 'POST',
            data : {
                'prop_id': prop_id
            },

            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert('Exclusão realizada com sucesso.');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro durante a exclusão.');
            }
        });
    }
}


</script>
