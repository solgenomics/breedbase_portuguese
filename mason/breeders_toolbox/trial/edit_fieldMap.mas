    var trial_name = "<% $trial_name %>";
    var edit_dialog_title = '';
    var replace_button_label = '';
    var substitute_button_label = '';
    var replace_dialog_title = '';
    var replace_stock_text1 = '';
    var replace_stock_text2 = '';
    var replace_button_submit = '';
    var substitute_dialog_title = '';
    var substitute_button_submit = '';
    var replace_message_title = '';
    var replace_success_message = '';
    var subs_message_title = '';
    var subs_success_message = '';

    if (trial_stock_type == 'family_name') {
        edit_dialog_title = 'Substituir nomes de famílias nas parcelas do ensaio';
        replace_button_label = 'Substituir nome de família';
        substitute_button_label = 'Trocar nome de família';
        replace_dialog_title = 'Substituir nome de família no ensaio '.concat(trial_name);
        replace_stock_text1 = 'Selecionar nome de família: ';
        replace_stock_text2 = 'Informar novo nome de família: ';
        replace_button_submit = 'Substituir nome de família no ensaio';
        substitute_dialog_title = 'Trocar nome de família de parcela em '.concat(trial_name);
        substitute_button_submit = 'Trocar nome de família da parcela';
        replace_message_title = 'Substituir nome de família do ensaio';
        replace_success_message = 'O nome de família foi substituído com sucesso.';
        subs_message_title = 'Trocar nome de família da parcela';
        subs_success_message = 'O nome de família foi trocado com sucesso.';
    } else if (trial_stock_type == 'cross') {
        edit_dialog_title = 'Substituir IDs exclusivos de cruzamentos nas parcelas do ensaio';
        replace_button_label = 'Substituir ID exclusivo de cruzamento';
        substitute_button_label = 'Trocar ID exclusivo de cruzamento';
        replace_dialog_title = 'Substituir ID exclusivo de cruzamento no ensaio '.concat(trial_name);
        replace_stock_text1 = 'Selecionar ID exclusivo de cruzamento: ';
        replace_stock_text2 = 'Informar novo ID exclusivo de cruzamento: ';
        replace_button_submit = 'Substituir ID exclusivo de cruzamento no ensaio';
        substitute_dialog_title = 'Trocar ID exclusivo de cruzamento da parcela em '.concat(trial_name);
        substitute_button_submit = 'Trocar ID exclusivo de cruzamento da parcela';
        replace_message_title = 'Substituir ID exclusivo de cruzamento';
        replace_success_message = 'O ID exclusivo de cruzamento foi substituído com sucesso.';
        subs_message_title = 'Trocar ID exclusivo de cruzamento';
        subs_success_message = 'O ID exclusivo de cruzamento foi trocado com sucesso.';
    } else {
        edit_dialog_title = 'Substituir acessos nas parcelas do ensaio';
        replace_button_label = 'Substituir acesso';
        // substitute_button_label = 'Substitute Accession';
        replace_dialog_title = 'Substituir acesso no ensaio '.concat(trial_name);
        replace_stock_text1 = 'Selecionar acesso: ';
        replace_stock_text2 = 'Informar novo acesso: ';
        replace_button_submit = 'Substituir acesso no ensaio';
        // substitute_dialog_title = 'Substitute Plot Accession in '.concat(trial_name);
        // substitute_button_submit = 'Substitute Plot Accession';
        replace_message_title = 'Substituir acesso do ensaio';
        replace_success_message = 'O acesso foi substituído com sucesso.';
        // subs_message_title = 'Substitute Plot Accession';
        // subs_success_message = 'Accession was substituted successfully.';
    }

    jQuery('#edit_field_map_title').text(edit_dialog_title);
    jQuery('#replace_trial_stock_submit').text(replace_button_label);
    // jQuery('#substitute_stock_submit').text(substitute_button_label);
    jQuery('#replace_stocks_dialog').text(replace_dialog_title);
    jQuery('#replace_stock_label1').text(replace_stock_text1);
    jQuery('#replace_stock_label2').text(replace_stock_text2);
    jQuery('#replace_stock_submit').text(replace_button_submit);
    // jQuery('#substitute_plot_dialog').text(substitute_dialog_title);
    // jQuery('#substitute_plot_stock_submit').text(substitute_button_submit);
    jQuery('#replace_stock_message_title').text(replace_message_title);
    jQuery('#replace_stock_success_message').text(replace_success_message);
    // jQuery('#subs_stock_message_title').text(subs_message_title);
    // jQuery('#subs_stock_success_message').text(subs_success_message);

});


</script>
