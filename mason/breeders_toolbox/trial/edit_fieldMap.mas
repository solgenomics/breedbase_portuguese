                <button id="close_replace_trial_accession_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="replace_stock_submit" id="replace_stock_submit"></button>
            </div>
        </div>
    </div>
</div>

