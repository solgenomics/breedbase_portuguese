
<%args>
$trial_id
$trial_name => undef
$trial_has_plants => undef
</%args>

<div class="modal fade" id="add_tissue_samples_dialog" name="add_tissue_samples_dialog" tabindex="-1" role="dialog" aria-labelledby="addTissueSamplesDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addTissueSamplesDialog">Adicionar amostras de tecido a <% $trial_name %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

% if (!$trial_has_plants){
                    <h3>AVISO: este ensaio não tem registros de plantas. As amostras de tecido são adicionadas a cada planta; portanto, primeiro adicione os registros de plantas na seção “Registros de plantas” da página de detalhes do ensaio.</h3>
% }

                    <form class="form-horizontal" role="form" method="post" id="add_tissue_samples_dialog_form" name="add_tissue_samples_dialog_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span title="Você pode usar o mesmo nome de tecido mais de uma vez, por exemplo, raiz e raiz. O nome continuará exclusivo porque um índice, como 1 e 2, será acrescentado ao final." </span><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;Número de amostras de tecido por planta: </span></label>
                            <div class="col-sm-8" >
                                <input name="add_tissue_samples_per_plant_num" id="add_tissue_samples_per_plant_num" class="form-control" type="text" autofocus/>
                            </div>
                        </div>

                        <div id="add_tissue_samples_names_div">
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Herdar tratamentos das parcelas: </label>
                            <div class="col-sm-8" >
                                <input name="add_tissue_samples_per_plant_inherit_treatments" id="add_tissue_samples_per_plant_inherit_treatments" type="checkbox" checked disabled/>
                            </div>
                        </div>
                    </form><br/>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="add_tissue_samples_cancel_button" id="add_tissue_samples_cancel_button" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="add_tissue_samples_save_button" id="add_tissue_samples_save_button" title="Salvar">Salvar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function() {

    jQuery('#create_tissue_sample_entries_button').click( function () {
        alert("Verifique a seção Vínculos experimentais para saber se este ensaio já está ligado a uma placa de genotipagem. Talvez não seja necessário criar novas amostras de tecido.");
        jQuery('#add_tissue_samples_dialog').modal("show");
    });

    jQuery('#add_tissue_samples_save_button').click( function () {
        add_tissue_samples_to_trial();
    });

    jQuery('#add_tissue_samples_per_plant_num').keyup(function(){
        var num_tissues = jQuery(this).val();
        var html = '';
        for (var i=1; i<=num_tissues; i++){
            html = html + '<div class="form-group"><label class="col-sm-3 control-label"><span title="Os nomes das amostras combinarão o nome da planta, o nome do tecido informado aqui e o número do tecido."><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;Nome do tecido '+i+': </span></label><div class="col-sm-9" ><input name="add_tissue_samples_tissue_name" id="add_tissue_samples_tissue_name_'+i+'" class="form-control" type="text" placeholder="exemplos: folha, raiz, caule, semente, fruto ou tubérculo" /></div></div>';
        }
        jQuery('#add_tissue_samples_names_div').html(html);
    });

});

function add_tissue_samples_to_trial() {

    var is_checked;
    if(jQuery('#add_tissue_samples_per_plant_inherit_treatments').is(":checked")){
        is_checked = 1;
    }

    var tissue_names = [];
    jQuery('input[name="add_tissue_samples_tissue_name"]').each(function() {
        tissue_names.push(this.value);
    });

    jQuery.ajax( {
      url: '/ajax/breeders/trial/'+<% $trial_id %>+'/create_tissue_samples/',
      type: 'POST',
      beforeSend: function() {
          enable_working_modal();
      },
      data: {
        'tissue_samples_per_plant' : jQuery('#add_tissue_samples_per_plant_num').val(),
        'inherits_plot_treatments' : is_checked,
        'tissue_samples_names' : JSON.stringify(tissue_names)
      },
      success: function(response) {
        disable_working_modal();
        if (response.error) {
          alert(response.error);
        }
        else {
          alert("Os registros de amostras de tecido foram criados com sucesso.");
          jQuery('#add_plants_dialog').modal("hide");
          window.location.replace('/breeders/trial/'+<% $trial_id %>);
        }
      },
      error: function(response) {
        disable_working_modal();
        alert("Ocorreu um erro ao criar os registros de amostras de tecido.");
      },
    });

}

function enable_working_modal() {
    jQuery("#working_modal").modal("show");
}

function disable_working_modal() {
    jQuery("#working_modal").modal("hide");
}

function enable_plants_datatable() {
    jQuery('#trial_plants_table_html').DataTable();
}

</script>
