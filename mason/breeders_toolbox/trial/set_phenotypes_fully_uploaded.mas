
<%args>
$trial_id => undef
$trial_name => undef
</%args>

<div class="modal fade" id="trial_set_phenotypes_fully_loaded_modal" name="trial_set_phenotypes_fully_loaded_modal" tabindex="-1" role="dialog" aria-labelledby="setPhenotypesFullyUploadedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="setPhenotypesFullyUploadedDialog">Envio completo dos fenótipos de <% $trial_name %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-6 control-label">Todos os fenótipos foram enviados? </label>
                            <div class="col-sm-6" >
                                <select class="form-control" id="trial_set_phenotypes_fully_loaded_select">
                                    <option value="1">Sim</option>
                                    <option value="0">Não</option>
                                </select>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_set_phenotypes_fully_loaded_modal" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="trial_set_phenotypes_fully_loaded_submit" id="trial_set_phenotypes_fully_loaded_submit" >Salvar</button>
            </div>
        </div>
    </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {
    jQuery('#trial_set_phenotypes_fully_link').click(function(){
        jQuery('#trial_set_phenotypes_fully_loaded_modal').modal('show');
    });
    
    jQuery('#trial_set_phenotypes_fully_loaded_submit').click(function(){
        var value = jQuery('#trial_set_phenotypes_fully_loaded_select').val();
        jQuery.ajax( {
            url: '/ajax/breeders/trial/<% $trial_id %>/phenotypes_fully_uploaded',
            method: 'POST',
            data: {
                'phenotypes_fully_uploaded':value
            },
            success: function(response) {
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert('Salvo com sucesso.');
                    location.reload();
                }
            },
            error: function(response) {
                alert('Ocorreu um erro ao definir o envio completo dos fenótipos.');
            }
        });
    });
});

</script>
