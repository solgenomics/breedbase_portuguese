<%args>
$trial_id
$trial_name
$breeding_program_name
$location_name
$user_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$has_plant_entries => undef
$folder_id => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$user_can_modify => undef
</%args>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

%  if ($user_can_modify) {
<button class="btn btn-sm btn-primary" style="margin:3px" id="update_trial_status_link">Atualizar status do ensaio</button>
<br/><br/>
% }


<&| /page/info_section.mas, title => "Atividades do ensaio", collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <table id = "trial_activities_table" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Tipo de status</th>
                            <th>Data</th>
                            <th>Atualizado por</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<div class="panel-body">

<&| /page/info_section.mas, id=>"trial_completion_layout_section", title=>"Delineamento de campo", collapsible=>1, collapsed=>1 &>
%  if ($design_name) {
            <p class="text-success" title="Este ensaio tem um tipo de delineamento salvo. Você pode visualizar e baixar as informações na seção Delineamento desta página."><small>Tem delineamento de campo&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-danger" title="Este ensaio não tem um tipo de delineamento salvo. Entre em contato com o suporte, pois isso não deveria acontecer."><small>Sem delineamento de campo&nbsp;&nbsp;</small><span class="glyphicon glyphicon-remove-sign"></span></p>
%  }

            <div id="trial_completion_layout_section_div">
                <div class="well well-sm">CARREGANDO...</div>
            </div>

%  if ($has_plant_entries) {
            <p class="text-success" title="Este ensaio tem registros de parcelas e plantas. Portanto, os fenótipos podem ser registrados no nível de parcela e de planta."><small>Tem parcelas<br/>e plantas&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-info" title="Este ensaio tem parcelas, mas não tem registros de plantas. Esses registros são necessários para a fenotipagem no nível de planta. Crie-os em Delineamento > Registros de plantas."><small>Tem parcelas<br/>sem plantas&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>
%  }
</&>

<&| /page/info_section.mas, id=>"trial_completion_phenotype_section", title=>"Fenotipagem", collapsible=>1, collapsed=>1 &>

            <div id="trial_completion_phenotype_section_div">
                <div class="well well-sm">CARREGANDO...</div>
            </div>
<!--
%  if ($phenotypes_fully_uploaded) {
            <p class="text-success" title="All recorded phenotypes for this trial are saved in the database. You can change this by clicking [Phenotypes Fully Uploaded?] in the Files section on this page."><small>Phenotyping<br/>Complete&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-info" title="Once phenotypes are fully uploaded for a trial, you can click [Phenotypes Fully Uploaded?] in the Files section on this page."><small>Phenotyping<br/>Incomplete&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>
%  }
-->
</&>

</div>

<& /breeders_toolbox/trial/update_trial_status_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, user_name => $user_name &>

<script defer="defer">

jQuery(document).ready(function () {

    jQuery('#trial_activities_table').DataTable({
        'autoWidth': false,
        'searching': false,
        'info': false,
        'paging': false,
        'order': false,
        'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/all_trial_activities',
    });

    jQuery('#trial_completion_layout_section_onswitch').click( function() {
        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/trial_completion_layout_section',
            success: function(response){
                var html = '';
                if (response.has_layout == 1){
                    html += '<p class="text-success" title="Este ensaio tem parcelas e informações de disposição salvas. As relações entre acessos, parcelas, lotes de sementes, plantas e subparcelas estão consistentes. Visualize ou baixe os dados na seção Delineamento."><small>Tem disposição de campo&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-danger" title="Há um problema na disposição. Entre em contato com o suporte, pois isso não deveria acontecer. Clique para ver mais informações."><span id="layout_error_button"><small>Disposição de campo inválida&nbsp;&nbsp;</small><span class="glyphicon glyphicon-remove-sign"></span></span></p>';
                }
                if (response.has_physical_map == 1){
                    html += '<p class="text-success" title="Este ensaio tem um mapa físico salvo. Visualize ou edite o mapa na seção Disposição física do ensaio."><small>Tem mapa físico&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-info" title="Este ensaio não tem informações de mapa físico. Adicione-as clicando em Enviar coordenadas do ensaio na seção Disposição física. Clique para ver mais informações."><span id="physical_map_error_button"><small>Sem mapa físico&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></span></p>';
                }
                if (response.has_seedlots == 1){
                    html += '<p class="text-success" title="Este ensaio tem lotes de sementes vinculados às parcelas, com os acessos sincronizados. Isso permite rastrear o material de melhoramento. Consulte os dados na seção Delineamento."><small>Tem lotes de sementes&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-info" title="Este ensaio não tem lotes de sementes salvos, portanto não é possível rastrear o material por lotes. Envie os dados em Enviar lotes plantados no ensaio, na seção Delineamento. Clique para ver mais informações."><span id="seedlot_error_button"><small>Sem informações de lotes&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></span></p>';
                }
                jQuery(document).on('click', 'span[id="layout_error_button"]', function(){
                    alert(response.layout_errors);
                });
                jQuery(document).on('click', 'span[id="physical_map_error_button"]', function(){
                    alert(response.physical_map_errors);
                });
                jQuery(document).on('click', 'span[id="seedlot_error_button"]', function(){
                    alert(response.seedlot_errors);
                });
                jQuery('#trial_completion_layout_section_div').html(html);
            },
            error: function(response){
                alert('Erro ao obter a seção de conclusão da disposição do ensaio.');
            }
        });
    });

    jQuery('#trial_completion_phenotype_section_onswitch').click( function() {
        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/trial_completion_phenotype_section',
            success: function(response){
                var html = '';
                if (response.has_phenotypes == 1){
                    html = '<p class="text-success" title="Este ensaio tem fenótipos salvos. Visualize ou baixe os dados na seção Características avaliadas."><small>Tem fenótipos&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html = '<p class="text-info" title="Este ensaio não tem fenótipos armazenados. Envie os fenótipos pela seção Arquivos."><small>Sem fenótipos&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>';
                }
                jQuery('#trial_completion_phenotype_section_div').html(html);
            },
            error: function(response){
                alert('Erro ao obter a seção de conclusão da fenotipagem.');
            }
        });
    });

});

</script>
