<%args>
$trial_id => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<div id="trial_additional_uploaded_files_div">
[CARREGANDO ...]
</div>

<div class="modal fade" id="trial_upload_additional_file_dialog" name="trial_upload_additional_file_dialog" tabindex="-1" role="dialog" aria-labelledby="trialUploadAdditionalFileDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialUploadAdditionalFileDialog">Enviar arquivo adicional para o ensaio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'Informações do envio' &>
                        <p>
                            <b>Informações sobre o envio de arquivos</b>
                            <br>
                            <a id="trial_upload_additional_file_format">Informações de envio</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="trial_upload_additional_file_form" name="trial_upload_additional_file_form">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo: </label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_additional_file" id="trial_upload_additional_file" encoding="multipart/form-data" />
                            </div>
                        </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="trial_upload_additional_file_cancel_button" id="trial_upload_additional_file_cancel_button"     data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="trial_upload_additional_file_submit_button" id="trial_upload_additional_file_submit_button" title="Enviar">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_upload_additional_file_info_dialog" name="trial_upload_additional_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="trialUploadAdditionalFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialUploadAdditionalFileInfoDialog">Informações de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Use esta opção para enviar qualquer arquivo adicional relacionado a um ensaio.</b>
                    <br/><br/>
                    <p>Os arquivos adicionais podem incluir, entre outros:</p>
                    <ul>
                        <li>Imagens do ensaio, como uma fotografia do campo ou uma imagem aérea.</li>
                        <li>Documentação do ensaio, como protocolos ou autorizações.</li>
                        <li>Relatórios do ensaio, como informações complementares ou publicações.</li>
                        <li>Gravações do ensaio, em áudio ou vídeo.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_additional_file_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    display_trial_additional_upload_files();

    jQuery('#trial_upload_additional_files_link').click( function(){
        jQuery('#trial_upload_additional_file_dialog').modal('show');
    });

    jQuery('#trial_upload_additional_file_format').click( function(){
        jQuery('#trial_upload_additional_file_info_dialog').modal('show');
    });

    jQuery('#trial_upload_additional_file_submit_button').click(function () {
        trial_upload_additional_file_submit();
    });
    function trial_upload_additional_file_submit() {
        var uploadFile = jQuery("#trial_upload_additional_file").val();
        jQuery('#trial_upload_additional_file_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_additional_file");
        if (uploadFile === '') {
            alert("Selecione um arquivo.");
            return;
        }
        jQuery("#trial_upload_additional_file_form").submit();
    }

    jQuery('#trial_upload_additional_file_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedAdditionalFile = jQuery("#trial_upload_additional_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedAdditionalFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("Nenhum arquivo selecionado.");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert("Arquivo enviado com sucesso.");
                display_trial_additional_upload_files();
            }
        }
    });


 



    function display_trial_additional_upload_files (){
        jQuery.ajax ({
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/get_uploaded_additional_file',
            beforeSend : function(){
                jQuery('#trial_additional_uploaded_files_div').html("[CARREGANDO ...]");
            },
            success: function(response){
                //console.log(response);
                var html = "<table class='table table-hover table-condensed table-bordered' id='trial_additional_uploaded_files_table'><thead><tr><th>Nome do arquivo</th><th>Data de envio</th><th>Enviado por</th><th>Opções</th></tr></thead><tbody>";
                for (i=0; i<response.files.length; i++) {
                    html = html + '<tr><td>'+response.files[i][4]+'</td><td>'+response.files[i][1]+'</td><td><a href="/solpeople/profile/'+response.files[i][2]+'">'+response.files[i][3]+'</a></td><td><a href="/breeders/phenotyping/download/'+response.files[i][0]+'">Baixar</a> | <a href="javascript:obsolete_additional_file('+<% $trial_id %>+', '+response.files[i][0]+"\"Lemover</a></td></tr>";
                }
                html = html + "</tbody></table>";
                jQuery('#trial_additional_uploaded_files_div').html(html);
                jQuery('#trial_additional_uploaded_files_table').DataTable();
            },
            error: function(response){
                alert("Erro ao obter os arquivos adicionais enviados.");
            }
       });
   
    }						   
   

 

});						 

						   
 function obsolete_additional_file(trial_id, file_id) {
       var yes = confirm('Deseja realmente tornar este arquivo obsoleto? Esta operação não pode ser desfeita.');
       if (yes) {
          jQuery.ajax({
              url: '/ajax/breeders/trial/'+trial_id+'/obsolete_uploaded_additional_file/'+file_id,
	      success: function(r) {
	          if (r.error) { alert(r.error); }
						   else {
						    jQuery('#trial_additional_uploaded_files_table').DataTable().clear().draw();
	              alert("O arquivo foi marcado como obsoleto.");
		  }
	       },
	       error: function(r) {  alert("Ocorreu um erro!") }
	  });
	}
   }


</script>
