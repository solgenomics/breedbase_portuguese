
<%args>
$trial_id
$curator => undef
</%args>

<& /util/import_javascript.mas, classes => [ "jquery", "jqueryui", "thickbox", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List", "CXGN.BreederSearch", "CXGN.BreedersToolbox.HTMLSelect" ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<div id="trial_subplots_html">
</div>

<br>

<button id="select_all_subplots_btn" class="btn btn-primary">Selecionar/desmarcar todas</button>

<br>

<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title => 'Adicionar subparcelas a uma lista', collapsible=>1, collapsed=>0, subtitle=>'<i>Adicione as subparcelas deste ensaio a uma lista nova ou existente</i>'&>
        <br>
            <table style="width:100%">
                <tr>
                    <td>
                        <input style="width:85%" class="form-control input-sm" type="text" id="subplot_select_new_list_name" placeholder="Nome da nova lista..."/>
                        <input style="width:85%" class="form-control input-sm" type="text" id="subplot_select_new_list_description" placeholder="Descrição da nova lista..."/>
                        <button class="btn btn-primary btn-sm" id="subplot_select_add_to_new_list_btn" type="button">Adicionar seleção à nova lista</button>
                    </td>
                    <td>
                        <div id="subplot_select_existing_list_name" style="width:85%"></div>
                        <button class="btn btn-primary btn-sm" id="subplot_select_add_to_existing_list_btn" type="button">Adicionar seleção à lista existente</button>
                    </td>
                </tr>
            </table>
% if ($curator) {
            <br>
            <button id="subplot_select_delete_subplots" class="btn btn-danger">Excluir subparcelas selecionadas</button>
% } 
        </&>
    </div>
</div>

<script>

jQuery(document).ready(function () {

    jQuery('#trial_subplots_onswitch').one("click", function() {

        jQuery.ajax( {
            url: '/ajax/html/select/subplots_from_trial',
            data: {trial_id: <% $trial_id %>},
            beforeSend: function(){
                var html = '<div class="well well-sm"><center><img src="/img/wheel.gif" /></center></div>';
                jQuery('#trial_subplots_html').html(html);
            },
            success: function(response) {
                jQuery('#trial_subplots_html').empty();
                jQuery('#trial_subplots_html').html(response.select);

                jQuery('#subplots_from_trial_select_table').DataTable({
                    paging: false,
                    searching: true,
                    ordering: true,
                    order : [[1, 'asc']],
                    info: true,
                    scrollY: '250px',
                    scrollX : true,
                    scrollCollapse: true
                });

                var lo = new CXGN.List();
                jQuery('#subplot_select_existing_list_name').html(lo.listSelect('subplot_select_existing_list_name', ['subplots'], undefined, undefined, undefined));
            },
            error: function(response) {
                jQuery('#trial_subplots_html').html("erro");
                alert("Ocorreu um erro.");
            }
        });
    });

    jQuery('#select_all_subplots_btn').click(function() {
        let anyChecked = jQuery('.exp_design_subplot_select:checkbox:checked').length > 0;

        if (anyChecked) {
            jQuery('.exp_design_subplot_select').prop("checked", false);
        } else {
            jQuery('.exp_design_subplot_select').prop("checked", true);
        }
    });

    jQuery('#subplot_select_add_to_new_list_btn').click(function() {
        jQuery.ajax({
            url : '/list/new',
            data : {
                name : jQuery('#subplot_select_new_list_name').val(),
                desc : jQuery('#subplot_select_new_list_description').val()
            },
            beforeSend: function() {
                jQuery('#working_modal').modal("show");
            },
            success : function(response) {
                if (response.error) {
                    jQuery('#working_modal').modal("hide");
                    alert("Ocorreu um erro: " + response.error);
                } else {
                    let new_list_id = response.list_id;
                    jQuery.ajax({
                        url : '/list/type/'+new_list_id+'/subplots',
                        success: function(response) {
                            if (response.error) {
                                jQuery('#working_modal').modal("hide");
                                alert("A nova lista foi criada, mas ocorreu um erro ao adicionar os itens: " + response.error);
                            } else {
                                jQuery.ajax({
                                    url : '/list/add/bulk',
                                    data : {
                                        list_id : new_list_id,
                                        elements : jQuery('.exp_design_subplot_select:checkbox:checked')
                                            .map(function() {
                                                return this.id.replace('select_subplot_', '');
                                            })
                                            .get()
                                            .join('\t')
                                    },
                                    success : function(response) { 
                                        jQuery('#working_modal').modal("hide");
                                        if (response.error) {
                                            alert("A nova lista foi criada, mas ocorreu um erro ao adicionar os itens: " + response.error);
                                        } else {
                                            alert("Lista criada.");
                                            var lo = new CXGN.List();
                                            jQuery('#subplot_select_existing_list_name').html(lo.listSelect('subplot_select_existing_list_name', ['subplots'], undefined, undefined, undefined));
                                        }
                                    },
                                    error : function(error) {
                                        jQuery('#working_modal').modal("hide");
                                        alert("A nova lista foi criada, mas ocorreu um erro do servidor ao adicionar os itens.");
                                    }
                                });
                            }
                        },
                        error : function() {
                            jQuery('#working_modal').modal("hide");
                            alert("A nova lista foi criada, mas ocorreu um erro do servidor ao adicionar os itens.");
                        }
                    });
                }
            },
            error : function() {
                jQuery('#working_modal').modal("hide");
                alert("Ocorreu um erro do servidor ao criar a nova lista.");
            }
        })
    });

    jQuery('#subplot_select_add_to_existing_list_btn').click(function() {
        jQuery.ajax({
            url : '/list/add/bulk',
            data : {
                list_id : jQuery('#subplot_select_existing_list_name_list_select').val(),
                elements : jQuery('.exp_design_subplot_select:checkbox:checked')
                    .map(function() {
                        return this.id.replace('select_subplot_', '');
                    })
                    .get()
                    .join('\t')
            },
            beforeSend : function() {
                jQuery('#working_modal').modal("show");
            },
            success : function(response) {
                jQuery('#working_modal').modal("hide");
                if (response.error) {
                    alert("Erro ao adicionar itens à lista: " + response.error);
                } else {
                    alert("Subparcelas adicionadas à lista.");
                }
            },
            error : function() {
                jQuery('#working_modal').modal("hide");
                alert("Erro do servidor ao adicionar subparcelas à lista.");
            }
        });
    }); 

    jQuery('#subplot_select_delete_subplots').click(function() {
        if (confirm("Tem certeza de que deseja excluir as subparcelas selecionadas? Todos os materiais derivados, como plantas ou amostras de tecido, também serão excluídos. Esta ação não pode ser desfeita.")) {
            let subplot_ids = jQuery('.exp_design_subplot_select:checkbox:checked')
                .map(function() {
                    return this.id.replace('select_subplot_', '');
                })
                .get()
                .join('\t');
            let trial_id = "<% $trial_id %>";
            jQuery.ajax({
                url : `/ajax/breeders/trial/${trial_id}/delete_subplots`,
                method : 'POST',
                data : {
                    subplots_list : subplot_ids
                },
                beforeSend : function() {
                    jQuery('#working_modal').modal("show");
                },
                success : function(response) {
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert("Erro: " + response.error);
                    } else {
                        alert("Subparcelas excluídas.");
                        window.location.reload();
                    }
                },
                error : function(response) {
                    jQuery('#working_modal').modal("hide");
                    alert("Ocorreu um erro do servidor. Consulte o console.");
                }
            });
        } 
        return;
    });

});

</script>
