<%args>
$trial_id
$stockref => undef
$data_level => 'plot'
$has_col_and_row_numbers => undef
$has_subplot_entries => undef
$has_plant_entries => undef
$trial_stock_type => undef
</%args>

<& /util/import_css.mas, paths => ['fieldmap/leaflet-search.min.css', 'fieldmap/leaflet.css'] &>
<& /util/import_javascript.mas, entries => ['fieldmap'], classes => [ 'jqueryui.js', 'jquery.js', 'jstree.dist.jstree', "thickbox", "CXGN.Page.FormattingHelpers", 'brapi.fieldmap.leaflet', 'brapi.fieldmap.L-Path-Transform', 'brapi.fieldmap.leaflet-search', 'brapi.fieldmap.turf', 'brapi.BrAPI', 'brapi.BrAPIFieldmap' ] &>

<style id='heatmap_stylesheet'>
    #trait_heatmap {display: inline; }
    #trial_no_phenoMSG {display: none; }
    #trial_no_rowColMSG {display: none; }
    #trial_heatmap_div  {display: none; }
    #chart {display: none; }
    #chart_fm {display: none; }
    #d3legend {display: none; }
    #plot_image_ids {display: none;}


    #tooltip {
        position: absolute;
        max-width: 400px;
        max-height: 200px;
        padding: 5px;
        font: 12px sans-serif;
        background: lightsteelblue;
        border: 0px;
        border-radius: 8px;
        pointer-events: none;
    }

    #container_heatmap {
        /*border:2px dashed #000;*/
        height: 390px;
        width: 700px;
        overflow: auto;
        /*overflow: scroll;*/
        display: none;
        margin: 10px;
    }
    #container_fm {
        /*border:2px dashed #000;*/
        height: 100%;
        /*width: 390px;*/
        width: 100%;
        overflow: auto;
        /*overflow: scroll;*/
        display: none;
        transition: all 1s ease-in-out;
    }

    #fieldmap_wrapper {
        width: 90%;
        margin-left: auto;
        margin-right: auto;
        overflow-x: scroll;
        margin-top: 1%;
    }

    .interactive_fieldmap_buttons {
        margin-top: 4%;
        width: 405px;
        margin-left: auto;
        margin-right: auto;
    }

    rect.bordered {
        stroke: #E6E6E6;
        stroke-width:2px;
      }

      text.mono {
        font-size: 9pt;
        font-family: Consolas, courier;
        fill: #aaa;
      }

      text.axis-workweek {
        fill: #000;
      }

      text.axis-worktime {
        fill: #000;
      }

      .legend { list-style: none; }
      .legend li { float: left; margin-left: 10px; margin-right: 10px;}
      .legend span { border: 1px solid #ccc; float: left; width: 12px; height: 12px; margin: 2px; }

      .legend .border_plots { background-color: #d3d3d3}
      .legend .block_even_number { background-color: #c7e9b4; }
      .legend .block_odd_number { background-color: #41b6c4; }
      .legend .checks { background-color: #6a5acd; }
      .legend .rep_even_number { background-color: red;}
      .legend .rep_odd_number { background-color: green;}
      .legend .overlapping_plot { background-color: #000; }
      .legend .trait_not_measured {background-color: darkgrey;} 
      .legend .value_scale {display: inline-block; width: 80px;}

      .rotated {
          transform: rotate(-180deg);
      }

    ul {
        list-style-type: none;
        padding-left: 20px;
    }
    .collapsible {
        cursor: pointer;
        display: flex;
        align-items: center;
    }
    .arrow {
        margin-right: 5px;
        transition: transform 0.2s ease;
    }
    .hidden {
        display: none;
    }

    
</style>


<div class="well well-sm">
    <div style="display: flex; gap: 25px">
        <div class="form-group form-group-sm" id="traitdiv" style="display:inline-block">
            <label for="trait_list_dropdown" class="col-sm-2 control-label">Selecionar:</label><br />
            <div class="col-sm-12">
                <div id="heatmap_traits_assayed_dropdown">
                    Carregando características avaliadas...
                </div>
            </div>
        </div>
        <div id="include_linked_trials" class="form-group form-group-sm">
            <label for="include_linked_trials_checkmark" class="control-label">Exibir ensaios no mesmo campo:</label><br />
            <input type="checkbox" id="include_linked_trials_checkmark" name="include_linked_trials_checkmark">
            <div id="include_linked_trials_list_container" style="margin-top: 10px; display: none">
                <p><strong>Ensaios no mesmo campo:</strong></p>
                <ul id="include_linked_trials_list">
                    <p>Carregando...</p>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="form-group form-group-sm" id="ctrldiv" style="diaplay:none">
    <label for="check_list_dropdown" class="col-sm-2 control-label">Visualizar parcelas testemunhas:</label><br />
    <div class="col-sm-12">
        <div id="heatmap_trial_checks_dropdown">
        </div>
        <div class="col-sm-4" id="check_plot_link">
        </div>
    </div>
    <br>
</div>

<div id="view_ctrl_button" style="display:none">
  <a id="view_ctrl_button_link"><button class="btn btn-primary"  type="button" id="view_ctrl_id_button" value="delete_cords" >Visualizar testemunhas</button></a>
</div>

<div id="container_heatmap" ></div>

<div id="container_legend">

    <ul id='legend_list' class="legend">
        <li><span class="border_plots"></span> Parcelas de bordadura e de preenchimento</li>
        <li><span class="block_even_number"></span> Números pares de blocos (ex.: 2, 4, ...)</li>
        <li><span class="block_odd_number"></span> Números ímpares de blocos (ex.: 1, 3, ...)</li>
        <li><span class="checks"></span> Testemunhas</li>
        <li><span class="rep_odd_number"></span> Números ímpares de repetições (ex.: 1, 3, ...)</li>
        <li><span class="rep_even_number"></span> Números pares de repetições (ex.: 2, 4, ...)</li>
        <li><span class="overlapping_plot"></span> Parcelas sobrepostas (duas ou mais na mesma posição)</li>
        <li> <img src="/static/css/images/plot_images.png" alt="Câmera" height="20" width="20"> Parcela com imagem</li>
        <li><span class="trait_not_measured"></span>Sem medição</li>
        <li style='display:flex'><div>Valor baixo</div> <span class="value_scale" id="pheno_color_scale"></span> <div>Valor alto</div></li>
    </ul>
</div>
<br><br>

<div id="container_fm">
    <div style="margin-top: 2%; position: relative">
        <div style="display: flex; flex-wrap: wrap; gap: 25px">
            <div class="form-inline">
                <label>Disposição das parcelas</label>
                <select class="form-control fieldmap_edit" name="plot_layout" id="plot_layout">
                    <option value="">--Selecione a disposição das parcelas--</option>
                    <option value="serpentine">Serpentina</option>
                    <option value="zigzag">Zigue-zague</option>
                </select>
            </div>
            <div clas="form-inline">
                <label for="invert_row_checkmark">Inverter linhas</label>
                <input type="checkbox" id="invert_row_checkmark" name="invert_row_checkmark" value="yes">
            </div>
        </div>
        <br />
        <div style="display: flex; flex-wrap: wrap; gap: 25px">
            <div class="form-inline">
                <label for="top_border_selection">Bordadura superior</label>
                <input type="checkbox" id="top_border_selection" name="top_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="left_border_selection">Bordadura esquerda</label>
                <input type="checkbox" id="left_border_selection" name="left_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="right_border_selection">Bordadura direita</label>
                <input type="checkbox" id="right_border_selection" name="right_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="bottom_border_selection">Bordadura inferior</label>
                <input type="checkbox" id="bottom_border_selection" name="bottom_border_selection" value="yes" class="fieldmap_edit">
            </div>
        </div>
        <div id="fieldmap_edit_info" style="display: none">
            <p style="font-style: italic">OBSERVAÇÃO: o mapa de campo não pode ser alterado e as bordaduras não são exibidas quando os ensaios vinculados estão visíveis.</p>
        </div>
        <br>
        <div class="interactive_fieldmap_buttons">
            <button type="button" class="btn btn-primary fieldmap_edit" id="transpose_fieldmap">Transpor</button>
            <button type="button" class="btn btn-primary fieldmap_edit" id="change_dimensions_button">Alterar dimensões</button>
            <button type="button" class="btn btn-primary fieldmap_edit" id ="remove_fillers">Remover parcelas de preenchimento</button>
            <button type="button" id="print_fieldmap" name="print_fieldmap" class="btn btn-primary fieldmap_edit">Imprimir mapa de campo</button>
            <button type="button" id="submit_fieldmap" name="submit_fieldmap" class="btn btn-success fieldmap_edit">Salvar disposição do campo</button>
        </div>
    </div>
    <div id="fieldmap_wrapper">
        <div id="fieldmap_chart"></div>
    </div>
% if ( $has_col_and_row_numbers ) {
    <div style="margin-top: 40px" class="well well-sm">
        <h3 style="margin: 0 0 10px 0">Baixar ordem das parcelas</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 25px; justify-content: space-around; align-items: center">
            <div>
                <label>Tipo de download:</label>
                <select class="form-control" name="plot_download_type" id="plot_download_type">
                    <option value="">--Selecione o tipo--</option>
                    <option value="planting">Ordem de plantio</option>
                    <option value="collection">Ordem de coleta</option>
                    <option value="harvest">Ordem de colheita</option>
                    <option value="harvestmaster">HarvestMaster</option>
                </select>
            </div>
            <div>
                <label>Ordem das parcelas:</label>
                <select class="form-control" name="plot_download_order" id="plot_download_order" style="max-width: 300px">
                    <option value="">--Selecione a ordem das parcelas--</option>
                    <option value="by_col_serpentine">Por coluna: serpentina</option>
                    <option value="by_col_zigzag">Por coluna: zigue-zague</option>
                    <option value="by_row_serpentine">Por linha: serpentina</option>
                    <option value="by_row_zigzag">Por linha: zigue-zague</option>
                </select>
            </div>
            <div>
                <label>Parcela inicial:</label>
                <select class="form-control" id="plot_download_start" name="plot_download_start" style="max-width: 300px">
                    <option value="bottom_left">Inferior esquerda</option>
                    <option value="top_left">Superior esquerda</option>
                    <option value="top_right">Superior direita</option>
                    <option value="bottom_right">Inferior direita</option>
                </select>
            </div>
            <div style="display: flex; flex-direction: column; justify-content: end; text-align: right">
                <div>
                    <label for="plot_download_borders">Incluir bordaduras</label>
                    <input type="checkbox" id="plot_download_borders" name="plot_download_borders" value="no">
                </div>
                <div>
                    <label for="plot_download_gaps">Incluir espaços vazios</label>
                    <input type="checkbox" id="plot_download_gaps" name="plot_download_gaps" value="no">
                </div>
% if ( $has_subplot_entries ) {
                <div>
                    <label for="plot_download_subplots">Incluir subparcelas</label>
                    <input type="checkbox" id="plot_download_subplots" name="plot_download_subplots" value="no">
                </div>
% }
% if ( $has_plant_entries ) {
                <div>
                    <label for="plot_download_plants">Incluir plantas</label>
                    <input type="checkbox" id="plot_download_plants" name="plot_download_plants" value="no">
                </div>
% }
            </div>
        </div>
        <div id="plot_download_harvestmaster_options" style="display: none; padding: 15px">
            <p><strong>Opções do HarvestMaster:</strong></p>
            <div style="display: flex; flex-wrap: wrap; gap: 25px; justify-content: space-around; align-items: center">
                <div>
                    <label>HarvestMaster PLTID:</label>
                    <select class="form-control" id="hm_pltid" name="hm_pltid" style="max-width: 400px">
                        <option value="plot_id" selected>ID da parcela no banco de dados</option>
                        <option value="plot_name">Nome da parcela</option>
                        <option value="plot_number">Número da parcela</option>
                    </select>
                </div>
                <div>
                    <label>HarvestMaster Range:</label>
                    <select class="form-control" id="hm_range" name="hm_range" style="max-width: 400px">
                        <option value="col_number">Coluna no Breedbase</option>
                        <option value="row_number" selected>Linha no Breedbase</option>
                    </select>
                </div>
                <div>
                    <label>Linha no HarvestMaster:</label>
                    <select class="form-control" id="hm_row" name="hm_row" style="max-width: 400px">
                        <option value="col_number" selected>Coluna no Breedbase</option>
                        <option value="row_number">Linha no Breedbase</option>
                    </select>
                </div>
            </div>
        </div>
        <div style="padding: 15px 50px; text-align: center">
            <button class="btn btn-primary" id="plot_download_button">Baixar</button>
        </div>
    </div>
</div>
% }


<div id="trait_heatmap" >carregando...</div>
<div id="container_heatmap_geo" ></div>
<div id="trial_no_phenoMSG" >Envie os fenótipos do ensaio para visualizar o mapa de calor das características avaliadas</div>
<div class="container" id="trial_no_rowColMSG">
    <div class="well">
    <!--    <centre><div id="trial_no_rowColMSG2" ><b>Trial plots have no row and column number to display heatmap</b></div></centre> -->
    </div>
</div>

<canvas id='trial_phenotype_heatmap_download_image_canvas' width="3000" height="3000" style="display:none"></canvas>

<div id="chart"></div>
<!--<div class="col-sm-10" id="d_button" style="display:none";>
  <a id="delete_trait" class="btn btn-primary">Delete Selected Trait</a> &nbsp;
</div> -->


<div id="delete_field_map_dialog" title="Exclusão do mapa físico do campo" style="display:none;">
   <div id="trait_list_dc" name="trait_list">
       <label id="trait_list_label_dc" for="trait_list_list_select" style="display: inline-block; width: 300px;">Confirme a exclusão do mapa de campo.<br />

       </label>

   </div>
</div>

<div class="modal  fade" id="suppress_plot_pheno_dialog" name="suppress_plot_pheno_dialog" tabindex="-1" role="dialog" aria-labelledby="SuppressPlotPhenoDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SuppressPlotPhenoDialog">Suprimir medição fenotípica da parcela</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="suppress_plot_pheno_form" name="suppress_plot_pheno_form">

                    <center>
                    <p3>A medição suprimida será considerada um valor atípico e poderá ser excluída da análise e do download de fenótipos.</p3>
                    </center></br>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Nome da parcela:</label>
                            <div class="col-sm-8" id="myplot_name">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">Valor fenotípico: </label>
                            <div class="col-sm-8" id="pheno_value">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">ID do fenótipo: </label>
                            <div class="col-sm-8" id="mypheno_id">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">ID da característica: </label>
                            <div class="col-sm-8" id="mytrait_id">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_suppress_plot_pheno_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="suppress_plot_pheno_dialog_submit" id="suppress_plot_pheno_dialog_submit">Suprimir fenótipo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="suppress_phenotype_dialog_success_message" name="suppress_phenotype_dialog_success_message" tabindex="-1" role="dialog" aria-labelledby="SuppressPhenoDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SuppressPhenoDialog">Suprimir fenótipo da parcela</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="suppress_plotPheno_form" name="suppress_plotPheno_form">

                    <p3>O fenótipo foi suprimido com sucesso.</p3>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_suppress_plot_pheno_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>

            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="delete_trait_dialog_confirm_message" name="delete_trait_dialog_confirm_message" tabindex="-1" role="dialog" aria-labelledby="DeleteAssayedTraitDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="DeleteAssayedTraitDialog"><b>Exclusão de característica avaliada</b></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="trait_deletion_form" name="trait_deletion_form">

                    <p3><b>Confirme a exclusão da característica selecionada.</b></p3></br>
                    <center><p2>A característica será excluída permanentemente do banco de dados.</p2></center>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_delete_trait_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="delete_selected_trait_dialog_submit" id="delete_selected_trait_dialog_submit">Excluir característica</button>
            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="delete_trait_dialog_success_message" name="delete_trait_dialog_success_message" tabindex="-1" role="dialog" aria-labelledby="TraitDeletionDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="TraitDeletionDialog"><b>Exclusão de característica avaliada</b></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <p3>A característica foi excluída com sucesso.</p3>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trait_delete_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="download_field_layout_modal" name="download_field_layout_modal" tabindex="-1" role="dialog" aria-labelledby="DownloadTrialLayoutDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="DownloadTrialLayoutDialog"><b>Opções de download da disposição espacial</b></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" >
                        <div class="well">
                            <div class="form-group">
                                <div class="col-sm-3 control-label"><strong>Informações a incluir: </strong></div>
                                <div class="col-sm-9" >
% if ($trial_stock_type eq "cross") {
                                    <div class="checkbox">
                                        <label><input type="checkbox" id="accession_name" value="accession_name" checked> Nome do cruzamento/acesso </label>
                                    </div>
% }
% else {
                                    <div class="checkbox">
                                        <label><input type="checkbox" id ="accession_name" value="accession_name" checked> Nome do acesso </label>
                                    </div>
% }
                                    <div class="checkbox">
                                        <label> <input type="checkbox" id="obs_unit_name" value="obsunit_name"> Nome da unidade de observação </label>
                                    </div>
                                    <div class="checkbox">
                                        <label> <input type="checkbox" id="plot_id" value="plot_id"> ID da parcela </label>
                                    </div>
                                    <div class="checkbox">
                                        <label><input type="checkbox" id="plot_num" value="plot_num"> Número da parcela </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_download_layout_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" id="download_field_layout_button" title="Baixar">Baixar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="hm_plot_details_modal" name="hm_plot_details_modal" tabindex="-1" role="dialog" aria-labelledby="HmPlotDetailsModal">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="HmPlotDetailsModal">Detalhes da parcela</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="hm_plot_details_form" name="hm_plot_details_form">
                      <div id="hm_plot_information">
                      </div>

                      <div class="form-group">
                        <label class="col-sm-3 control-label">Nome da parcela: </label>
                        <div class="col-sm-9" id="hm_plot_name">

                        </div>
                      </div>

                      <div class="form-group">
                        <label class="col-sm-3 control-label">Número da parcela: </label>
                        <div class="col-sm-9" id="hm_plot_number">
                        </div>
                      </div>

                      <div class="form-group">
                        <label class="col-sm-3 control-label">ID da parcela no banco de dados: </label>
                        <div class="col-sm-9" id="hm_plot_id">
                        </div>
                      </div>

                      <div class="form-group">
                        <label class="col-sm-3 control-label">Acesso: </label>
                        <div class="col-sm-9" id="hm_plot_accession">
                        </div>
                      </div>

                      <div class="form-group" id="hm_plot_structure_container" hidden>
                        <label class="col-sm-3 control-label">Estrutura da parcela: </label>
                        <div class="col-sm-9" id="hm_plot_structure_data_container">
                        </div>
                      </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary " name="hm_view_plot_image_submit" id="hm_view_plot_image_submit">Visualizar imagens da parcela</button>
                <button id="hm_close_replace_plot_accession_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="hm_edit_plot_info" id="hm_edit_plot_info" onclick="jQuery('#hm_replace_plot_accessions_dialog').modal('show')">Editar informações da parcela</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="hm_replace_plot_accessions_dialog" name="hm_replace_plot_accessions_dialog" tabindex="-1" role="dialog" aria-labelledby="HmReplacePlotAccessionsDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="HmReplacePlotAccessionsDialog">Substituir acesso da parcela</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="hm_replace_plot_accession_form" name="hm_replace_plot_accession_form">
