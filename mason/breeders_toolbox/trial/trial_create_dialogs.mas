%        $method = 'p-rep';
%    } else {
%        $method = $type;
%    }
%    my %display_types = (
%        'Completely Randomized' => 'Inteiramente casualizado',
%        'Complete Block' => 'Blocos completos casualizados',
%        'Resolvable Row-Column' => 'Linha-coluna resolvível',
%        'Doubly-Resolvable Row-Column' => 'Linha-coluna duplamente resolvível',
%        'Un-Replicated Diagonal Design' => 'Delineamento diagonal sem repetição',
%        'Alpha Lattice' => 'Látice alfa',
%        'Modified Augmented Design' => 'Delineamento aumentado modificado',
%        'Nursery/Greenhouse' => 'Viveiro/casa de vegetação',
%        'Split Plot' => 'Parcelas subdivididas',
%        'Partially Replicated' => 'Parcialmente repetido',
%    );
%    $display_type = $display_types{$type} if exists $display_types{$type};
    <option value="<%$method%>"><%$display_type%></option>
%}
                                        </select>
                                        <div id="create_trial_design_description_div">
                                        </div>
                                        <div id="prephelp" style="display: none">
                                            <button type="button" class="btn btn-link" data-toggle="modal" data-target="#partial_rep_help_dialog">Ajuda de uso <span class="glyphicon glyphicon-question-sign"></span></button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" id="randomization_div" style="display:none;">
                                    <label class="col-sm-4 control-label">Usar a mesma casualização em todos os locais: </label>
                                    <div class="col-sm-8" >
                                        <input type="checkbox" id="use_same_layout" value="same_design" />
                                    </div>
                                </div>
                                <hr>
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" name="create_trial_validate_form_button" id="create_trial_validate_form_button">Primeiro, validar o formulário</button>
                                <button type="button" class="btn btn-lg btn-primary" disabled onclick="Workflow.complete(this); return false;" name="create_trial_submit">Continuar para a próxima etapa</button>
                                <center>

                            </&>
                            <&| /util/workflow.mas:step, title=> "Informações do delineamento" &>
                                <& /page/page_title.mas, title=>"Defina o esquema do ensaio" &>
                                <div class="well well-sm">
                                    <div class="form-group form-group-sm" id="show_list_of_accession_section" >
                                        <center><h4>Quais acessos estarão no campo?</h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label">Lista de acessos a incluir (obrigatória):</label>
                                        <div class="col-sm-5" id="select_list" name="select_list">
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_cross_section" >
                                        <center><h4>Quais cruzamentos estarão no campo?</h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label">Lista de cruzamentos a incluir (obrigatória):</label>
                                        <div class="col-sm-5" id="select_cross_list" name="select_cross_list">
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_family_name_section" >
                                        <center><h4>Quais famílias estarão no campo?</h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label">Lista de nomes de famílias a incluir (obrigatória):</label>
                                        <div class="col-sm-5" id="select_family_name_list" name="select_family_name_list">
                                        </div>
                                    </div>
                                    <div class="form-group" id="westcott_check_1_section" style="display: none">
                                      <label class="col-sm-3 control-label">Nome da testemunha 1: </label>
                                      <div class="col-sm-9" >
                                        <input class="form-control" id="westcott_check_1" name="westcott_check_1" placeholder="Obrigatório"></input>
                                      </div>
                                    </div>
                                    <div class="form-group" id="westcott_check_2_section" style="display: none">
                                      <label class="col-sm-3 control-label">Nome da testemunha 2: </label>
                                      <div class="col-sm-9" >
                                        <input class="form-control" id="westcott_check_2" name="westcott_check_2" placeholder="Obrigatório"> </input>
                                      </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir (obrigatória): </label>
                                        <div class="col-sm-5" id="list_of_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_cross_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir (obrigatória): </label>
                                        <div class="col-sm-5" id="list_of_cross_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_family_name_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir (obrigatória): </label>
                                        <div class="col-sm-5" id="list_of_family_name_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="crbd_show_list_of_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir. Ela deve ser diferente da lista de acessos (opcional): </label>
                                        <div class="col-sm-5" id="crbd_list_of_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="crbd_show_list_of_cross_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir. A lista deve conter acessos (opcional): </label>
                                        <div class="col-sm-5" id="crbd_list_of_cross_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="crbd_show_list_of_family_name_checks_section" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de testemunhas a incluir. A lista deve conter acessos (opcional): </label>
                                        <div class="col-sm-5" id="crbd_list_of_family_name_checks_section" >
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_unrep_accession" style="display: none" >
                                        <label class="col-sm-7 control-label">Lista de acessos sem repetição (obrigatória):</label>
