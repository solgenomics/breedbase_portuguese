<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_type
$planting_date
$transplanting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$plot_width
$plot_length
$field_size
$field_trial_is_planned_to_be_genotyped
$field_trial_is_planned_to_cross
$trial_stock_type
$trial_stock_count
$trial_owner
$latest_trial_activity => undef
$plot_name_template => undef

</%args>

<%init>
my ($dap, $dah);

sub _normalize_to_ymd {
    my ($s) = @_;
    return undef unless defined $s;
    $s =~ s/^\s+|\s+$//g;

    # "YYYY-MonthName-DD" -> "YYYY-mm-dd"  (e.g., 2025-November-14)
    if ($s =~ /^(\d{4})[-\/](\p{L}+)[-\/](\d{1,2})$/) {
        my ($y, $mon, $d) = ($1, lc($2), $3);
        $mon =~ s/[^a-z]//g;

        my %m = (
            jan=>1, january=>1, feb=>2, february=>2, mar=>3, march=>3,
            apr=>4, april=>4, may=>5, jun=>6, june=>6, jul=>7, july=>7,
            aug=>8, august=>8, sep=>9, sept=>9, september=>9,
            oct=>10, october=>10, nov=>11, november=>11, dec=>12, december=>12
        );

        my $mnum = $m{$mon} || $m{substr($mon,0,3)};
        return $mnum ? sprintf("%04d-%02d-%02d", $y, $mnum, $d) : undef;
    }

    # "YYYY-m-d" or "YYYY/mm/dd" -> "YYYY-mm-dd"
    if ($s =~ /^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/) {
        return sprintf("%04d-%02d-%02d", $1, $2, $3);
    }

    return undef;
}

sub _days_since {
    my ($date_str) = @_;
    return undef unless $date_str;

    my $ymd = _normalize_to_ymd($date_str);
    return undef unless $ymd;

    eval {
        require Time::Piece;
        my $tp = Time::Piece->strptime($ymd, '%Y-%m-%d');
        my $today = Time::Piece::localtime();
        my $diff_days = int( ($today - $tp) / (24*60*60) );
        return ($diff_days >= 0) ? $diff_days : undef;
    } || undef;
}

sub _positive_integer_conf {
    my ($conf_name) = @_;
    my $value = eval { $c->get_conf($conf_name) };
    return undef unless defined $value && $value =~ /^\d+$/ && $value > 0;
    return int($value);
}

sub _limit_days_display {
    my ($days, $limit) = @_;
    return undef unless defined $days;
    return (defined $limit && $days >= $limit) ? '>'.$limit : $days;
}

$dap = _days_since($planting_date);
$dah = _days_since($harvest_date);
my $display_dap_dah = eval { $c->get_conf('display_dap_dah') } ? 1 : 0;
my $dap_display = $display_dap_dah ? _limit_days_display($dap, _positive_integer_conf('limit_dap')) : undef;
my $dah_display = $display_dap_dah ? _limit_days_display($dah, _positive_integer_conf('limit_dah')) : undef;

my ($plot_name_template_name, $plot_name_template_display);
if ($plot_name_template) {
    require JSON;
    my $tmpl = eval { JSON::decode_json($plot_name_template) };
    if ($tmpl) {
        ($plot_name_template_name) = keys %$tmpl;
        my $name_attributes = $tmpl->{$plot_name_template_name}->{name_attributes} || [];
        my @parts = map { ref $_ eq 'HASH' ? ($_->{text} // '') : '{' . $_ . '}' } @$name_attributes;
        $plot_name_template_display = join('_', @parts);
    }
}

my %stock_type_labels = (
    accession   => 'acesso',
    cross       => 'cruzamento',
    family_name => 'nome de família',
);
my %trial_type_labels = (
    'Seedling Nursery'        => 'Viveiro de plântulas',
    phenotyping_trial         => 'Ensaio de fenotipagem',
    'Advanced Yield Trial'    => 'Ensaio avançado de produtividade',
    'Preliminary Yield Trial' => 'Ensaio preliminar de produtividade',
    'Uniform Yield Trial'     => 'Ensaio uniforme de produtividade',
    'Variety Release Trial'   => 'Ensaio de lançamento de cultivar',
    'Clonal Evaluation'       => 'Avaliação clonal',
    genetic_gain_trial        => 'Ensaio de ganho genético',
    storage_trial             => 'Ensaio de armazenamento',
    heterosis_trial           => 'Ensaio de heterose',
    health_status_trial       => 'Ensaio de estado fitossanitário',
    grafting_trial            => 'Ensaio de enxertia',
    'Screen House'            => 'Telado',
    'Seed Multiplication'     => 'Multiplicação de sementes',
    crossing_block_trial      => 'Ensaio de bloco de cruzamentos',
    'Specialty Trial'         => 'Ensaio especial',
);
my %activity_labels = (
    'Trial Created'            => 'Ensaio criado',
    'Trial Uploaded'           => 'Ensaio enviado',
    'Started Phenotyping'      => 'Fenotipagem iniciada',
    'Phenotyping Completed'    => 'Fenotipagem concluída',
    'Data Cleaning Completed'  => 'Limpeza de dados concluída',
    'Data Analysis Completed'  => 'Análise de dados concluída',
);
</%init>


<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome do ensaio</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[Sem nome de ensaio]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Programa de melhoramento</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print "<span class='text-danger'>[Sem programa de melhoramento]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>Local do ensaio</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name ( $country_name )";
% } else {
%  print "<span class='text-danger'>[Sem local]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Ano</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[Sem ano]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Tipo de material avaliado neste ensaio</b></td>
                <td>
                    <div id="stock_type_in_trial">
% if ($trial_stock_type) {
%     print $stock_type_labels{$trial_stock_type} || $trial_stock_type;
% } else {
%     print "acesso";
% }
                    </div>
                </td>
            </tr>

	    <tr>
                <td><b>Número de materiais neste ensaio</b></td>
                <td>
                    <div id="stock_number_in_trial">
% if ($trial_stock_count) {
%     print "$trial_stock_count";
% } else {
% print "<span class='text-danger'>[Sem materiais no ensaio]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Tipo de ensaio</b></td>
                <td>
                    <div id="trial_type">
% if ($trial_type) {
%  print $trial_type_labels{$trial_type} || $trial_type;
% } else {
% print "<span class='text-danger'>[Tipo não definido]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Data de plantio</b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $planting_date %>" ><% $planting_date %></a>
% if (defined $dap_display) {
&nbsp;<span>| DAP: <% $dap_display %> </span>
% }
% } else {
%  print "<span class='text-danger'>[Sem data de plantio]</span>";
% }
                    </div>
                </td>
            </tr>
% if ($transplanting_date && $transplanting_date ne '') {
<tr>
    <td><b>Data de transplantio</b></td>
    <td>
        <div id="transplanting_date">
            <a href="/breeders/trial/<% $trial_id %>?currentDate=<% $transplanting_date %>" ><% $transplanting_date %></a>
        </div>
    </td>
</tr>
% }
            <tr>
                <td><b>Data de colheita</b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $harvest_date %>" ><% $harvest_date %></a>
% if (defined $dah_display) {
&nbsp;<span> | DAC: <% $dah_display %> </span>
% }
% } else {
%  print "<span class='text-danger'>[Sem data de colheita]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Descrição</b></td>
                <td>
% if ($trial_description) {
%  print "<div id='trial_description' style='white-space: pre-wrap;'>$trial_description</div>";
% } else {
%  print "<div id='trial_description'><span class='text-danger'>[Sem descrição]</span></div>";
% }
                </td>
            </tr>

            <tr>
                <td><b>Pasta</b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link">Nova pasta</button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link">Alterar pasta</button>
                </td>
            </tr>

	    <tr><td><b>Criado por</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[N/A]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Atividade mais recente do ensaio</b></td>
                <td>
                        <div id="latest_trial_activity">
% if ($latest_trial_activity) {
%  my $latest_activity_display = $activity_labels{$latest_trial_activity} || $latest_trial_activity;
%  print "<span class='text-success'>$latest_activity_display</span>";
% } else {
%  print "<span class='text-danger'>[Sem registro]</span>";
% }
                        </div>
                    </td>
                </tr>

% if ($plot_name_template_display) {
            <tr>
                <td><b>Modelo de nome de parcela</b></td>
                <td>
                    <div id="plot_name_template">
                        <div><b><% $plot_name_template_name %></b></div>
                        <div><% $plot_name_template_display %></div>
                    </div>
                </td>
            </tr>
% }

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>

        <table class="table table-hover table-bordered">
            <tr><td><b>Largura da parcela (m)</b></td>
                <td>
                    <div id="plot_width">
% if ($plot_width) {
%  print "$plot_width";
% } else {
%  print "<span class='text-default'>[Sem largura da parcela]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>Comprimento da parcela (m)</b></td>
                <td>
                    <div id="plot_length">
% if ($plot_length) {
%  print "$plot_length";
% } else {
%  print "<span class='text-default'>[Sem comprimento da parcela]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>Área do campo (ha)</b></td>
                <td>
                    <div id="field_size">
% if ($field_size) {
%  print "$field_size";
% } else {
%  print "<span class='text-default'>[Sem área do campo]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>O ensaio será genotipado</b></td>
                <td>
                    <div id="planned_to_be_genotyped">
% if ($field_trial_is_planned_to_be_genotyped) {
%  print lc($field_trial_is_planned_to_be_genotyped) eq 'yes' ? 'Sim' : lc($field_trial_is_planned_to_be_genotyped) eq 'no' ? 'Não' : $field_trial_is_planned_to_be_genotyped;
% } else {
%  print "Não";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>O ensaio será usado em cruzamentos</b></td>
                <td>
                    <div id="planned_to_cross">
% if ($field_trial_is_planned_to_cross) {
%  print lc($field_trial_is_planned_to_cross) eq 'yes' ? 'Sim' : lc($field_trial_is_planned_to_cross) eq 'no' ? 'Não' : $field_trial_is_planned_to_cross;
% } else {
%  print "Não";
% }
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
