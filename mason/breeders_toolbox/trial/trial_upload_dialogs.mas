                                            <option value="12">12.0</option>
                                            <option value="12.5">12.5</option>
                                        </select> -->
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Área do campo (ha): </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="trial_upload_field_size" name="trial_upload_field_size" type="text" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Plantas por parcela: </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="trial_upload_plant_entries" name="trial_upload_plant_entries" type="text" />
                                        <p><i>Cria registros de plantas para cada parcela. Ignore este campo se não desejar adicionar plantas.</i></p>
                                    </div>
                                    <label style="font-size: 80%;" class="col-sm-3 control-label">Herdar tratamentos das parcelas: </label>
                                    <div class="col-sm-8" >
                                        <input name="trial_upload_plants_per_plot_inherit_treatments" id="trial_upload_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Atribuir linha e coluna às plantas dentro das parcelas?</label>
                                        <div class="col-sm-9" >
                                            <input name="trial_upload_rows_and_columns_to_plants" id="trial_upload_rows_and_columns_to_plants" type="checkbox"/>
                                            <div id="trial_upload_plant_row_column_format_dialog" style="display:none">
                                                <p><i>Uma planta por coordenada (linha, coluna). As linhas e colunas serão preenchidas em zigue-zague. A numeração começa em 1 dentro de cada parcela.</i></p>
                                                <table style="width:60%">
                                                    <tr>
                                                        <td>
                                                            <label>Número de linhas por parcela</label>
                                                        </td>
                                                        <td>
                                                            <input name="trial_upload_rows_per_plot" id="trial_upload_rows_per_plot" type="number"/>
                                                        </td>
                                                    </tr><tr>
                                                        <td>
                                                            <label>Número de colunas por parcela</label>
                                                        </td>
                                                        <td>
                                                            <input name="trial_upload_cols_per_plot" id="trial_upload_cols_per_plot" type="number"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Descrição: </label>
                                    <div class="col-sm-9" >
                                        <textarea class="form-control" id="trial_upload_description" name="trial_upload_description" form="upload_trial_form"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Tipo de material avaliado no ensaio: </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="trial_upload_trial_stock_type" name="trial_upload_trial_stock_type">
                                            <option value="">Selecione um tipo de material</option>
                                            <option value="accession">acesso</option>
                                            <option value="cross">cruzamento</option>
                                            <option value="family_name">nome de família</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Tipo de delineamento: </label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_upload_design_method" name="trial_upload_design_method">
% foreach my $type(@$design_types){
%    my $method;
%    my $display_type = $type;
%    if ($type eq 'Completely Randomized'){
%        $method = 'CRD';
%    } elsif ($type eq 'Complete Block'){
%        $method = 'RCBD';
%    } elsif ($type eq 'Resolvable Row-Column'){
%        $method = 'RRC';
%    } elsif ($type eq 'DRRC'){
%        $method = 'DRRC';
%    } elsif ($type eq 'Un-Replicated Diagonal Design'){
%        $method = 'URDD';
%    } elsif ($type eq 'Augmented Row-Column'){
%        $method = 'ARC';
%    } elsif ($type eq 'Alpha Lattice'){
%        $method = 'Alpha';
%    } elsif ($type eq 'Modified Augmented Design'){
%        $method = 'MAD';
%    } elsif ($type eq 'Nursery/Greenhouse'){
%        $method = 'greenhouse';
%    } elsif ($type eq 'Split Plot'){
%        $method = 'splitplot';
%    } elsif ($type eq 'Strip Plot'){
%        $method = 'stripplot';
%    } elsif ($type eq 'Partially Replicated'){
%        $method = 'p-rep';
%    } else {
%        $method = $type;
%    }
%    my %display_types = (
%        'Completely Randomized' => 'Inteiramente casualizado',
%        'Complete Block' => 'Blocos completos casualizados',
%        'Resolvable Row-Column' => 'Linha-coluna resolvível',
%        'DRRC' => 'Linha-coluna duplamente resolvível',
%        'Un-Replicated Diagonal Design' => 'Delineamento diagonal sem repetição',
%        'Augmented Row-Column' => 'Linha-coluna aumentada',
%        'Alpha Lattice' => 'Látice alfa',
%        'Modified Augmented Design' => 'Delineamento aumentado modificado',
%        'Nursery/Greenhouse' => 'Viveiro/casa de vegetação',
%        'Split Plot' => 'Parcelas subdivididas',
%        'Strip Plot' => 'Faixas subdivididas',
%        'Partially Replicated' => 'Parcialmente repetido',
%    );
%    $display_type = $display_types{$type} if exists $display_types{$type};
    <option value="<%$method%>"><%$display_type%></option>
%}
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Arquivo para envio: </label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="trial_uploaded_file" id="trial_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>

                                <br/><br/>
                                <center>
                                <button id="next_step_trial_information_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">Ir para a próxima etapa</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Vínculos do ensaio" &>
                                <& /page/page_title.mas, title=>"Este ensaio está vinculado a outros ensaios de campo, placas de genotipagem ou experimentos de cruzamento no banco de dados? Se não tiver certeza, pule esta etapa. A informação poderá ser adicionada na página de detalhes após salvar o ensaio." &>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">Este ensaio dá continuidade a um ensaio de campo anterior? </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_sourced" name="upload_trial_trial_sourced">
                                                <option value="no">Não</option>
                                                <option value="yes">Sim</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none" id="upload_trial_source_trial_section">
                                        <label class="col-sm-5 control-label">Selecione os ensaios que antecederam este: </label>
                                        <div class="col-sm-7">
                                            <div id="upload_trial_trial_source" name="upload_trial_trial_source">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <p>Se forem coletadas amostras de tecido para criar uma placa de genotipagem de 96 poços, ao adicionar a placa ao banco de dados poderão ser usados os nomes das parcelas, das plantas ou das amostras de tecido deste ensaio. Assim, será criado um vínculo entre o ensaio de campo e a placa.</p>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">Este ensaio será genotipado? </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_will_be_genotyped" name="upload_trial_trial_will_be_genotyped">
                                                <option value="no">Não</option>
                                                <option value="yes">Sim</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <p>Se forem realizados cruzamentos neste ensaio de campo, cada cruzamento poderá ser vinculado a parcelas femininas e masculinas específicas. Ao enviar esses cruzamentos, o ensaio poderá ser vinculado automaticamente ao experimento de cruzamento no banco de dados.</p>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">Serão realizados cruzamentos neste ensaio? </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_will_be_crossed" name="upload_trial_trial_will_be_crossed">
                                                <option value="no">Não</option>
                                                <option value="yes">Sim</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <br />

                                <div class="form-horizontal">
                                    <p>Marque esta opção para ignorar possíveis avisos e salvar o ensaio no banco de dados.</p>
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">Ignorar avisos? </label>
                                        <div class="col-sm-7">
                                            <input id="upload_trial_ignore_warnings" name="upload_trial_ignore_warnings" type="checkbox">
                                        </div>
                                    </div>
                                </div>

                                <div style="display:none; padding: 5px; text-align: center" id="upload_trial_warning_messages" class="alert-warning" role="alert"></div>

                                <br />

                                <center>
                                    <button type="button" class="btn btn-lg btn-primary" name="upload_trial_validate_form_button" id="upload_trial_validate_form_button">Primeiro, validar o formulário</button>
                                    <button type="button" class="btn btn-lg btn-primary" disabled name="upload_trial_submit_first" onclick="Workflow.complete(this, false); return false;" >Enviar ensaio</button>
                                <center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "Corrigir acessos ausentes" &>
                                <& /page/page_title.mas, title=>"Correção do problema de acessos ausentes" &>

                                <div id="upload_trial_missing_accessions_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>Os acessos avaliados no ensaio precisam existir no banco de dados antes que o ensaio seja adicionado. Um mesmo acesso pode ser avaliado em vários ensaios e, por isso, existe como entidade independente. A inclusão de novos acessos exige cuidado para evitar duplicações incorretas.</li>
                                            <li>Para adicionar acessos ao banco de dados, use uma lista de acessos ou um arquivo Excel.</li>
                                        </ul>
                                    </div>

                                    <div id="upload_trial_add_missing_accessions_html">
                                    </div>

                                    <button class="btn btn-info" name="add_accessions_link">Adicionar os acessos ao banco de dados</button><br/><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Clique aqui quando todos os acessos estiverem no banco de dados</button><br/><br/>
                                </div>
                                <div id="upload_trial_error_display">

                                    <h3>Mensagens de erro do envio do ensaio</h3>
                                    <div class="panel panel-danger">
                                        <div class="panel-body">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <center>
                                <div id="upload_trial_no_error_messages_html">
                                </div>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Corrigir lotes de sementes ausentes" &>
                                <& /page/page_title.mas, title=>"Correção do problema de lotes de sementes ausentes" &>

                                <div id="upload_trial_missing_seedlots_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>Os lotes de sementes usados no ensaio precisam existir no banco de dados antes que o ensaio seja adicionado. Um mesmo lote pode ser usado em vários ensaios e, por isso, existe como entidade independente. A inclusão de novos lotes exige cuidado para evitar que os dados sejam vinculados incorretamente a registros duplicados.</li>
                                        </ul>
                                    </div>
                                    <ul>
                                    <li>Para adicionar lotes de sementes ao banco de dados, envie um arquivo Excel ou adicione cada lote individualmente.<br/><br/>
                                        <ul>
                                        <li><button class="btn btn-info" name="seedlot_bulk_upload">Enviar arquivo Excel</button><br/><br/></li>
                                        <li><button class="btn btn-info" name="add_seedlot_button">Adicionar um lote de sementes</button></li>
                                        </ul>
                                    </li>
                                    </ul><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Clique aqui quando todos os lotes estiverem no banco de dados</button><br/><br/>
                                </div>
                                <div id="upload_trial_error_display_seedlot">

                                    <h3>Mensagens de erro do envio do ensaio</h3>
                                    <div class="panel panel-danger">
                                        <div class="panel-body">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <center>
                                <div id="upload_trial_no_error_messages_seedlot_html">
                                </div>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "Tentar enviar o ensaio novamente" &>
                                <& /page/page_title.mas, title=>"Envie o ensaio novamente. Os erros já devem ter sido corrigidos; caso contrário, consulte a caixa vermelha abaixo. Você pode continuar alterando o arquivo e clicar em Enviar até que ele seja aceito." &>
                                <div id="trial_upload_show_repeat_upload_button">
                                    <center>
                                    <button type="button" class="btn btn-lg btn-primary" name="upload_trial_submit_second" >Enviar ensaio</button><br/><br/>
                                    </center>
                                </div>
                                <center>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>

                                <div id="upload_trial_error_display_second_try" style="display:none">

                                    <h3>Foram encontrados estes problemas no arquivo:</h3>
                                    <div class="panel panel-danger">
                                        <div class="list-group-item-danger">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </&>
                            <&| /util/workflow.mas:complete, title=> "Concluído" &>
                                <& /page/page_title.mas, title=>"Concluído! Seu ensaio agora está no banco de dados" &>
                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    O arquivo do ensaio foi enviado com sucesso
                                </p>

                                <ul>
                                    <li>Você pode acessar a página de detalhes do ensaio que acabou de criar.</li>
                                    <li>Você pode imprimir códigos de barras das parcelas, plantas ou amostras de tecido deste ensaio.</li>
                                    <li>Você já pode adicionar fenótipos às parcelas ou plantas deste ensaio.</li>
                                </ul>
                                <br/>
                                <div name="upload_trial_completed_message"></div>
                                <!--center>
                                <button class="btn btn-primary" id="upload_trial_success_complete_button">O ensaio foi salvo no banco de dados sem erros. Clique aqui</button><br/><br/>
                                </center-->
                            </&>
                        </&>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_upload_spreadsheet_info_dialog" name="trial_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTrialInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Os ensaios podem ser enviados em um arquivo Excel (.xls ou .xlsx)</b>
                    <br />
                    <hr>
                    <&| /page/info_section.mas, title=>"Tipo de material avaliado neste ensaio: acesso", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>Cabeçalho:</b>
                            <br/>
                            A primeira linha (cabeçalho) deve conter o seguinte:
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>accession_name</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                        <td>entry_number</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>Cabeçalho como texto:</b><br/>
                            <p>plot_name,accession_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot,entry_number</p>
                        </div>
                    </&>

                    <&| /page/info_section.mas, title=>"Tipo de material avaliado neste ensaio: identificador exclusivo do cruzamento", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>Cabeçalho:</b>
                            <br/>
                            A primeira linha (cabeçalho) deve conter o seguinte:
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>cross_unique_id</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                        <td>entry_number</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>Cabeçalho como texto:</b><br/>
                            <p>plot_name,cross_unique_id,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot,entry_number</p>
                        </div>
                    </&>

                    <&| /page/info_section.mas, title=>"Tipo de material avaliado neste ensaio: nome de família", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>Cabeçalho:</b>
                            <br/>
                            A primeira linha (cabeçalho) deve conter o seguinte:
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>family_name</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                        <td>entry_number</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>Cabeçalho como texto:</b><br/>
                            <p>plot_name,family_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot,entry_number</p>
                        </div>
                    </&>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li>accession_name, cross_unique_id ou family_name (deve existir no banco de dados; é o acesso, identificador exclusivo do cruzamento ou nome de família avaliado na parcela)</li>
                    <li>plot_number (número sequencial da parcela no campo, por exemplo, 1001, 1002, 2001 e 2002; deve ser exclusivo dentro do ensaio)</li>
                    <li>block_number (parâmetro do delineamento que indica o bloco da parcela)</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                    <li>plot_name (deve ser exclusivo em todo o banco de dados; se não for informado, será gerado automaticamente como <code>{trial_name}-PLOT_{plot_number}</code> ou conforme o modelo especificado)</li>
                    <li>is_a_control (informe 1 se a parcela for controle ou testemunha; caso contrário, deixe em branco)</li>
                    <li>rep_number (número da repetição; valor numérico)</li>
                    <li>range_number (número da faixa, geralmente equivalente a col_number; valor numérico)</li>
                    <li>row_number (número da linha; em um campo em grade, representa a coordenada y; valor numérico necessário para gerar o mapa de campo)</li>
                    <li>col_number (número da coluna; em um campo em grade, representa a coordenada x; também chamado de range_number; valor numérico necessário para gerar o mapa de campo)</li>
                    <li>seedlot_name (lote de origem da semente plantada; deve existir no banco de dados; para parcelas do tipo nome de família, podem ser usados lotes dos cruzamentos integrantes da família)</li>
                    <li>num_seed_per_plot (número de sementes por parcela, transferidas do lote informado em seedlot_name; valor numérico)</li>
                    <li>weight_gram_seed_per_plot (peso, em gramas, das sementes na parcela, transferidas do lote informado em seedlot_name; valor numérico)</li>
                    <li>entry_number (número de entrada atribuído ao material dentro do ensaio; valor numérico)</li>
                    <li>intercrop_accession_name (nomes dos acessos adicionais plantados na parcela junto com o acesso principal; eles já devem existir no banco de dados; para vários acessos em consórcio, separe os nomes por vírgula em uma coluna ou adicione outras colunas com este cabeçalho)</li>
                    </ul>

                    <b>Tratamentos:</b>
                    <ul>
                    <li>Os tratamentos experimentais são processados de modo semelhante aos fenótipos e podem ser enviados pela página de detalhes após a criação do ensaio. Também podem ser incluídos como colunas adicionais no arquivo, no formato <code>experimental treatment|EXPERIMENT_TREATMENT:0000001</code>.</li>
                    </ul>

                    <hr />
                    <p>Somente os campos obrigatórios precisam constar no modelo de envio. Você pode acrescentar quaisquer campos opcionais, em qualquer ordem.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="multiple_trial_upload_spreadsheet_info_dialog" name="multiple_trial_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadMultipleTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadMultipleTrialInfoDialog">Informações do modelo de envio</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <br />
                    <b>Vários delineamentos de ensaios:</b>
                    <br />
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha deve conter o cabeçalho a seguir, que amplia o cabeçalho usado para um único ensaio:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>trial_name</td>
                                <td>breeding_program</td>
                                <td>Localização</td>
                                <td>ano</td>
                                <td>transplanting_date</td>
                                <td>design_type</td>
                                <td>Descrição</td>
                                <td>trial_type</td>
                                <td>trial_stock_type</td>
                                <td>plot_width</td>
                                <td>plot_length</td>
                                <td>field_size</td>
                                <td>planting_date</td>
                                <td>harvest_date</td>
                                <td>plot_name</td>
                                <td>accession_name</td>
                                <td>plot_number</td>
                                <td>block_number</td>
                                <td>is_a_control</td>
                                <td>rep_number</td>
                                <td>range_number</td>
                                <td>row_number</td>
                                <td>col_number</td>
                                <td>seedlot_name</td>
                                <td>num_seed_per_plot</td>
                                <td>weight_gram_seed_per_plot</td>
                                <td>entry_number</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Cabeçalho como texto:</b><br/>
                    <p>trial_name,breeding_program,location,year,transplanting_date,design_type,description,trial_type,trial_stock_type,plot_width,plot_length,field_size,planting_date,harvest_date,plot_name,accession_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot,entry_number</p>

                    <b>Observações:</b><br/>
                    <p>Se os materiais avaliados em algum ensaio forem cruzamentos ou nomes de famílias, a coluna <b>trial_stock_type</b> será obrigatória e deverá conter <code>cross</code> ou <code>family_name</code>. Todas as linhas do mesmo ensaio devem ter o mesmo tipo de material.</p>

                    <b>Campos obrigatórios:</b>
                    <ul>
                    <li>trial_name (deve ser exclusivo em todo o banco de dados; geralmente combina ano, transplanting_date, finalidade, número exclusivo e local)</li>
                    <li>breeding_program (nome do programa de melhoramento responsável pelo ensaio; deve existir no banco de dados)</li>
                    <li>Localização (<strong>nome</strong> UO <strong>abreviação</strong> do local onde o ensaio foi realizado; deve existir no banco de dados)</li>
                    <li>year (ano de realização do ensaio)</li>

                    <li>design_type (sigla do tipo de delineamento; deve existir no banco de dados. Valores possíveis: CRD, RCBD, RRC, DRRC, URDD, ARC, Alpha, Lattice, Augmented, MAD, greenhouse, splitplot, stripplot, p-rep e Westcott)</li>
                    <li>description (texto adicional com outras informações relevantes sobre o ensaio)</li>
                    <li>accession_name, cross_unique_id ou family_name (acesso, cruzamento ou família avaliado na parcela; deve existir no banco de dados)</li>
                    <li>plot_number (número sequencial da parcela no campo, por exemplo, 1001, 1002, 2001 e 2002; deve ser exclusivo dentro do ensaio)</li>
                    <li>block_number (parâmetro do delineamento que indica o bloco da parcela)</li>
                    </ul>

                    <b>Campos opcionais adicionais:</b>
                    <ul>
                    <li>plot_name (deve ser exclusivo em todo o banco de dados; se não for informado, será gerado como <code>{trial_name}-PLOT_{plot_number}</code>)</li>
                    <li>plot_name_template (nome de um modelo de nome de parcela já salvo; deve pertencer ao programa de melhoramento informado e só pode haver um por ensaio; pode substituir plot_name)</li>
                    <li>trial_type (nome do tipo de ensaio; deve existir no banco de dados e usar um dos valores cadastrados)</li>
                    <li>trial_stock_type (tipo de material avaliado; use exatamente <code>accession</code>, <code>cross</code> ou <code>family_name</code>; o padrão é <code>accession</code>)
                    <li>plot_width (largura da parcela em metros)</li>
                    <li>plot_length (comprimento da parcela em metros)</li>
                    <li>field_size (área do campo em hectares)</li>
                    <li>planting_date (data de plantio no formato AAAA-MM-DD)</li>
                    <li>transplanting_date (data de transplantio no formato AAAA-MM-DD)</li>
                    <li>harvest_date (data de colheita no formato AAAA-MM-DD)</li>
                    <li>is_a_control (informe 1 se a parcela for controle ou testemunha; caso contrário, informe 0 ou deixe em branco)</li>
                    <li>rep_number (número da repetição; deve ser numérico)</li>
                    <li>range_number (número da faixa, geralmente equivalente a col_number; deve ser numérico)</li>
                    <li>row_number (número da linha; em um campo em grade, representa a coordenada y; valor numérico necessário para gerar o mapa de campo)</li>
                    <li>col_number (número da coluna; em um campo em grade, representa a coordenada x; também chamado de range_number; valor numérico necessário para gerar o mapa de campo)</li>
                    <li>seedlot_name (lote de origem da semente plantada; deve existir no banco de dados; para parcelas do tipo nome de família, podem ser usados lotes dos cruzamentos integrantes da família)</li>
                    <li>num_seed_per_plot (número de sementes por parcela, transferidas do lote informado em seedlot_name; valor numérico)</li>
                    <li>weight_gram_seed_per_plot (peso, em gramas, das sementes na parcela, transferidas do lote informado em seedlot_name; valor numérico)</li>
                    <li>entry_number (número de entrada atribuído ao material dentro do ensaio; valor numérico)</li>
                    <li>intercrop_accession_name (nomes dos acessos adicionais plantados em consórcio; eles já devem existir no banco de dados; separe vários nomes por vírgula em uma coluna ou use colunas adicionais com este cabeçalho)</li>
                    </ul>

                    <b>Tratamentos:</b>
                    <ul>
                    <li>Os tratamentos experimentais são processados de modo semelhante aos fenótipos e podem ser enviados pela página de detalhes após a criação do ensaio. Também podem ser incluídos como colunas adicionais no arquivo, no formato <code>experimental treatment|EXPERIMENT_TREATMENT:0000001</code>.</li>
                    </ul>

                    <hr />
                    <& /help/file_upload_type.mas, type => "Ensaios", optional_column => 1 &>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_multiple_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_trial_metadata_dialog" name="upload_trial_metadata_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTrialMetadataDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTrialMetadataDialog">Enviar metadados de ensaios</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>Este envio permite atualizar os metadados de ensaios que <strong>já foram adicionados ao banco de dados</strong>.</p>
                    <p>Todo metadado fornecido no arquivo substituirá o valor existente. Campos em branco manterão os metadados atuais inalterados.</p>

                    <&| /page/explanation.mas, title=>'Informações do modelo' &>
                        <p>
                            <b>Informações sobre o formato do arquivo</b>
                            <br>
                            <a id="trial_metadata_upload_spreadsheet_format_info">Formato da planilha</a>
                        </p>
                    </&>

                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_trial_metadata_form" name="upload_trial_metadata_form">
                        <div style="display: flex; justify-content: space-between; max-width: 500px; flex-wrap: wrap; align-items: flex-end; gap: 15px;">
                            <div>
                                <label for="trial_metadata_upload_file" style="display: inline-block;">Arquivo de metadados dos ensaios:</label>
                                <input type="file" name="trial_metadata_upload_file" id="trial_metadata_upload_file" encoding="multipart/form-data" />
                            </div>
                            <div>
                                <label class="control-label">Ignorar avisos: </label>
                                <input id="trial_metadata_upload_ignore_warnings" name="trial_metadata_upload_ignore_warnings" type="checkbox" data-toggle="toggle" encoding="multipart/form-data">
                            </div>
                        </div>
                    </form>

                    <div style="display:none; margin: 15px; padding: 15px" id="upload_trial_metadata_warning_messages" class="alert-warning" role="alert"></div>
                    <div style="display:none; margin: 15px; padding: 15px" id="upload_trial_metadata_error_messages" class="alert-danger" role="alert"></div>
                    <div style="display:none; margin: 15px; padding: 15px" id="upload_trial_metadata_success_messages" class="alert-success" role="alert"></div>

                    <div style="margin: 15px; text-align: center">
                        <button style="display:none" class="btn btn-primary" id="upload_trial_metadata_success_button">Recarregar página</button>
                    </div>

                    <& /help/file_upload_type.mas, type => "Metadados de ensaios" , optional_column => 1 &>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_trial_metadata_dialog_submit" id="upload_trial_metadata_dialog_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_metadata_upload_spreadsheet_format_modal" name="trial_metadata_upload_spreadsheet_format_modal" tabindex="-1" role="dialog" aria-labelledby="uploadTrialMetadataInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTrialMetadataInfoDialog">Informações do modelo de metadados de ensaios</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha deve conter o cabeçalho a seguir:
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>trial_name</td>
                                <td>breeding_program</td>
                                <td>pasta</td>
                                <td>Localização</td>
                                <td>ano</td>
                                <td>transplanting_date</td>
                                <td>planting_date</td>
                                <td>harvest_date</td>
                                <td>design_type</td>
                                <td>Descrição</td>
                                <td>trial_type</td>
                                <td>plot_width</td>
                                <td>plot_length</td>
                                <td>field_size</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos obrigatórios:</b>
                    <ul>
                        <li><b>trial_name:</b> nome do ensaio (já deve existir no banco de dados)</li>
                    </ul>
                    <br><b>Valores opcionais:</b><br>
                    <ul>
                        <li>new_trial_name (novo nome do ensaio; ainda não deve existir no banco de dados)</li>
                        <li>breeding_program (nome do programa de melhoramento responsável; deve existir no banco de dados)</li>
                        <li>folder (nome da pasta em que o ensaio será exibido em Gerenciar &gt; Ensaios de campo; se não existir, será criada no programa de melhoramento do ensaio)
                        <li>Localização (<strong>nome</strong> UO <strong>abreviação</strong> do local do ensaio; deve existir no banco de dados)</li>
                        <li>year (ano de realização do ensaio)</li>
                        <li>transplanting_date (data de transplantio no formato AAAA-MM-DD ou <code>remove</code> para remover a data)</li>
                        <li>planting_date (data de plantio no formato AAAA-MM-DD ou <code>remove</code> para remover a data)</li>
                        <li>harvest_date (data de colheita no formato AAAA-MM-DD ou <code>remove</code> para remover a data)</li>
                        <li>design_type (sigla do tipo de delineamento; deve existir no banco de dados. Valores possíveis: CRD, RCBD, RRC, DRRC, URDD, ARC, Alpha, Lattice, Augmented, MAD, greenhouse, splitplot, p-rep e Westcott)</li>
                        <li>description (texto adicional com outras informações relevantes sobre o ensaio)</li>
                        <li>trial_type (nome do tipo de ensaio; deve existir no banco de dados e usar um dos valores cadastrados)</li>
                        <li>plot_width (largura da parcela em metros)</li>
                        <li>plot_length (comprimento da parcela em metros)</li>
                        <li>field_size (área do campo em hectares)</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Metadados de ensaios", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_trial_metadata_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>



<script>
jQuery(document).ready(function(){

    jQuery('#trial_upload_rows_and_columns_to_plants').click( function () {
        if (jQuery('#trial_upload_rows_and_columns_to_plants').is(':checked')){
            jQuery('#trial_upload_plant_row_column_format_dialog').show();
        } else {
            jQuery('#trial_upload_plant_row_column_format_dialog').hide();
        }

    });

    var selectedProgram = jQuery('#trial_upload_breeding_program').val()

    filter_options(selectedProgram, 'program', 'trial_upload_location');

    jQuery('#trial_upload_breeding_program').change(function() {
        filter_options(jQuery(this).val(), 'program', 'trial_upload_location');
    });

    jQuery('#multiple_trial_designs_upload_file').change(function() {
        if (jQuery(this).val()) {
          jQuery('#multiple_trial_designs_upload_submit').prop("disabled",false);
        } else {
          jQuery('#multiple_trial_designs_upload_submit').prop("disabled",true);
        }
    });

    jQuery('#upload_multiple_trials_ignore_warnings').change(function() {
      if (this.checked) {
        jQuery('#upload_multiple_trials_warning_messages').hide();
      }
    });

    jQuery('#trial_metadata_upload_ignore_warnings').change(function() {
      if (this.checked) {
        jQuery('#upload_trial_metadata_warning_messages').hide();
      }
    });
});
</script>
