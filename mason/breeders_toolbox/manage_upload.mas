<a href="/breeders/genotyping"><p>Acessar o gerenciamento de placas de genotipagem</p></a>
</td>
<td>
<a href="/search/trials"><p>Acessar a pesquisa de ensaios</p></a>
</td>
</tr>
</tbody>
</table>
</div>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities => $facilities &>

