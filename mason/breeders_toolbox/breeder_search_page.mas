
<%args>
$dataset_id => undef
</%args>

<%once>
  my $default_repeat_measurements = $c->get_conf('pheno_download_default_repeat_measurements');
  my $default_include_timestamps = $c->get_conf('pheno_download_default_include_timestamps');
  my $default_include_intercrop_accessions = $c->get_conf('pheno_download_default_include_intercrop_accessions');
  my $default_include_entry_numbers = $c->get_conf('pheno_download_default_include_entry_numbers');
  my $default_include_trait_synonyms = $c->get_conf('pheno_download_default_include_trait_synonyms');
  my $default_supress_outliers = $c->get_conf('exclude_phenotype_outliers');
  my $default_include_pedigree_parents = $c->get_conf('pheno_download_default_include_pedigree_parents');
</%once>

<& /util/import_javascript.mas, entries => ["wizard"] &>
<& /util/import_css.mas, paths => ['wizard.css'] &>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

<& /page/page_title.mas, title=>"Assistente de pesquisa" &>

<div class="row">
  <div class="col-md-12" style="margin-bottom:1em; text-align:right;">
    Não está vendo seus dados? <button id="update_wizard_lists" class="btn btn-default">Recarregar listas</button>
    <button id="update_wizard_show" class="btn btn-default">Atualizar assistente</button>
  </div>
</div>

<& /breeders_toolbox/breeder_search_page_dataset_overlay.mas &>

<div id="wizard" class="row">
  <span class="wizard-main">
    <span class="wizard-columns"></span>
    <div class="templates" style="display: none !important;">

      <div class="wizard-unselected">
        <div class="btn-group wizard-list-item">
          <button type="button" class="btn btn-xs btn-success wizard-list-add">&#x2b;</button>
          <a target="_blank" class="btn btn-xs btn-default wizard-list-name"></a>
        </div>
      </div>

      <div class="wizard-selected">
        <div class="btn-group wizard-list-item">
          <button type="button" class="btn btn-xs btn-danger wizard-list-rem">&#10005;</button>
          <a target="_blank" class="btn btn-xs btn-default wizard-list-name"></a>
        </div>
      </div>

      <div class="wizard-column">
        <div class="wizard-panel panel panel-default">

          <div class="panel-heading">
            <select class="wizard-type-select form-control input-sm form-inline">
              <option value="" disabled selected>Selecione o tipo de coluna</option>
              <optgroup class="wizard-types-group" label="--------------------"></optgroup>
              <optgroup class="wizard-lists-group" label="Carregar seleção de uma lista:"></optgroup>
            </select>
          </div>

          <div class="wizard-search-container">
            <textarea class="wizard-search form-control" placeholder="Pesquisador"></textarea>
            <div class="wizard-search-options">
              <div class="wizard-search-options-group btn-group" role="group">
                <button type="button" class="btn btn-xs btn-primary active wizard-search-options-btn wizard-search-options-contains">Contém</button>
                <button type="button" class="btn btn-xs btn-default wizard-search-options-btn wizard-search-options-exact">Exato</button>
              </div>
              <div class="btn-group" role="group">
                <button type="button" class="btn btn-xs btn-danger wizard-search-options-clear">
                  &nbsp;<span class="glyphicon glyphicon-remove" style="top: 2px"></span>&nbsp;
                </button>
                <button type="button" class="btn btn-xs btn-info wizard-search-options-done">
                  &nbsp;<span class="glyphicon glyphicon-chevron-up" style="top: 2px"></span>&nbsp;
                </button>
              </div>
            </div>
          </div>

          <div class="panel-body">

            <div class="wizard-btn-center">
              <div class="btn-group">
                <button class="wizard-select-all btn btn-default btn-xs">Selecionar todos</button
                ><button class="wizard-btn-tag btn btn-primary btn-xs">
                  <span class="wizard-count-selected">0</span>/<span class="wizard-count-all">0</span>
                </button
                ><button class="wizard-select-clear btn btn-default btn-xs">Limpar</button>
              </div>
            </div>

            <div style="position: relative">
              <span class="wizard-loader glyphicon glyphicon-refresh" aria-hidden="true"></span>
              <ul class="wizard-list-unselected wizard-list well"></ul>
              <ul class="wizard-list-selected wizard-list well"></ul>
            </div>

            <div class="wizard-btn-center wizard-union-toggle">
              <div class="btn-group wizard-union-toggle-btn-group">
                <button type="button" class="btn btn-xs btn-default disabled">Correspondência</button>
                <button type="button" class="btn btn-xs wizard-union-toggle-btn wizard-union-toggle-btn-any btn-primary active">QUALQUER</button>
                <button type="button" class="btn btn-xs wizard-union-toggle-btn wizard-union-toggle-btn-min btn-default">MÍN.</button>
                <button type="button" class="btn btn-xs wizard-union-toggle-btn wizard-union-toggle-btn-all btn-default">TODOS</button>
              </div>
              <div class="input-group input-group-sm wizard-union-toggle-min-group">
                <span class="input-group-btn">
                  <button class="btn btn-default disabled" type="button">>=</button>
                </span>
                <input type="text" class="form-control wizard-union-toggle-min-value">
                <span class="input-group-btn">
                  <button class="btn btn-xs wizard-union-toggle-min-type wizard-union-toggle-min-type-percent btn-primary active" type="button">%</button>
                  <button class="btn btn-xs wizard-union-toggle-min-type wizard-union-toggle-min-type-count btn-default" type="button">#</button>
                </span>
              </div>
            </div>

          </div>

          <table class="wizard-save-to-list table panel-footer">
            <&| /util/user.mas:logged_in &>
              <tr>
                <td>
                  <select class="wizard-add-to-list-id form-control input-sm">
                    <option selected value="" disabled>Adicionar à lista...</option>
                    <optgroup class="wizard-lists-group" label="--------------------"></optgroup>
                  </select>
                </td>
                <td>
                  <button class="wizard-add-to-list btn btn-sm btn-primary btn-block">Adicionar</button>
                </td>
              </tr>
              <tr>
                <td>
                  <input class="wizard-create-list-name form-control input-sm" type="text" placeholder="Criar nova lista..."></input>
                </td>
                <td>
                  <button class="wizard-create-list btn btn-primary btn-sm btn-block">Criar</button>
                </td>
              </tr>
            </&>
            <&| /util/user.mas:logged_out &>
              <tr>
                <td><button class="btn btn-xs btn-primary" name="site_login_button">Entrar</button> para salvar listas.</td>
              </tr>
            </&>
          </table>

        </div>
      </div>

    </div>
  </span>

  <div class="clearfix col-xs-12"></div>

  <div class="wizard-datasets panel-group col-sm-12 col-md-6">
    <div class="panel panel-default wizard-panel">
      <div class="panel-heading">
        <&| /util/user.mas:logged_out &><button class="btn btn-xs btn-primary" name="site_login_button">Entrar</button> Para</&>
        carregar/criar conjuntos de dados usando as colunas de <button class="btn btn-xs btn-default disabled wizard-btn-tag">Correspondência</button>
      </div>
      <&| /util/user.mas:logged_in &>
        <div class="panel-body">
          <div class="input-group">
            <select class="form-control input-sm wizard-dataset-select">
              <option selected value="" disabled>Carregar conjunto de dados</option>
              <optgroup class="wizard-dataset-group" label="--------------------"></optgroup>
            </select>
            <span class="input-group-btn">
              <span><button style="min-width:5em;margin-left:4px;" class="btn btn-sm btn-primary wizard-dataset-load">Carregar</button></span>
              <span><button style="min-width:9em;margin-left:4px;" class="btn btn-sm btn-primary wizard-dataset-public">Tornar público</button></span>
              <span><button style="min-width:5em;margin-left:4px;" class="btn btn-sm btn-danger wizard-dataset-delete">Excluir</button></span>
            </span>
          </div>
        </div>
        <div class="panel-body" style="margin-top:-1px;">
          <div class="input-group">
            <input type="text" placeholder="Criar novo conjunto de dados" class="form-control input-sm wizard-dataset-name" />
            <span class="input-group-btn">
              <span><button style="min-width:5em;margin-left:4px;" class="btn btn-sm btn-primary wizard-dataset-create">Criar</button></span>
            </span>
          </div>
        </div>
      </&>
    </div>
  </div>

  <div class="wizard-downloads panel-group col-sm-12 col-md-6" id="wiz-down-group" role="tablist" aria-multiselectable="true">
    <&| /util/user.mas:logged_out &>
      <div class="panel panel-default">
        <div class="panel-heading">
          <button class="btn btn-xs btn-primary" name="site_login_button">Entrar</button> para baixar dados relacionados.
        </div>
      </div>
    </&>
    <&| /util/user.mas:logged_in &>
      <div class="panel panel-default">
        <div class="panel-heading" role="button" data-toggle="collapse" data-parent="#wiz-down-group" href="#wiz-down-1-c" aria-controls="wiz-down-1-c">
          <span class="btnn btn-link">Dados genotípicos relacionados</span>
        </div>
        <div id="wiz-down-1-c" class="panel-collapse collapse" role="tabpanel">
          <p style="margin: 15px; text-color: #999; font-size: 90%">Baixe os registros genotípicos correspondentes do banco de dados. Selecione <strong>um único protocolo de genotipagem</strong> E <strong>um ou mais acessos</strong> para baixar os dados correspondentes.</p>
          <table class="table">
            <tr>
              <td colspan="4">
                <span class="glyphicon glyphicon-info-sign" title="Para baixar dados genotípicos relacionados, selecione um ou mais acessos e, opcionalmente, no máximo um protocolo de genotipagem no assistente. Se nenhum protocolo for selecionado, será usado o padrão do banco de dados. Marque esta opção para calcular os genótipos dos acessos selecionados a partir dos genótipos dos genitores; isso se aplica ao download de genótipos, da GRM e à realização de GWAS."></span>
                <span>Baixar dados genotípicos</span>
                <input class="wizard-download-genotypes-info form-control input-sm" type="text" disabled></input>
              </td>
              <td colspan="4">
                  <span>Calcular a partir dos genitores</span><br/>
                  <input type="checkbox" class="wizard-download-genotypes-parents-compute">
              </td>
              <td colspan="4">
                  <span>Incluir genótipos duplicados</span><br/>
                  <input type="checkbox" class="wizard-download-genotypes-duplicates-include">
              </td>
            </tr>
          </table>
          <div class="panel-footer" style="border-top: 1px solid #ddd;">
            <table class="table">
                <tr>
                    <td colspan="12">
                        <span class="glyphicon glyphicon-info-sign" title="Use cromossomos ou alelos de marcadores para filtrar os dados de genotipagem. Não é possível usar os dois critérios ao mesmo tempo."></span>
                        <span>Filtrar por cromossomo ou alelos de marcadores</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                        <span>Cromossomo</span>
                        <select class="wizard-download-genotypes-chromosome-number form-control input-sm"></select>
                    </td>
                    <td colspan="4">
                        <span>Posição inicial</span>
                        <input placeholder="" type="number" class="wizard-download-genotypes-start-position form-control input-sm">
                    </td>
                    <td colspan="4">
                        <span>Posição final</span>
                        <input placeholder="" type="number" class="wizard-download-genotypes-end-position form-control input-sm">
                    </td>
                </tr>
                <tr>
                    <td colspan="6">
                        <span>Filtro de alelos de marcadores</span>
                        <select class="wizard-download-genotypes-marker-set-list-id form-control input-sm" id="wizard-download-genotypes-marker-set-list-id"></select>
                    </td>
                    <td colspan="6">
                        <br/>
                        <button class="btn btn-sm btn-default" onClick="window.open('/breeders/markers', '_blank');">Gerenciar alelos de marcadores</button>
                    </td>
                </tr>
                <tr>
                    <td colspan="6">
                        <span>Formato de download dos genótipos</span>
                        <select class="wizard-download-genotypes-format form-control input-sm" >
                            <option value="VCF">Formato de arquivo VCF</option>
                            <option value="DosageMatrix">Formato de matriz de dosagem (.tsv)</option>
                        </select>
                    </td>
                    <td colspan="6">
                    </td>
                </tr>
                <tr>
                    <td colspan="8">
                        <span class="glyphicon glyphicon-info-sign" title="Selecione acessos e, opcionalmente, um protocolo de genotipagem. Se nenhum protocolo for selecionado, será usado o padrão do sistema. Para filtrar genótipos, use cromossomo, posição inicial, posição final ou alelos de marcadores. Marque a opção para calcular genótipos a partir dos genitores, caso estes tenham dados genotípicos. Os genótipos podem ser baixados nos formatos VCF e matriz de dosagem."></span>
                        <span>Baixar genótipos</span><br/>
                        <button class="wizard-download-genotypes btn btn-sm btn-primary">
                            <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                            Baixar genótipos
                        </button>
                        <input class="wizard-download-genotypes-info2 form-control btn-warning" type="text"></input>  <!-- warn Há protocolos de genotipagem demais-->
                        <input class="wizard-download-genotypes-info3 form-control btn-warning" type="text"></input>  <!-- show default protocol -->
                        <input class="wizard-download-genotypes-info4 form-control btn-warning" type="text"></input>  <!-- show slow download warning -->
                    </td>
                    <td colspan="4">
                    </td>
                </tr>
            </table>
          </div>
          <div class="panel-footer" style="border-top: 1px solid #ddd;">
            <table class="table">
                <tr>
                    <td colspan="6">
                      <span>Frequência do alelo menor</span>
                      <input placeholder="0.05" value="0.05" type="number" class="wizard-download-genotypes-grm-maf form-control input-sm">
                    </td>
                    <td colspan="3">
                      <span>Filtro de marcadores</span>
                      <input placeholder="0.60" value="0.60" type="number" class="wizard-download-genotypes-grm-marker-filter form-control input-sm">
                    </td>
                    <td colspan="3">
                      <span>Filtro de indivíduos</span>
                      <input placeholder="0.80" value="0.80" type="number" class="wizard-download-genotypes-grm-individuals-filter form-control input-sm">
                    </td>
                </tr>
              <tr>
                <td colspan="12">
                  <span>Formato de download da matriz de parentesco genômico (GRM)</span>
                  <select class="wizard-download-genotypes-grm-format form-control input-sm" >
                      <option value="matrix_uniquenames">Matriz com nomes dos materiais (.tsv)</option>
                      <option value="three_column_uniquenames">Três colunas com nomes dos materiais (.tsv)</option>
                      <option value="three_column_reciprocal_uniquenames">Três colunas recíprocas com nomes dos materiais (.tsv)</option>
                      <option value="heatmap">Mapa de calor (.pdf)</option>
                      <option value="matrix">Matriz com IDs dos materiais (.tsv)</option>
                      <option value="three_column">Três colunas com IDs dos materiais (.tsv)</option>
                      <option value="three_column_stock_id_integer">Três colunas com IDs inteiros dos materiais (.tsv)</option>
                      <option value="three_column_reciprocal">Três colunas recíprocas com IDs dos materiais (.tsv)</option>
                      <option value="three_column_reciprocal_stock_id_integer">Três colunas recíprocas com IDs inteiros dos materiais (.tsv)</option>
                  </select>
                  <br/>
                    <span class="glyphicon glyphicon-info-sign" title="Selecione acessos e, opcionalmente, um protocolo de genotipagem. Se nenhum protocolo for selecionado, será usado o padrão do sistema. Informe a frequência do alelo menor (MAF) e os filtros de marcadores e indivíduos. Marque a opção para calcular genótipos a partir dos genitores, caso estes tenham dados genotípicos. A GRM pode ser baixada como matriz (.tsv) ou em três colunas."></span>
                    <span>Baixar GRM</span><br/>
                    <button class="wizard-download-genetic-relationship-matrix btn btn-sm btn-primary">
                        <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                        Baixar GRM
                    </button>
                </td>
              </tr>
              <tr>
                  <td colspan="12">
                    <span>Formato de download do estudo de associação genômica ampla (GWAS)</span>
                    <select class="wizard-download-genotypes-gwas-format form-control input-sm" >
                        <option value="manhattan_qq_plots">Gráficos Manhattan + QQ (.pdf)</option>
                        <option value="results_tsv">Resultados GWAS (.tsv)</option>
                    </select>
                    <br/>
                    <span>Todas as características selecionadas são medidas repetidas</span>
                    <select class="wizard-download-genotypes-gwas-repeated-measurements form-control input-sm" >
                        <option value="no">Não</option>
                        <option value="yes">Sim</option>
                    </select>
                    <br/>
                        <span class="glyphicon glyphicon-info-sign" title="Selecione acessos, características e, opcionalmente, um protocolo de genotipagem. Se nenhum protocolo for selecionado, será usado o padrão do sistema. Características que não são medidas repetidas são analisadas separadamente, gerando resultados distintos, como vários gráficos Manhattan. Se forem medidas repetidas, selecione 'Sim' para executar uma única GWAS com todos os fenótipos, gerando, por exemplo, um único gráfico Manhattan. Informe a frequência do alelo menor (MAF) e os filtros de marcadores e indivíduos. Marque a opção para calcular genótipos a partir dos genitores, caso estes tenham dados genotípicos. A GWAS usa efeitos fixos para ensaios de campo e repetições, além de uma matriz de parentesco calculada dos dados genotípicos. A MAF e os dados ausentes são usados na filtragem antes da GWAS e do cálculo da matriz. Escolha resultados em gráficos Manhattan e QQ (.pdf) ou em tabela (.tsv)."></span>
                        <span>Executar GWAS</span><br/>
                      <button class="wizard-download-gwas btn btn-sm btn-primary">
                          <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                          Baixar GWAS
                      </button>
                  </td>
              </tr>
            </table>

          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading" role="button" data-toggle="collapse" data-parent="#wiz-down-group" href="#wiz-down-1-c-a" aria-controls="wiz-down-1-c-a">
          <span class="btnn btn-link">Dados genotípicos armazenados</span>
        </div>
        <div id="wiz-down-1-c-a" class="panel-collapse collapse" role="tabpanel">
          <p style="margin: 15px; text-color: #999; font-size: 90%">Baixe os arquivos VCF originais armazenados de projetos completos de genotipagem. Selecione <strong>um ou mais projetos e/ou protocolos de genotipagem</strong> para baixar os arquivos VCF dos projetos correspondentes.</p>
          <div id="wiz-down-1-c-a-body" style="min-height: 50px"></div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading" role="button" data-toggle="collapse" data-parent="#wiz-down-group" href="#wiz-down-2-c" aria-controls="wiz-down-2-c">
          <span class="btnn btn-link">Metadados de ensaios relacionados</span>
        </div>
        <div id="wiz-down-2-c" class="panel-collapse collapse" role="tabpanel">
          <table class="table">
            <tr>
              <td>
                <input class="wizard-download-tmetadata-info form-control input-sm" type="text" disabled value="Nenhum ensaio selecionado"></input>
              </td>
              <td>
                <select class="wizard-download-tmetadata-format form-control input-sm">
                  <option value="" disabled>Formato</option>
                  <option selected value="csv">CSV</option>
                  <option value="xlsx">XLSX</option>
                </select>
              </td>
            </tr>
          </table>
          <div class="panel-footer" style="border-top: 1px solid #ddd;">
            <button class="wizard-download-tmetadata btn btn-sm btn-primary">
                <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                Metadados
            </button>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading" role="button" data-toggle="collapse" data-parent="#wiz-down-group" href="#wiz-down-3-c" aria-controls="wiz-down-3-c">
          <span class="btnn btn-link">Fenótipos de ensaios relacionados</span>
        </div>
        <div id="wiz-down-3-c" class="panel-collapse collapse" role="tabpanel">
          <table class="table">
            <tr>
              <td colspan="3">
                <input class="wizard-download-phenotypes-info form-control input-sm" type="text" disabled></input>
              </td>
            </tr>
            <tr>
            <td colspan="1">
              <select class="wizard-download-phenotypes-speed form-control input-sm">
                <option value="" disabled>Tipo de download</option>
                <option selected value="Native">Padrão</option>
                <option value="MaterializedViewTable">Rápido (acelera o download, mas pode omitir alterações recentes)</option>
              </select>
            </td>
              <td colspan="1">
                <select class="wizard-download-phenotypes-format form-control input-sm">
                  <option value="" disabled>Formato de download</option>
                  <option selected value="csv">CSV</option>
                  <option value="xlsx">XLSX</option>
                </select>
              </td>
              <td colspan="1">
                <select class="wizard-download-phenotypes-level form-control input-sm">
                  <option value="" disabled>Nível dos dados</option>
                  <option selected value="all">Todos</option>
                  <option value="plot">Parcelas</option>
                  <option value="plant">Plantas</option>
                </select>
              </td>
            </tr>
            <tr>
              <td>
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-timestamp" type="checkbox" />
                    Incluir data e hora
                  </label>
                </div>
              </td>
              <td colspan="2">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-entry-numbers" type="checkbox" />
                    Incluir números de entrada dos acessos
                  </label>
                </div>
              </td>
            </tr>
            <tr>
              <td style="border-top: none; padding-top: 0">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-trait-synonyms" type="checkbox" />
                    Incluir sinônimos das características
                  </label>
                </div>
              </td>
              <td colspan="2" style="border-top: none; padding-top: 0">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-intercrop" type="checkbox" />
                    Incluir acessos de culturas consorciadas
                  </label>
                </div>
              </td>
            </tr>
            <tr>
              <td style="border-top: none; padding-top: 0">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-pedigree_parents" type="checkbox" />
                    Incluindo os genitores
                  </label>
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="3">
                Medidas repetidas: <br />
                <select class="wizard-download-repetitive-measurements-type form-control" >
                  <option value="first">Primeiro valor</option>
                  <option value="last">Último valor</option>
                  <option value="average">Valor médio</option>
                  <option value="sum">Soma dos valores</option>
                  <option value="all_values_single_line">Todos os valores em uma linha</option>
                  <option value="all_values_multiple_line">Todos os valores em várias linhas</option>
                </select>
              </td>
            </tr>
            <tr>
              <td style="border-top: none; padding-top: 0">
                De:<br /><input type="text" class="wizard-download-start-date form-control" id="phenotype_start_date" title="phenotype_start_date"  />
              </td>
              <td style="border-top: none; padding-top: 0" colspan="2">
                Até:<br /><input type="text" class="wizard-download-end-date form-control" id="phenotype_end_date" title="phenotype_end_date" />
              </td>
            </tr>
            <tr>
              <td style="border-top: none; padding-top: 0">
                <input type="checkbox" id="include_dateless_items" checked="1" />
                Incluir itens sem data
              </td>
            </tr>
            <tr>
              <td>
                <span>O nome da característica contém</span>
                <input placeholder="ex.: altura da planta" type="text" class="wizard-download-phenotypes-name form-control">
              </td>
              <td>
                <span>Valor mínimo</span>
                <input placeholder="-&#8734;" type="text" class="wizard-download-phenotypes-min form-control">
              </td>
              <td>
                <span>Valor máximo</span>
                <input placeholder="&#8734;" type="text" class="wizard-download-phenotypes-max form-control">
              </td>
            </tr>
            <tr>
              <td style="border-top: none; padding-top: 0" colspan="3">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-phenotypes-outliers" type="checkbox" />
                    Excluir valores fenotípicos atípicos definidos pelo usuário
                  </label>
                </div>
              </td>
            </tr>
          </table>
          <div class="panel-footer" style="border-top: 1px solid #ddd;">
            <button class="wizard-download-phenotypes btn btn-sm btn-primary">
                <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                Baixar fenótipos
            </button>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading" role="button" data-toggle="collapse" data-parent="#wiz-down-group" href="#wiz-down-4-c" aria-controls="wiz-down-4-c">
          <span class="btnn btn-link">Fenótipos de alta dimensionalidade de ensaios relacionados</span>
        </div>
        <div id="wiz-down-4-c" class="panel-collapse collapse" role="tabpanel">
          <table class="table">
            <tr>
              <td colspan="3">
                <input class="wizard-download-high-dim-phenotypes-info form-control input-sm" type="text" disabled></input>
                <input class="wizard-download-high-dim-phenotypes-protocol-info form-control input-sm" type="text" disabled></input>
              </td>
            </tr>
            <tr>
            <td colspan="1">
              <select class="wizard-download-high-dim-phenotypes-speed form-control input-sm">
                <option value="" disabled>Tipo de download</option>
                <option selected value="Native">Padrão</option>
                <option value="MaterializedViewTable">Rápido (acelera o download, mas pode omitir alterações recentes)</option>
              </select>
            </td>
              <td colspan="1">
                <select class="wizard-download-high-dim-phenotypes-format form-control input-sm">
                  <option value="" disabled>Formato de download</option>
                  <option selected value="csv">CSV</option>
                  <option value="xlsx">XLSX</option>
                </select>
              </td>
            </tr>
            <tr>
              <td>
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-high-dim-phenotypes-timestamp" type="checkbox" />
                    Incluir data e hora
                  </label>
                </div>
              </td>
              <td colspan="2">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-high-dim-phenotypes-entry-numbers" type="checkbox" checked />
                    Incluir números de entrada dos acessos
                  </label>
                </div>
              </td>
            </tr>
            <tr>
              <!--
              <td style="border-top: none; padding-top: 0">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-high-dim-phenotypes-outliers" type="checkbox" />
                    Excluir valores fenotípicos atípicos definidos pelo usuário
                  </label>
                </div>
              </td>
              !-->
              <td colspan="2" style="border-top: none; padding-top: 0">
                <div class="checkbox">
                  <label>
                    <input class="wizard-download-high-dim-phenotypes-intercrop" type="checkbox" checked />
                    Incluir acessos de culturas consorciadas
                  </label>
                </div>
              </td>
            </tr>
            <!--
            <tr>
              <td colspan="3">
                Medidas repetidas: <br />
                <select class="wizard-download-repetitive-measurements-type form-control" disabled>
                  <option value="first">Primeiro valor</option>
                  <option value="last">Último valor</option>
                  <option value="average" selected>Valor médio</option>
                  <option value="sum">Soma dos valores</option>
                  <option value="all_values_single_line">Todos os valores em uma linha</option>
                  <option value="all_values_multiple_line">Todos os valores em várias linhas</option>
                </select>
              </td>
            </tr>
            !-->
            <tr>
              <td style="border-top: none; padding-top: 0">
                De:<br /><input type="text" class="wizard-download-start-date form-control" id="phenotype_start_date" title="phenotype_start_date"  />
              </td>
              <td style="border-top: none; padding-top: 0">
                Até:<br /><input type="text" class="wizard-download-end-date form-control" id="phenotype_end_date" title="phenotype_end_date" />
              </td>
              <td style="border-top: none; padding-top: 0">
                <input type="checkbox" id="include_dateless_items" checked="1" />
                Incluir itens sem data
              </td>
            </tr>
            <tr>
              <td>
                <span>Fenótipo de alta dimensionalidade</span>
              <select class="wizard-download-high-dim-phenotypes-type form-control input-sm">
                <option selected value="NIRS">NIRS</option>
              </select>
              </td>
              <td>
                <span>Comprimento de onda mínimo</span>
                <input placeholder="-&#8734;" type="text" class="wizard-download-high-dim-phenotypes-min form-control">
              </td>
              <td>
                <span>Comprimento de onda máximo</span>
                <input placeholder="&#8734;" type="text" class="wizard-download-high-dim-phenotypes-max form-control">
              </td>
            </tr>
          </table>
          <div class="panel-footer" style="border-top: 1px solid #ddd;">
            <button class="wizard-download-high-dim-phenotypes btn btn-sm btn-primary">
                <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                Baixar fenótipos
            </button>
          </div>
        </div>
      </div>
    </&>
  </div>

</div>

<script>
  window.sWizard = jsMod['wizard'].WizardSetup("#wizard");
</script>

<div class="modal fade" id="update_wizard_dialog" name="update_wizard_dialog" tabindex="-1" role="dialog" aria-labelledby="updateWizardDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h3 class="modal-title" id="updateWizardDialog">Atualizar assistente de pesquisa</h3>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	     <h4>Como funciona o assistente</h4>
          <p>Para oferecer pesquisas rápidas e flexíveis, o assistente armazena uma cópia dos dados em um formato temporário otimizado para suas consultas.</p><p>Essa cópia precisa ser atualizada regularmente. As atualizações geralmente começam quando novos dados são enviados, mas usuários com permissão de envio ou superior também podem iniciá-las manualmente.</p><p>Se nenhuma atualização estiver em andamento, você poderá iniciar uma abaixo. Ela será executada no servidor sem exigir outras ações. Dependendo do tamanho do banco de dados, poderá levar de alguns minutos a algumas horas.</p>
	<div><h4>Estado atual:</h4><p id="wizard_status"></p></div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="well well-sm" id="update_wizard_error" style="display:none;"></div>
        <button type="button" class="btn btn-primary wiz-update" name="update_wizard" data-loading-text="Processando..." id="update_wizard">Atualizar assistente de pesquisa</button>
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script>

  jQuery(document).ready(function (){
%  if ($dataset_id){
      document.getElementsByClassName("wizard-dataset-select")[0].value = <% $dataset_id %>;
      document.getElementsByClassName("wizard-dataset-load")[0].click();
%  }
   $(".wizard-download-genotypes-info2").hide();
   $(".wizard-download-genotypes-info3").hide();
   $(".wizard-download-genotypes-info4").hide();
   setDefaultPhenoDownloadOptions();
  });

  function setDefaultPhenoDownloadOptions() {
    var default_repeat_measurements = "<% $default_repeat_measurements %>";
    var default_include_timestamps = <% $default_include_timestamps %>;
    var default_include_intercrop_accessions = <% $default_include_intercrop_accessions %>;
    var default_include_entry_numbers = <% $default_include_entry_numbers %>;
    var default_include_trait_synonyms = <% $default_include_trait_synonyms %>;
    var default_supress_outliers = <% $default_supress_outliers %>;
    var default_include_pedigree_parents = <% $default_include_pedigree_parents %>;

    jQuery(".wizard-download-repetitive-measurements-type").each(function() { jQuery(this).val(default_repeat_measurements) });
    jQuery(".wizard-download-phenotypes-timestamp").each(function() { jQuery(this).prop('checked', default_include_timestamps === 1) });
    jQuery(".wizard-download-phenotypes-entry-numbers").each(function() { jQuery(this).prop('checked', default_include_entry_numbers === 1) });
    jQuery(".wizard-download-phenotypes-trait-synonyms").each(function() { jQuery(this).prop('checked', default_include_trait_synonyms === 1) });
    jQuery(".wizard-download-phenotypes-intercrop").each(function() { jQuery(this).prop('checked', default_include_intercrop_accessions === 1) });
    jQuery(".wizard-download-phenotypes-outliers").each(function() { jQuery(this).prop('checked', default_supress_outliers === 1) });
    jQuery(".wizard-download-phenotypes-pedigree_parents").each(function() { jQuery(this).prop('checked', default_include_pedigree_parents === 1) });
  }

  d3.select('#update_wizard_show').on('click', function () {
    $('#update_wizard_dialog').modal("show");
    jsMod['wizard'].updateStatus("#wizard_status")
      .then(function(isLoading){
        if(isLoading) {
          d3.select("#update_wizard")
          .attr("title","Uma atualização do assistente de pesquisa já está em andamento...")
          .attr("disabled",true);
        }
        else {
          d3.select("#update_wizard")
          .attr("title","Atualize o assistente de pesquisa para incluir os dados recém-enviados")
          .attr("disabled",null)
        }
      });
  });

  d3.select("#update_wizard").on('click',function(){
    jsMod['wizard'].refreshMatviews("fullview",this);
  });

  d3.select("#update_wizard_lists").on('click',function(){
    window.sWizard.reload_lists();
  });


  // Wizard Callback: get archived vcf files available for selected genotyping protocol / project
  window.sWizard.wizard.on_change(function(categories, selections, operations) {
    var protocols = (selections.genotyping_protocols || []).map((i) => i.id);
    var projects = (selections.genotyping_projects || []).map((i) => i.id);
    if ( protocols.length === 0 && projects.length === 0 ) {
      updateArchivedVCFFiles({ no_geno_selected: true });
    }
    else {
      updateArchivedVCFFiles({ loading: true });
      jQuery.ajax({
        url: '/ajax/genotyping_project/has_archived_vcf',
        method: 'GET',
        data: {
          genotyping_protocol_id: !projects || projects.length === 0 ? (protocols.length > 0 ? protocols.join(',') : undefined) : undefined,
          genotyping_project_id: projects.length > 0 ? projects.join(',') : undefined,
          limit: true
        },
        error: function(response) {
          console.log(`ERRO: não foi possível consultar os arquivos VCF arquivados no banco de dados [protocolos: ${protocols.join(',')}, projects: ${projects.join(',')}]`);
          console.log(response);
          updateArchivedVCFFiles({ error: true });
        },
        success: function(response) {
          updateArchivedVCFFiles({ data: response });
        }
      });
    }
  });
  updateArchivedVCFFiles({ no_geno_selected: true });

  // Set the display of the Dados genotípicos armazenados section
  function updateArchivedVCFFiles({ no_geno_selected = false, loading = false, error = false, data = {} } = {}) {
    let html = '';
    if ( no_geno_selected ) {
      html += "<p style='text-align: center; margin: 15px; font-size: 90%'>Selecione um ou mais <em>protocolos de genotipagem</em> e/ou <em>projetos de genotipagem</em>...</p>";
    }
    else if ( loading ) {
      html += "<p style='text-align: center; margin: 15px'>Carregando...</p>";
    }
    else if ( error ) {
      html += "<p style='text-align: center; margin: 15px'>Erro: não foi possível verificar os arquivos armazenados</p>";
    }
    else if ( data ) {
      html += "<table class='table table-hover table-striped'>";
      html += "<thead><tr><th>Protocolo</th><th>Projeto</th><th>Arquivo VCF</th></tr></thead>";
      html += "<tbody>";
      Object.keys(data).forEach((proj_id) => {
        const files = data[proj_id];
        files.forEach((file) => {
          html += "<tr>";
          html += `<td><a href="/breeders_toolbox/protocol/${file.genotyping_protocol_id}" target="_blank">${file.genotyping_protocol_name}</td>`;
          html += `<td><a href="/breeders/trial/${file.genotyping_project_id}" target="_blank">${file.genotyping_project_name}</td>`;
          if ( file.exists === 'true' ) {
            html += `<td><a href="/ajax/genotyping_project/download_archived_vcf?genotyping_project_id=${file.genotyping_project_id}&basename=${file.basename}" target="_blank">Baixar</a></td>`;
          }
          else {
            html += "<td>Arquivo não encontrado</td>";
          }
          html += "</tr>";
        });
      });
      html += "</tbody>";
      html += "</table>";
    }

    jQuery('#wiz-down-1-c-a-body').html(html);
  }

  // Wizard Callback: get chromosome names for a single selected genotyping protocol
  var SELECTED_GENOTYPING_PROTOCOL = undefined;
  var SELECTED_GENOTYPING_PROJECT = undefined;
  var SELECTED_ACCESSIONS = undefined;
  var num_markers = 0;
  var download_units = 0;
  window.sWizard.wizard.on_change(function(categories, selections, operations) {
    var selected_genotyping_protocols = selections.hasOwnProperty('genotyping_protocols') ? selections.genotyping_protocols : [];
    var selected_genotyping_projects = selections.hasOwnProperty('genotyping_projects') ? selections.genotyping_projects : [];
    var selected_accessions = selections.hasOwnProperty('accessions') ? selections.accessions : [];
    selected_accessions = selected_accessions.length;
    if ( selected_genotyping_protocols.length >= 1 ) {
      $(".wizard-download-genotypes-info3").hide();
      var selected_genotyping_protocol = selected_genotyping_protocols.length === 1 ? selected_genotyping_protocols[0].id : "";
      if ( selected_genotyping_protocol != SELECTED_GENOTYPING_PROTOCOL ) {
        SELECTED_GENOTYPING_PROTOCOL = selected_genotyping_protocol;
        jQuery.ajax({
          url: '/ajax/breeder/search/genotyping_protocol_chromosomes',
          method: "GET",
          data: { 'genotyping_protocol': SELECTED_GENOTYPING_PROTOCOL },
          error: function(response) {
            console.log("ERRO: não foi possível obter os nomes dos cromossomos do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
            console.log(response);
            updateChromosomeNames();
          },
          success: function(response) {
            if (response.error) {
              console.log("ERRO: o servidor retornou um erro ao obter os nomes dos cromossomos do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
              console.log(repsonse.error);
              updateChromosomeNames();
            } else {
              updateChromosomeNames(response.chromosome_names);
            }
          }
        });
        jQuery.ajax({
          url: '/ajax/genotyping_protocol/num_markers',
          method: "GET",
          data: { 'protocol_ids': SELECTED_GENOTYPING_PROTOCOL },
          error: function(response) {
            console.log("ERRO: não foi possível obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
            console.log(response);
          },
          success: function(response) {
            if (response.error) {
              console.log("ERRO: o servidor retornou um erro ao obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
              console.log(repsonse.error);
            } else {
              num_markers = response.data;
            }
          }
        });
      }
      if ( selected_genotyping_protocols.length > 1 ) {
        $(".wizard-download-genotypes-info2").show();
        $(".wizard-download-genotypes-info2").val("Há protocolos de genotipagem demais");
      } else {
        $(".wizard-download-genotypes-info2").hide();
      }
    } else if ( selected_genotyping_projects.length >= 1 ) {
      var selected_genotyping_project = selected_genotyping_projects[0].id;
      if ( selected_genotyping_project !== SELECTED_GENOTYPING_PROJECT ) {
        SELECTED_GENOTYPING_PROJECT = selected_genotyping_project;
        jQuery.ajax({
          url: '/ajax/genotyping_project/protocols',
          method: "GET",
          data: { 'genotyping_project_id': SELECTED_GENOTYPING_PROJECT },
          error: function(response) {
            console.log("ERRO: não foi possível obter o protocolo do projeto de genotipagem nº" + SELECTED_GENOTYPING_PROJECT);
            console.log(response);
          },
          success: function(response) {
            if (response.error) {
              console.log("ERRO: o servidor retornou um erro ao obter o protocolo do projeto de genotipagem nº" + SELECTED_GENOTYPING_PROJECT);
              console.log(response.error);
            }
            else {
              genotyping_protocol = response.data;
              SELECTED_GENOTYPING_PROTOCOL = genotyping_protocol[0]["protocol_id"];
              // console.log(genotyping_protocol[0]["protocol_id"]);
              // console.log(genotyping_protocol[0]["protocol_name"]);
              if ( selected_genotyping_protocols.length < 1 ) {
                $(".wizard-download-genotypes-info3").show();
                $(".wizard-download-genotypes-info3").val("protocolo de genotipagem \"" + genotyping_protocol[0]["protocol_name"] + "\"");
              }
            }
            jQuery.ajax({
              url: '/ajax/breeder/search/genotyping_protocol_chromosomes',
              method: "GET",
              data: { 'genotyping_protocol': SELECTED_GENOTYPING_PROTOCOL },
              error: function(response) {
                console.log("ERRO: não foi possível obter os nomes dos cromossomos do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                console.log(response);
                updateChromosomeNames();
              },
              success: function(response) {
                if (response.error) {
                  console.log("ERRO: o servidor retornou um erro ao obter os nomes dos cromossomos do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                  console.log(repsonse.error);
                  updateChromosomeNames();
                } else {
                  updateChromosomeNames(response.chromosome_names);
                }
              }
            });
            // console.log("calling ajax " + SELECTED_GENOTYPING_PROTOCOL);
            jQuery.ajax({
              url: '/ajax/genotyping_protocol/num_markers',
              method: "GET",
              data: { 'protocol_ids': SELECTED_GENOTYPING_PROTOCOL },
              error: function(response) {
                console.log("ERRO: não foi possível obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                console.log(response);
              },
              success: function(response) {
                if (response.error) {
                  console.log("ERRO: o servidor retornou um erro ao obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                  console.log(repsonse.error);
                } else {
                  num_markers = response.data;
                }
             }
            });
          }
        });
      }
    } else {
      var protocol_name = '<% $c->config->{default_genotyping_protocol} %>';
      $(".wizard-download-genotypes-info3").show();
      $(".wizard-download-genotypes-info3").val("protocolo de genotipagem \"" + protocol_name + "\"");
      jQuery.ajax({
          url: '/get/genotyping/protocols/',
          method: "POST",
          dataType: "json",
          error: function(response) {
            console.log("ERRO: não foi possível obter o protocolo de genotipagem");
            console.log(response);
          },
          success: function(response) {
           if (response.error) {
              console.log("ERRO: o servidor retornou um erro ao obter o protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
              console.log(repsonse.error);
            } else {
              SELECTED_GENOTYPING_PROTOCOL = response.default_protocol.protocol_id;
              jQuery.ajax({
                url: '/ajax/genotyping_protocol/num_markers',
                method: "GET",
                data: { 'protocol_ids': SELECTED_GENOTYPING_PROTOCOL },
                error: function(response) {
                  console.log("ERRO: não foi possível obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                  console.log(response);
                },
                success: function(response) {
                  if (response.error) {
                    console.log("ERRO: o servidor retornou um erro ao obter os marcadores do protocolo de genotipagem nº" + SELECTED_GENOTYPING_PROTOCOL);
                    console.log(repsonse.error);
                  } else {
                    num_markers = response.data;
                  }
               }
              });
            }
          }
      });
    }
    if ( selected_accessions !== SELECTED_ACCESSIONS ) {
      SELECTED_ACCESSIONS = selected_accessions;
      download_units = parseInt((num_markers * selected_accessions) / 1000000);
      if (download_units > 1) {
            $(".wizard-download-genotypes-info4").show();
            $(".wizard-download-genotypes-info4").val(download_units + " milhões de valores; o download será lento");
            // console.log("download units " + download_units);
      } else {
            $(".wizard-download-genotypes-info4").hide();
            $(".wizard-download-genotypes-info4").val(download_units.toString());
      }
    }
  });
  // updateChromosomeNames();

  // Set the chromosome names for the select dropdown menu
  function updateChromosomeNames(names) {
    var html = "";
    if ( names )  {
      html += "<option value=''>Todos</option>";
      for ( var i = 0; i < names.length; i++ ) {
        html += "<option value='" + names[i] + "'>" + names[i] + "</option>";
      }
    }
    $(".wizard-download-genotypes-chromosome-number").html(html);
  }

  jQuery('input[title="phenotype_start_date"]').daterangepicker(
   {
       "singleDatePicker": true,
       "showDropdowns": true,
       "autoUpdateInput": true,
       "startDate": "1960-01-01",
       "yearSelect" : true,
       "minDate": "1960-01-01",
       "maxDate": "2030-12-31",
       locale: {
        format: 'YYYY-MM-DD',
        applyLabel: 'Aplicar',
        cancelLabel: 'Cancelar',
        fromLabel: 'De',
        toLabel: 'Até',
        customRangeLabel: 'Intervalo personalizado',
        weekLabel: 'Sem.',
        daysOfWeek: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'],
        monthNames: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro']
      }
   },

);


jQuery('input[title="phenotype_end_date"]').daterangepicker(
   {
       "singleDatePicker": true,
       "showDropdowns": true,
       "autoUpdateInput": true,
       //"startDate": "1960-01-01",
       "yearSelect" : true,
       "minDate": "1960-01-01",
       "maxDate": "2030-12-31",
       locale: {
        format: 'YYYY-MM-DD',
        applyLabel: 'Aplicar',
        cancelLabel: 'Cancelar',
        fromLabel: 'De',
        toLabel: 'Até',
        customRangeLabel: 'Intervalo personalizado',
