<%args>
$protocol_id
$protocol_name
$protocol_description
$marker_names => []
$header_information_lines => []
$reference_genome_name
$species_name
$create_date
$sample_observation_unit_type_name
$marker_type
$assay_type
</%args>

<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome do protocolo de genotipagem</b></td>
                <td>
                    <% $protocol_name %>
                </td>
            </tr>

            <tr>
                <td><b>Descrição do protocolo</b></td>
                <td>
                    <% $protocol_description %>
                </td>
            </tr>

            <tr><td><b>Tipo de ensaio</b></td>
                <td>
                    <% $assay_type %>
                </td>
            </tr>

            <tr>
                <td><b>Tipo de marcador</b></td>
                <td>
                    <% $marker_type %>
                </td>
            </tr>

            <tr>
                <td><b>Número de marcadores</b></td>
                <td>
%                   print scalar(@$marker_names);
                </td>
            </tr>

            <tr>
                <td><b>Descrição das informações do cabeçalho</b></td>
                <td>
% my @trimmed;
% my $header_line_count = 0;
% foreach (@$header_information_lines){
%    if ($header_line_count < 10) {
%        $_ =~ tr/<>//d;
%        push @trimmed, $_;
%    }
%    else {
%        push @trimmed, "### ----- EXIBINDO SOMENTE AS 10 PRIMEIRAS LINHAS ----- ###";
%        last;
%    }
%    $header_line_count++;
% }
% my $description = join '<br/>', @trimmed;
% $description = $description ? $description : 'N/D';
% print "$description";
                </td>
            </tr>

            <tr><td><b>Genoma de referência</b></td>
                <td>
                    <% $reference_genome_name %>
                </td>
            </tr>

            <tr><td><b>Nome da espécie</b></td>
                <td>
                    <% $species_name %>
                </td>
            </tr>

            <tr><td><b>Unidade amostral</b></td>
                <td>
                    <% $sample_observation_unit_type_name %>
                </td>
            </tr>

            <tr><td><b>Data de criação</b></td>
                <td>
                    <% $create_date %>
                </td>
            </tr>

        </table>

    </div>
</div>
