<%args>
$protocol_id
</%args>

<button class="btn btn-danger" id="genotyping_protocol_detail_page_delete">Excluir dados de genotipagem deste protocolo</button>

<script>

jQuery('#genotyping_protocol_detail_page_delete').click(function(){
    if (confirm("Tem certeza de que deseja excluir este protocolo de genotipagem? Esta ação não pode ser desfeita!")) {
        jQuery.ajax ({
            url : '/ajax/genotyping_protocol/delete/<% $protocol_id %>',
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert('Protocolo de genotipagem excluído!');
                    window.location.replace("/search/genotyping_protocols");
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Erro ao excluir o protocolo de genotipagem!');
            }

        });
    }
});

</script>
