
<%doc>

=head1 NAME

/breeders_toolbox/trial.mas - a mason component to display a genotyping protocol detail page

=head1 AUTHOR

=cut

</%doc>

<%args>
$protocol_id
$protocol_name
$protocol_description
$marker_names
$header_information_lines
$reference_genome_name
$species_name
$sample_observation_unit_type_name
$create_date
$marker_type
$marker_info_headers
$assay_type
$map_details_protocolprop_id
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min'] &>

<br/>

<& /page/page_title.mas, title=>"Detalhes do protocolo de genotipagem ".$protocol_name &>

% if ($map_details_protocolprop_id) {
    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Detalhes do protocolo de genotipagem</h4>", info_section_subtitle => 'Visualize as informações básicas do protocolo de genotipagem.',buttons_html => '<button class="btn btn-primary btn-sm" id="edit_genotyping_protocol_details" style="margin:3px">Editar detalhes do protocolo de genotipagem</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_protocol_details", protocol_name => $protocol_name, protocol_description => $protocol_description, marker_names => $marker_names, header_information_lines => $header_information_lines, reference_genome_name => $reference_genome_name, species_name => $species_name, create_date => $create_date, sample_observation_unit_type_name => $sample_observation_unit_type_name, marker_type => $marker_type, assay_type => $assay_type &>
% } else {
    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Detalhes do protocolo de genotipagem</h4>", info_section_subtitle => 'Visualize as informações básicas do protocolo de genotipagem.', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_protocol_details", protocol_name => $protocol_name, protocol_description => $protocol_description, marker_names => $marker_names, header_information_lines => $header_information_lines, reference_genome_name => $reference_genome_name, species_name => $species_name, create_date => $create_date, sample_observation_unit_type_name => $sample_observation_unit_type_name, marker_type => $marker_type, assay_type => $assay_type &>
%}
% if ($marker_type eq 'SSR') {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Marcadores</h4>", info_section_subtitle => 'Visualize as informações dos marcadores usados neste protocolo.', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "pcr_based_genotyping_markers" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Metadados dos marcadores</h4>", info_section_subtitle => 'Visualize os metadados atribuídos aos marcadores deste protocolo.', icon_class => "glyphicon glyphicon-tags", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_names => $marker_names, info_section_title => "<h4 style='display:inline'>Dados de genótipos</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem deste protocolo.',buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="download_ssr_data_link">Baixar dados SSR</button>', icon_class => "glyphicon glyphicon-save-file", info_section_id => "pcr_genotyping_protocol_genotype_data" &>
% } elsif ($assay_type eq 'KASP') {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_info_headers => $marker_info_headers, info_section_title => "<h4 style='display:inline'>Marcadores</h4>", info_section_subtitle => 'Visualize as informações dos marcadores usados neste protocolo.', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "genotyping_protocol_markers", buttons_html => '<button class="btn btn-primary btn-sm" id="download_protocol_marker_info" style="margin:3px">Baixar todas as informações dos marcadores (CSV)</button>' &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Metadados dos marcadores</h4>", info_section_subtitle => 'Visualize os metadados atribuídos aos marcadores deste protocolo.', icon_class => "glyphicon glyphicon-tags", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Dados de genótipos</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem deste protocolo.', icon_class => "glyphicon glyphicon-save-file", info_section_id => "genotyping_protocol_genotype_data", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_vcf">Baixar todos os dados de genótipos em VCF</button><button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_dosagematrix">Baixar todos os dados de genótipos como matriz de dosagem</button><button class="btn btn-default" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_csv">Baixar todos os dados de genótipos (CSV)</button>' &>
% } else {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_info_headers => $marker_info_headers, info_section_title => "<h4 style='display:inline'>Marcadores</h4>", info_section_subtitle => 'Visualize as informações dos marcadores usados neste protocolo.', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "genotyping_protocol_markers"&>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Metadados dos marcadores</h4>", info_section_subtitle => 'Visualize os metadados atribuídos aos marcadores deste protocolo.', icon_class => "glyphicon glyphicon-tags", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Dados de genótipos</h4>", info_section_subtitle => 'Visualize e baixe os dados de genotipagem deste protocolo.', icon_class => "glyphicon glyphicon-save-file", info_section_id => "genotyping_protocol_genotype_data", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_vcf">Baixar todos os dados de genótipos em VCF</button><button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_dosagematrix">Baixar todos os dados de genótipos como matriz de dosagem</button>' &>
% }


% if ($c->user() && $c->user()->has_role("curator")) {
<& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>Excluir protocolo de genotipagem e todos os dados</h4>", info_section_subtitle => 'Exclua o protocolo de genotipagem e todos os dados associados.', icon_class => "glyphicon glyphicon-trash", info_section_id => "genotyping_protocol_delete_genotype_data" &>
% }


<& /breeders_toolbox/genotyping_protocol/edit_genotyping_protocol_details_dialog.mas, protocol_id => $protocol_id, protocol_name => $protocol_name, protocol_description => $protocol_description, reference_genome_name => $reference_genome_name, species_name => $species_name, sample_observation_unit_type_name => $sample_observation_unit_type_name, assay_type => $assay_type &>
