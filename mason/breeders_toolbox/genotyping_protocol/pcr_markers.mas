<%args>
$protocol_id
</%args>

<table id="pcr_protocol_markers_table" class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>Nome do marcador</th>
            <th>Tamanhos dos produtos</th>
            <th>Primer direto</th>
            <th>Primer reverso</th>
            <th>Temperatura de anelamento</th>
            <th>Motivo da sequência</th>
            <th>Origem da sequência</th>
            <th>Grupo de ligação</th>
        </tr>
    </thead>
    </tbody>
</table>

<script>

jQuery(document).ready(function(){

    var pcr_genotyping_protocol_table = jQuery('#pcr_protocol_markers_table').DataTable({
        'autoWidth': false,
        'ajax': {'url': '/ajax/genotyping_protocol/pcr_markers',
                 'data': function(d) {
                    d.protocol_id = <% $protocol_id %>;
                }
        },
    });

});


</script>
