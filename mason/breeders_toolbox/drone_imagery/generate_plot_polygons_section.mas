<%args>
$id_extension => ''
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="well well-sm">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Número de linhas: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_rows<% $id_extension %>" name="drone_imagery_plot_polygons_num_rows<% $id_extension %>" type="number" placeholder="Número de linhas na seção da imagem" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">Número de colunas: </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_cols<% $id_extension %>" name="drone_imagery_plot_polygons_num_cols<% $id_extension %>" type="number" placeholder="Número de colunas na seção da imagem"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4>Clique nos quatro cantos da área de interesse:</h4>

                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_left_click<% $id_extension %>">Clicar no canto superior esquerdo</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_right_click<% $id_extension %>">Clicar no canto superior direito</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_left_click<% $id_extension %>">Clicar no canto inferior esquerdo</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_right_click<% $id_extension %>">Clicar no canto inferior direito</button>
                </div>
            </div>
            <hr>
        
            <&| /page/info_section.mas, title => 'Parâmetros do modelo', collapsible=>1, collapsed => 1, subtitle=> 'Visualize e edite os parâmetros do modelo. Eles podem ser preenchidos pelos botões acima.' &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem superior da coluna mais à esquerda: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem inferior da coluna mais à esquerda: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem esquerda da linha superior: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" type="number" placeholder="Deslocamento esquerdo da seção da imagem" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem direita da linha superior: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" type="number" placeholder="Deslocamento direito da seção da imagem" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem esquerda da linha inferior: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" type="number" placeholder="Deslocamento esquerdo da seção da imagem" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Margem inferior da coluna mais à direita: </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" type="number" placeholder="Deslocamento inferior da coluna mais à direita" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </&>

            <br/>
            <button class="btn btn-sm btn-primary" id="drone_imagery_plot_polygons_rectangles_apply<% $id_extension %>">Desenhar modelo de polígonos das parcelas (não salva; aplique vários modelos se necessário)</button>

        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4>Ou cole um modelo usado anteriormente:</h4>
                </div>
            </div>

            <&| /page/info_section.mas, title => 'Modelos de polígonos de parcelas usados anteriormente', collapsible=>1, collapsed => 1, subtitle=> 'Visualize e use modelos aplicados anteriormente neste ensaio de campo.' &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">Modelos usados anteriormente neste ensaio de campo: </label>
                                    <div class="col-sm-6">
                                        <div id="plot_polygons_previously_saved_plot_polygon_templates<% $id_extension %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <button class="btn btn-primary" id="plot_polygons_use_previously_saved_template<% $id_extension %>">Desenhar modelo de polígonos das parcelas (não salva)</button>
                </div>
            </&>
        </div>
    </div>

    <div id="drone_imagery_plot_polygons_active_templates<% $id_extension %>"></div>

</div>
