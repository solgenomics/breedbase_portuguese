<%args>
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<& /util/import_css.mas, paths => [ ] &>

<& /page/page_title.mas, title=>"Gerenciar geração de identificadores" &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <p>Muitas vezes é necessário criar identificadores antecipadamente. Este recurso é usado no ACAI e no projeto Banana Agronomy para imprimir previamente identificadores com código de barras, que depois são atribuídos a ensaios no campo. Também pode ser usado para imprimir previamente identificadores que serão atribuídos a amostras no laboratório.</p>
        </div>
    </div>
</div>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Identificadores disponíveis</h4>", info_section_subtitle => 'Visualize, adicione e baixe identificadores.', buttons_html => '<button class="btn btn-primary btn-sm" id="add_new_identifier_button" style="margin:3px">Adicionar novo identificador</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "identifier_generation_list" &>

<div class="modal fade" id="add_new_identifier_dialog" name="add_new_identifier_dialog" tabindex="-1" role="dialog" aria-labelledby="addNewIdentifierDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addNewIdentifierDialog">Adicionar novo identificador</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" id="create_new_identifier_form" name="create_new_identifier_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Nome: </label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_list_name" name="new_identifier_list_name" type="text" placeholder="Por exemplo: Identificadores_ACTLNG"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Prefixo: </label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_prefix" name="new_identifier_prefix" type="text" placeholder="Por exemplo: ACTLNG"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Número de dígitos: </label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_num_digits" name="new_identifier_num_digits" type="number" placeholder="Por exemplo: 6. Com os exemplos, o primeiro identificador seria ACTLNG000001" value="6"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Número atual do identificador: </label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_current_num" name="new_identifier_current_num" type="number" placeholder="Por exemplo: 101. Com os exemplos, o próximo identificador seria ACTLNG000101" value="1"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Descrição: </label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_description" name="new_identifier_description" type="text" placeholder="Descrição da finalidade do identificador" />
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" id="new_identifier_submit_button">Enviar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){
    jQuery('#add_new_identifier_button').click(function(){
        jQuery('#add_new_identifier_dialog').modal('show');
    });

    jQuery('#new_identifier_submit_button').click(function(){
        var identifier_list_name = jQuery('#new_identifier_list_name').val();
        var identifier_prefix = jQuery('#new_identifier_prefix').val();
        var num_digits = jQuery('#new_identifier_num_digits').val();
        var current_number = jQuery('#new_identifier_current_num').val();
        var description = jQuery('#new_identifier_description').val();
        jQuery.ajax({
            url : '/ajax/breeders/new_identifier_generation',
            data : {
                'identifier_name':identifier_list_name,
                'identifier_prefix':identifier_prefix,
                'num_digits':num_digits,
                'current_number':current_number,
                'description':description
            },
            success: function(response){
                console.log(response);
                if(response.error){
                    alert(response.error);
                }
                if(response.success){
                    alert(response.success);
                }
            },
            error: function(response){
                alert('Erro ao enviar o novo identificador!');
            }
        });
    });
});

</script>
