
<%args>
$trial_id 
</%args>

<div id="data_agreement_div">

</div>

<script>

jQuery(document).ready(function () {

    get_data_agreement(<% $trial_id %>, 'data_agreement_div');

    function get_data_agreement(project_id, div) { 
      jQuery.ajax( { 
        async: true,
        url: '/breeders/trial/data_agreement/get',
        data: { 'project_id': project_id },
        success: function(response) {
           if (response.text) { 
             jQuery('#'+div).html(response.text);
           }
           else { 
             jQuery('#'+div).html('Por padrão, os dados do ensaio são fornecidos nos termos do Acordo de Toronto, conforme explicado na <a href="/usage_policy">política de uso de dados</a>.');
           }
           if (response.message) { alert(response.message); }
        },
        error: function(response) { 
           alert('Ocorreu um erro ao obter os dados do acordo de uso.');
        }
      });
    }

});


</script>
