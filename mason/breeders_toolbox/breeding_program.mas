
<%args>
$program
$user => undef
</%args>

<%perl>
my $delete_flag = 0;
if ($user && $user->check_roles("curator")) {
    $delete_flag = 1;
}

my $program_name = $program->get_name;
my $program_id   = $program->get_program_id;
</%perl>


<& /page/page_title.mas, title=>"Programa de melhoramento $program_name" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, program_id => $program_id, info_section_title => "<h4 style='display:inline'>Metadados de nomes gerados automaticamente</h4>", info_section_subtitle => 'Visualize formatos de nomes gerados automaticamente, últimos números de série e descrições', icon_class => "glyphicon glyphicon-text-color", buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_autogenerated_name_metadata_link_program_page" name="add_autogenerated_name_metadata_link" >Adicionar metadados de nomes gerados automaticamente</button>', info_section_id => "autogenerated_name_metadata_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, program_id => $program_id, program_name => $program_name, info_section_title => "<h4 style='display:inline'>Perfis de produto</h4>", info_section_subtitle => 'Visualize os perfis de produto',buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_profile_button">Enviar novo perfil de produto</button><button class="btn btn-sm btn-default" style="margin:3px" id="download_template_button">Baixar modelo</button>', icon_class => "glyphicon glyphicon-signal", info_section_id => "program_product_profile_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, program_id => $program_id, info_section_title => "<h4 style='display:inline'>Locais</h4>", info_section_subtitle => 'Visualize os locais relacionados a este programa de melhoramento', icon_class => "glyphicon glyphicon-pushpin", info_section_id => "program_location_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, program_id => $program_id, info_section_title => "<h4 style='display:inline'>PROJETOS</h4>", info_section_subtitle => 'Visualize ensaios de campo, experimentos de genotipagem e experimentos de cruzamento', icon_class => "glyphicon glyphicon-th", info_section_id => "program_project_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, program_id => $program_id, info_section_title => "<h4 style='display:inline'>Materiais</h4>", info_section_subtitle => 'Visualize acessos, cruzamentos e lotes de sementes', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "program_stock_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, program_id => $program_id, info_section_title => "<h4 style='display:inline'>Resumo dos fenótipos</h4>", info_section_subtitle => 'Visualize o resumo e o histograma dos fenótipos', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "program_phenotype_section" &>

<& /breeders_toolbox/program/create_profile_template_dialog.mas &>
<& /breeders_toolbox/program/upload_profile_dialog.mas, program_id => $program_id, program_name => $program_name &>
<& /breeders_toolbox/program/add_autogenerated_name_metadata_dialog.mas, program_id => $program_id, program_name => $program_name &>

<!--

<&| /page/info_section.mas, id=>"program_trials", title => "Ensaios" , collapsible=>1, collapsed=>0, hide_if_empty=>1 &>
    <& /breeders_toolbox/program/trials.mas, program_id => $program_id &>
</&>

<&| /page/info_section.mas, id=>"program_accessions", title=>"Acessos", collapsible=>1, collapsed=>0, hide_if_empty=>1 &>
  <& /breeders_toolbox/program/program_accessions.mas, program_id => $program_id &>
</&>

<&| /page/info_section.mas, id=>"program_traits_assayed", title => "Características testados" , collapsible=>1, collapsed=>0, hide_if_empty=>1 &>
  <& /breeders_toolbox/program/traits.mas, program_id => $program_id, collapse_phenotypes_section => 0  &>
</&>

-->

<script>

jQuery(document).ready(function () {

    jQuery('#download_template_button').click(function(){
        var list = new CXGN.List();
        var trait_lists = list.listSelect('select_list', ['traits'], 'Selecione uma lista', undefined, undefined);
        jQuery('#select_list_div').html(trait_lists);

        jQuery('#create_profile_template_dialog').modal("show");

    })

    jQuery('#upload_profile_button').click(function(){

        jQuery('#upload_profile_dialog').modal("show");

    })

});

</script>
