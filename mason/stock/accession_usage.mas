<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /page/page_title.mas, title=>'Uso dos acessos' &>

<&| /page/info_section.mas, title => 'Uso dos acessos em ensaios', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_trials" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>Nome do acesso</th>
    <th>Número de ensaios</th>
    <th>Número total de parcelas</th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => 'Uso dos acessos como genitor feminino', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_female" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>Nome do acesso</th>
    <th>Número de progênies</th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=female_parent" class="btn btn-sm btn-default">Baixar</a>

</&>

<&| /page/info_section.mas, title => 'Uso dos acessos como genitor masculino', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_male" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>Nome do acesso</th>
    <th>Número de progênies</th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=male_parent" class="btn btn-sm btn-default">Baixar</a>

</&>

<&| /page/info_section.mas, title => 'Desempenho fenotípico dos acessos', collapsible=>1, collapsed=>0 &>

<div class="well">
    <div class="panel panel-default">
        <div class="panel-body">

            <table id="accession_usage_phenotypes" class='table table-bordered table-hover'>
                <thead>
                    <tr>
                        <th>Acesso</th>
                        <th>Variável de observação</th>
                        <th>Média</th>
                        <th>Mín.</th>
                        <th>Máx.</th>
                        <th>Desvio padrão</th>
                        <th>CV</th>
                        <th>Quantidade</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

</&>

<script>

jQuery(document).ready(function(){

  jQuery('#accession_usage_trials').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_trials'
  });


  jQuery('#accession_usage_female').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_female'
  });


  jQuery('#accession_usage_male').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_male'
  });

  var stock_table = jQuery('#accession_usage_phenotypes').DataTable({
      'destroy' : true,
      'searching' : false,
      'ordering'  : false,
      'processing': true,
      'serverSide': true,
      'lengthMenu': [10,20,50,100,1000,5000],
      'ajax': { 'url':  '/ajax/accession_usage_phenotypes?display=plots_accession' }
  });

});

</script>
