<%doc>
=head1 NAME

stockprops.mas

=head1 DESCRIPTION

This component can print stock properties


=head1 ARGUMENTS

=over 1

=item props
hashref of stockprops . keys = prop name (cvterm.name) values = list of prop values

=back

=head1 AUTHOR
Naama Menda <nm249@cornell.edu>


=cut

</%doc>

<%args>
  $stock_id
  $form_div_id
  $subset => [  'released_variety_name' ]
  $props
  $editable => []
  $div_name => ''
  $edit_privs => 0
</%args>
<& /util/import_javascript.mas,
   classes => ["jquery", "jqueryui", "CXGN.Page.FormattingHelpers",  "CXGN.Stock" ],
&>

<%perl>
use JSON::Any;
use CXGN::Page::FormattingHelpers qw | simple_selectbox_html simple_checkbox_html |;

my $subset_json = JSON::Any->objToJson($subset);


$div_name ||= join("_", @$subset);
$div_name =~ s/ +/\_/g;

$edit_privs ||= 0;

my $prop_select = simple_selectbox_html(
     name => $div_name."_select",
     id => $div_name."_select",
     choices => $editable
);


</%perl>

<div id="<% $div_name %>_content">
</div>


<div class ="modal fade" id="<% $div_name %>_add_dialog" name="<% $div_name %>_add_dialog" tabindex="-1" role="dialog" aria-labelledby="add<% $div_name %>Dialog">

  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header" style="text-align: center">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="add<% $div_name %>Dialog">Adicionar propriedade</h4>
      </div>
      <div class="modal-body">
	<div class="container-fluid">
	  
          <form class="form-horizontal" role="form" method="post" id="add_<% $div_name %>_dialog_form" name="add_<% $div_name %>_dialog_form">
            <div class="form-group">
              <label class="col-sm-6 control-label"><% $prop_select %> </label><br />
	    </div>
	    <div class ="form-group">
              <div class="col-sm-6" >
                <textarea name="<% $div_name %>_prop" id="<% $div_name %>_prop" class="form-control" type="text"></textarea>
              </div>
            </div>

          </div>
        </div>
      
      <div class="modal-footer">
        <button id="close_add_<% $div_name %>_stockprop_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-primary" name="<% $div_name %>_addProp_submit" id="<% $div_name %>_addProp_submit" title="Enviar">Enviar</button>
      </div>
      </form>
    </div>
  </div>
</div>

<script defer="defer" >

jQuery(document).ready(function() {
   jQuery('#<% $div_name %>_select option').each(function() {
      var label = <% $div_name %>_propertyLabel(jQuery(this).val());
      jQuery(this).text(label).attr('title', label);
   });
   <% $div_name %>_getProps();


   jQuery('#<% $form_div_id %>').click(function(){
      jQuery('#<% $div_name %>_add_dialog').modal("show");
   });

   jQuery('#<% $div_name %>_addProp_submit').click( function () {
    <% $div_name %>_addProp() },
    );
});    
 
// note: the $div_name prefix is needed when several instances are created on a page

function <% $div_name %>_propertyLabel(name) {
  var labels = {
    stock_synonym: 'Sinônimo',
    'solcap number': 'Número SolCAP',
    variety: 'Variedade',
    released_variety_name: 'Nome da variedade lançada',
    donor: 'Doador',
    'donor institute': 'Instituição doadora',
    'donor PUI': 'Identificador permanente do doador',
    'country of origin': 'País de origem',
    state: 'Estado',
    'institute code': 'Código da instituição',
    'institute name': 'Nome da instituição',
    'biological status of accession code': 'Código do estado biológico do acesso',
    notes: 'Observações',
    'accession number': 'Número do acesso',
    PUI: 'Identificador permanente (PUI)',
    'seed source': 'Origem das sementes',
    'type of germplasm storage code': 'Código do tipo de armazenamento de germoplasma',
    'acquisition date': 'Data de aquisição',
    organization: 'Organização',
    location_code: 'Código do local',
    ploidy: 'Ploidia',
    ploidy_level: 'Nível de ploidia',
    genome_structure: 'Estrutura do genoma',
    ncbi_taxonomy_id: 'ID taxonômico do NCBI',
    transgenic: 'Transgênico',
    introgression_parent: 'Genitor de origem da introgressão',
    introgression_backcross_parent: 'Genitor de retrocruzamento da introgressão',
    introgression_map_version: 'Versão do mapa da introgressão',
    introgression_chromosome: 'Cromossomo da introgressão',
    introgression_start_position_bp: 'Posição inicial da introgressão (pb)',
    introgression_end_position_bp: 'Posição final da introgressão (pb)',
    number_of_insertions: 'Número de inserções',
    GenbankRecord: 'Registro no GenBank',
    catalog: 'Catálogo',
    Strain: 'Linhagem',
    CloningOrganism: 'Organismo hospedeiro da clonagem',
    InherentMarker: 'Marcador inerente',
    Backbone: 'Estrutura-base',
    SelectionMarker: 'Marcador de seleção',
    CassetteName: 'Nome do cassete',
    VectorType: 'Tipo de vetor',
    Gene: 'Gene',
    Promotors: 'Promotores',
    Terminators: 'Terminadores',
    PlantAntibioticResistantMarker: 'Marcador de resistência a antibióticos no hospedeiro',
    BacterialResistantMarker: 'Marcador de resistência bacteriana'
  };
  return Object.prototype.hasOwnProperty.call(labels, name) ? labels[name] : name;
}

function <% $div_name %>_getProps() {
  jQuery.ajax( {
    type: 'GET',
    url: '/stock/prop/get',
    data: { stock_id: <% $stock_id %> },
    success: function(response) { <% $div_name %>_renderProps(response);  },
    error: function(response) { alert('Ocorreu um erro'); }
  });
 
}

function <% $div_name %>_renderProps(props) {
   var subset = eval(<% $subset_json %>);

   // eliminate types without values
   var filteredSet = {};
   for (var n=0; n<subset.length; n++) {
     for (var i=0; i<props.length; i++) {
       if (subset[n] ==  props[i]['type_name']) {
         filteredSet[subset[n]]=1;
           }
       }
   }


   var html = '';
   var prop_string;
   var edit_privs = <% $edit_privs %>;
   for (var n in filteredSet) {
      var lines = new Array();
      for(var i=0; i<props.length; i++) {
        if (n ===  props[i]['type_name']) {
          var lineStr = props[i]['value'];
          if (jQuery.cookie("sgn_session_id") && edit_privs === 1) {
            lineStr = lineStr + '[<a href="javascript:<% $div_name %>_deleteProp(\''+props[i]['value']+'\', '+props[i]['stockprop_id']+')">X</a>]';
          }
	  lines.push(lineStr);
        }

      }
      html = html + '<b>'+<% $div_name %>_propertyLabel(n)+'</b>&nbsp;&nbsp;';
      //html  = html + lineStr;
      html = html + lines.join(", ");
      html = html + '<br />\n';
   }
   jQuery('#<% $div_name %>_content').html(html);

}



function <% $div_name %>_addProp() {
  var prop_type = jQuery('#<% $div_name %>_select').val();
  var prop = jQuery('#<% $div_name %>_prop').val();
  prop = prop.trim();
  if (prop === '') { alert("Preencha o campo."); return; }

  jQuery.ajax( {
    type: 'POST',
    url: '/stock/prop/add',
    beforeSend: function(){
        jQuery('#working_modal').modal('show');
    },
    data: { 'stock_id' : <% $stock_id %>, 'prop' : prop, 'prop_type': prop_type },
    success: function(response) {
        jQuery('#working_modal').modal('hide');
        if ("Erro" in response) { alert ('ERRO: '+response.error); }
        if ("message" in response) {
            alert('Propriedade adicionada com sucesso: ' + prop + '. ('+response.message+')');
        }
    },
    error: function(response) {
        jQuery('#working_modal').modal('hide');
        alert('Ocorreu um erro ao armazenar a propriedade: ' + response.error);
    },
    complete: function() {
	<% $div_name %>_getProps();
	jQuery('#<% $div_name %>_add_dialog').modal("hide");
    },				   
  });
  
  }


function <% $div_name %>_deleteProp(stockprop_value, stockprop_id) {
    var yes = confirm('Excluir a propriedade '+stockprop_value+'?');
    if (yes) {
        jQuery.ajax( {
            method: 'GET',
            url: '/stock/prop/delete',
            data: { 'stockprop_id' : stockprop_id },
            success: function(response) {
            if ('message' in response) {
                alert(response.message);
                //location.reload();
            }
            if ("Erro"   in response) {  alert(response.error);   }
           },
           error: function(response) { alert('Ocorreu um erro. Tente novamente mais tarde.');
           },
         complete: function() {
           <% $div_name %>_getProps();
	 }
        });
    }
}

</script>
