<%doc>

=head1 NAME

stock/barcode/upload_confirm.mas - a mason component for displaying a confirmation
message of stock phenotyping data loaded from a barcode reader.
page.

=AUTHOR

Naama Menda <nm249@cornell.edu>

=cut

</%doc>

<%args>

@errors => ()
@warnings => ()
$data => undef # formatted data to be printed on confirmation page
$feedback_email
$tempfile

</%args>

<%perl>

my $err_string;

my $warning_string = join "<br />" , @warnings;
if (!@errors) {
    $err_string = "Nenhum erro encontrado! Clique em Confirmar envio para continuar";
} else {
    $err_string .= "Foram encontrados os erros abaixo. Corrija-os e tente novamente. <a href=\"mailto:$feedback_email\">Entre em contato conosco</a> para obter ajuda: <br />";
    $err_string .= join "<br />" , @errors;
    $err_string .= "<h4>Não é possível continuar com o envio.</h4>";
    $err_string .= qq|<a href="javascript:history.back()">Voltar à página de envio</a>|;
}

</%perl>

<& /page/page_title.mas, title => "Confirmar envio dos dados de códigos de barras" &>
<&| /page/info_section.mas, title => "Confirmar envio" &>
 <form action="/barcode/stock/store" method="POST" >
   <h4>Avisos</h4><div> <% $warning_string %> </div>
   <br />
   <h4>Erros</h4><div> <% $err_string %> </div>
   <br />
   <input type="hidden" name="type" value="confirm">
   <input type="hidden" name="tempfile" value="<% $tempfile %>">

%if (!@errors) {
   <input type = "submit" value = "Confirmar envio">
%}
 </form>
</&>
