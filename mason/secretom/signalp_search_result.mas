<%args>
  $data
  $query
  $headings
  $csv_download
</%args>

<& /page/page_title.mas, title => 'Busca de resultados SecreTary SignalP TargetP' &>

<h3 style="text-align: center">Busca por "<% $query |h%>".</h3>

<&| /page/info_section.mas, title => 'Resultados', subtitle => @$data." resultados &mdash; ".qq|<a href="$csv_download">[Baixar planilha]</a>| &>

%  if( @$data ) {
%    foreach my $row ( @$data ) {
%       $row->[0] = link_identifier( $row->[0] ) || $row->[0];
%       $row->[1] =~ s/^\s*\|\s*//;
   <&| /page/info_section.mas, title => 'Correspondência: '.$row->[0], is_subsection => 1 &>
     <% $table->( $row, [ 0,2,3 ] ) %> 
     <% $table->( $row, [ 1 ] ) %> 
     <% $table->( $row, [ 4,5,6 ] ) %>
	<% $table->( $row, [ 7,8,9 ] ) %>
	<% $table->( $row, [ 10 ] ) %> 
	  <% $table->( $row, [ 11,12 ] ) %>
   </&>
%    } 
%  } else {
   <h3 style="text-align: center">Nenhum resultado encontrado para "<% $query |h %>".</h3>
%  }

</&>

<%init>
use List::MoreUtils qw/ mesh /;
use CXGN::Page::FormattingHelpers qw/ info_table_html /;
use CXGN::Tools::Identifiers qw/ link_identifier /;

my $table = sub {
    my ( $row, $order, %other ) = @_;

    my @row = @{$row}[ @$order ];
    my @h = @{$headings}[ @$order ];

    return info_table_html( mesh( @h, @row ),  __multicol => 5, __border => 0, %other );

};

</%init>
