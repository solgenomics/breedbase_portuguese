<%args>

$propagation_group_id
$propagation_group_name
$description
$material_type
$material_source_type
$accession_link
$source_link
$date
$sub_location
$operator_name
$project_link
$accession_stock_id
$purpose

</%args>

<& /util/import_javascript.mas, classes => ["jquery", "jqueryui", "thickbox", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List", "jquery.dataTables"] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<& /page/page_title.mas, title => "Detalhes do ID de grupo de propagação '$propagation_group_name'" &>

<&| /page/info_section.mas, title=>"Detalhes",  collapsible => 1, collapsed=>0 &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <table class="table table-bordered table-hover">
                        <tr><td><b>Projeto</b></td><td><%$project_link%></td></tr>
                        <tr><td><b>Material</b></td><td><%$accession_link%></td></tr>
                        <tr><td><b>Tipo de material</b></td><td><%$material_type%></td></tr>
                        <tr><td><b>Tipo de origem</b></td><td><%$material_source_type%></td></tr>
                        <tr><td><b>Nome de origem</b></td><td><%$source_link%></td></tr>
                        <tr><td><b>Data</b></td><td><%$date%></td></tr>
                        <tr><td><b>Sublocal</b></td><td><%$sub_location%></td></tr>
                        <tr><td><b>Finalidade</b></td><td><%$purpose%></td></tr>
                        <tr><td><b>Descrição</b></td><td><%$description%></td></tr>
                        <tr><td><b>Responsável</b></td><td><%$operator_name%></td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <button class="btn btn-sm btn-primary" style="margin:3px" id="add_new_propagation_id_link">Adicionar novo ID de propagação</button>
</&>

<& /propagation/propagation_id_section.mas, propagation_group_stock_id => $propagation_group_id &>
<& /propagation/inactive_propagation_id_section.mas, propagation_group_stock_id => $propagation_group_id &>

<& /propagation/add_propagation_id_dialog.mas, propagation_group_id => $propagation_group_id, propagation_group_name => $propagation_group_name, accession_stock_id => $accession_stock_id&>


<script>

jQuery(document).ready(function(){

jQuery('#add_new_propagation_id_link').click(function() {

    jQuery("#propagation_rootstock_name").autocomplete({
        source: '/ajax/stock/only_accession_autocomplete',
        appendTo : propagation_id_dialog
    });

    jQuery("#add_propagation_id_dialog").modal("show");

});


});

</script>
