<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="add_propagation_project_dialog" name="add_propagation_project_dialog" tabindex="-1" role="dialog" aria-labelledby="addPropagationProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_propagation_project_dismiss_button_1" name="add_propagation_project_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="addPropagationProjectDialog">Adicionar novo projeto de propagação</h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_propagation_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"O que são projetos de propagação?" &>
                            <p>A página do projeto de propagação centraliza os diferentes processos de propagação.</p>
                            <ul>
                                <li>Cada projeto pode agrupar processos com o mesmo tipo de propagação, objetivo ou ano de execução.</li>
                                <li>Os metadados de cada processo (nome do acesso, tipo de material, data e responsável) são vinculados a um <b>identificador de grupo de propagação</b> único globalmente.</li>
                                <li>Em cada grupo, o progresso de cada planta produzida é acompanhado por um <b>identificador de propagação</b> único globalmente.</li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_propagation_project" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="add_propagation_project_form" id="add_propagation_project_form">
                            <&| /util/workflow.mas:step, title=> "Adicionar um projeto de propagação" &>
                                <& /page/page_title.mas, title=>"Informe os dados básicos do projeto de propagação" &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable">Nome do projeto: </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="propagation_project_name" name="propagation_project_name"  />
                                        </div>
                                    </div><br/>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Tipo de propagação: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_type" name="propagation_type">
                                                <option value="Macropropagation">Macropropagação</option>
                                                <!--
                                                <option value="">Select a Type</option>
                                                <option value="Micropropagation">Micropropagação</option>
                                                -->
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_project_program" name="propagation_project_program">
                                                <option value="">Selecione um programa de melhoramento</option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Local: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_project_location" name="propagation_project_location">
                                                <option value="">Selecione um local</option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Ano:</label>
                                        <div class="col-sm-9">
                                            <div id="propagation_project_year" name="propagation_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Descrição:</label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="propagation_project_description" name="propagation_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="add_propagation_project_submit" id="add_propagation_project_submit">Enviar</button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! O projeto de propagação está no banco de dados" &>
                            <ul>
                                <li>Clique em 'Atualizar' para visualizar o novo projeto na página de gerenciamento.</li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_propagation_project_dismiss_button_2" name="add_propagation_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#propagation_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'propagation_project_location');

    jQuery('#propagation_project_program').change(function() {
        filter_options(jQuery('#propagation_project_program option:selected').text(), 'program', 'propagation_project_location');
    });

    jQuery("[name='add_propagation_project_dismiss_button']").click(function() {
        jQuery('#add_propagation_project_dialog').modal('hide');
        jQuery('#propagation_project_name').val('');
        jQuery('#propagation_project_program').val('');
        jQuery('#propagation_project_location').val('');
        jQuery('#propagation_project_year').val('');
        jQuery('#propagation_project_description').val('');
        jQuery('#propagation_type').val('');
    });

    jQuery('#add_propagation_project_submit').click(function() {
        var propagation_project_name = jQuery("#propagation_project_name").val();
        if (!propagation_project_name) {
            alert("O nome do projeto é obrigatório");
            return;
        }

        var propagation_type = jQuery("#propagation_type").val();
        if (!propagation_type) {
            alert ("O tipo de propagação é obrigatório");
            return;
        }

        var selectedProgram = jQuery("#propagation_project_program").val();
        if (!selectedProgram) {
            alert("O programa de melhoramento é obrigatório");
            return;
        }

        var propagation_project_location = jQuery("#propagation_project_location").val();
        if (!propagation_project_location) {
            alert ("O local é obrigatório");
            return;
        }

        var year = jQuery("#propagation_project_year_select").val();
        if (!year) {
            alert ("O ano é obrigatório");
            return;
        }

        var project_description = jQuery('textarea#propagation_project_description').val();
        if (!project_description) {
            alert ("A descrição é obrigatória");
            return;
        }

        jQuery.ajax({
            url: '/ajax/propagation/add_propagation_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': propagation_project_name,
                'propagation_type': propagation_type,
                'project_program_id': selectedProgram,
                'project_location': propagation_project_location,
                'year': year,
                'project_description': project_description,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            error: function(response) {
                alert("Ocorreu um erro!" + JSON.stringify(response));
                return;
            },
            parseerror: function(response) {
                alert("Ocorreu um erro ao interpretar os dados!" + response);
                return;
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success == 1) {
                    Workflow.focus("#add_propagation_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_propagation_project_workflow");
                }
            },

        });

    });

});

</script>
