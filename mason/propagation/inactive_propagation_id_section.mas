<%args>
$propagation_group_stock_id
</%args>


<&| /page/info_section.mas, title => 'IDs de propagação inativos', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="inactive_propagation_ids_table">
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<script>

jQuery(document).ready(function(){

    const propagation_group_stock_id = "<%$propagation_group_stock_id%>";
    const inactive_propagation_ids_table = jQuery('#inactive_propagation_ids_table').DataTable({
        'ajax': '/ajax/propagation/inactive_propagation_ids_in_group/'+propagation_group_stock_id,
        'autoWidth': false,
        'columns': [
            { title: "ID de propagação", "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.propagation_stock_id+"/view'>"+row.propagation_name+"</a>"; } },
            { title: "Acesso", "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.accession_stock_id+"/view'>"+row.accession_name+"</a>"; } },
            { title: "Porta-enxerto", "data": null, "render": function ( data, type, row ) {
                if (row.rootstock_stock_id === null){
                    return ' '
                } else {
                    return "<a href='/stock/"+row.rootstock_stock_id+"'>"+row.rootstock_name+"</a>"
                }
            }},
            { title: "Estado", "data": "propagation_status" },
            { title: "Data de atualização", "data": "updated_date" },
            { title: "Atualizado por", "data": "updated_by" },
            { title: "Observações", "data": "notes" },

        ],

    });


});


</script>
