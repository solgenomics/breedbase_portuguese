<%args>
$trial_id
$trial_name
</%args>

<div class="modal fade" id="upload_propagation_group_ids_dialog" name="upload_propagation_group_ids_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationGroupIDsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_propagation_group_dismiss_button_2" name="upload_propagation_group_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationGroupIDsDialog">Enviar identificadores de grupos de propagação</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'Informações do modelo' &>
                        <p>
                            <b>Informações sobre o formato do arquivo</b>
                            <br>
                            <a id="propagation_group_ids_upload_spreadsheet_format_info">Formato da planilha</a>
                        </p>
                    </&>
                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_propagation_group_ids_form" name="upload_propagation_group_ids_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Enviar arquivo: </label>
                            <div class="col-sm-9" >
                                <input type="file" name="propagation_group_ids_file" id="propagation_group_ids_file" encoding="multipart/form-data" />
                                <input name="propagation_project_id" id="propagation_project_id" type="hidden" value="<% $trial_id %>">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_propagation_group_dismiss_button_1" name="upload_propagation_group_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_propagation_group_ids_submit" id="upload_propagation_group_ids_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="propagation_group_ids_saved_dialog_message" name="propagation_group_ids_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="propagationGroupIdsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="propagationGroupIdsSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Os IDs dos grupos de propagação foram salvos com sucesso.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_propagation_group_ids_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_propagation_group_ids_error_display" name="upload_propagation_group_ids_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationGroupIdsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationGroupIdsErrorDialog">Erro no envio dos identificadores de grupos de propagação</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="propagation_group_id_upload_spreadsheet_info_dialog" name="propagation_group_id_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationGroupIDInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationGroupIDInfoDialog">Informações do modelo de envio de identificadores de grupos de propagação</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter <b>propagation_group_identifier</b>, <b>accession_name</b>, <b>material_type</b>, <b>Data</b>, <b>Descrição</b> E <b>operator_name</b>. Inclua informações adicionais nas colunas opcionais indicadas abaixo:
                    <br/>
                    <br>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>propagation_group_identifier</td>
                                <td>accession_name</td>
                                <td>material_type</td>
                                <td>Data</td>
                                <td>Descrição</td>
                                <td>operator_name</td>
                                <td>source_type</td>
                                <td>source_name</td>
                                <td>sub_location</td>
                                <td>propósito</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>Campos obrigatórios:</b>
                    <ul>
                        <li>propagation_group_identifier (deve ser único globalmente e não pode existir no banco de dados)</li>
                        <li>accession_name (deve corresponder a um <b>nome único</b> existente no banco de dados)</li>
                        <li>material_type (use um dos valores: budwood, stem, shoot, root, corm, plant ou seed; entre em contato conosco para adicionar outros tipos)</li>
                        <li>date (data de início da propagação no formato AAAA-MM-DD)</li>
                        <li>Descrição</li>
                        <li>operator_name</li>
                    </ul>

                    <b>Campos opcionais:</b>
                    <ul>
                        <li>source_type (use plot, subplot, plant, seedlot ou new)</li>
                        <li>source_name (deve corresponder a um <b>nome único</b> existente no banco de dados, dos tipos plot, subplot, plant ou seedlot)</li>
                        <li>sub_location (localização detalhada dos materiais de propagação)</li>
                        <li>purpose (use replicate, replacement ou backup)</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Propagation Group Identifiers", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_propagation_group_id_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#upload_propagation_group_ids_link').click(function() {
        jQuery("#upload_propagation_group_ids_dialog").modal("show");
    });

    jQuery('#upload_propagation_group_ids_spreadsheet_format_info').click(function(){
        jQuery("#propagation_group_ids_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_propagation_group_ids_submit").click(function(){
        upload_propagation_group_ids();
    });

    function upload_propagation_group_ids() {
        var uploadFile = jQuery("#propagation_group_ids_file").val();
        if (uploadFile === '') {
            alert("Selecione um arquivo");
            return;
        }

        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: "/ajax/propagation/upload_propagation_group_identifiers",
            type: 'POST',
            data: new FormData(jQuery("#upload_propagation_group_ids_form")[0]),
            processData: false,
            contentType: false,
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error_string) {
                    jQuery("#upload_propagation_group_ids_error_display tbody").html('');
                    jQuery("#upload_propagation_group_ids_error_display tbody").append(response.error_string);
                    jQuery("#upload_propagation_group_ids_error_display").modal("show");
                    return;
                }
                if (response.error) {
                    alert(response.error);
                    return;
                }
                if (response.success) {
                    jQuery("#upload_propagation_group_ids_dialog").modal("hide");
                    jQuery('#propagation_group_ids_saved_dialog_message').modal("show");
                }
            }
        });
    };

    jQuery("#dismiss_propagation_group_ids_saved_dialog").click(function(){
        location.reload();
    });

    jQuery('#propagation_group_ids_upload_spreadsheet_format_info').click(function() {
        jQuery("#propagation_group_id_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("[name='upload_propagation_group_dismiss_button']").click(function() {
        jQuery('#upload_propagation_group_ids_dialog').modal('hide');
        jQuery('#propagation_group_ids_file').val('');
    });

});

</script>
