

<%args>
$error => undef
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>'Baixar códigos de barras dos ensaios' &>

% if (!$error) {
  Sucesso! Clique no link abaixo para baixar o arquivo de etiquetas de códigos de barras.<br />
  <br /><br />
  <a target="_blank" href="<% $file %>" >Baixar arquivo <% $filetype %></a>
% }
% elsif ($error){
    <b>Erro ao baixar códigos de barras:</b> <%$error%>
% }
