

<%args>
$error => undef
@found => ()
@not_found => ()
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>'Baixar códigos de barras' &>

% if (!@not_found && !$error) {
  Todos os materiais da lista foram encontrados no banco de dados. Clique no link abaixo para baixar o arquivo de etiquetas.<br />
% }
% elsif ($error){
    <b>Download de código de barras de fenotipagem de parcela: </b><%$error%> Para imprimir outros códigos de barras, use a seção <b>Baixar códigos de barras dos materiais.</b>
% }
% else {
  Os seguintes <% scalar(@not_found) %> materiais não foram encontrados no banco de dados:<br />
%   foreach my $nf (@not_found) {
      <b><% $nf %></b>
%   }
    <br /><br />
%   if (@found > 0) {

    Os outros <% scalar(@found) %> códigos de barras podem ser baixados pelo link abaixo.



%   }
%   else {
    Nenhum material foi encontrado. Verifique os dados informados e tente novamente.
%   }


% }

% if (@found > 0) {
<br /><br />
<a target="_blank" href="<% $file %>" >Baixar arquivo <% $filetype %></a>
%}
