
<h1>Ferramenta de extração de DNA do CassavaBase</h1>

<table>
<tr><th>LINHA</th><th>COLUNA</th></tr>
<tr><td>
% foreach my $row ('A'..'H') { 
<& /barcode/tool/generate.mas, code=>$row &>
%}
</td><td>
% foreach my $col (1..12) { 
  <& /barcode/tool/generate.mas, code=>$col &>
%}
</td></tr></table>
