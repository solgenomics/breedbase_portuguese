
<%args>
$operator
$date
$project
$location
$size => 'large'
</%args>

<%perl>
use Tie::UrlEncoder;

our %urlencode;
my $encoded_operator = $urlencode{$operator};
my $encoded_date     = $urlencode{$date};

</%perl>

<center>
<h1>FOLHA DE CÓDIGOS DE BARRAS DE METADADOS DO CASSAVABASE</h1>
<font size="7">Responsável</font><br />

<img src="/barcode/image/?code=O:<% $encoded_operator %>&size=<% $size %>" />

<br />
<br />

<font size="7">Data de hoje</font>
<br />
<img src="/barcode/image/?code=D:<% $encoded_date %>&size=<% $size %>" />

<br />
<br />

<font size="7">Projeto</font>
<br />
<img src="/barcode/image/?code=P:<% $project %>&size=<% $size %>" />

<br />
<br />

<font size="7">Local</font>
<br />
<img src="/barcode/image/?code=L:<% $location %>&size=<% $size %>" />


</center>
