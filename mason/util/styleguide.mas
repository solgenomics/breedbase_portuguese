    addToListMenu("styleguide_add_to_list_menu", "styleguide_add_to_list_items", {
        listType:'accessions'
    });
&lt;/script&gt;
</pre>

<p>Resultado:</p>
<div id="styleguide_add_to_list_menu"></div>
<div id="styleguide_add_to_list_items" style="display:none">item1
    item2
    item3
</div>
<script type="text/javascript">
    addToListMenu("styleguide_add_to_list_menu", "styleguide_add_to_list_items", {
        listType:'accessions'
    });
</script>

