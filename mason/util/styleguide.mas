&lt;div id="htmlselectexample"&gt;&lt;/div&gt;
&lt;script type="text/javascript"&gt;
    get_select_box("trials", "htmlselectexample")
&lt;/script&gt;
</pre>

<p>Cria:</p>
<div id="htmlselectexample"></div>
<script type="text/javascript">
    get_select_box("trials", "htmlselectexample")
</script>

