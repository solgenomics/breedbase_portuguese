<%args>
$code => undef
</%args>

<p id="authorize-status">
% if ( defined $code ) {
    Conectando conta...
% } else {
    ERRO: código de autorização não retornado
% }
</p>

<script>

jQuery(document).ready(() => {
    storeConnection("<% $code %>");
});

function storeConnection(code) {
    if ( code && code !== "" && window.opener ) {
        const service = window.opener.authorize_data?.service || {};
        jQuery.ajax({
            url: `/ajax/dataset/publish/connection/`,
            method: 'POST',
            data: { code, service: service.key },
            success: (resp) => {
                if ( resp?.error ) {
                    alert("Não foi possível salvar as informações da conexão [" + resp.error + "]");
                }
                else {
                    jQuery("#authorize-status").html("Contas conectadas — você pode fechar esta janela");
                    window.close();
                }
            },
            error: () => {
                alert("Não foi possível salvar as informações da conexão");
            }
        });
    }
}

</script>
