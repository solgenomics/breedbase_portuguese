<%doc>

=head1 NAME

/solgs/genotyping_protocol/index.mas - genotyping protocol selection template



=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%perl>

my $url = $c->req->path;
my $geno_msg = "<p>Este banco de dados não tem dados de genótipo ou você não selecionou um protocolo de genotipagem. ";
my $geno_msg_part = "carregue dados de genótipo no banco de dados e tente novamente ou selecione um protocolo de genotipagem (acima).";
if ($url =~ /solgs/) {
  $geno_msg = "$geno_msg Portanto, o solGS não funciona neste site.</p>
  <p>Para usá-lo, $geno_msg_part</p>";
} else {
  $geno_msg = "$geno_msg  Portanto, esta ferramenta não funciona com dados de genótipo neste site.</p>
  <p>Se você pretende usar a ferramenta com dados de genótipo, $geno_msg_part</p>";
}

</%perl>

<& /util/import_javascript.mas, classes => ['solGS.genotypingProtocol'] &>

<div id="genotyping_protocols_canvas">
  <div id="genotyping_protocols_message" class="message" style="display:none;">Recuperando protocolos de genotipagem... por favor, espere...</div>
    <div id="genotyping_protocols_progress">
      <& /solgs/spinner/spinner.mas &>
    </div>
  </div>

<div  class='row text-center'
       id='genotyping_protocol'
       style='margin:40px 0 40px 0;display:none'>
    <div>
      <button class='btn btn-light'
	      type='button'
	      id='genotyping_protocol_message'>Recuperando protocolos de genotipagem...
      </button>
      <button class='btn btn-success'
	      type='button'
	      id='genotyping_protocols_change'>Mudança
      </button>
    </div>
    <div id='genotyping_protocols_list_div' style='text-align:center;width:40%;display:none;margin:0 auto;'>
      <select class='form-control text-center'
	      id='genotyping_protocols_list_select'>
      </select>
    </div>

   <input type='hidden'
	   id='genotyping_protocol_id'
	   value=''/>
</div>

<div class="row" style="margin-top:10px;margin-bottom:10px">
	<div  id="genotype_missing_message"  class="col-md-6 col-md-offset-3  bg-danger" style="padding-top:10px;padding-bottom:10px;display:none">
  	<% $geno_msg %>
  </div>
</div>

