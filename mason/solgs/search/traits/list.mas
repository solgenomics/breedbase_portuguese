<%doc>
A subset of GS traits list.
</%doc>

<%args>

$index
$traits_list

</%args>
<%perl>
my $table;	

if (@$traits_list) {
  $table  = qq | <table id="traits_starting_with_index_table" class="table table-condensed table-striped"> |;
  $table .= qq | <thead><tr><td>Característica</td><td>Definição</td></tr></thead><tbody> |;
	
  foreach my $trait (@$traits_list) {
    $table .= qq | <tr> |;
    $table .= qq | <td> $trait->[0] </td> |;
    $table .= qq | <td> $trait->[1] </td> |;
    $table .= qq | </tr> |;
  }
    
  $table .= qq | </tbody> |;
  $table .= qq | </table> |;

} else {
  $table = qq | <p>Não há características começando com $index </p> |; 
}

</%perl>

<div class="container">
  <& /page/page_title.mas, 
     title=>'Lista de características com dados GS'
    &>

    <&| /page/info_section.mas, 
	title => qq |Características que começam com "$index" |
      &>

      <div id="traits_starting_with_index_div">
	<% $table %>
     </div>

 </&>
</div>
