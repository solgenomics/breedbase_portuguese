<%doc>
solgs search results view.
</%doc>

<%args>

$result
$query
$pager => undef;
$page_links => undef;
$form => undef;
$genotyping_protocol_id => ''
</%args>

<& /util/import_javascript.mas, classes => ["solGS.solGS"] &>

<& /page/page_title.mas,
    title => 'Características com dados de seleção genômica',
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas,
      title => 'Resultados da Pesquisa',
&>
  <& /page/columnar_table.mas,
     headings    => ['Name', 'Definition'],
    data         => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
  &>

  </&>
  
%}
%else
%{
<&| /page/info_section.mas,
      title => 'Resultados da Pesquisa',
&>
%if ( $query )
%{
<br>Nenhum resultado encontrado para <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br>Sem resultados. Procure novamente com um nome característico.<br />
%}
</&>
%}

<input type="hidden" id="genotyping_protocol_id" value="<% $genotyping_protocol_id %>" />
