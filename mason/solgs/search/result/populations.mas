<%doc>

displays list of GS populations evaluated for a trait.

</%doc>

<%args>

$result
$form
$pager
$page_links
$query
$trait_id
$trait_name

</%args>

<& /util/import_javascript.mas, classes => ["solGS.solGS"] &>

<& /util/import_css.mas, paths => ['/static/css/solgs/solgs.css'] &>

<& /page/page_title.mas,
    title => "Populações de GS avaliadas por $query" ,
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas,
      title => "Criar uma população de treinamento usando indivíduos de uma ou mais ensaios para se encaixar em um modelo de previsão para $trait_name",
&>



<& /solgs/search/result/confirm/populations_list.mas,
   result     => $result,
   pager      => $pager,
   page_links => $page_links
&>

<div id="trait_id">
  <input type="hidden" name="trait_id" value="<% $trait_id %>" />
</div>

% if (scalar(@$result) > 1) 
% {

<div id="select_done">
  <input  class="button" type="button" value="Selecionar" onclick="selectedPops();"/>
</div>

%}

</&>

%}
%else
%{
<&| /page/info_section.mas,
      title => 'Nenhum resultado de busca',
&>

%if ( $query )
%{
<br>Nenhum resultado encontrado para <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br>Sem resultados. Procure novamente com um nome característico.<br />
%}
</&>
%}
