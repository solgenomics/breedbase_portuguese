<%doc>

a general format for projects details presentation.

</%doc>

<%args>

$result
$pager => ''
$page_links => ''

</%args>


<%perl>

use CXGN::Page::FormattingHelpers qw | tooltipped_text |;
my $marker_tip = tooltipped_text("Dica", "Você pode combinar ensaios que compartilham a mesma cor.");

</%perl>


<& /page/columnar_table.mas,
     headings    => ['', 'Projetos', 'Descrição', 'Local', 'Ano', $marker_tip ],
     data        => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'llllll'
&>
 
%if ($pager)
%{
<& /page/pagination_control.mas, 
     pager      => $pager, 
     link_maker => $page_links 
&> 

%}






