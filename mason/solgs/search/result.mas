<%doc>

solGS search results view.

</%doc>

<%args>

$result
$form

</%args>

<& /page/page_title.mas,
    title => 'Resultados de busca do SolGS',
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas,
      title => 'Resultados da Pesquisa',
&>

<& /page/columnar_table.mas,
     headings    => [ 'Population', 'Location', 'Year', 'PI' ],
     data        => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
 &>
</&>

%}
%else
%{
<&| /page/info_section.mas,
      title => 'Nenhum resultado de busca',
&>

<br>Sem resultados. Procure novamente com um termo diferente.<br />

</&>

%}

<&| /page/info_section.mas,
    title       => 'Buscar',
    collapsible => '1',
    collapsed   =>  1
&>

<& /search/solgs.mas, form => $form &>

</&>



