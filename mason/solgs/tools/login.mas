
<%args>  
$tool_url => $tool_url
$analysis_type => $analysis_type
</%args>

<%perl>

my $login_msg = "Para ver seus conjuntos de dados e usar esta ferramenta, " . "você precisa <a href=\"/user/login?goto_url=$tool_url\">entrar</a>.";

</%perl>


% if ($c->user) {
    <& /solgs/tools/datatable_display.mas,
    analysis_type => $analysis_type &>
%} else {
    <div class="row">
    <div class="col-md-8 col-md-offset-2">
    <& /generic_message.mas, message => $login_msg &>
    </div>
    </div>
%}