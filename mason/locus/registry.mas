

<%doc>

=head1 NAME

/locus/registry.mas - a component for locus registry form

=head1 DESCRIPTION


Parameters:

=over 4

=item person_id

The ID of the logged in person

=item locus_id

a locus id

=item is_owner

boolean. If passed, a link to the registry form will be printed

=item registry

the existing registry name

=back

=head1 AUTHOR

Naama Menda <nm249@cornell.edu>

=cut

</%doc>

<%args>

$person_id
$locus_id
$is_owner => undef
$registry => undef

</%args>

<%perl>

</%perl>

% if ($registry) {
This locus is associated with registry name: <% $registry %>
% }
% if ($is_owner)  {

<& /util/import_javascript.mas, classes => ["CXGN.Phenome.Locus"] &>
  <div id="associateRegistryForm" style="display: none">
    <div id="registry_search">
      Nome do Registro:
      <input type="text"
	     style="width: 50%"
	     id="registry_input"
	     onkeyup="Locus.getRegistries(this.value)">
      <input type="button"
	     id="associate_registry_button"
	     value="Registro de associados"
	     disabled="true"
	     onclick="Locus.associateRegistry('<% $locus_id %>','<% $person_id %>');this.disabled=false;">

      <select id="registry_select"
	      style="width: 100%"
	      name="registry_select"
	      size="10"
	      onchange="Locus.updateRegistryInput()">

      </select>

      Clique <a href="javascript:Locus.addRegistryView()">Aqui</a> para adicionar um novo nome de registro ao nosso banco de dados
    </div>

    <div id="registry_add" style="display: none">
      <b>Por favor, digite os valores do novo nome de registro abaixo (* é necessário)</b><br><br>
      <table cellspacing="0" cellpadding="0">
	<tr><td>Símbolo de Registro: </td><td width="20">&nbsp;</td>
	  <td><input type="text" id="registry_symbol" onblur="Locus.enableButton();" onchange="Locus.enableButton();"></td></tr>
	<tr><td>Nome do Registro: </td><td width="20">&nbsp;</td>
	  <td><input type="text" id="registry_name" onblur="Locus.enableButton();" onchange="Locus.enableButton();"></td></tr>
      </table>
      Descrição do registro:<br>
      <textarea id="registry_description" style="width: 100%"></textarea><br>
      <input type="button" disabled="true" id="add_registry_button" value="Adicionar Novo Registro" onclick="Locus.addRegistry('<% $locus_id %> ', '<% $person_id %> ');this.disabled=true;"><br>
      Clique <a href="javascript:Locus.searchRegistries()">Aqui</a> Voltar para a busca de registro
    </div>
  </div>

% }

