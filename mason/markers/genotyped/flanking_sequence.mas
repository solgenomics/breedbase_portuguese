<%args>
    $blast_db => undef
    $chrom => undef
    $pos => undef
</%args>

<%init>
    if ( !$blast_db ) {
        print "<p><strong>ERRO: </strong>blast_db ausente!</p>";
    }
    if ( !$chrom ) {
        print "<p><strong>ERRO: </strong>nome do cromossomo ausente!</p>";
    }
    if ( !$pos ) {
        print "<p><strong>ERRO: </strong>posição ausente!</p>";
    }
</%init>


<p>
    <a href="/tools/blast/match/show?blast_db_id=<% $blast_db %>;id=<% $chrom %>;hilite_coords=<% $pos %>-<% $pos %>" target="_blank">
        Veja a sequência de flanqueamento do marcador
    </a>
</p>