
<%args>
$vector_id
$transformation_id => undef
$program_name => undef
</%args>

<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="vector_obsoleted_transformants_table">
        <thead>
            <tr>
                <th>Acesso</th>
                <th>Observação</th>
                <th>Data</th>
                <th>Marcado como obsoleto por</th>
% if (!$transformation_id) {
                <th>ID da transformação</th>
%}
            </tr>
        </thead>

    </table>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title => 'Copiar acessos obsoletos para uma lista', collapsible=>1, collapsed=>0, subtitle=>'<i>Copie os nomes dos acessos obsoletos para uma lista nova ou existente</i>'&>
        <br>
        <div id="obsoleted_transformant_names" style="display:none"></div>
        <div id="obsoleted_transformants_to_list_menu"></div>
        </&>
    </div>
</div>

<style>
    .table th {
        white-space: nowrap;
    }
</style>


<script>

jQuery(document).ready(function(){
    const vector_id = "<%$vector_id%>";
    const filter_by_transformation_id = "<%$transformation_id%>";

    jQuery('#obsoleted_accessions_section_onswitch').click( function() {
        var related_stocks_table = jQuery('#vector_obsoleted_transformants_table').DataTable({
            'ordering': false,
            'autoWidth': false,
            'ajax': { 'url':  '/ajax/transformation/vector_obsoleted_accessions',
                'data': function(d) {
                    d.vector_id = vector_id;
                    d.filter_by_transformation_id = filter_by_transformation_id;
                }
            },
            "fnInitComplete": function(oSettings, json) {
                if (!isLoggedIn()) {
                    jQuery('#obsoleted_transformants_to_list_menu').html("<div class='well well-sm'><h3>Entre no sistema para usar listas!</h3></div>");
                } else {
                    var html = "";
                    for(var i=0; i<json.data.length; i++){
                        html += json.data[i][5]+"\n";
                    }
                    jQuery("#obsoleted_transformant_names").html(html);
                    addToListMenu("obsoleted_transformants_to_list_menu", "obsoleted_transformant_names", {
                        selectText: true,
                        listType:'obsoleted_stocks'
                    });
                }
            }
        });
    }); 
});


</script>
