<%args>
$vector_id
$vector_name
</%args>

<& /util/import_javascript.mas, classes => [  'moment_min', 'daterangepicker' ] &>

<div class="modal fade" id="upload_qPCR_data_dialog" name="upload_qPCR_data_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadqPCRDataDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_qPCR_data_dismiss_button_1" name="upload_qPCR_data_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadqPCRDataDialog">Enviar dados de qPCR (valores Cq)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <center>
                        <&| /page/explanation.mas, title=>'Informações do modelo' &>
                            <p>
                                <b>Informações sobre o formato do arquivo</b>
                                <br>
                                <a id="Cq_values_upload_spreadsheet_format_info">Formato da planilha</a>
                            </p>
                        </&>
                    </center>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_qPCR_data_form" name="upload_qPCR_data_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Tipo de tecido: </label>
                            <div class="col-sm-8" >
                                <div id="qPCR_tissue_type_div"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Controle endógeno: </label>
                            <div class="col-sm-8" >
                                <div id="qPCR_endogenous_control_div"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" >Data do ensaio: </label>
                            <div class="col-sm-8">
                                <input class="form-control" id="assay_date" name="assay_date" title="assay_date" type="text" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Método de normalização: </label>
                            <div class="col-sm-8" >
                                <div id="qPCR_normalization_methods_div"></div>
                            </div>
                        </div>
                        <div id="normalization_method_description_div">
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Observações:</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" id="qPCR_notes" name="qPCR_notes" ></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo (valores Cq): </label>
                            <div class="col-sm-8" >
                                <input type="file" name="Cq_qPCR_data_file" id="Cq_qPCR_data_file" encoding="multipart/form-data" />
                                <input name="qPCR_data_vector_id" id="qPCR_data_vector_id" type="hidden" value="<% $vector_id %>">
                                <input name="qPCR_data_vector_name" id="qPCR_data_vector_name" type="hidden" value="<% $vector_name %>">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_qPCR_data_dismiss_button_2" name="upload_qPCR_data_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_qPCR_data_submit" id="upload_qPCR_data_submit">Enviar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="qPCR_data_saved_dialog_message" name="qPCR_data_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="qPCRDataSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="qPCRDataSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Os dados de qPCR foram salvos com sucesso.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_qPCR_data_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_qPCR_data_error_display" name="upload_qPCR_data_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadqPCRDataErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadqPCRDataErrorDialog">Erro no envio dos dados de qPCR</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Cq_qPCR_data_upload_spreadsheet_info_dialog" name="Cq_qPCR_data_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCQqPCRDataInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCQqPCRDataInfoDialog">Informações do modelo de envio de dados de qPCR (valores Cq)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>accession_name</td>
                                <td>replicate_number</td>
                                <td>gene</td>
                                <td>Cq</td>
                            </tr>
                        </tbody>
                    </table>
                    <br>
                    <b>Campos obrigatórios:</b>
                    <ul>
                        <li>accession_name (deve existir no banco de dados)</li>
                        <li>replicate_number (informe 1 se não houver repetição; se uma amostra tiver repetições, o valor normalizado derivado será a média)</li>
                        <li>gene (os genes da planilha devem estar cadastrados como genes da construção vetorial ou do controle endógeno selecionado; <b>uma construção vetorial pode ter vários genes separados por vírgulas, por exemplo, geneA,geneB,geneC</b>)</li>
                        <li>Cq (valores numéricos usados para calcular os valores normalizados; ambos são armazenados no banco de dados; se não houver valor Cq, use ND)</li>
                    </ul>
                    <br>
                    <b>Por exemplo:</b>
                    Dados Cq de um controle endógeno (geneA) e dois alvos (geneB e geneC). Cada amostra tem duas repetições. Não é necessário agrupar as mesmas repetições como na planilha de exemplo.
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>accession_name</td>
                                <td>replicate_number</td>
                                <td>gene</td>
                                <td>Cq</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>1</td>
                                <td>geneA</td>
                                <td>22.28</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>1</td>
                                <td>geneB</td>
                                <td>24.26</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>1</td>
                                <td>geneC</td>
                                <td>19.4</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>1</td>
                                <td>geneA</td>
                                <td>20.18</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>1</td>
                                <td>geneB</td>
                                <td>20.24</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>1</td>
                                <td>geneC</td>
                                <td>18.29</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>2</td>
                                <td>geneA</td>
                                <td>21.28</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>2</td>
                                <td>geneB</td>
                                <td>23.16</td>
                            </tr>
                            <tr>
                                <td>accession_1</td>
                                <td>2</td>
                                <td>geneC</td>
                                <td>20.4</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>2</td>
                                <td>geneA</td>
                                <td>20.25</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>2</td>
                                <td>geneB</td>
                                <td>25.21</td>
                            </tr>
                            <tr>
                                <td>accession_2</td>
                                <td>2</td>
                                <td>geneC</td>
                                <td>20.6</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
                <& /help/file_upload_type.mas, type => "qPCR Data", optional_column => 0 &>
            </div>
            <div class="modal-footer">
                <button id="close_relative_expression_data_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery("[name='upload_qPCR_data_link']").click(function() {
        get_select_box('tissue_types', 'qPCR_tissue_type_div', { 'name' : 'qPCR_tissue_type', 'id' : 'qPCR_tissue_type' , 'empty' : 1});
        get_select_box('endogenous_controls', 'qPCR_endogenous_control_div', { 'name' : 'qPCR_endogenous_control', 'id' : 'qPCR_endogenous_control' , 'empty' : 1});
        get_select_box('qPCR_normalization_methods', 'qPCR_normalization_methods_div', { 'name' : 'qPCR_normalization_method', 'id' : 'qPCR_normalization_method' , 'empty' : 1});
        jQuery("#upload_qPCR_data_dialog").modal("show");
    });

    jQuery('input[title="assay_date"]').daterangepicker(
        {
            "singleDatePicker": true,
            "showDropdowns": true,
            "autoUpdateInput": true,
            locale: {
                format: 'YYYY-MM-DD',
                applyLabel: 'Aplicar',
                cancelLabel: 'Cancelar',
                fromLabel: 'De',
                toLabel: 'Até',
                customRangeLabel: 'Intervalo personalizado',
                weekLabel: 'Sem.',
                daysOfWeek: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'],
                monthNames: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro']
            },
        },
    );

    jQuery(document).on('change', '#qPCR_normalization_methods_div', function () {
        let normalization_method = ''
        normalization_method = jQuery("#qPCR_normalization_method").val();
        if (normalization_method == "CASS_Delta_Cq"){
            jQuery('#normalization_method_description_div').html('<br/><div class="well" style="text-align: center"><p>Os valores normalizados são calculados pela fórmula:<br><b>2^Cq(Controle endógeno) / 2^Cq(Alvo)</b>.</p></div>');
        } else {
            jQuery('#normalization_method_description_div').html('');
        }
    });

    jQuery('#Cq_values_upload_spreadsheet_format_info').click(function(){
        jQuery("#Cq_qPCR_data_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_qPCR_data_submit").click(function(){
        upload_qPCR_data();
    });

    function upload_qPCR_data() {
        const Cq_upload_file = jQuery("#Cq_qPCR_data_file").val();
        const tissue_type = jQuery("#qPCR_tissue_type").val();
        const endogenous_control = jQuery("#qPCR_endogenous_control").val();
        const assay_date = jQuery("#assay_date").val();
        const normalization_method = jQuery("#qPCR_normalization_method").val();

        if (tissue_type === ''){
            alert("Selecione um tipo de tecido");
            return;
        }

        if (endogenous_control === ''){
            alert("Selecione um controle endógeno");
            return;
        }

        if (assay_date === ''){
            alert("Informe a data do ensaio");
            return;
        }

        if (normalization_method === '') {
            alert("Selecione um método de normalização");
            return;
        }

        if (Cq_upload_file === ''){
            alert("Selecione um arquivo");
            return;
        }

        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: "/ajax/transformation/upload_qPCR_data",
            type: 'POST',
            data: new FormData(jQuery("#upload_qPCR_data_form")[0]),
            processData: false,
            contentType: false,
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error_string) {
                    jQuery("#upload_qPCR_data_error_display tbody").html('');
                    jQuery("#upload_qPCR_data_error_display tbody").append(response.error_string);
                    jQuery("#upload_qPCR_data_error_display").modal("show");
                    return;
                }
                if (response.error) {
                    alert(response.error);
                    return;
                }
                if (response.success) {
                    jQuery('#upload_qPCR_data_dialog').modal('hide');
                    jQuery('#qPCR_data_saved_dialog_message').modal("show");
                }
            }
        });
    };

    jQuery("[name='upload_qPCR_data_dismiss_button']").click(function() {
        jQuery('#upload_qPCR_data_dialog').modal('hide');
        jQuery('#qPCR_tissue_type_div').val('');
        jQuery('#qPCR_endogenous_control_div').val('');
        jQuery('#assay_date').val('');
        jQuery('#qPCR_notes').val('');
        jQuery('#qPCR_normalization_methods_div').val('');
        jQuery('#assay_date').data('daterangepicker').setStartDate(new Date);
        jQuery('#assay_date').data('daterangepicker').setEndDate(new Date);

    });

    jQuery("#dismiss_qPCR_data_saved_dialog").click(function(){
        location.reload();
    });

});

</script>
