<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.Transformation' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, id=>'delete_transformation_ids_section', title => 'Excluir IDs de transformação', subtitle => '<font color="red">A exclusão não pode ser desfeita</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <center>IDs de transformação com transformantes associados não podem ser excluídos, mas podem ser marcados como encerrados.</center>
    </div>

    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="transformation_ids_deletion_table">
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_transformation_project_section', title => 'Excluir projeto de transformação', subtitle => '<font color="red">A exclusão não pode ser desfeita.</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <center>Projetos com IDs de transformação associados não podem ser excluídos. Primeiro exclua os IDs de transformação associados ao projeto.</center>
    </div>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-primary" id="delete_transformation_project" role="button">Excluir projeto de transformação</button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    const project_id = "<% $trial_id %>";

    jQuery('#delete_transformation_project').click(function() {
        const confirmation = confirm("Tem certeza de que deseja excluir este projeto de transformação? A exclusão não pode ser desfeita.");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+project_id+'/delete/transformation_project',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('Exclusão realizada com sucesso');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('Ocorreu um erro durante a exclusão');
                }
            });
        }
    });

    const deletion_table = jQuery('#transformation_ids_deletion_table').DataTable({
        'ajax': '/ajax/transformation/all_transformation_ids_in_project/'+project_id,
        'autoWidth': false,
        'columns': [
            { title: "ID da transformação", "data": null, "render": function ( data, type, row ) { return "<a href='/transformation/"+row.transformation_id+"'>"+row.transformation_name+"</a>"; } },
            { title: "Estado", "data": "status_type" },
            { title: "Número de transformantes", "data": "number_of_transformants" },
            { title: "Excluir", "data": null, "render": function ( data, type, row ) {
                if (row.number_of_transformants > 0){
                    return 'Não é possível excluir'
                } else {
                    return "<a onclick='deleteTransformationID("+row.transformation_id+")'>Excluir</a>";

                }
            }},

        ],

    });

});

</script>
