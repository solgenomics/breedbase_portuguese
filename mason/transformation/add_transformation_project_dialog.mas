<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="create_transformation_project_dialog" name="create_transformation_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createTransformationProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_transformation_project_dismiss_button_1" name="add_transformation_project_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="createTransformationProjectDialog">Adicionar novo projeto de transformação</h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_transformation_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"O que são projetos de transformação?" &>

                            <p>Use projetos de transformação para gerenciar e organizar os experimentos de transformação</p>
                            <ul>
                                <li>Cada experimento de transformação é vinculado a um ID de transformação único globalmente.</li>
                                <li>O ID de transformação reúne informações sobre o material vegetal e a construção vetorial usados no experimento.</li>
                                <li>Na página de detalhes da transformação, adicione automaticamente nomes de novos transformantes (acessos) ao banco de dados informando a quantidade de transformantes gerados.</li>
                                <li>Cada nome de transformante (acesso) gerado automaticamente usa o ID de transformação como base e um número de série sequencial. </li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_intro" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_transformation_project_form" id="create_transformation_project_form">
                            <&| /util/workflow.mas:step, title=> "Adicionar um projeto de transformação" &>
                                <& /page/page_title.mas, title=>"Informe os dados básicos do projeto de transformação" &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable">Nome do projeto: </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="transformation_project_name" name="transformation_project_name"  />
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_program" name="transformation_project_program">
                                                <option value="">Selecione um programa de melhoramento</option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Local: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_location" name="transformation_project_location">
                                                <option value="">Selecione um local</option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Ano:</label>
                                        <div class="col-sm-9">
                                            <div id="transformation_project_year" name="transformation_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Descrição:</label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="transformation_project_description" name="transformation_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="create_transformation_project_submit" id="create_transformation_project_submit">Enviar</button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"Concluído! O projeto de transformação está no banco de dados" &>
                            <ul>
                                <li>Clique em 'Atualizar' para visualizar o novo projeto na página de gerenciamento.</li>
                                <li>Use a página do projeto de transformação para criar IDs de transformação.</li>
                                <li><b>Se o projeto de transformação estiver vinculado automaticamente à ferramenta de acompanhamento, configure o formato dos nomes gerados automaticamente antes de usar essa ferramenta.</b></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_transformation_project_dismiss_button_2" name="add_transformation_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#transformation_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'transformation_project_location');

    jQuery('#transformation_project_program').change(function() {
        filter_options(jQuery('#transformation_project_program option:selected').text(), 'program', 'transformation_project_location');
    });

    jQuery("[name='add_transformation_project_dismiss_button']").click(function() {
        jQuery('#create_transformation_project_dialog').modal('hide');
        jQuery('#transformation_project_name').val('');
        jQuery('#transformation_project_program').val('');
        jQuery('#transformation_project_location').val('');
        jQuery('#transformation_project_year').val('');
        jQuery('#transformation_project_description').val('');
    });

    jQuery('#create_transformation_project_submit').click(function() {
        var transformation_project_name = jQuery("#transformation_project_name").val();
        if (!transformation_project_name) {
            alert("O nome do projeto é obrigatório");
            return;
        }

        var selectedProgram = jQuery("#transformation_project_program").val();
        if (!selectedProgram) {
            alert("O programa de melhoramento é obrigatório");
            return;
        }

        var transformation_project_location = jQuery("#transformation_project_location").val();
        if (!transformation_project_location) {
            alert ("O local é obrigatório");
            return;
        }

        var year = jQuery("#transformation_project_year_select").val();
        if (!year) {
            alert ("O ano é obrigatório");
            return;
        }

        var project_description = jQuery('textarea#transformation_project_description').val();
        if (!project_description) {
            alert ("A descrição é obrigatória");
            return;
        }

        jQuery.ajax({
            url: '/ajax/transformation/add_transformation_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': transformation_project_name,
                'project_program_id': selectedProgram,
                'project_location': transformation_project_location,
                'year': year,
                'project_description': project_description,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            error: function(response) {
                alert("Ocorreu um erro!" + JSON.stringify(response));
                return;
            },
            parseerror: function(response) {
                alert("Ocorreu um erro ao interpretar os dados!" + response);
                return;
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success == 1) {
                    Workflow.focus("#add_transformation_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_transformation_project_workflow");
                }
            },

        });

    });

});

</script>
