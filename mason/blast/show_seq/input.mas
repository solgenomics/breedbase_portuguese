<& /page/page_title.mas, title => 'Mostre uma sequência de um banco de dados BLAST' &>

<form>
<table cellpadding="5" cellspacing="5" alt=""><tr>
<td><b>Conjunto de dados</b></td><td> <select name="blast_db_id">
<option value="93">Tomato WGS Sequence</option>
<option value="56">Tomate BAC contíguos</option>
</select></td></tr>

<td><b>Id</b></td><td> <input type="text" name="id" size="10"/><br /></td></tr>

<tr><td colspan="3"><b>Coordenadas de destaque (entrar como: 1-100,200-300)</b></td></tr>
<tr><td><b>Coordenadas: </b></td><td> <input type="text" name="hilite_coords" size="10" /><br /></td></tr>

<tr><td><b>Formato</b></td><td><select name="format"><option value="html">html</option><option value="text">texto</option></select></td></tr>

</table>

<input type="submit" />
</form>

