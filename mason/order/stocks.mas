<%args>

$role => "stock_orderer"
$check_vendor_role => undef
$tracking_order_activity => undef
$user_id

</%args>


<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery/dataTables', 'CXGN.BreedersToolbox.HTMLSelect.js', 'CXGN.List' ] &>

% if ($check_vendor_role == 1) {
    <&| /page/page_title.mas, title => "Gerenciar pedidos do fornecedor" &>
    </&>
% } else {
    <&| /page/page_title.mas, title => "Seus pedidos" &>
    </&>
%}

<td>
    <a href="/catalog/view"><p>Ir para a página do catálogo</p></a>
</td>

<br/>
% if ($check_vendor_role == 1) {
    <&| /page/info_section.mas, title => 'Gerenciar pedidos atuais', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_current_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, title => 'Pedidos concluídos', collapsible=>1, collapsed=>1 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_completed_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

% if ($check_vendor_role != 1) {
    <&| /page/info_section.mas, title => 'Seus pedidos atuais', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_current_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>Número do pedido</th>
                                    <th>Data de envio</th>
                                    <th>Detalhes do pedido</th>
                                    <th>Situação</th>
                                    <th>Enviar pedido para</th>
                                    <th>Comentários</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, title => 'Seus pedidos concluídos', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_completed_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>Número do pedido</th>
                                    <th>Data de envio</th>
                                    <th>Detalhes do pedido</th>
                                    <th>Situação</th>
                                    <th>Data de conclusão</th>
                                    <th>Processado por</th>
                                    <th>Comentários</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<div class="modal fade" id="update_order_dialog" name="update_order_dialog" tabindex="-1" role="dialog" aria-labelledby="updateOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateOrderDialog">Atualizar pedido</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="update_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button id="update_order_button" type="button" class="btn btn-primary" >Atualizar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update_saved_dialog" name="update_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="updateSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        O pedido foi atualizado.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_update_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="re_open_order_dialog" name="re_open_order_dialog" tabindex="-1" role="dialog" aria-labelledby="reOpenOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="reOpenOrderDialog">Reabrir pedido</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="re_open_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button id="re_open_order_button" type="button" class="btn btn-primary" >Reabrir</button>
            </div>
        </div>
    </div>
</div>

% if (($check_vendor_role == 1) && $tracking_order_activity) {
    <&| /page/info_section.mas, title => 'Acompanhamento dos pedidos', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <!--
                    <button id="download_active_item_file_button" class="btn btn-primary">Baixar arquivo de itens</button>
                    <button id="download_ontology_file_button" class="btn btn-primary">Baixar ontologias de coleta de dados</button>
                    -->
                    <button id="generate_active_item_barcode_button" class="btn btn-primary">Gerar códigos de barras dos itens</button>
                    <a href="/activity/record" class="btn btn-default">Ir para a página de registro</a>
                </div>
                <div class = "panel-body">

                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="order_progress_table">
                        <thead>
                            <tr>
                                <th>Número do pedido</th>
                                <th>Detalhes do pedido</th>
                                <th>ID de rastreamento</th>
                                <th>Material</th>
% my $activity_types = $c->config->{tracking_activities_header};
% my @column_header = split ',',$activity_types;
% foreach my $column_header(@column_header){
                                <th><%$column_header%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </&>
% }

<& /order/create_item_file_dialog.mas&>
<& /order/create_ontology_file_dialog.mas &>
<& /order/generate_identifier_barcode_dialog.mas, identifier => "", user_id => $user_id &>

<script>

$(window).ready( function() {

    jQuery('#user_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/current',
    });

    jQuery('#user_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/completed',
    });

    jQuery('#vendor_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_current_orders',
        columns: [
            { title: "Número do pedido", "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: "Solicitado por", "data": "order_from_name" },
            { title: "Data de envio", "data": "create_date" },
            { title: "Detalhes do pedido", "data": "order_details" },
            { title: "Situação", "data": "order_status" },
            { title: "Comentários", "data": "contact_person_comments" },
            { title: "Atualizar", "data": "null", "render": function ( data, type, row ) { return "<a onclick='updateOrder(\""+row.order_id+"\", \""+row.order_from_name+"\")' >Atualizar</a>"; } },
        ]
    });

    jQuery('#vendor_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_completed_orders',
        columns: [
            { title: "Número do pedido", "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: "Solicitado por", "data": "order_from_name" },
            { title: "Data de envio", "data": "create_date" },
            { title: "Detalhes do pedido", "data": "order_details" },
            { title: "Situação", "data": "order_status" },
            { title: "Data de conclusão", "data": "completion_date" },
            { title: "Comentários", "data": "contact_person_comments" },
            { title: "Atualizar", "data": "null", "render": function ( data, type, row ) { return "<a onclick='reOpenOrder(\""+row.order_id+"\", \""+row.order_from_name+"\")' >Reabrir</a>"; } },
        ]
    });

    jQuery('#update_order_button').click( function() {
        var order_id = jQuery('#update_order_id').val();
        var new_order_status = jQuery('#update_order_status').val();
        if (!new_order_status) {
            alert ("Selecione uma situação");
            return;
        }
        var contact_person_comments = jQuery('#contact_person_comments').val();

        jQuery.ajax({
            url: '/ajax/order/update',
            dataType: "json",
            type: 'POST',
            data : {
                'order_id' : order_id,
                'new_status': new_order_status,
                'contact_person_comments': contact_person_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_saved_dialog').modal('show');
                    jQuery('#update_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao atualizar o pedido');
            }
        });
    });

    jQuery("#dismiss_update_saved_dialog").click(function(){
        location.reload();
    });

    jQuery('#re_open_order_button').click( function() {
        var order_id = jQuery('#re_open_order_id').val();
        var re_open_status = jQuery('#re_open_status').val();
        var re_open_comments = jQuery('#re_open_comments').val();
        if (!re_open_comments) {
            alert ("Adicione comentários para reabrir o pedido");
            return;
        }

        jQuery.ajax({
            url: '/ajax/order/update',
            dataType: "json",
            type: 'POST',
            data : {
                'order_id' : order_id,
                'new_status': re_open_status,
                'contact_person_comments': re_open_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_saved_dialog').modal('show');
                    jQuery('#re_open_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao atualizar o pedido');
            }
        });
    });

    jQuery('#order_progress_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/order/progress',
    });

});

function updateOrder(order_id, order_from_name){
    var html = '';
    html += '<form class="form-horizontal"><div class="form-group"><label class="col-sm-3 control-label">Número do pedido: </label><div class="col-sm-9" ><input class="form-control" id="update_order_id" name="update_order_id" value="'+order_id+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Solicitado por: </label><div class="col-sm-9" ><input class="form-control" id="ordered_by_name" name="ordered_by_name" value="'+order_from_name+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Situação: </label><div class="col-sm-9" ><select class="form-control" id="update_order_status" name="update_order_status"><option disabled value="" selected hidden>Selecione uma situação</option>';
    html += '<option value='+"being_processed"+'>'+"em processamento"+'</option>';
    html += '<option value='+"shipped"+'>'+"enviado"+'</option>';
    html += '<option value='+"completed"+'>'+"concluído"+'</option>';
    html += '<option value='+"cancelled"+'>'+"cancelado"+'</option>';
    html += '</select></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Comentários: </label><div class="col-sm-9" ><input class="form-control" id="contact_person_comments" placeholder="Opcional"></div></div></form>'

    jQuery('#update_order_div').html(html);
    jQuery('#update_order_dialog').modal('show');

}

function reOpenOrder(order_id, order_from_name){
    var re_open = "re-opened"
    var html = '';
    html += '<form class="form-horizontal"><div class="form-group"><label class="col-sm-3 control-label">Número do pedido: </label><div class="col-sm-9" ><input class="form-control" id="re_open_order_id" name="re_open_order_id" value="'+order_id+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Solicitado por: </label><div class="col-sm-9" ><input class="form-control" id="re_open_ordered_by" name="re_open_ordered_by" value="'+order_from_name+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Situação: </label><div class="col-sm-9" ><input class="form-control" id="re_open_status" name="re_open_status" value="'+re_open+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">Comentários: </label><div class="col-sm-9" ><input class="form-control" id="re_open_comments" placeholder="Obrigatório"></div></div></form>'

    jQuery('#re_open_order_div').html(html);
    jQuery('#re_open_order_dialog').modal('show');

}


</script>
