<%args>

</%args>


<div class="modal fade" id="upload_catalog_items_dialog" name="upload_catalog_items_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsDialog">Enviar itens do catálogo </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'Informações do modelo' &>
                        <p>
                            <b>Informações do formato de arquivo</b>
                            <br>
                            <a id="upload_catalog_items_format">Formato da planilha</a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_catalog_items_form" name="upload_catalog_items_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enviar arquivo (.xls ou .xlsx): </label>
                                <div class="col-sm-8">
                                    <input type="file" name="catalog_items_upload_file" id="catalog_items_upload_file" encoding="multipart/form-data" />
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="upload_catalog_items_submit" id="upload_catalog_items_submit">Enviar arquivo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_error_display" name="upload_catalog_items_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsErrorDialog">Erro ao enviar o arquivo de itens do catálogo</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="catalog_items_saved_dialog_message" name="catalog_items_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="catalogItemsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="catalogItemsSavedDialog">Sucesso</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Os itens do catálogo foram salvos com sucesso.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_catalog_items_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar e recarregar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_format_dialog" name="upload_catalog_items_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsFormatDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsFormatDialog">Informações do modelo</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Os itens do catálogo podem ser enviados em um arquivo Excel (.xls ou .xlsx)</b>
                    <br>
                    <b>Cabeçalho:</b>
                    <br>
                    A primeira linha (cabeçalho) deve conter os seguintes campos:
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>item_name</td>
                                <td>category</td>
                                <td>additional_info</td>
                                <td>material_source</td>
                                <td>breeding_program</td>
                                <td>contact_person_username</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>Colunas obrigatórias:</b>
                    <ul>
                        <li><b>item_name:</b>O nome do item deve existir no banco de dados e corresponder a um acesso, lote de sementes, população ou construção vetorial</li>
                        <li><b>category:</b>Deve ser um dos valores: released variety (variedade lançada), pathogen assay (ensaio de patógeno), control (controle) ou transgenic line (linhagem transgênica). Este campo pode ser personalizado; entre em contato conosco. </li>
                        <li><b>additional_info:</b> Obrigatório no cabeçalho, mas o valor pode ficar em branco.</li>
                        <li><b>material_source:</b> Obrigatório no cabeçalho, mas o valor pode ficar em branco.</li>
                        <li><b>breeding_program:</b>O programa de melhoramento deve existir no banco de dados.</li>
                        <li><b>contact_person_username:</b>Indique a pessoa de contato de cada item. O nome de usuário deve existir no banco de dados</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready( function() {

    jQuery("#upload_catalog_items_button").click(function(){

        jQuery("#upload_catalog_items_format").click(function(){
            jQuery("#upload_catalog_items_format_dialog").modal("show");
        });

        jQuery("#upload_catalog_items_dialog").modal("show");
    });


    jQuery("#upload_catalog_items_submit").click(function(){
        var uploadFile = jQuery("#catalog_items_upload_file").val();
        jQuery('#upload_catalog_items_form').attr("action", "/ajax/catalog/upload_items");
        if (uploadFile === ''){
            alert("Selecione um arquivo");
            return;
        }
        jQuery("#upload_catalog_items_form").submit();
        jQuery("#upload_catalog_items_dialog").modal("hide");
    });

    jQuery("#upload_catalog_items_form").iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_catalog_items_error_display tbody").html('');
                jQuery("#upload_catalog_items_error_display tbody").append(response.error_string);
                jQuery("#upload_catalog_items_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#catalog_items_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_catalog_items_saved_dialog").click(function(){
        location.reload();
    });

});


</script>
