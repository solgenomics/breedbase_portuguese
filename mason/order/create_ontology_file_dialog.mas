<div class="modal fade" id="create_ontology_file_dialog" name="create_ontology_file_dialog" tabindex="-1" role="dialog" aria-labelledby="createOntologyFileDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="createOntologyFileDialog">Criar arquivo de ontologia de acompanhamento para o aplicativo Fieldbook no Android</h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" >
                        <div class="form-group">
                            <label class="control-label col-sm-3">Ontologias:</label>
                            <div class="col-sm-9" >
                                <div class="input-group">
                                    <select class="form-control" id="ontology_list_select"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="ontology_file_name">Nome do arquivo:</label>
                            <div class="col-sm-9">
                                <input id="ontology_file_name" type="text" class="form-control" placeholder="Digite o nome aqui">
                            </div>
                        </div>
                    </form><br/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="create_ontology_file_cancel_button" id="create_ontology_file_cancel_button" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="create_ontology_file_submit_button" id="create_ontology_file_submit_button" title="Enviar">Criar arquivo</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready( function() {

    var lo = new CXGN.List();
    jQuery('#ontology_list_select').html(lo.listSelect('ontology_list_select', ['traits'], 'Selecione uma lista de ontologias', undefined, undefined));

    jQuery("#download_ontology_file_button").click( function() {
        jQuery('#create_ontology_file_dialog').modal('show');
    });
});

</script>
