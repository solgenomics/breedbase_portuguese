<%args>
  $organism
  $assembly_list
  $bug_tracker_url  => ''
  $bug_tracker_desc => 'assembly bug tracker'
</%args>

% if( @$assembly_list ) {
    <div style="margin: 1em 0">
%       for my $a (@$assembly_list) {
        <& /genomes/default/data_set.mas, a => $a &>
%       }
    </div>
    <&| /page/info_table.mas, border => 1 &>

    Problemas na montagem

    ----

      <p>Se, no decorrer do seu trabalho, você encontrar erros ou outros problemas nestas montagens de genoma, relate-os usando um dos seguintes links:</p>

      <ul>
        <li>
          <a href="mailto:<% $c->get_conf('feedback_email') %>?subject=<% $organism->species    %> genome assembly issue">envie-nos um e-mail</a>
        </li>
%       if( $bug_tracker_url ) {
        <li>
          <a href="<% $bug_tracker_url %>"><% $bug_tracker_desc %></a>
        </li>
%       }
      </ul>

    </&>
% }

