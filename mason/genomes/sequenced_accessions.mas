
<%args>
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /util/import_javascript.mas,
  entries => ["sequenced_accessions"]
&>


<& /page/page_title.mas, title=> "Acessos Sequenciados" &>

<div>
<table class="table table-condensed" cellspacing="20px" id="sequenced_stocks_table" >
<thead>
   <tr>
   <th>Acesso</th>
   <th>Ano</th>
<th>Organização</th>
   <th>Site</th>
<th>Analisar</th>
<th>Gerenciar</th>
   </tr>
</thead>
</table>
</div>
<!-- Dialog for adding sequencing info -->

<div class="modal fade" id="edit_sequencing_info_dialog" role="dialog">
    <div class="modal-dialog" role="modal">
        <div class="form-search">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><div aria-hidden="true">&times;</div></button>
                    <h5 class="modal-title">Informe os dados de sequenciamento do acesso:</h5>
                </div> <!-- modal-header -->
                <form id="sequencing_info_form" class="form-horizontal">
                    <div class="modal-body">
                        <div class="row">
                            <label class="col-sm-3 control-label">Organização: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" alt="Organização" placeholder="Organização responsável pelo sequenciamento" name="organization" id="organization" size="30" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Ano: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Ano do sequenciamento" name="sequencing_year" id="sequencing_year" size="6" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Site: </label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <span class="input-group-addon" id="https-prefix">https:&sol;&sol;</span>
                                    <input type="text" class="form-control" placeholder="Site" aria-label="https-prefix" aria-describedby="https-prefix" name="website"  id="website" size="10" />
                                </div>
                            </div> <!-- input-group -->
                            <br />
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">E-mail de contato: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="E-mail de contato" name="contact_email"  id="contact_email" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Acesso no GenBank: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Acesso no GenBank" name="genbank_accession"  id="genbank_accession" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Agência de financiamento: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Organização de financiamento" name="funded_by"  id="funded_by" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">ID do projeto na agência de financiamento: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="ID do projeto na organização financiadora"  name="funder_project_id" id="funder_project_id" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Link do JBrowse: </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Link do JBrowse" name="jbrowse_link" id="jbrowse_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Link do BLAST</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Link do BLAST" name="blast_link" id="blast_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Link FTP</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Link FTP" name="ftp_link" id="ftp_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Link do NCBI</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Link do NCBI" name="ncbi_link" id="ncbi_link" size="20" /><br />
                            </div>
                        </div>
                        <div>
                            <input type="hidden" id="stock_id"  name="stock_id" value="`+stock_id+`" />
                            <input type="hidden" id="stockprop_id"  name="stockprop_id" value="`+stockprop_id+`" />
                        </div>
                    </div> <!-- modal-body -->
                    <div class="modal-footer">
                        <button id="save_sequencing_info_button" type="submit" class="btn btn-primary">Salvar alterações</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                    </div> <!-- modal-footer -->
                </form> <!-- sequencing_info form -->
            </div> <!-- modal-content -->
        </div> <!-- form-search -->
    </div> <!-- modal-dialog -->
</div> <!-- modal -->


<div id="sequenced_stocks_div">
</div>

  <script>
    jQuery(document).ready( function() {
    //alert("HELLO");
    var sequenced_stocks = window.jsMod['sequenced_accessions'].init("sequenced_stocks_div");
    //alert("HELLO AGAIN!");
    });
  </script>
