<%args>
  $organism
</%args>
<& /page/page_title.mas, title => 'Dados do genoma de <i>'.$organism->species.'</i>' &>

<&| /page/info_section.mas,
      title       => 'Conjuntos de dados de sequência',
      collapsible => 1,
 &>
  <& /genomes/default/genome_builds.mas, %ARGS &>
</&>


<&| /page/info_section.mas,
      title       => 'Anotações navegáveis',
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /gbrowse/list_sources.mas, organism => $organism &>

</&>

<&| /page/info_section.mas,
      title       => 'Conjuntos de dados de anotação',
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /genomes/default/annotation_sets.mas, %ARGS &>

</&>
