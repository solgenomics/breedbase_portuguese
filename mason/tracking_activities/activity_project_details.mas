<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
$vendor_id
$parent_project_id
$activity_type
</%args>


<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome do projeto de atividades de rastreamento</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[Nome do projeto de atividades de rastreamento não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Tipo de registro</b></td>
                <td>
                    <div id="activity_type">
% if ($activity_type eq 'transformation') {
%     print 'Transformação';
% } elsif ($activity_type eq 'tissue_culture') {
%     print 'Cultura de tecidos';
% } else {
%   print "<span class='text-danger'>[Tipo de registro não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Programa de melhoramento </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
%  print "$breeding_program_name";
% }
% else {
%  print "<span class='text-danger'>[Programa de melhoramento não informado]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>Local</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name && ($location_name ne '[Computation]')) {
%  print "$location_name ($country_name)";
% } else {
%  print "<span class='text-danger'>[Local não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Ano</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[Ano não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Descrição</b></td>
                <td>
% if ($trial_description) {
%  print "<div id='trial_description' style='white-space: pre-wrap;'>$trial_description</div>";
% } else {
%  print "<div id='trial_description'><span class='text-danger'>[Descrição não informada]</span></div>";
% }
                </td>
            </tr>

            <tr>
                <td><b>Pasta</b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link">Massa Nova</button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link">Alterar pasta</button>
                </td>
            </tr>

            <tr>
                <td><b>Criado por</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[Não se aplica]</span>";
% }
                    </div>
                </td>
            </tr>
        </table>

    </div>
</div>
% if (!$vendor_id && !$parent_project_id) {
    <button class="btn btn-sm btn-primary" style="margin:3px" id="generate_identifiers_link">Gerar identificadores de rastreamento</button>
% }
</br>
</br>
% if ($parent_project_id) {
    <td>
        <a href='/breeders/trial/<%$parent_project_id%>'><p>Ir para a página de transformação</p></a>
    </td>
% }


<& /tracking_activities/generate_tracking_identifiers_dialog.mas, trial_name => $trial_name, breeding_program_name => $breeding_program_name &>
