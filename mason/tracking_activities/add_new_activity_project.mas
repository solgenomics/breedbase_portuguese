<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="create_activity_project_dialog" name="create_activity_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createActivityProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_activity_project_dismiss_button_1" name="add_activity_project_dismiss_button" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="creatActivityProjectDialog">Adicionar projeto de atividades de rastreamento</h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_tracking_activity_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> "Introdução" &>
                            <& /page/page_title.mas, title=>"Ferramenta de atividades de rastreamento" &>
                            <p>Use a ferramenta de rastreamento para acompanhar e registrar atividades relacionadas aos materiais armazenados no banco de dados (por exemplo, o processo de cultura de tecidos de um acesso). Os tipos de dados de cada processo podem ser personalizados (entre em contato conosco).</p>
                            <ul>
                                <li>O identificador de rastreamento é um nome globalmente exclusivo atribuído a cada material para registrar informações de rastreamento.</li>
                                <li>Os identificadores de rastreamento são organizados em projetos de atividades de rastreamento</li>
                                <li>Gere identificadores de rastreamento usando o link na página do projeto de atividades de rastreamento</li>
                                <li>A página de registro permite inserir diferentes tipos de dados. O link está na página do projeto. Para registrar novas informações, recupere um identificador de rastreamento lendo seu código de barras.</li>
                                <li>Cada identificador de rastreamento tem sua própria página de detalhes, onde também é possível registrar dados. Essa página exibe os detalhes de cada registro, incluindo valor, operador, data e hora, além de um resumo dos registros do mesmo tipo de dado</li>
                                <li>Para acompanhar a preparação dos itens solicitados pela ferramenta de pedidos, é possível integrá-la à ferramenta de rastreamento (entre em contato conosco).</li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_project" class="btn btn-primary" onclick="Workflow.complete(this);">Ir para a próxima etapa</button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_activity_project_form" id="create_activity_project_form">
                            <&| /util/workflow.mas:step, title=> "Adicionar informações do projeto" &>
                                <& /page/page_title.mas, title=>"Informe os dados básicos do projeto" &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable">Nome do projeto: </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="activity_project_name" name="activity_project_name"  />
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Tipo de atividade: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="activity_type" name="activity_type">
                                                <option value="">Selecione um tipo de atividade</option>
                                                <option value="tissue_culture">Cultura de tecidos</option>
                                                <option value="transformation">Transformação</option>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Programa de melhoramento: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="activity_project_program" name="activity_project_program">
                                                <option value="">Selecione o programa de melhoramento</option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Local deste projeto: </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="activity_project_location" name="activity_project_location">
                                                <option value="">Selecione o local</option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Ano:</label>
                                        <div class="col-sm-9">
                                            <div id="activity_project_year" name="activity_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Descrição:</label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="activity_project_description" name="activity_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="create_activity_project_submit" id="create_activity_project_submit">Enviar</button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> "Concluído" &>
                            <& /page/page_title.mas, title=>"O projeto foi salvo no banco de dados" &>
                            <ul>
                                <center><li>Use o link "Gerar identificadores de rastreamento" na página do projeto de atividades de rastreamento para gerar os identificadores de cada projeto.</li></center>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_activity_project_dismiss_button_2" name="add_activity_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#activity_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'activity_project_location');

    jQuery('#activity_project_program').change(function() {
        filter_options(jQuery('#activity_project_program option:selected').text(), 'program', 'activity_project_location');
    });

    jQuery("[name='add_activity_project_dismiss_button']").click(function() {
        jQuery('#create_activity_project_dialog').modal('hide');
        jQuery('#activity_project_name').val('');
        jQuery('#activity_project_program').val('');
        jQuery('#activity_project_location').val('');
        jQuery('#activity_project_project_year').val('');
        jQuery('#activity_project_description').val('');
    });

    jQuery('#create_activity_project_submit').click(function() {
        var project_name = jQuery("#activity_project_name").val();
        if (!project_name) {
            alert("O nome do projeto é obrigatório");
            return;
        }

        var activity_type = jQuery("#activity_type").val();
        if (!activity_type) {
            alert("O tipo de atividade é obrigatório");
            return;
        }

        var breeding_program = jQuery("#activity_project_program").val();
        if (!breeding_program) {
            alert("O programa de melhoramento é obrigatório");
            return;
        }

        var project_location = jQuery("#activity_project_location").val();
        if (!project_location) {
            alert ("O local é obrigatório");
            return;
        }

        var year = jQuery("#activity_project_year_select").val();
        if (!year) {
            alert ("O ano é obrigatório");
            return;
        }

        var project_description = jQuery("#activity_project_description").val();
        if (!project_description) {
            alert ("A descrição é obrigatória");
            return;
        }

        jQuery.ajax({
            url: '/ajax/tracking_activity/create_tracking_activity_project',
            dataType: "json",
            type: 'POST',
            data : {
                'project_name' : project_name,
                'activity_type': activity_type,
                'breeding_program': breeding_program,
                'project_location': project_location,
                'year': year,
                'project_description': project_description
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                if (response.error) {
                    jQuery('#working_modal').modal('hide');
                    alert(response.error);
                } else {
                    refreshActivityJsTree(0);
                    Workflow.focus("#add_tracking_activity_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_tracking_activity_project_workflow");
                    jQuery('#working_modal').modal('hide');
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Ocorreu um erro ao salvar o novo projeto de atividades de rastreamento');
            }
        });
    });

});

</script>
