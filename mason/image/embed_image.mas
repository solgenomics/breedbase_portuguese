
<%args>
$image_id
$size => "large"
$dbh
</%args>

<%perl>

  my $url = "";
  eval { 
    my $image = SGN::Image->new( $dbh, $image_id );
    $url = $image->get_image_url($size);
};
if ($@) { 
    print "Desculpe. Não foi possível obter a imagem # $image_id\n"; 
}
</%perl>

<img src="<% $url %>" />




   
    
