<table width="100%"><tr><td>

<h4>Lista de recursos</h4>

<!-- button id="add_feature_button">Adicionar característica</button><br / -->
<table id="vector_table" width="100%" class="display table table-hover table-striped">
<thead><tr><td>Nº</td><td>Característica</td><td>Início</td><td>Fim</td><td>Cor</td><td>Orientação</td><td>Ações</td></tr></thead><tbody></tbody></table>

<br />
<button type="button" id="open_add_feature_dialog_button" class="btn btn-primary" data-toggle="modal" >Adicione um novo recurso</button> <!-- data-target="#add_feature_dialog">Add Feature</button -->
<br />
<br />
<br />

<!-- Add a svg area, empty -->
</td><td width="160px">&nbsp;</td><td>

<h4>Lista de enzimas de restrição</h4>


<table id="re_sites_table" width="100%" class="display table table-hover table-striped">
<thead><tr><td>#</td><td>Sítio de restrição</td><td>Coordenada de corte</td><td>Ações</td></tr></thead><tbody></tbody></table>

<br /><br />
<button type="button" id="add_re_site_button" class="btn btn-primary" data-toggle="modal" >Adicione o local da enzima de restrição</button>
</td></tr></table>

<table id="metadata_table" width="40%" class="display table table-hover table-striped">
<thead><tr><td>Nome do vetor</td><td>Comprimento do vetor</td></tr></thead><tbody></tbody>
</table>

