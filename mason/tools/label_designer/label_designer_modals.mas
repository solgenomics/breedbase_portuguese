<div class="modal fade" id="customFieldModal" tabindex="-1" role="dialog" aria-labelledby="customFieldModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="row">
                    <center><label>Custom_Field:</label></center>
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <center>
                            <input type="text" class="form-control" id="d3-custom-input" placeholder="Digite aqui" autofocus>
                        </center>
                    </div>
                    <div class="col-md-3"></div>
                </div>
                <br>
                <div class="row">
                    <div class="col-md-6">
                        <center>
                            <label>Adicionar variável:</label><br>
                            <select id="d3-custom-add-field-input" class="form-control"></select>
                        </center>
                    </div>
                    <div class="col-md-6">
                        <center>
                            <label>Adicionar número personalizado:</label><br>
                            <input type="number" class="form-control" id="start_number" placeholder="Número de início">
                            <input type="number" class="form-control" id="increment_number" placeholder="Número de Incremento">
                            <button class="btn btn-primary" id="d3-add-number">Adicionar</button>
                        </center>
                    </div>
                </div>
                <br>
                <div class="row">
                    <center><button class="btn btn-primary" id="d3-custom-preview">Veja a visualização</button></center><br><br>
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <center><p id="d3-custom-content"></p></center>
                    </div>
                    <div class="col-md-3"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                <button id="d3-custom-field-save" type="button" class="btn btn-primary" data-dismiss="modal">Certo</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="editAdditionalSettingsModal" tabindex="-1" role="dialog" aria-labelledby="editAdditionalSettingsModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <center>
                            <label>Configurações adicionais:</label>
                        <br>
                        <img src="/static/img/print_setting_options.png" class="img-responsive" alt="Configurações da impressora" height="196" width="480" style="border: 1px solid black;">
                    </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <center>
                        <label class='radio'><input type="radio" name="dimoptradio2" id="dim_inches2" class="radio-select-imperial" value="inch">Imperial</label>
                        <label class='radio'><input type="radio" name="dimoptradio2" id="dim_cm2" class="radio-select-metric" value="cm" checked>Sistema métrico (cm)</label>
                    </center>
                    <div class="col-md-1">
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Margem superior:</label><br>
                            <input class="form-control"  type="number" id="top_margin" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Margem esquerda:</label><br>
                            <input class="form-control"  type="number" id="left_margin" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Gap horizontal:</label><br>
                            <input class="form-control"  type="number" id="horizontal_gap" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Gap vertical:</label><br>
                            <input class="form-control" type="number" id="vertical_gap" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Número de colunas:</label>
                            <input class="form-control" placeholder="Nom rótulos através" type="number" id="number_of_columns" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Número de linhas:</label>
                            <input class="form-control" placeholder="Etiquetas para baixo" type="number" id="number_of_rows" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                        <br><label>Limite por Rep:</label>
                            <select class="form-control" id="plot_filter" name="plot_filter" style="max-width: 100%">
                            </select>
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Cópias por rótulo:</label>
                            <input class="form-control" id="copies_per_plot" name="copies_per_plot" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Total # to download:</label>
                            <input class="form-control" id="label_designer_labels_to_download" name="label_designer_labels_to_download" type="number" placeholder="10" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5"></div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <br /><br />
                        <p><strong>Posição da Primeira Marca:</strong><br />
                        Defina a coluna e o número da linha de onde imprimir o primeiro rótulo, se usar uma folha que já foi parcialmente usada.</p>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Coluna inicial:</label>
                            <input class="form-control" id="start_col" name="start_col" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Linha de início:</label>
                            <input class="form-control" id="start_row" name="start_row" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                <button id="d3-edit-additional-settings" type="button" class="btn btn-primary" data-dismiss="modal">Salve</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="batchDownloadModal" tabindex="-1" role="dialog" aria-labelledby="batchDownloadModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <center>
                            <label>Lote Download:</label>
                        <br>
                        <p id="batch_download_message"></p>
                    </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Número de início:</label><br>
                            <input class="form-control" placeholder="0" type="number" id="label_designer_start_number" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label>Número final:</label><br>
                            <input class="form-control" placeholder="1000" type="number" id="label_designer_end_number" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                <button id="d3-batch-download-submit" type="button" class="btn btn-primary" data-dismiss="modal">Baixar</button>
            </div>
        </div>
    </div>
</div>
