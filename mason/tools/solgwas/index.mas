
<%doc>
</%doc>

<%args>

</%args>

<%perl>
  use JSON::Any;


</%perl>


<& '/util/import_javascript.mas', classes => ['jquery', 'jqueryui', 'CXGN.Login', 'd3.d3v4Min.js', 'CXGN.BreedersToolbox.HTMLSelect'] &>

<script src="https://cdn.jsdelivr.net/npm/vega@4"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@2"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@4"></script>

<& /page/page_title.mas, title=>"SolGWAS" &>

<&| /page/info_section.mas, id=>"input_dataset_section", title=>"Selecionar dados de entrada", collapsible=>1, collapsed=>0, subtitle=>'<a class="btn btn-link pull-right" href="/help/solgwas" target="_blank">Ajuda <span class="glyphicon glyphicon-question-sign"></span></a>' &>
  <input type="hidden" name="outformat" value="0" />


  <div class="form-group form-inline">
    <label for="dataset_select">Conjuntos de dados disponíveis: </label><div id="dataset_select"></div>
    <br>

    <button class="btn btn-info" id="createDataset"><span class="glyphicon glyphicon-plus"></span>&nbsp;&nbsp;Criar conjunto de dados</button>
    <button class="btn btn-primary" id="selectDataset" type="submit" name="selectDataset" value="selectDataset">Selecionar conjunto de dados</button>
    <br>
    <br>

    </div>
      <div class="form-group form-inline">
        <label class="blast_select_label" for="pheno_select">Características disponíveis: </label>        
        <& /page/html_select.mas, name=>'pheno_select', id=>'pheno_select', params=>"class\=\"form-control input-sm blast_select_box\"", choices=>"" &>                
        <button class="btn btn-primary" id="preview_trait_histogram_btn" type="submit" name="preview_trait_histogram_btn" value="preview_trait_histogram_btn">Ver histograma da característica</button>
        <img id="loading-spinner" src="/img/wheel.gif" alt="Carregando" style="visibility: hidden;">
        <br>
        <input type="checkbox" id="dataset_trait_outliers" />
        <label>Excluir outliers do conjunto de dados </label>
        <br>
        <br>
        <center>
          <div id="trait_histogram_plot">
          </div>
        </center>
        <br>
        <br>
        <div class="form-group form-inline">
          <input type="checkbox" id="kinshipmat" />
          <label>Incluir matriz de parentesco no modelo </label>
          <br>
          <input type="checkbox" id="princomp" />
          <label>Incluir componentes principais no modelo </label>
          <button class="btn btn-primary" id="preview_pca" type="submit" name="preview_pca" value="preview_pca">Ver gráfico de PCA</button>
        </div>
        <br>
        <br>
        <br>
        <center>
          <div id="pca_output"></div>
        </center>
        <br>

        <!--    <label class="blast_select_label" for="geno_select">Genotypes &nbsp; </label>
        <& /page/html_select.mas, name=>'geno_select', id=>'geno_select', params=>"class\=\"form-control input-sm blast_select_box\"", choices=>"" &> -->
        <br>    
      </div>

      <div style="text-align: center">
        <button class="btn btn-primary" id="runGWA" name="runGWA">Executar SolGWAS</button>
      </div>
      <br />

      <div id="tempfile" style="display:none" >
      </div>





</&>




<&| /page/info_section.mas, title=>"Saída", collapsible=>1, collapsed=>0, subtitle=>'<a id="download_table" class="download_tag" target="_blank" href="javascript:download_table();" title="Baixar resultados em formato tabular">Tabela&#8675;</a>&nbsp;&nbsp;<a id="download_basic" class="download_tag" target="_blank" href="javascript:download();" title="Baixar resultados em formato básico">Básico&#8675;</a>' &>



  <center>
    <div id="sgn_blast_graph" style="display:none">
        <div id="myCanvas">
          Seu navegador não suporta o canvas do HTML5
        </div>
    </div>
  </center>
  <br>
  <center>
    <div id="Solgwas_output"></div>
  </center>
  <div id="Overview_output"></div>
  <div id="Coverage_output"></div>
  <div id="Table_output" style="min-width:900px;"></div>
  <div id="Bioperl_output"></div>
  <div id="Basic_output"></div>

</&>

<script>

jQuery(document).ready(function() {

  if (isLoggedIn()) {
    get_select_box("datasets", "dataset_select", {"checkbox_name":"dataset_select_checkbox", "analysis_type":"GWAS", "show_compatibility":"yes"});
  }
  else {
    alert("Entre na sua conta para usar o SolGWAS");
  }
  $('#pheno_select').attr("disabled",true).html('');

  jQuery("#createDataset").click(function(e) {
    window.location = "/breeders/search/?dsp=genotyping_protocols,trials|traits,accessions&dsr=/tools/solgwas";
  });

  jQuery('#dataset_select').click(function() {
    $('#pheno_select').attr("disabled",true).html('');
    $('#trait_histogram_plot').html('');
    $('#pca_output').empty();
    $('#Solgwas_output').empty();
    $('#princomp').attr('checked', false);
    $('#kinshipmat').attr('checked', false);
  });

  jQuery('#selectDataset').click(function() {
    var dataset_id = get_dataset_id();
    if (!dataset_id) {
      return;
    }
    var dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;
    document.getElementById("preview_trait_histogram_btn").disabled = true;
    document.getElementById("loading-spinner").style.visibility = 'visible'; 
    $.ajax({
      url: '/ajax/solgwas/shared_phenotypes',
      data: {
        'dataset_id': dataset_id,
        'dataset_trait_outliers': dataset_trait_outliers,
      },
      success: function(response) {
        if (response.error) {
          $('#dataset_select').val('ERROR');
          document.getElementById("loading-spinner").style.visibility = 'hidden'; 
        }
        else {
          //	    alert(response.options);
          //	    	    alert(response.options.length);
	        var option_html = '<option selected="selected" value=""> </option>';
	        for (var i = 0; i < response.options.length; i++) {
	          option_html += '<option value="'+response.options[i][1]+'">'+(response.options[i][1])+'</option>';
	        }
	        $('#pheno_select').attr("disabled",false).html(option_html);
          jQuery('#tempfile').html(response.tempfile);
          document.getElementById("preview_trait_histogram_btn").disabled = false;
          document.getElementById("loading-spinner").style.visibility = 'hidden'; 
	      }
      },
      error: function(response) {
        alert("Ocorreu um erro. O serviço pode estar temporariamente indisponível");
        document.getElementById("preview_trait_histogram_btn").disabled = false;
        document.getElementById("loading-spinner").style.visibility = 'hidden'; 
      }
    });
  });

  jQuery('#dataset_trait_outliers').click(function() {
    var dataset_id = get_dataset_id();
    if (!dataset_id) {
      return;
    }
    var dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;
    document.getElementById("preview_trait_histogram_btn").disabled = true;
    document.getElementById("loading-spinner").style.visibility = 'visible'; 
    $.ajax({
      url: '/ajax/solgwas/shared_phenotypes',
      data: {
        'dataset_id': dataset_id,
        'dataset_trait_outliers': dataset_trait_outliers,
      },
      success: function(response) {
        if (response.error) {
          $('#dataset_select').val('ERROR');
          alert("Ocorreu um erro. Há um problema com os dados");
          document.getElementById("preview_trait_histogram_btn").disabled = false;          
          document.getElementById("loading-spinner").style.visibility = 'hidden'; 
        }        
        else {         	       
          jQuery('#tempfile').html(response.tempfile);
          document.getElementById("preview_trait_histogram_btn").disabled = false;
          document.getElementById("loading-spinner").style.visibility = 'hidden'; 
	      }
      },
      error: function(response) {
        alert("Ocorreu um erro. O serviço pode estar temporariamente indisponível");
        document.getElementById("preview_trait_histogram_btn").disabled = false;
        document.getElementById("loading-spinner").style.visibility = 'hidden'; 
      }
    });
  });


  jQuery('#preview_trait_histogram_btn').on('click', function() {
    if (!jQuery('#pheno_select').val()) {
      alert("Selecione um conjunto de dados e uma característica.")
    } else {
      //alert("Inside trait preview");
      var tempfile = jQuery('#tempfile').html();
      var trait = jQuery('#pheno_select').val();
      //alert(trait);
      jQuery.ajax( {
          url: '/ajax/solgwas/getdata',
          data: { 'file' : tempfile },
          success: function(r)  {
          //alert("data grabbed "+JSON.stringify(r.data));
          var v = {
              "$schema": "https://vega.github.io/schema/vega-lite/v2.json",
              "width": 200,
              "height": 100,
              "padding": 5,
              "data": { 'values': r.data },
              "mark": "bar",
              "encoding": {
              "x": {
                "bin": true,
                "field": trait,
                "type": "quantitative"
              },
              "y": {
                "aggregate": "count",
                "type": "quantitative"
              }
             }
            };

            //alert("embedding"+ JSON.stringify(v));
            vegaEmbed("#trait_histogram_plot", v);
            //alert("done");
          },


        error: function(e) { alert("erro!"); }
      });
    };
  });


  jQuery('#preview_pca').click( function () {
    if (!jQuery('#pheno_select').val()) {
      alert("Selecione um conjunto de dados e uma característica.")
    } else {
      $('#pca_output').empty();
      if ($('#pheno_select').val() != ""){
        var dataset_id = get_dataset_id();
        var trait_id = $('#pheno_select').val();        
        $.ajax({
          url: '/ajax/solgwas/generate_pca',
          async: true,
          data: {
            'dataset_id': dataset_id, 
            'trait_id': trait_id,            
            },
  	      beforeSend: function() {
            jQuery("#working_modal").modal("show");
  	      },
          success: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error) {
              $('#dataset_select').val('ERROR');
            }
            else {
              var fig2_response = response.figure2;
  	            $('#pca_output').append("<img id='SolGWAS_Figure2' src='"+ fig2_response + "'/>");
  	      }
          },
          error: function(response) {
            alert("Ocorreu um erro. O serviço pode estar temporariamente indisponível");
          }
        });
      }
    };
  });

  jQuery('#runGWA').click( function () {
    if (!jQuery('#pheno_select').val()) {
      alert("Selecione um conjunto de dados e uma característica.")
      $('#Solgwas_output').empty();
    } else {
      $('#Solgwas_output').empty();
      if ($('#pheno_select').val() != ""){
        var dataset_id = get_dataset_id();
        var trait_id = $('#pheno_select').val();
        var pc_check = 0;
        var kinship_check = 0;
        if ($('#princomp').is(':checked')) {
          var pc_check = 1;
        }
        if ($('#kinshipmat').is(':checked')) {
          var kinship_check = 1;
        }
        var dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;
        //alert(pc_check);
        //alert(kinship_check);
        //alert("Dataset ID: "+dataset_id);
        //alert("Pheno ID: "+trait_id);
        $.ajax({
          url: '/ajax/solgwas/generate_results',
          data: {
            'dataset_id': dataset_id,
            'trait_id': trait_id,
            'pc_check': pc_check,
            'kinship_check': kinship_check,
            'dataset_trait_outliers': dataset_trait_outliers,
            },
  	      beforeSend: function() {
            jQuery("#working_modal").modal("show");
  	      },
          timeout: 30000000,
          success: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error) {
              alert(response.error);
            }
            else {
              var fig3_response = response.figure3;
              var fig4_response = response.figure4;
  	          //alert("Response ID: "+temp_response);
      	      //alert("Response ID: "+fig3_response);

  	          $('#Solgwas_output').append("<img id='SolGWAS_Figure3' src='"+ fig3_response + "'/>");
  	          $('#Solgwas_output').append("<img id='SolGWAS_Figure4' src='"+ fig4_response + "'/>");
  	        }
          },
          error: function(xhr, status, error) {
            var err = eval("(" + xhr.responseText + ")");
            alert(err.Message);
          }
        });
      }
    };
  });

  function get_dataset_id() {
      var selected_datasets = [];
      jQuery('input[name="dataset_select_checkbox"]:checked').each(function() {
          selected_datasets.push(jQuery(this).val());
      });
      if (selected_datasets.length < 1){
          alert("Selecione pelo menos um conjunto de dados!");
          return false;
      } else if (selected_datasets.length > 1){
          alert("Selecione apenas um conjunto de dados!");
          return false;
      } else {
  	var dataset_id=selected_datasets[0];
  	return dataset_id;
    }
  }
});



</script>


<!-- STYLE -->
<style>

h1 {
  display:none;
}

.seq_map {
	color: #777777;
	width: 700px;
	position:relative;
	overflow: auto;
	align: left;
}

.blast_select_box {
  width:300px;
  margin-right:10px;
}

.blast_select_label {
  width:100px;
  margin-right:10px;
  line-height: 32px;
}

.ui-dialog {
	position:relative;
}

#region_square {
	position:absolute;
	vertical-align:middle;
}
.help_dialog {
	color:blue;
	cursor:pointer
}
#desc_dialog {
	overflow: auto;
	position: relative;
}
.help_box {
	background-color:#EEEEFE;
	border-color:#AAA;
	border-width:2px;
	border-style:solid;
	border-radius:5px;
	padding-left: 10px;
	padding-right: 10px;
}

#sequence {
  min-height: 80px;
  max-height: 300px;
  max-width: 98%;
}

.download_tag {
  display:none;
}

/* BLAST canvas Graph */

.width-1000 {
  width: 1000px;
  text-align: center;
}

#sgn_blast_graph {
  overflow:hidden;
}

#myCanvas {
  height:450px;
  width:1020px;
  overflow:scroll;
  overflow-x: hidden;
}


</style>
