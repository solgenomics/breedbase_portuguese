<%args>
$transcriptomics_files => undef
$deleted_transcriptomics_files => undef
$all_transcriptomics_files => undef
$all_deleted_transcriptomics_files => undef
$locations => undef
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /tools/high_dimensional_phenotypes/upload_high_dim_spreadsheet_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<div class="well">
<&| /page/info_section.mas, title=>'Dados transcriptômicos enviados', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Visualize e gerencie os arquivos de dados transcriptômicos enviados' &>

    <&| /page/info_section.mas, title=>'Seus dados transcriptômicos enviados', is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Seus dados transcriptômicos obsoletos', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Estes são arquivos transcriptômicos excluídos' &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$deleted_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Todos os dados transcriptômicos enviados', is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Todos os dados transcriptômicos obsoletos', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Estes são arquivos transcriptômicos excluídos' &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_deleted_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
</&>
</div>

<div class="well">
<&| /page/info_section.mas, title=>'Análises transcriptômicas', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Visualize e gerencie suas análises transcriptômicas' &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="analyses_by_user_table">
              <thead>
              <tr>
                <th>
                  Nome da análise
                </th>
                <th>
                  Descrição
                </th>
                <th>
                  Tipo de modelo
                </th>
                <th>
                  Protocolo
                </th>
                <th>
                  Aplicação
                </th>
                <th>
                  Linguagem
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>

