
<%args>
$seq_id
$build
$family
$desc => undef
$seq => undef

</%args>


<h1>Detalhes da sequência</h1>

<h2>Identificador</h2>

<% $seq_id %></h1>

<h2>Visualizando Construir</h2>

<% $build %>

<h2>Família</h2>

<a href="/tools/genefamily/details/<% $build %>/<% $family %>"><% $family %></a>

<h2>Descrição</h2>

<% $desc %>

<h2>Sequência</h2>

Comprimento: <% length($seq) %>

<pre>
% $seq =~ s/(.{60})/$1\n/g;
<% $seq %>
</pre>
