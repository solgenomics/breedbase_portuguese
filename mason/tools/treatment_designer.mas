<%args>
    $exp_treatment_root
    $db_name
</%args>

<div style="text-align: center; margin: 2em 0">
   <h2 style="margin-bottom: 1em">Projete novos tratamentos experimentais</h2>
   <h4>Tratamentos experimentais são aplicados aos materiais de um ensaio. Subparcelas, plantas e amostras de tecido herdam tratamentos de seus materiais de pais.</h4>

   <h4> Verifique o <a href='/search/treatments'>Página de busca de tratamento</a> para ver se seu tratamento já foi feito antes de projetar novos tratamentos.</h4>

    <br>

   <div class="container-fluid">
        <form class="form-horizontal" role="form" method="post" id="new_treatment_design_form" name="new_treatment_design_form">
        <div class="form-group">
                <label class="col-sm-3 control-label"> Novo nome de tratamento: </label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_name" name="new_treatment_name" type="text" placeholder="Os tubos serão removidos do nome."/>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Definição:</label>
                <div class="col-sm-9">
                    <textarea style="width:70%;" class="form-control" id="new_treatment_definition" name="new_treatment_definition" placeholder="Que seja descritivo. Não se esqueça de descrever os significados da categoria usando dados categóricos."></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Formato do tratamento:</label>
                <div class="col-sm-9">
                    <select style="width:70%;" class="form-control" id="new_treatment_format_select" name="new_treatment_format_select" type="select">
                        <option value="numeric" selected>Numérica</option>
                        <option value="categorical">Categorial</option>
                        <option value="percent">Percentagem</option>
                        <option value="boolean">Booleano</option>
                        <option value="date">Data</option>
                        <option value="text">Texto</option>
                        <option value="counter">Contador</option>
                        <option value="ontology">Ontologia (termos de pai para filho)</option>
                    </select>
                </div>
            </div>
            <div class="form-group" id="new_treatment_repeat_select_container">
                <label class="col-sm-3 control-label">Tipo de aplicação:</label>
                <div class="col-sm-9">
                    <select style="width:70%;" class="form-control" id="new_treatment_repeat_select" name="new_treatment_repeat_select" type="select">
                        <option value="single" selected>Uma única aplicação</option>
                        <option value="multiple">Aplicação repetida</option>
                        <option value="time_series">Séries temporais</option>
                    </select>
                </div>
            </div>
            <div class="form-group" id="new_treatment_default_value_container">
                <label class="col-sm-3 control-label" id="new_treatment_default_value_label">Valor padrão:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_default_value" name="new_treatment_default_value" type="text" placeholder="(Opcional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_minimum_value_container">
                <label class="col-sm-3 control-label">Valor mínimo:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_min_value" name="new_treatment_min_value" type="text" placeholder="(Opcional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_maximum_value_container">
                <label class="col-sm-3 control-label">Valor máximo:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_max_value" name="new_treatment_max_value" type="text" placeholder="(Opcional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_add_categories_container" style="display:none;">
                <label class="col-sm-3 control-label">Adicione categorias:</label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_add_category" name="new_treatment_add_category" type="text" placeholder="Opcional. Sem personagens especiais."/></td>
                            <td style="width:25%"><input  class="form-control" id="new_treatment_category_ordinal" name="new_treatment_category_ordinal" type="number" placeholder="Ordenar"></td>
                            <td><button id="new_treatment_add_category_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <table id="new_treatment_categories" style="width:30%;">
                    </table>
                    <button id="new_treatment_remove_category_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
            <div class="form-group" id="chain_parent_term_container">
                <label class="col-sm-3 control-label" id="chain_parent_term"><span class="glyphicon glyphicon-question-sign" style="color:blue;font-size:18px" title="Não deveria ser um termo variável. Será o termo raiz do tratamento por padrão se nenhum for adicionado."></span>Corrente ao termo existente:</label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_parent_term" name="new_treatment_parent_term" type="text" placeholder="Nome completo, como em &#x27;Legacy experiment treatment|EXPERIMENT_TREATMENT:0000001&#x27;"/></td>
                            <td><button id="new_treatment_add_parent_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <ul id="new_treatment_parents" style="text-align:left;width:70%;padding-left:1em;list-style-type:disc;"></ul>
                    <button id="new_treatment_remove_parent_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
        </form>
        <button class="btn btn-primary" id="new_treatment_submit_btn">Enviar</button>
    </div>
</div>

<button id="download_ontology_btn" class="btn btn-primary">Baixe a Ontologia do Tratamento</button>
<br>
<br>
<& /ontology/embedded_browser.mas, cvterm => $exp_treatment_root &>

<script>
    jQuery(document).ready(function () {

        jQuery('#new_treatment_submit_btn').on('click', function () {

            jQuery('#working_modal').modal("show");

            let name = jQuery('#new_treatment_name').val();
            let definition = jQuery('#new_treatment_definition').val();
            let format = jQuery('#new_treatment_format_select').val();
            let default_value = jQuery('#new_treatment_default_value').val();
            let minimum = jQuery('#new_treatment_minimum').val();
            let maximum = jQuery('#new_treatment_maximum').val();
            let repeat_type = jQuery('#new_treatment_repeat_select').val();
            let categories = JSON.parse(html_table_to_json(jQuery('#new_treatment_categories').html()));
            let cat_list = [];
            let cat_details_list = [];
            Object.keys(categories).sort().forEach(key => {
                cat_list.push( key );
                cat_details_list.push(categories[key]);
            });
            categories = cat_list.join('/');
            let category_details = cat_details_list.join('/');
            let parent_terms = [];
            jQuery('#new_treatment_parents li').each(function() {
                parent_terms.push(jQuery(this).text());
            });
            let parent_terms_json = JSON.stringify(parent_terms);

            jQuery.ajax({
                url: '/ajax/treatment/create',
                data : {
                    definition : definition,
                    name : name,
                    format : format,
                    default_value : default_value,
                    minimum : minimum,
                    maximum : maximum,
                    categories : categories,
                    category_details : category_details,
                    parent_terms : parent_terms_json,
                    repeat_type : repeat_type
                },
                success: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert(response.error);
                    } else {
                        alert("Novo tratamento salvo.");
                        window.location.reload();
                    }
                },
                error: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    console.log(response);
                    alert("Ocorreu um erro. Consulte o console.");
                }
            });
        });

        jQuery('#new_treatment_parent_term').autocomplete({
            source : '/ajax/cvterm/autocompleteslim' + "?db_name=<% $db_name %>"
        });

        jQuery('#new_treatment_add_parent_btn').on('click', function(e) {
            e.preventDefault();
            let parent_term = jQuery('#new_treatment_parent_term').val().trim();
            if (parent_term) {
                jQuery('<li>').text(parent_term).appendTo('#new_treatment_parents');
                jQuery('#new_treatment_remove_parent_btn').show();
                jQuery('#new_treatment_parent_term').val('');
            }
        });

        jQuery('#new_treatment_remove_parent_btn').on('click', function(e) {
            e.preventDefault();
            jQuery('#new_treatment_parents li:last').remove();
            if (jQuery('#new_treatment_parents li').length === 0) {
                jQuery('#new_treatment_remove_parent_btn').hide();
            }
        });

        jQuery('#new_treatment_format_select').on('change', function () {
            let treatment_type = jQuery(this).val();
            if (treatment_type === 'numeric') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Valor padrão:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'categorical') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').show();
                jQuery('#new_treatment_default_value_label').html("Categoria padrão:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'ontology') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').hide();
                jQuery('#new_treatment_repeat_select_container').hide();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'percent') { 
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Valor padrão:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('100');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'counter') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Valor padrão:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'boolean') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Valor padrão:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('1');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'date') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'text') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            }
        });

        jQuery('#new_treatment_add_category_btn').on('click',function(e) {
            e.preventDefault();
            let new_category = jQuery('#new_treatment_add_category').val();
            let new_ordinal = jQuery('#new_treatment_category_ordinal').val();

            if (! new_ordinal) {
                alert("Atribua um valor ordinal à nova categoria.");
                return;
            }

            if (new_category.includes('/') || new_category.includes('=')){
                alert("Não use caracteres especiais.");
                return;
            }

            if (new_category !== null && new_category !== "" && new_category.trim() !== "" ) {
                let table_str = jQuery('#new_treatment_categories').html();
                let table_elems = [];
                if (table_str && table_str.trim() !== "") {
                    table_elems = JSON.parse(html_table_to_json(table_str));
                }
                table_elems[new_ordinal] = new_category;
                table_str = json_to_html_table(table_elems);
                jQuery('#new_treatment_categories').html(table_str);
                if (Object.keys(table_elems).length > 0) {
                    jQuery('#new_treatment_remove_category_btn').css('display', '');
                }
            }
            jQuery('#new_treatment_add_category').val('');
            jQuery('#new_treatment_category_ordinal').val('');
        });

        jQuery('#new_treatment_remove_category_btn').on('click',function(e) {
            e.preventDefault();
            let table_str = jQuery('#new_treatment_categories').html();
            let table_elems = JSON.parse(html_table_to_json(table_str));
            let max_key = Math.max( ... Object.keys(table_elems).map(Number));
            delete table_elems[max_key];
            if (Object.keys(table_elems).length == 0) {
                jQuery('#new_treatment_remove_category_btn').css('display', 'none');
            }
            table_str = json_to_html_table(table_elems);
            jQuery('#new_treatment_categories').html(table_str);
        });

        jQuery('#download_ontology_btn').click(function() {

            jQuery('#working_modal').modal("show");

            fetch("/ajax/onto/download_obo/<% $db_name %>")
                .then(response => response.blob())
                .then(blob => {
                    jQuery('#working_modal').modal("hide");
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = "<% $db_name %>.txt";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                })
                .catch(error => {
                    jQuery('#working_modal').modal("hide");
                    alert("Ocorreu um erro: " + error);
                    console.error("Falha ao baixar:", error)
                });
        });

        function html_table_to_json(html_str) {
            let list = html_str.replace(/^<tr>|<\/?table>|<tr>|^\s+|<td>|<\/td>|<\/tr>$|\s+$/g,'').split("</tr>").filter(str => str.trim() !== '');
            let object = Object.fromEntries(list.map(cat => {
                    const [key, value] = cat.split("=").map(s => s.trim());
                    return [key, value];
                })
            );
            return JSON.stringify(object);
        }

        function json_to_html_table(json) {
            let html_arr = [];
            Object.keys(json).sort().forEach(key => {
                html_arr.push( key + " = " + json[key]);
            });
            return "<tr><td>"+html_arr.join("</td></tr><tr><td>")+"</td></tr>";
        }
    });
</script>