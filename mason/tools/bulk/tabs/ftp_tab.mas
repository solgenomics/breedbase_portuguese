
<%perl>

=head2 ftp_site

  Desc: sub ftp_site
  Args: n/a
  Ret : ftp tab format

  Defines the format of the ftp tab using html & perl. Specifies
  links for downloading ftp information.

=cut

print <<HTML;
    <h3 style="margin-bottom: 0.3em">Site FTP da SGN</h3>
	<div style="margin: 0 1em 0 1em">Baixe conjuntos de dados completos.</div><br />

    <div style="margin: 0; padding: 1em; border: 1px solid #ccccff">
	<a class="folderlink" href="ftp://ftp.solgenomics.net">nível superior do FTP</a>
	
	<ul style="margin: 1em 0 0 0; list-style: none">
	
HTML

    my %ftplinks = (
        'unigene_builds' =>
'Informações de sequência, qualidade e membros de todos os builds de unigenes da SGN',
        'est_sequences' =>
          'Arquivos de sequência e qualidade de todos os ESTs da SGN, organizados por biblioteca',
        'maps_and_markers' =>
          'Sequências de marcadores e listas de posições de marcadores de todos os mapas da SGN',
        'physical_mapping' =>
'Arquivos de dados brutos das análises de FPC e overgo da biblioteca de BACs HindIII de tomate',
        'blast_annotations' =>
'Melhores resultados contra GenBank NR e Arabidopsis para todos os unigenes da SGN.',
        'manual_annotations' =>
          'Anotações manuais de diversos unigenes da SGN',
        'user_requests' =>
'Conjuntos de dados personalizados para usuários individuais (envie pedidos especiais para <a href="mailto:sgn-feedback@sgn.cornell.edu">sgn-feedback</a>)',
        'genomes/Solanum_lycopersicum' =>
          'Dados genômicos do tomate, incluindo sequências de extremidades de BAC e de BACs completos',
	  'genomes/Solanum_tuberosum' => 
	  'Dados do genoma da batata',
	  'genomes/Nicotiana_benthamiana' => 'Dados do genoma de Nicotiana benthamiana',
	  'genomes/Solanum_melongena_consortium' => 'Dados do genoma da berinjela V3',
        'COSII' => 'Dados de marcadores COSII'
    );

    foreach my $dir ( sort keys %ftplinks ) {
        my $desc = $ftplinks{$dir};
        print <<HTML;
	<li><a class="folderlink" href="ftp://ftp.solgenomics.net/$dir"> $dir</a>
	    <div class="folderdesc">$desc</div>
	</li>
HTML
    }

    print <<HTML;
        </ul>
    </div>

	<br />
	<i>Observação:</i> O site FTP da SGN também pode ser acessado diretamente em <a href="ftp://ftp.solgenomics.net">ftp://ftp.solgenomics.net</a> usando um navegador ou programa de FTP.
HTML




</%perl>
