
<%args>
$ug_build_select => ''
$debug => ''
</%args>


<form name="bulkform" action="/tools/bulk/download" method="post" enctype="multipart/form-data">
  
  <br />
  <table summary="" cellpadding="10" width="100%"><tr><td valign="top" bgcolor="#EEEEEE" width="320">
	
	<% $ug_build_select %>
	<br />
	
	Digite uma lista de identificadores ou carregue um arquivo contendo identificadores, um por linha:<br />
	<table summary="" width="100%"><tr><td>
	      <textarea id="ids" name="ids" rows="5" cols="20"></textarea>
	    </td>
	    <td>
	      <i>Exemplo:</i> #example box
	      <div style="border: 1px solid gray; width: 10em; height: 5em">
<pre><div id="clone_example_ids">cLEB-1-A2
cLEB-1-A3
cLEB-1-A4</div></pre><a href="javascript:copy_example_data()">Entendido</a>
</div> 

<script>
function copy_example_data() { 
document.getElementById("ids").innerHTML=document.getElementById("clone_example_ids").innerHTML;
}
</script>
	 
	</td></tr></table>
	
	<br />
	<br />
	E/ou arquivo de lista de upload: <br /><input type="file" name="file" />
	<br />
	<br />
	
    </td><td valign="top" bgcolor="#EEEEEE" width="320">
	<b>Por favor, selecione as informações que deseja para cada identificador:</b><br />
	<input type="checkbox" name="clone_name" checked="checked" /> Nome do clone<br />
	<input type="checkbox" name="SGN_C" checked="checked" /> Clone id (SGN-C)<br />
	<input type="checkbox" name="SGN_T" checked="checked" /> sequência lida id (SGN-T)<br />
	<input type="checkbox" name="SGN_E" checked="checked" /> est id (SGN-E)<br />
	<input type="checkbox" name="build_nr" checked="checked" /> Unigene construir nr<br />
	<input type="checkbox" name="SGN_U" checked="checked" /> Unigene id (SGN-U)<br />
	<input type="checkbox" name="chipname" checked="checked" /> chipname<br />
	<input type="checkbox" name="SGN_S" checked="checked" /> SGN-S<br />
	<input type="checkbox" name="TUS" checked="checked" /> Número TUS (usado para encomendar clones)<br />
	<input type="checkbox" name="manual_annotation" /> Anotação manual<br />
	<input type="checkbox" name="automatic_annotation" /> Anotação automática (BLAST)<br />
	<input type="checkbox" name="sequence" onclick="check_fasta_option()" /> Sequência<br />
	&nbsp;&nbsp;&nbsp;<input type="radio" name="seq_type" value="est_seq" checked="checked" /> Sequência EST<br />
	&nbsp;&nbsp;&nbsp;<input type="radio" name="seq_type" value="unigene_seq" /> Sequência Unigene<br />

</td></tr></table>

%    if ( $debug eq "1" ) {
%        print
%qq|<input type="checkbox" checked="checked" name="debug" /> print debug statements<br /><br />\n|;
%    }

 	<input type="hidden" name="idType" value="clone" />
	<input type="reset" />&nbsp;&nbsp;
        <input type="submit" value="Enviar" /><br />
   </form>


