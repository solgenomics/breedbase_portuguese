<%args>
$high_dimensional_phenotype_type => undef #either NIRS, Transcriptomics, Metabolomics
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form' ] &>

<!--button class="btn btn-primary" name="upload_high_dim_phenotypes_spreadsheet_link">Upload High Dimensional Data</button-->

<%perl>
my @instrument_model_options = split ",", $c->config->{instrument_model_options};
my @library_method_options = split ",", $c->config->{library_method_options};
my @layout_options = split ",", $c->config->{layout_options};
my @mapping_software_options = split ",", $c->config->{mapping_software_options};
my @sequencing_platform_options = split ",", $c->config->{sequencing_platform_options};
my @na_extraction_method_options = split ",", $c->config->{na_extraction_method_options};
my @sequencing_center_options = split ",", $c->config->{genotyping_facilities};
</%perl>

<div class="modal fade" id="upload_high_dim_phenotypes_spreadsheet_dialog" name="upload_high_dim_phenotypes_spreadsheet_dialog" tabindex="-1" role="dialog" aria-labelledby="addHighDimDataDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addHighDimDataDialog">Envie dados fenotipos de alta dimensão</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /util/workflow.mas, id=> "high_dim_data_upload_workflow" &>
                <&| /util/workflow.mas:step, title=> "Introdução" &>
                    <& /page/page_title.mas, title=>"Este fluxo de trabalho irá guiá-lo através do upload de dados de alta dimensão no banco de dados." &>

                    <center>
                        <div class="well">
                            <h4>Dados de fenótipo de alta dimensão incluem:</h4>
                            <p>NIRS</p>
                            <p>Transcrição</p>
                            <p>Metabolômica</p>
                        </div>
                    </center>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Vá para o próximo passo</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Amostras" &>
                    <& /page/page_title.mas, title=>"Certifique-se de que suas amostras já estão no banco de dados." &>

                    <center>
                        <div class="well">
                            <h4>As amostras para as quais você está carregando fenótipos de alta dimensão já devem existir no banco de dados. Podem ser entidades de campo, como nomes de parcelas, nomes de plantas e nomes de amostras de tecido. Podem ser nomes de amostras de tecido. Também podem ser nomes de amostras de um ensaio de amostragem no banco de dados.</h4>
                            <p>Vá para <a href="/breeders/samples">Gerenciar amostras de tecido</a> para mais orientação.</p>
                            <p>Você pode carregar ou criar um novo ensaio de amostragem <button class="btn btn-sm btn-primary" style="margin:3px" name="create_sampling_trial_button">Criar um novo ensaio de amostragem</button></p>
                        </div>
                    </center>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">Vá para o próximo passo</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Tipo de Dados" &>
                    <& /page/page_title.mas, title=>"Selecione o tipo de dados de alta dimensão que estão sendo enviados" &>
                    <br/><br/>
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Tipo de dados: </label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="high_dim_data_upload_type_select">
%  if ($high_dimensional_phenotype_type eq 'NIRS') {
                                    <option value="">Selecione um</option>
                                    <option value="NIRS">NIRS</option>
                                    <option disabled value="Transcriptomics">Transcrição</option>
                                    <option disabled value="Metabolomics">Metabolômica</option>
%  } elsif ($high_dimensional_phenotype_type eq 'Transcriptomics') {
                                    <option value="">Selecione um</option>
                                    <option value="Transcriptomics">Transcrição</option>
                                    <option disabled value="NIRS">NIRS</option>
                                    <option disabled value="Metabolomics">Metabolômica</option>
%  } elsif ($high_dimensional_phenotype_type eq 'Metabolomics') {
                                    <option value="">Selecione um</option>
                                    <option value="Metabolomics">Metabolômica</option>
                                    <option disabled value="Transcriptomics">Transcrição</option>
                                    <option disabled value="NIRS">NIRS</option>
%  } else {
                                    <option value="">Selecione um</option>
                                    <option value="NIRS">NIRS</option>
                                    <option value="Transcriptomics">Transcrição</option>
                                    <option value="Metabolomics">Metabolômica</option>
%  }
                                </select>
                            </div>
                        </div>
                    </form>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_data_type_step">Vá para o próximo passo</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Informação do Protocolo" &>
                    <& /page/page_title.mas, title=>"Selecione um protocolo para como seus dados foram gerados ou crie um novo protocolo." &>

                    <div id="high_dim_data_upload_protocol_select">
                    </div>

                    <hr>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_new_protocol">Protocolo não mostrado. Criar um Novo Protocolo</button>
                    </center>
                    <br/><br/>

                    <div id="high_dim_data_upload_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Nome do protocolo: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_protocol_name" type="text">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Descrição do protocolo: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_protocol_desc"  type="text">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="high_dim_data_upload_nirs_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Dispositivo NIRS: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_nirs_device_type_select">
                                        <option value="SCIO">SCIO</option>
                                        <option value="QST">QST</option>
                                        <option value="Foss6500">Foss6500</option>
                                        <option value="Foss DS2500">Foss DS2500</option>
                                        <option value="Foss XDS">Foss XDS</option>
                                        <option value="BunchiN500">BunchiN500</option>
                                        <option value="LinkSquare">LinkSquare</option>
                                        <option value="ASD Qualityspec">ASD Qualityspec</option>
                                        <option value="ASD LabSpec">ASD Lab Spec</option>
                                        <option value="Specim FX17">Specim FX17</option>
                                        <option value="FTIR6X">FT/IR-6X</option>
                                        <option value="InnoSpectraNIR-S-G1">InnoSpectraNIR-S-G1</option>
                                        <option value="Viavi microNIR">Viavi microNIR</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="high_dim_data_upload_transcriptomics_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Unidade de Transcrição: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_unit_select">
                                    <option value="RPKM">RPKM</option>
                                    <option value="FPKM">FPKM</option>
                                    <option value="TPM">TPM</option>
                                    <option value="VST">VST</option>
                                    <option value="RawCount">RawCount</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Versão Genoma: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_genome_version_select" type="text" placeholder="ex.: v6.1, v7.0, v8.0">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Versão da Anotação Genoma: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_genome_annotation_version_select" type="text" placeholder="ex.: v6.0, v6.1, v7.0">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Modelo do instrumento: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_instrument_model_select">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $model_option (@instrument_model_options) {
                                    </%perl>
                                    <option value="<% $model_option %>"><% $model_option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Disposição espacial: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_layout_select" type = "text" placeholder="Por exemplo. Fim emparelhado">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@layout_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Método da Biblioteca: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_library_method_select">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@library_method_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Comentários da Biblioteca: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_library_comments_select" type = "text" placeholder="Por exemplo. Usei o método 3&#x27;RNA-seq">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Software de mapeamento: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_mapping_software_select" type = "text" placeholder="Por exemplo. HISAT2">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@mapping_software_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Sequencing Center: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_sequencing_center_select" type = "text" placeholder="Por exemplo. Instituto Universitário de Biotecnologia de Cornell">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@sequencing_center_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Sequencing Platform: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_sequencing_platform_select" type = "text" placeholder="Por exemplo. Illumina">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@sequencing_platform_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Comprimento de leitura: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_read_length_select" type = "text" placeholder="Por exemplo, 5x de profundidade com 150 bp">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Método de extração de ácido nucleico: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_nucleic_acid_extraction_method_select" type = "text" placeholder="Por exemplo. Borato quente">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@na_extraction_method_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div id="high_dim_data_upload_metabolomics_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Tipo de Equipamento: </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_metabolomics_equipment_type">
                                        <option value="NMR">NMR</option>
                                        <option value="MS">MS</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Alvo: </label>
                                <div class="col-sm-9" >
                                <select class="form-control" id="high_dim_data_upload_metabolomics_targeted">
                                    <option value="True">Verdade</option>
                                    <option value="False">Falso</option>
                                </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Protocolo de Fenótipo: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_phenotype_type" type="text" placeholder="Por exemplo, abundância relativa, BLUP, drBLUP, concentração">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Unidades fenotípicas: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_phenotype_units" type="text" placeholder="Por exemplo, ug/g">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Protocolo de coleta de amostras: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_sample_collection_protocol" type="text" placeholder="Por exemplo, sementes maduras de aveia descascadas">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Protocolo de extração de amostras: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_sample_extraction_protocol" type="text" placeholder="Por exemplo, descrever protocolo de extração usado">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Protocolo de Transformação de Dados Raw: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_rawdata_transformation_protocol" type="text" placeholder="Por exemplo, descrever o protocolo de transformação de dados em bruto usado">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Protocolo de identificação de metabolitos: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_metabolite_identification_protocol" type="text" placeholder="Por exemplo, descrever o protocolo de identificação metabolômica usado">
                                </div>
                            </div>
                        </div>

                        <div id="high_dim_data_upload_metabolomics_protocol_ms_div" style="display:none">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Tipo de Cromatografia: </label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="high_dim_data_upload_metabolomics_chromatography_type">
                                            <option value="LCMS">LCMS</option>
                                            <option value="GCMS">GCMS</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Instrumento de Cromatografia: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_system_brand" type="text" placeholder="Por exemplo. Sistema ThermoFisher MS100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Cromatografia AutoSampler Modelo: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_AutoSampler_Model" type="text" placeholder="Por exemplo, escreva o nome do modelo AutoSampler usado">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Cromatografia Coluna Modelo: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_column_brand" type="text" placeholder="Por exemplo. Coluna ThermoFisher MS100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Tipo de Coluna de Cromatografia: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_column_type" type="text" placeholder="Por exemplo, alta polaridade">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Protocolo de Cromatografia: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_protocol" type="text" placeholder="Por exemplo, descrever protocolo de cromatografia usado">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Protocolo de Espectrometria de Massa: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_mass_spectrometry_protocol" type="text" placeholder="Por exemplo, descrever protocolo de espectrometria de massa usado">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Instrumento MS: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_brand" type="text" placeholder="Por exemplo. ThermoFisher MS100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Analisador de Massa MS: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_mass_analyzer" type="text" placeholder="e.g. single quadropole">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Fonte do MS Ion: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_ion_source" type="text" placeholder="Por exemplo. EI, ESI, APCI, Maldi">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Polaridade da varredura de espectrometria de massas: </label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="high_dim_data_upload_metabolomics_ms_scan_polarity">
                                            <option value="negative">Negativo</option>
                                            <option value="positive">Positivo</option>
                                            <option value="both">Ambos</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Intervalo m/z da varredura de espectrometria de massas: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_scan_MZ_Range" type="text" placeholder="Por exemplo, 60-800">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Descrição do equipamento: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_equipment_description" type="text" placeholder="Por exemplo. TermoFisher MS100 Elétrons Ionização TOF Modo Íon Negativo">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Descrição do Processo de Dados: </label>
                                <div class="col-sm-9" >
                                    <textarea rows="10" class="form-control" id="high_dim_data_upload_metabolomics_data_process_description" placeholder="Por exemplo. Isso descreve o modo, configurações do instrumento, procedimento de calibração. Também descreve como os arquivos da máquina LCMS foram transformados em área de pico. Finalmente, descreve como as anotações de metabólitos foram avaliadas até os picos."></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Publicação: </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_publication" type="text" placeholder="Por exemplo. https://doi.org/10.3389/fgene.2021.643733">
                                </div>
                            </div>
                        </div>
                    </div>

                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_data_protocol_step">Vá para o próximo passo</button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> "Informação do Modelo" &>
                    <& /page/page_title.mas, title=>"Dados de alta dimensão devem ser enviados usando as informações do modelo fornecidas" &>

                    <center>
                    <&| /page/explanation.mas, title=>'Informações sobre o Modelo da Matriz de Dados' &>
                        <p>
                        <b>Informação do formato de arquivo</b>
                        <br>
                        <a id="high_dim_data_spreadsheet_format_info">Formato da Folha de Dados Matrix</a>
                        </p>
                    </&>
                    </center>

                    <div id="high_dim_data_upload_transcriptomics_protocol_template_div">
                        <center>
