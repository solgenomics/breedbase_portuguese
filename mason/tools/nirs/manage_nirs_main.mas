<%args>
$nirs_files => undef
$deleted_nirs_files => undef
$all_nirs_files => undef
$all_deleted_nirs_files => undef
$locations => undef
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /tools/high_dimensional_phenotypes/upload_high_dim_spreadsheet_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_relationship_matrix_dialogs.mas &>
<& /tools/nirs/nirs_analysis_train_dialogs.mas &>
<& /tools/nirs/nirs_analysis_predict_dialogs.mas &>
<& /tools/nirs/nirs_analysis_plot_spectra_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<div class="well">
<&| /page/info_section.mas, title=>'Dados NIRS enviados', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Veja e gerencie arquivos de dados NIRS carregados' &>

    <&| /page/info_section.mas, title=>'Seus dados NIRS enviados', is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Seus dados da NIRS', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Estes são arquivos NIRS excluídos' &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Todos os dados NIRS enviados', is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>'Todos os dados da NIRS', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Estes são arquivos NIRS excluídos' &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
</&>
</div>

<div class="well">
<&| /page/info_section.mas, title=>'Análises NIRS', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Veja e gerencie suas análises NIRS' &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="analyses_by_user_table">
              <thead>
              <tr>
                <th>
                  Nome da Análise
                </th>
                <th>
                  Descrição
                </th>
                <th>
                  Tipo de Modelo
                </th>
                <th>
                  Protocolo
                </th>
                <th>
                  Aplicação
                </th>
                <th>
                  Linguagem
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>


<div class="well">
<&| /page/info_section.mas, title=>'Modelos NIRS treinados', is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>'Veja e gerencie seus modelos NIRS' &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="models_by_user_table">
              <thead>
              <tr>
                <th>
                  Nome do modelo
                </th>
                <th>
                  Descrição
                </th>
                <th>
                  Tipo de Modelo
                </th>
                <th>
                  Protocolo
                </th>
                <th>
                  Aplicação
                </th>
                <th>
                  Linguagem
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });
});
</script>
