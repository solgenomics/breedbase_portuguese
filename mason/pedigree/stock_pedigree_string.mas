
<%args>
$stock_id
</%args>

<&| /page/info_section.mas, title=>'Genealogia em texto' &>
  <select id="pedigree_level_select">
    <option value="Parents">Progenitores</option>
    <option value="Grandparents">Avós</option>
    <option value="Great-Grandparents">Bisavós</option>
  </select>

  <span id="pedigree_string">[carregando...]</span>

  <br /><br />
</&>

<script>

jQuery(document).ready(function($) {

  get_pedigree_string(<% $stock_id %>);
  jQuery('#pedigree_level_select').change( function() {
    jQuery('#pedigree_string').html('[carregando...]');
    get_pedigree_string(<% $stock_id %>);
  });
});

function get_pedigree_string(stock_id) {
    jQuery.ajax( {
      url : '/stock/'+ stock_id +'/pedigreestring',
      data : { 'level' : jQuery('#pedigree_level_select').val() },
      error : function(response) {
         alert("ocorreu um erro");
      },
      success: function(response) {
         jQuery('#pedigree_string').html(response.pedigree_string);
      }
    });
}

</script>
