<%args>
  $file
</%args>
% my $stat = $file->stat;
% if( $stat ) {
<a href="/metadata/file/<% $file->file_id |u %>/download">
   <% $file->basename |h %> (<% Number::Bytes::Human::format_bytes( $stat->size ) %>b)
</a>
% } else {
<span class="ghosted" style="cursor: pointer" title="arquivo temporariamente indisponível"><% $file->basename |h %> (temporariamente indisponível)</span>\
%}
<%once>
  use Number::Bytes::Human;
</%once>
