% unless( my $g = $c->enabled_feature('gbrowse2') ) {

<h2>GBrowse não instalado.</h2>
Nenhuma ajuda disponível.

% } else {
<& .gbrowse_info, gb => $g &>
% }


<%def .gbrowse_info>
<%args>
  $gb
</%args>

<& /page/page_title.mas, title => 'Ajuda do GBrowse' &>

<&| /page/info_section.mas, title => 'Sobre' &>
  <p>
    O <% $c->site_name %> usa o Generic Genome Browser (GBrowse),
    desenvolvido pelo <a href="http://gmod.org">projeto GMOD</a>, para
    disponibilizar anotações de sequências navegáveis.
  </p>

  <p>Consulte a <a href="http://gmod.org/wiki/GBrowse#On-line_documentation">documentação on-line do GBrowse</a> para instruções de uso.</p>
</&>

<&| /page/info_section.mas, title => 'Conjuntos de dados disponíveis no GBrowse' &>

%   my $s = $m->scomp('/gbrowse/list_sources.mas');
    <% $s =~ /\S/ ? $s : '<strong>nenhuma fonte disponível</strong>' %>

</&>

</%def>
