<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch' ] &>

<div class="modal fade" id="upload_fieldbook_phenotypes_dialog" name="upload_fieldbook_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="addFieldbookPhenotypeDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addFieldbookPhenotypeDialog">Enviar arquivo do Fieldbook</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_fieldbook_phenotype_file_form" name="upload_fieldbook_phenotype_file_form">
                <div class="well well-sm">
                    <h5>Enviar arquivo de fenótipos exportado pelo Fieldbook no formato de banco de dados para parcelas ou plantas</h5>
                </div>
            <&| /page/explanation.mas, title=>'Informações do modelo' &>
                <p>
                <b>Informações sobre o formato do arquivo</b>
                <br>
                <a id="phenotype_fieldbook_upload_info">Formato da planilha</a>
                </p>
            </&>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Nível dos dados: </label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="upload_fieldbook_phenotype_data_level" name="upload_fieldbook_phenotype_data_level">
                            <option value="plots">Parcelas</option>
                            <option value="plants">Plantas</option>
                            <option value="subplots">Subparcelas</option>
                            <option value="tissue_samples">Amostras de tecido</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Arquivo do Fieldbook: </label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_fieldbook_phenotype_file_input" name="upload_fieldbook_phenotype_file_input" encoding="multipart/form-data" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Opcional: arquivo ZIP de imagens (.zip): </label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_fieldbook_phenotype_images_zipfile" name="upload_fieldbook_phenotype_images_zipfile" encoding="multipart/form-data" />
                    </div>
                </div>

                <div id="upload_phenotype_fieldbook_verify_status"></div>
            </form><br/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-info" name="upload_fieldbook_phenotype_submit_verify" id="upload_fieldbook_phenotype_submit_verify">Verificar</button>
	<button disabled type="button" class="btn btn-primary" name="upload_fieldbook_phenotype_submit_store" id="upload_fieldbook_phenotype_submit_store" title="Primeiro verifique o arquivo">Armazenar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="upload_fieldbook_file_info_dialog" name="upload_fieldbook_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="transcriptomicsUploadInfoDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="transcriptomicsUploadInfoDialog">Informações do modelo</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <h3>Os arquivos do Fieldbook podem ser enviados nos formatos .xlsx ou .csv</h3>
            <h4>Ao exportar fenótipos do Fieldbook, o arquivo já deve estar neste formato. Confirme se a exportação foi realizada corretamente</h4>

            <ul>

                <li><strong>plot_id</strong>, <strong>plant_id</strong>, <strong>subplot_id</strong> UO <strong>tissue_sample_id</strong>: informe o ID de um material já cadastrado no banco de dados.</li>
                <li><strong>Característica</strong>: Uma característica existente no banco de dados.</li>
                <li><strong>valor</strong>: Valor correspondente à característica observada.</li>
                <li><strong>observaçãoTimeStamp</strong>: Data e hora da observação.</li>
                <li><strong>Colecionador</strong>: Nome da pessoa que coletou a observação.</li>
            </ul>
            <table class="table table-hover table-bordered table-condensed" >
                <thead></thead>
                <tbody>
                    <tr>
                        <td>plot_id</td>
                        <td>Característica</td>
                        <td>valor</td>
                        <td>observaçãoTimeStamp</td>
                        <td>Colecionador</td>
                    </tr>
                </tbody>
            </table>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_fieldbook_phenotypes_link').click( function() {
	jQuery('#upload_fieldbook_phenotypes_dialog').modal("show");
    });

    jQuery('#phenotype_fieldbook_upload_info').click( function() {
        jQuery('#upload_fieldbook_file_info_dialog').modal("show");
    });

});

</script>
