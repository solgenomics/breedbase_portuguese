
<%args>
@projects => undef
$programs => undef
@file_metadata => ()
$user_id => undef
@layout_files => undef
@trait_files => undef
@phenotype_files => undef
@removed_phenotype_files => undef
@roles => ()
$fieldbook_config_qrcode_url => ""
$project_name => ""
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form','CXGN.List','CXGN.BreedersToolbox.FieldBook', 'CXGN.BreedersToolbox.HTMLSelect'] &>

  <& /page/page_title.mas, title=>'Ferramentas do Field Book' &>

    <&| /page/info_section.mas, title => "Configuração do BrAPI", subtitle => "Leia o código QR com o Field Book para configurar o acesso BrAPI a este banco de dados" &>

      <div class="container-fluid" style="text-align:center">
	<table>
	  <tr><td width="400" align="center" >
	      <div id="configure_fieldbook_qrcode_div">
		<img src="<% $fieldbook_config_qrcode_url %>" /><br />
		<% $project_name %>
	      </div>
	    </td><td width="60">&nbsp;</td>
	    <td width="400">
	      <div>
	
		<p>Para conectar o Field Book a este banco de dados via BrAPI, no aplicativo:</p>
		<ol>
		  <li>Abra as <strong>Configurações</strong> do Field Book</li>
		  <li>Abra as configurações do <strong>BrAPI</strong></li>
		  <li>Confirme se a opção <strong>Habilitar BRAPI</strong> está marcada</li>
		  <li>Toque na opção <strong>ler código de barras <img style="width: 30px" src="data:image/png;base64," /></strong> da barra de ferramentas</li>
		  <li>Escolha <strong>Importar novas configurações</strong></li>
		  <li>Leia o código QR à esquerda</li>
		  <li>Você será direcionado para entrar no banco de dados com seu nome de usuário e senha</li>
		  <li>Selecione <strong>Autorizar acesso</strong> para permitir que o Field Book use sua conta</li>
		  <li>Marque este banco de dados como <strong>Origem de importação</strong> e <strong>Destino de exportação</strong> padrão</li>
		</ol>
	      </div>
	</td></tr></table>
      </div>
      
      
  </&>
  
  <div class="container-fluid">
    
    <&| /page/explanation.mas, title=>'Arquivos de disposição de campo', collapsible=>1, collapsed=>0, &>
      <p>
	<em><b>Field Book</b></em> é um aplicativo para coletar dados fenotípicos de parcelas experimentais em um tablet Android.
	<br/><br/>
	<a href="https://play.google.com/store/apps/details?id=com.fieldbook.tracker"> Aplicativo Field Book</a>
	<br/><br/>
	Para usar o Field Book, crie nesta página um arquivo de disposição de campo e um arquivo de características. <br/>Depois de baixar os arquivos de disposição e características, transfira-os para as pastas do Field Book no dispositivo móvel, geralmente /fieldbook/import_field/ e /fieldbook/traits/, respectivamente.
	<br/><br/>
	Os arquivos de disposição e características criados aqui permitem que o Field Book identifique corretamente as características e as unidades experimentais, sejam parcelas, plantas ou amostras de tecido.
      </p>
</&>

</div>

<& /fieldbook/create_fieldbook_dialog.mas &>
  
  <&| /page/info_section.mas, title=>'Arquivos de disposição de campo', empty_message=>'', collapsible=>1, collapsed=>0, subtitle=>'[<a name="create_fieldbook_link">Novo</a>]' &>
    <%perl>
    #my @breeding_programs = @{$programs};
    #foreach my $prog (@breeding_programs) {
    #  print @$prog[0].@$prog[1]."</br>";
    #}
    foreach my $file (@file_metadata) {
    my @trial_array = @{$file};
    my $file_name = $trial_array[1];
    my $trial_layout_download = '[<a href="/fieldbook/trial_download/'.$trial_array[2].'">Baixar arquivo</a>]  |   [<a id="delete_fieldbook_layout_link" href="/fieldbook/delete_file/'.$trial_array[2].'">Excluir arquivo</a>]';
    print $trial_array[1]."$trial_layout_download<br>";
    #print $trial_array[2]."</br>";
    }
</%perl>
</&>

<& /fieldbook/create_trait_file_dialog.mas &>
  
<&| /page/info_section.mas, title=>'Arquivos de características', empty_message=>'', collapsible=>1, collapsed=>0, subtitle=>'[<a id="create_new_trait_file_link">Novo</a>]' &>
  <%perl>
  foreach my $trait_ref (@trait_files) {
    my @trait_array = @{$trait_ref};
    my $trait_file_name = $trait_array[0];
    my $trait_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">Baixar arquivo</a>] |   [<a id="delete_trait_file_link" href="/fieldbook/delete_file/'.$trait_array[1].'">Excluir arquivo</a>]';
    print $trait_array[0]."$trait_file_download<br>";
    #print $trial_array[4]."</br>";
  }
  </%perl>
</&>

<&| /page/info_section.mas, title=>'Arquivos de fenótipos enviados', collapsible=>1, collapsed=>0, subtitle=>'[<a id="upload_fieldbook_phenotypes_link">Enviar</a>]' &>
  <%perl>
  if (scalar(@phenotype_files)>0) {
    print qq { <br/><div class="well well-sm"><table class="table fieldbook_phenotype_datatables"><thead><tr><th>Nome do arquivo</th><th>Excluir</th></tr></thead><tbody> };

    foreach my $phenotype_ref (@phenotype_files) {
      my @phenotype_array = @{$phenotype_ref};
      my $phenotype_file_name = $phenotype_array[0];
      #my $phenotype_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">Baixar</a>]';
      #print $phenotype_array[0]."$trait_file_download<br>";
      print qq { <tr><td>$phenotype_array[0]</td><td><a href="javascript:remove_phenotype_data($phenotype_array[1])"><b>X</b></a></td></tr> };
    }

    print qq { </tbody></table></div> };
  }
  </%perl>

</&>

<& /fieldbook/upload_phenotype_fieldbook.mas &>

<&| /page/info_section.mas, title=>'Arquivos de fenótipos removidos', collapsible=>1, collapsed=>1 &>
  <%perl>
  foreach my $phenotype_ref (@removed_phenotype_files) {
    my @phenotype_array = @{$phenotype_ref};
    my $phenotype_file_name = $phenotype_array[0];
    #my $phenotype_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">Baixar</a>]';
    #print $phenotype_array[0]."$trait_file_download<br>";
    print qq { $phenotype_array[0]  <button disabled="1" id="re-upload" >Enviar novamente</button><br /> };
  }
  </%perl>
</&>

</div>


<script>

jQuery(document).ready(function() {
    jQuery('.fieldbook_phenotype_datatables').DataTable();
} );

  function remove_phenotype_data(file_id) {
    var yes = confirm("Deseja remover todos os dados associados a este arquivo (ID="+file_id+")");
    jQuery.ajax( {
      beforeSend: function() { jQuery('#working_modal').modal("show"); },
      url: '/breeders/trial/delete/file/'+file_id,
      success: function(response) {
         jQuery('#working_modal').modal("hide");
         if (response.error) {
           alert(response.error);
         }
         else {
            alert("SUCESSO!");
            location.reload();
         }
      },
      error: function(response) {
         jQuery('#working_modal').modal("hide");
         alert("Ocorreu um erro!");
      }
    });
  }
</script>
