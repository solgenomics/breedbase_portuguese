
<%doc>

=head1 NAME

oldloci.mas - a mason component that shows a list of loci that have been featured in the locus of the week section. The component takes no parameters.

=cut 

</%doc>

<%perl>
use strict;
use File::Spec;
use CXGN::Tools::File;

my $file=(File::Spec->catfile($c->get_conf("homepage_files_dir"), "loci.txt"));

my $loci = qq{ <br /><p class="boxbgcolor5"><br />A lista de todos os locais da semana está indisponível devido a um problema com o servidor. Pedimos desculpas por qualquer inconveniente. Por favor, volte mais tarde.<br /><br /></p><br /><br /> };


eval { 

  $loci = $m->file($file);

};


</%perl>

<& /page/page_title.mas, title=>'Todo Loci da Semana' &>

<% $loci %>

