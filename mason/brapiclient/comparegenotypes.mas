
<%args>

</%args>

<& /page/page_title.mas, title=>"Comparar genótipos usando BrAPI" &>

  Servidor: <input id="server_address" size="40" value="" /><br />

  Malt.pw.usda.gov/t3/wheatplus MOREX BARKEY

<br />

Nome do genótipo 1: <input id="genotype1" size="40" value="IITA-TMS-IBA000017" /><br />
Nome do genótipo 2: <input id="genotype2" size="40" value="95NA-00063"  /><br />

<button id="submit">Enviar</button>





<script>

  jQuery('#submit').click( function() { 
     compare_genotypes();
  });
    

  function compare_genotypes() { 

    var genotype1 = jQuery('#genotype1').val();
    var genotype2 = jQuery('#genotype2').val();
    var server = jQuery('#server_address').val();

    alert('Genótipo 1: '+genotype1+'; genótipo 2: '+genotype2 +'; servidor: '+server);

    var id1;
    var id2;

    jQuery.ajax( { 
       url: server + '/brapi/0.1/germplasm/find',
       data: { q : genotype1 },
  //dataType: 'jsonp',
       async: false,
       success: function(response) { 
         alert("RESPOSTA 1: "+response[0].germplasmId);
         id1 = response[0].germplasmId;
       },
       error: function(response) { 
         alert("Ocorreu um erro.");
       }
     });

     jQuery.ajax( { 
       url: server + '/brapi/0.1/germplasm/find',
       data: { q : genotype2 },
  //dataType: 'jsonp',
       async: false,
       success: function(response) { 
         alert("RESPOSTA 2: "+response[0].germplasmId);
         id2 = response[0].germplasmId;
       },
       error: function(response) { 
         alert("Ocorreu um erro");
  
       }
     });

     alert("Buscar genótipo de "+ id1);

     var scores1;
     var scores2;

     jQuery.ajax( { 
       url: server + '/brapi/0.1/genotype/'+id1,
//       dataType: 'jsonp',
       async: false,
       success: function(response) { 
         alert("RESPOSTA de "+id1+": "+Object.keys(response.genotypes[0].genotype).length);
         scores1 = response.genotypes[0].genotype;
       },
       error: function(response) { 
         alert("Ocorreu um erro ao buscar o genótipo de "+id1);
       }
     });
    
  jQuery.ajax( { 
       url: server +  '/brapi/0.1/genotype/'+id2,
       async: false,
//       dataType: 'jsonp',
       success: function(response) { 
         alert("RESPOSTA de "+id2+": "+Object.keys(response.genotypes[0].genotype).join(" / "));
         scores2 = response.genotypes[0].genotype;
       },
       error: function(response) { 
         alert("Ocorreu um erro ao buscar o genótipo de "+id1);
       }
     });
     var matches = 0;
     var total = 0;
     alert("CHAVES: "+Object.keys(scores1).join(">>>"));
     Object.keys(scores1).forEach( function(k) { 

          if (scores1[k] === scores2[k]) { 
            matches++;
          }
        
          total++;
        });
     alert("Correspondências: "+matches + " Total: "+total+ " D :" + (matches / total));
          
}
  


</script>
