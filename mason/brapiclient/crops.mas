<%args>
</%args>

<h4>Culturas</h4>

<div id="brapi_crops_div">
<button class="btn btn-primary" id="brapi_home_show_crops">Mostrar culturas</button>

</div>

<script>

jQuery(document).ready(function() {

jQuery("#brapi_home_show_crops").click(function() {
    jQuery.ajax( {
      'url': jQuery('#brapi_home_url_select').val()+'/brapi/v1/crops',
      'method': 'GET',
      'success': function(response) {
        console.log(response);
        var html = '<br/><ul>';
        for(var i = 0; i < response.result.data.length; i++) {
            html = html+'<li>'+response.result.data[i]+'</li>';
        }
        html = html+'</ul>';
        jQuery("#brapi_crops_div").empty().html(html);
      },
      error: function(response) {
        alert('Ocorreu um erro ao obter as culturas');
      }
    });
});

});

</script>
