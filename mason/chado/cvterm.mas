<br /><b> Referências cruzadas relacionadas</b><br />
% foreach my $sa (@secondary_accessions) {
<% $sa %><br />
%  }

</&>
<br />


% my $props_subtitle = $allow_edits ? "[<a id=\"cvterm_add_props\" href=\"javascript:cvtermprops_addPropDialog()\">Adicionar...</a>]" : "";

% if ($is_variable) {
<&| /page/info_section.mas, title => "Propriedades Variáveis" , collapsible=> 1, is_subsection => 1, subtitle=>$props_subtitle &>
      <& /chado/cvtermprops.mas,
       cv_name    => 'trait_property',
       cvterm_id  =>$cvterm_id,
       props      => $cvtermprops,
        div_name   => 'cvtermprops',
	edit_privs => $edit_privs,
  allow_edits => $allow_edits,
	subset     => \@editable_cvterm_props,
	editable   => \@editable_cvterm_props  &>
</&>

% }
% else {


%}

<div id="cvterm_id" style="display:none" ><% $cvterm_name %>|<% $accession %></div>

<&| /page/info_section.mas, title=>"Adicione este termo a uma lista", collapsible=>1, collapsed=>1 &>
<div id="paste_to_list">
LOAD...
</div>

</&>
<script>

  if (isLoggedIn()) {
    addToListMenu('paste_to_list', 'cvterm_id', { listType: 'traits' } );
  }
  else {
    jQuery('#paste_to_list').html("Por favor, faça login para usar listas.");
  }

</script>

<br />


<& /ontology/embedded_browser.mas, cvterm => $cvterm &>



<&| /page/info_section.mas,
    title=> "Loci anotado",
    subtitle => '',
    collapsible => 1,
    collapsed   => 1,
&>

<table id="loci_data" class="display">
<thead>
  <tr>
    <th>Organismo</th>
    <th>Símbolo de Locus</th>
    <th>Nome Locus</th>
  </tr>
</thead>

</table>

<script>

  jQuery(document).ready(function () {

    jQuery('#loci_data').DataTable( {
      'ajax': '/cvterm/'+ <% $cvterm_id %> + '/datatables/annotated_loci',
     });

    jQuery('#cvterm_edit_submit_btn').click(function() {

      jQuery.ajax({
        url : '/ajax/trait/edit/',
        data : {
          cvterm_id : <% $cvterm_id %> ,
          new_name : jQuery('#cvterm_new_name').val(),
          new_definition : jQuery('#cvterm_new_definition').val()
        },
        beforeSend : function () {
          jQuery('#working_modal').modal("show");
        },
        success : function (response) {
          jQuery('#working_modal').modal("hide");
          if (response.error) {
            alert(response.error);
          } else {
            alert("Mudanças salvas.");
            window.location.reload();
          }
        },
        error : function () {
          jQuery('#working_modal').modal("hide");
          alert("Ocorreu um erro ao editar os detalhes do termo da ontologia.");
        }
      });

    });
  });

</script>


</&>



