<%args>
    $content => ''
    $sha1
    $bulk_js_menu
    $bulk_download_stats
    $bulk_download_success
</%args>
<% $bulk_js_menu %>
<h1>Tradução:</h1>

% if($bulk_download_success) {
    Sua consulta foi bem-sucedida.<br>
<div id="bulk_download_stats">
<% $bulk_download_stats %>
</div>
Baixar como <a href="/bulk/feature/download/<% $sha1 %>.fasta">Fasta</a>
% } else {
    Sua consulta não continha nenhum identificador válido. Tente novamente.
% }
