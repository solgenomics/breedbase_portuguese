
<%args>
$model_id
</%args>

<button class="btn btn-default" id="delete_model_data_by_model_id" role="button">Excluir</button><br/><br/>

<div class="modal  fade" id="delete_model_data_dialog" name="delete_model_data_dialog" tabindex="-1" role="dialog" aria-labelledby="DeleteModelDataDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="DeleteModelDataDialog">Excluir modelo</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <center>
                    <p3> Tem certeza de que deseja excluir este modelo? <br> Confirme a exclusão abaixo...</p3>
                    </center></br>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_delete_model_dialog" type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" name="delete_model_data_dialog_submit" id="delete_model_data_dialog_submit">Excluir modelo</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#delete_model_data_by_model_id').click(function(){
        jQuery('#delete_model_data_dialog').modal('show');
    });

    jQuery('#delete_model_data_dialog_submit').click(function(){
        jQuery.ajax({
            type: 'GET',
            url : '/ajax/analysis_model/delete?model_id=<% $model_id %>',
            beforeSend: function() {
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                jQuery('#working_modal').modal('hide');
                console.log(response);
                if (response.error) {
                    alert(response.error);
                }
                if  (response.success) {
                    alert('MODELO EXCLUÍDO!')
                    location.reload();
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('Erro ao excluir o modelo de análise!');
            }
        });
    });
});
</script>
