<%args>
$trial_id
$trial_name
$trial_description
$breeding_program_name
$breeding_program_id
$year
$identifier_prefix
$trial_stock_type
$analysis_metadata
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>Nome da análise</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[Nome da análise não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Programa de melhoramento </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print "<span class='text-danger'>[Programa de melhoramento não informado]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>Ano</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[Ano não informado]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Descrição</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[Descrição não informada]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>Protocolo</b></td>
                <td>
                    <div id="analysis_protocol">
%  print $analysis_metadata->analysis_protocol;
                    </div>
                </td>
            </tr>

            <tr><td><b>Conjunto de dados</b></td>
                <td>
                    <div id="analysis_dataset_id">
%  print "<a href=/dataset/".$analysis_metadata->dataset_id.">".$analysis_metadata->dataset_id."</a>";
                    </div>
                </td>
            </tr>

            <tr><td><b>Criado em</b></td>
                <td>
                    <div id="analysis_create_timestamp">
%  print $analysis_metadata->create_timestamp;
                    </div>
                </td>
            </tr>

            <tr><td><b>Resumo dos resultados</b></td>
                <td>
                    <div id="analysis_result_summary">
%  if ($analysis_metadata->result_summary) {
%    while (my($k,$v) = each %{$analysis_metadata->result_summary}) {
%       print $k." : ".$v."<br/>";
%    }
%  }
                    </div>
                </td>
            </tr>

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
