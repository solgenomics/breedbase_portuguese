
<%args>
</%args>

<%doc>

=head1 NAME

/mason/analyses/index.mas - show user-specific analyses in the system

=head1 DESCRIPTION

Displays a page with a table of all the analyses run by the currently logged in user.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ], entries => ['analyses' ] &>

<& /page/page_title.mas, title => "Suas análises e modelos de análise" &>

<button class='btn btn-primary' style='margin:3px;float:right' id='drone_imagery_calculate_statistics_link'>Estatísticas de imagens de drone</button><button class='btn btn-primary' style='margin:3px;float:right' id='analysis_calculate_statistics_link'>Análise GEBV de um ou vários ensaios</button><button class="btn btn-default" name="upload_new_analysis_button" style="margin:3px;float:right">Enviar análise</button><br />
<hr>

<& /analyses/analysis_calculate_statistics.mas &>
<& /analyses/upload_analysis_dialogs.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_analysis.mas &>
<& /analyses/store_new_analysis_values_and_model.mas &>

<div class="well">
<h3>Suas análises</h3>
<table class="table table-bordered table-hover" id="analyses_by_user_table">
  <thead>
  <tr>
    <th>
      Nome da análise
    </th>
    <th>
      Descrição
    </th>
    <th>
      Tipo de modelo
    </th>
    <th>
      Protocolo
    </th>
    <th>
      Aplicação
    </th>
    <th>
      Linguagem
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<div class="well">
<h3>Seus modelos</h3>
<table class="table table-bordered table-hover" id="models_by_user_table">
  <thead>
  <tr>
    <th>
      Nome do modelo
    </th>
    <th>
      Descrição
    </th>
    <th>
      Tipo de modelo
    </th>
    <th>
      Protocolo
    </th>
    <th>
      Aplicação
    </th>
    <th>
      Linguagem
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user' }
    });
});
</script>
