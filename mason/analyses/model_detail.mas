
<%doc>

=head1 NAME

/mason/analyses/model_detail.mas

=head1 DESCRIPTION

Displays a detail page for an analysis model.


=head1 AUTHOR


=cut

</%doc>

<%args>
$model_id
$model_name
$model_description
$model_properties
$model_file_ids
$model_type_name
$model_files
$identifier_prefix
</%args>

<& /util/import_javascript.mas, entries => ['analyses'], classes => [ 'jquery', 'jquery.dataTables' ],  &>

<& /page/page_title.mas, title => "Modelo <span id=\"model_name_title\">$model_name</span>" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Detalhes do modelo</h4>", info_section_subtitle => 'Visualize as informações básicas do modelo.', buttons_html => '', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "analysis_model_details", model_id => $model_id, model_name => $model_name, model_description => $model_description, model_properties => $model_properties, model_file_ids => $model_file_ids, model_type_name => $model_type_name, model_files => $model_files, identifier_prefix => $identifier_prefix &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>Resultados das análises</h4>", info_section_subtitle => 'Visualize as análises derivadas deste modelo.', buttons_html => '', icon_class => "glyphicon glyphicon-option-horizontal", info_section_id => "model_analyses", model_id => $model_id &>

<& /page/detail_page_2_col_section.mas, model_id => $model_id, info_section_title => "<h4 style='display:inline'>Excluir modelo</h4>", info_section_subtitle => 'Exclua o modelo do banco de dados.', icon_class => "glyphicon glyphicon-trash", info_section_id => "model_deletion_section" &>

<script>
jQuery(document).ready(function(){

});
</script>
