<%doc>
QTL traits list.
</%doc>

<%args>
$index
$traits_list
</%args>

<& /page/page_title.mas, 
   title=>'Lista de características com QTLs'
&>

<&| /page/info_section.mas, 
   title    => qq |Características que começam com "$index" |
&>

<&/page/columnar_table.mas,
   data         => $traits_list,
  __align       => 'l',
  __alt_freq    => 2,
  __alt_width   => 1,
  __cellpadding => 20,
 &>

</&>
