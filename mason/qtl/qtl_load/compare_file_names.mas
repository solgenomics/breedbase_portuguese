<%doc>

=head1 NAME

compare_file_names.mas - a mason component for displaying message 
when a user tries to submit the same files for two different dataset fields...
=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$file1
$file2
$guide

</%args>

<%perl>
my $message = qq | <p>Você está tentando enviar arquivo(s) com o mesmo nome 
                     <b>($file1 e $file2)</b> neste passo e em um dos 
                     passos anteriores.
                   </p>
                   <p><a href="javascript:history.go(-1)"><b>Volte</b></a> 
                     e verifique o arquivo que você está tentando enviar ou, se o 
                     problema persistir, entre em contato conosco.
                   </p>
                | ;


</%perl>

<& /page/page_title.mas, title => 'Arquivos de dados' &>
<&| /page/info_section.mas, title => '', subtitle => $guide &>
  <% $message %>  
</&>
