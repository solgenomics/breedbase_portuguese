<%doc>

=head1 NAME

trait_columns.mas - a mason component for displaying message 
when a user tries to submit traits file with wrong order of column data...
=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$error
$guide

</%args>

<%perl>
$error .= qq |<p><a href="javascript:history.go(-1)"><b>Volte</b></a>, 
                 reorganize a ordem das colunas e envie o arquivo novamente ou, se 
                 o problema persistir, entre em contato conosco.
              </p>
             |;
</%perl>

<& /page/page_title.mas, title => 'Arquivo de características' &>
<&| /page/info_section.mas, title => '', subtitle => $guide &>
  <% $error %>  
</&>
