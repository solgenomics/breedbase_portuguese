<%doc>
QTL search results view.
</%doc>

<%args>

$data
$pager
$page_links
$query

</%args>

<& /page/page_title.mas,
    title => 'Resultados da pesquisa QTL',
&>
  
% if ($data) 
% { 

<&| /page/info_section.mas,
      title => 'Resultados da Pesquisa',
&>
  <& /page/columnar_table.mas,
     headings    => [ 'Nome da característica', 'Definição', 'QTL' ],
    data         => $data,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
  &>
  </&>
  <& /page/pagination_control.mas, 
     pager     => $pager, 
    link_maker => $page_links 
  &> 
%}
%else
%{
<&| /page/info_section.mas,
      title => 'Resultados da Pesquisa',
&>
%if ( $query )
%{
<br>Nenhum resultado encontrado para <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br>Sem resultados. Procure novamente com um nome característico.<br />
%}
</&>
%}

<&| /page/info_section.mas,
    title       => 'Buscar',
    collapsible => '1',
    collapsed   => 1
 &>

<& /search/phenotypes/qtl.mas &>

</&>


