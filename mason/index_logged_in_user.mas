
<%args>

$schema
$static_content_path
$username
$role
$first_name
$last_name
$sp_person_id
$timestamp
$phenotype_files => undef
$breeding_programs => undef
$locations => undef
$preferred_species => undef
$editable_stock_props => {}

</%args>

<%init>
my %role_in_portuguese = (
  user      => 'usuário',
  curator   => 'curador',
  submitter => 'colaborador',
  sequencer => 'sequenciador',
  breeder   => 'melhorista',
  admin     => 'administrador',
);
my $display_role = $role_in_portuguese{lc($role || '')} || $role;
</%init>

<div style="text-align: center">

<h3>Bem-vindo(a) de volta, <% $first_name %>!</h3>

Seu perfil atual é "<% $display_role %>".

<!-- table id="manage_user_role_table" class="table table-bordered" width="100%" >
<thead>
<tr><th>User</th><th>Your currently assigned roles</th></tr>

</thead>
<tbody>
</tbody>
</table -->

% if ($role ne "user") {

<&|  /page/info_section.mas, title => "<b><font size=\"3\">Continue de onde parou</font></b>", collapsible => 1, collapsed => 1 &>

<h4>Continue de onde parou:</h4>
Intervalo:&nbsp;

<select id="interval">
    <option value="day">Dia</option>
    <option value="week">Semana</option>
    <option value="month">mês</option>
    <option value="year">ano</option>
</select>

<br /><br />
<h4>10 ensaios criados mais recentemente:</h4>

<table id="recently_created_trial_table" style="width:100%" >
<thead>
<tr><th>Ensaio</th><th>Tipo de ensaio</th><th>Programa de melhoramento</th><th>Data de criação</th></tr>
</thead>
</table>

<br /><br />
<h4>10 ensaios modificados mais recentemente:</h4>

<table id="recently_modified_trial_table" style="width:100%">
<thead>
<tr><th>Ensaio</th><th>Tipo de ensaio</th><th>Programa de melhoramento</th><th>Último fenótipo adicionado</th></tr>
</thead>
</table>

<br /><br />
<h4>10 acessos adicionados mais recentemente:</h4>

<table id="recently_added_accessions_table" style="width:100%">
<thead>
<tr><th>Acesso</th><th>Data de criação</th></tr>
</thead>
</table>



</&>

%} # -- if ($role ne...

</div>

<script>
    var interval = jQuery('#interval').val()	

    update_tables(interval);

    jQuery('#interval').change( function() {
        interval = jQuery('#interval').val();
	update_tables(interval);
	});

    function update_tables(interval) { 
        jQuery('#recently_created_trial_table').DataTable({
	    'destroy': true,
    	    'columns' : [{ width: '300px' }, { width: '200px'}, { width: '100px'}, null],	
            'ajax':'/ajax/breeders/recent_trials/'+interval,
            'order': [[ 3, 'desc']],
	    'paging': false,
	    'searching': false,
	    'bInfo': false
        });

        jQuery('#recently_modified_trial_table').DataTable({
	    'destroy' : true,
            'columns': [{ width: '300px' }, { width: '200px'}, { width: '100px'}, null],
            'ajax':'/ajax/breeders/recently_modified_trials/'+interval,
    	    'paging': false,
	    'searching': false,
	    'bInfo' : false
        });

        jQuery('#recently_added_accessions_table').DataTable({
	    'destroy' : true,
            'ajax':'/ajax/breeders/recently_added_accessions/'+interval,
    	    'paging': false,
	    'searching' : false,
	    'bInfo': false,
    	    'columns': [{ width: '680px'}, null ],	
        });

//   jQuery('#manage_user_role_table').DataTable( {
//       ajax : '/ajax/roles/list/<% $sp_person_id %>',
//       searching: false,
//       paging: false,
//   });

}

</script>


<& /index.mas, schema => $schema, timestamp => $timestamp, static_content_path=> $static_content_path, phenotype_files => $phenotype_files, breeding_programs => $breeding_programs, locations => $locations, preferred_species => $preferred_species, editable_stock_props => $editable_stock_props &>
