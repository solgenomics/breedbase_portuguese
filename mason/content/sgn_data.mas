<%doc>

=head1 NAME

sgn_data.mas - SGN page for organism data overview in a tree format

=cut

</%doc>

<%args>
    $organism_trees
</%args>

<& /util/import_javascript.mas, classes => ["CXGN.Page.FormattingHelpers", "CXGN.Effects"] &>

<& /page/page_title.mas, title=> "Visão geral dos dados da SGN" &>

<script language="javascript" type="text/javascript" src="/js/popup.js"></script>

<div class="page_introduction">
  Esta página apresenta um resumo de todos os dados disponíveis sobre SGN classificados por espécie. Clique em um nome de espécie para obter detalhes sobre seus mapas disponíveis, loci, bibliotecas, ESTs, anotação metabólica e acessos fenotipados.
</div>

% for my $category (reverse sort keys %$organism_trees) {
%    my $organism_tree = $organism_trees->{$category};

   <&| /page/info_section.mas,
     title         => $category,
     subtitle      => 'Clique em um nome de organismo para ver mais detalhes ',
     empty_message => 'Árvore não disponível',
     collapsible   => 1,
     collapsed     => 0,
     &>

     <& /organism/tree.mas, organism_tree => $organism_tree &>

   </&>

% }
